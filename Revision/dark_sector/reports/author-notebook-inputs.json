			"kind":"Input",
			"label":"In[28]:=",
			"text":"HoldForm[MergeSetsStep[currentSets_List] := Module[{n = Length[currentSets], i, j, merged = currentSets}, Catch[For[i = 1, i <= Length[merged], i++, For[j = i + 1, j <= Length[merged], j++, If[Intersection[merged[[i]], merged[[j]]] =!= {}, merged = Delete[merged, {{i}, {j}}]; AppendTo[merged, Sort[Union[currentSets[[i]], currentSets[[j]]]]]; Throw[Sort[merged]]; ]; ]; ]; Sort[merged]]]; ]",
			"chars":391,
