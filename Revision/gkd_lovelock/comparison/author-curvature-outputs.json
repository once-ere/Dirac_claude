			"inputForm":"HoldForm[(Clear[rt]; )*(rt[g_, ass_:{}] := Module[{t, \\[CapitalGamma]\\[CapitalGamma], Ricci\\[CapitalGamma], Rie\\[CapitalGamma], RS, G, ginv}, Print[Now]; t = AbsoluteTiming[ginv = FullSimplify[Inverse[g], ass]; \\[CapitalGamma]\\[CapitalGamma] = FullSimplify[Table[(1\/2)*Sum[ginv[[i,s]]*(D[g[[s,j]], X[[k]]] + D[g[[s,k]], X[[j]]] - D[g[[j,k]], X[[s]]]), {s, 1, DIM8}], {i, 1, DIM8}, {j, 1, DIM8}, {k, 1, DIM8}], ass]; Ricci\\[CapitalGamma] = ParallelTable[FullSimplify[D[\\[CapitalGamma]\\[CapitalGamma][[\\[Mu],\\[Nu],\\[Beta]]], X[[\\[Alpha]]]] - D[\\[CapitalGamma]\\[CapitalGamma][[\\[Mu],\\[Nu],\\[Alpha]]], X[[\\[Beta]]]] + Sum[\\[CapitalGamma]\\[CapitalGamma][[\\[Mu],s,\\[Alpha]]]*\\[CapitalGamma]\\[CapitalGamma][[s,\\[Nu],\\[Beta]]] - \\[CapitalGamma]\\[CapitalGamma][[\\[Mu],s,\\[Beta]]]*\\[CapitalGamma]\\[CapitalGamma][[s,\\[Nu],\\[Alpha]]], {s, 1, DIM8}], ass], {\\[Mu], 1, DIM8}, {\\[Nu], 1, DIM8}, {\\[Alpha], 1, DIM8}, {\\[Beta], 1, DIM8}]; Rie\\[CapitalGamma] = ParallelTable[FullSimplify[Sum[Ricci\\[CapitalGamma][[\\[Alpha],\\[Mu],\\[Alpha],\\[Nu]]], {\\[Alpha], 1, DIM8}], ass], {\\[Mu], 1, DIM8}, {\\[Nu], 1, DIM8}]; RS = FullSimplify[Tr[ginv . Rie\\[CapitalGamma]], ass]; G = ParallelTable[CheckAbort[FullSimplify[Rie\\[CapitalGamma][[\\[Alpha]]] - (1\/2)*g[[\\[Alpha]]]*RS, ass], Defer[FullSimplify[Rie\\[CapitalGamma][[\\[Alpha]]] - (1\/2)*g[[\\[Alpha]]]*RS, ass]]], {\\[Alpha], 1, Length[Rie\\[CapitalGamma]]}]; ]; Print[t]; Print[Now]; Return[{ginv, \\[CapitalGamma]\\[CapitalGamma], Ricci\\[CapitalGamma], Rie\\[CapitalGamma], RS, G}]])]"
		},
