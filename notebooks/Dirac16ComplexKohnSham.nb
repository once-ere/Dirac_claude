                     {"AllTrue", "[", RowBox[{"states", ",", RowBox[
                         {RowBox[{RowBox[{"#1", "[", "\"particle\"", "]"}],
                          "\[Equal]", RowBox[{"(", RowBox[{RowBox[{"#1", "[",
                          "\"eps\"", "]"}], "\[GreaterEqual]", RowBox[{"-",
                          FractionBox["1", SuperscriptBox["10", "12"]]}]}],
                          ")"}]}], "&"}]}], "]"}]}], ",", RowBox[
                   {"\"nearest\"", "\[Rule]", RowBox[{"Function", "[",
                      RowBox[{"target", ",", RowBox[{RowBox[{"First", "[",
