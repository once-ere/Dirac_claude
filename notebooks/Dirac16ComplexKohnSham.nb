                       {"{", RowBox[{"True", ",", "False"}], "}"}]}],
                    "}"}]}], ",", RowBox[{"FrameStyle", "\[Rule]",
                  RowBox[{"Directive", "[", RowBox[{RowBox[{"RGBColor", "[",
                        "\"#c3c2b7\"", "]"}], ",", RowBox[
                       {"AbsoluteThickness", "[", "1", "]"}]}], "]"}]}], ",",
                RowBox[{"FrameTicksStyle", "\[Rule]", RowBox[{"Directive",
                    "[", RowBox[{RowBox[{"RGBColor", "[", "\"#52514e\"",
                        "]"}], ",", RowBox[{"FontFamily", "\[Rule]",
                        "\"Arial\""}], ",", RowBox[{"FontSize", "\[Rule]",
                        "12"}]}], "]"}]}], ",", RowBox[{"FrameLabel",
                  "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[
                         {"None", ",", "None"}], "}"}], ",", RowBox[
                       {"{", RowBox[{RowBox[{"Style", "[", RowBox[{"\"digits \
of agreement, -log10(max absolute deviation)\"", ",", RowBox[{"RGBColor",
                          "[", "\"#52514e\"", "]"}], ",", RowBox[
                          {"FontFamily", "\[Rule]", "\"Arial\""}], ",",
                          "13"}], "]"}], ",", "None"}], "}"}]}], "}"}]}],
                ",", RowBox[{"PlotLabel", "\[Rule]", RowBox[{"Style", "[",
                    RowBox[{"\"Agreement of the Mathematica computations with \
the Rust Kohn-Sham solver\"", ",", RowBox[{"RGBColor", "[", "\"#0b0b0b\"",
                        "]"}], ",", RowBox[{"FontFamily", "\[Rule]",
                        "\"Arial\""}], ",", "14"}], "]"}]}], ",",
                RowBox[{"GridLines", "\[Rule]", RowBox[{"{", RowBox[
                     {"Automatic", ",", "None"}], "}"}]}], ",",
                RowBox[{"GridLinesStyle", "\[Rule]", RowBox[{"Directive",
                    "[", RowBox[{RowBox[{"RGBColor", "[", "\"#e1e0d9\"",
                        "]"}], ",", RowBox[{"AbsoluteThickness", "[", "0.6`",
                        "]"}]}], "]"}]}], ",", RowBox[{"Background",
                  "\[Rule]", RowBox[{"RGBColor", "[", "\"#fcfcfb\"", "]"}]}],
                ",", RowBox[{"ImageSize", "\[Rule]", "760"}], ",",
                RowBox[{"AspectRatio", "\[Rule]", "0.62`"}], ",",
                RowBox[{"ImagePadding", "\[Rule]", RowBox[{"{", RowBox[
                     {RowBox[{"{", RowBox[{"250", ",", "30"}], "}"}], ",",
                      RowBox[{"{", RowBox[{"55", ",", "35"}], "}"}]}],
                    "}"}]}], ",", RowBox[{"PlotRange", "\[Rule]",
                  RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "16"}],
                        "}"}], ",", "All"}], "}"}]}]}], "]"}]}], ";",
          RowBox[{"AppendTo", "[", RowBox[{"figureFiles", ",",
              RowBox[{"exportFigure", "[", RowBox[
                 {"\"agreement_overview.png\"", ",", "g"}], "]"}]}], "]"}],
          ";", "g"}]}], "]"}]], "Input"],
  Cell["Report and fail-fast verification", "Section"],
  Cell["Summary of the measured agreement (all computed above; deviations are \
absolute unless marked otherwise; Rust = the committed CVODE outputs under \
artifacts/dirac16complex/kohn-sham/rust/spectrum and rust/scf).", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"findingsRows", "=",
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"exact theory\"", ",",
                "\"checks of wolfram/Dirac16ComplexKohnSham.wl (all pass)\"",
                ",", RowBox[{"theoryCheckSummary", "[", "\"checkCount\"",
                  "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"\"k = 0 box\"",
                ",", "\"exact levels vs Rust, six files\"", ",",
                RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                       {RowBox[{"#1", "[", "\"maxAbsDeviation\"", "]"}],
                        "&"}], ")"}], "/@", RowBox[{"Values", "[",
                      "boxComparison", "]"}]}], "]"}]}], "}"}], ",",
            RowBox[{"{", RowBox[{"\"k = 0 box\"", ",",
                "\"NDSolve shooting vs exact levels\"", ",", RowBox[
                 {"Max", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1", "[",
                          "\"k0VsExactBoxMaxAbsDeviation\"", "]"}], "&"}],
                      ")"}], "/@", RowBox[{"Values", "[",
                      "freeSpectrumResults", "]"}]}], "]"}]}], "}"}], ",",
            RowBox[{"{", RowBox[{"\"zero mode\"", ",",
                "\"slope d eps/dk vs -s c (Richardson, h = 2e-4)\"", ",",
                "zeroModeSlopeDeviation"}], "}"}], ",",
            RowBox[{"{", RowBox[{"\"free spectra\"", ",",
                "\"levels compared (six files, keys identical)\"", ",",
                RowBox[{"Total", "[", RowBox[{RowBox[{"(", RowBox[
                       {RowBox[{"#1", "[", "\"levels\"", "]"}], "&"}], ")"}],
                    "/@", RowBox[{"Values", "[", "freeSpectrumResults",
                      "]"}]}], "]"}]}], "}"}], ",",
            RowBox[{"{", RowBox[{"\"free spectra\"", ",",
                "\"eps, NDSolve vs Rust\"", ",", RowBox[{"Max", "[",
                  RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1", "[",
                          "\"maxAbsDeviation\"", "]"}], "&"}], ")"}], "/@",
                    RowBox[{"Values", "[", "freeSpectrumResults", "]"}]}],
                  "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{
                "\"free spectra\"", ",",
                "\"scalar / pressure charges vs Rust\"", ",", RowBox[
                 {"{", RowBox[{RowBox[{"Max", "[", RowBox[{RowBox[{"(",
                          RowBox[{RowBox[{"#1", "[",
                          "\"maxScalarChargeDeviation\"", "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Values", "[",
                          "freeSpectrumResults", "]"}]}], "]"}], ",",
                    RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"#1", "[",
                          "\"maxPressureChargeDeviation\"", "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Values", "[",
                          "freeSpectrumResults", "]"}]}], "]"}]}], "}"}]}],
              "}"}], ",", RowBox[{"{", RowBox[{"\"free spectra\"", ",",
                "\"linear-system matching residual (max)\"", ",",
                RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                       {RowBox[{"#1", "[", "\"maxMatchingResidual\"", "]"}],
                        "&"}], ")"}], "/@", RowBox[{"Values", "[",
                      "freeSpectrumResults", "]"}]}], "]"}]}], "}"}], ",",
            RowBox[{"{", RowBox[{"\"closed shells\"", ",",
                "\"tables m = 1, 3 (L = 3) vs Rust\"", ",", RowBox[
                 {"Max", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1", "[",
                          "\"maxAbsDeviation\"", "]"}], "&"}], ")"}], "/@",
                    RowBox[{"Values", "[", "closedShellComparison", "]"}]}],
                  "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"\"SCF N = 8\"",
                ",", "\"iterations to 1e-12 (Rust: to 1e-10)\"", ",",
                RowBox[{"{", RowBox[{RowBox[{"scfComparison", "[",
                      "\"iterations\"", "]"}], ",", RowBox[{"scfComparison",
                      "[", "\"rustIterations\"", "]"}]}], "}"}]}], "}"}],
            ",", RowBox[{"{", RowBox[{"\"SCF N = 8\"", ",",
                "\"eps_HOMO (= mu), WL vs Rust\"", ",", RowBox[
                 {"scfComparison", "[", "\"epsHomoDeviation\"", "]"}]}],
              "}"}], ",", RowBox[{"{", RowBox[{"\"SCF N = 8\"", ",",
                "\"E_0, WL vs Rust\"", ",", RowBox[{"scfComparison", "[",
                  "\"energyDeviation\"", "]"}]}], "}"}], ",",
            RowBox[{"{", RowBox[{"\"SCF N = 8\"", ",",
                "\"sum eps / Hartree / exchange energies\"", ",",
                RowBox[{"{", RowBox[{RowBox[{"scfComparison", "[",
                      "\"ksSumDeviation\"", "]"}], ",", RowBox[
                     {"scfComparison", "[", "\"hartreeDeviation\"", "]"}],
                    ",", RowBox[{"scfComparison", "[",
                      "\"exchangeDeviation\"", "]"}]}], "}"}]}], "}"}], ",",
            RowBox[{"{", RowBox[{"\"SCF N = 8\"", ",",
                "\"M_eff(y) and v_x(y) on the grid (max)\"", ",",
                RowBox[{"{", RowBox[{RowBox[{"scfComparison", "[",
                      "\"mEffMaxAbsDeviation\"", "]"}], ",", RowBox[
                     {"scfComparison", "[", "\"vxMaxAbsDeviation\"", "]"}]}],
                  "}"}]}], "}"}], ",", RowBox[{"{", RowBox[{"\"SCF N = 8\"",
                ",", "\"n_c and S_c relative to D\"", ",", RowBox[
                 {"{", RowBox[{RowBox[{"scfComparison", "[",
                      "\"ncMaxDeviationOverD\"", "]"}], ",", RowBox[
                     {"scfComparison", "[", "\"scMaxDeviationOverD\"",
                      "]"}]}], "}"}]}], "}"}], ",",
            RowBox[{"{", RowBox[{"\"SCF N = 8\"", ",",
                "\"HOMO orbital (a, b) on the grid\"", ",", RowBox[
                 {"scfComparison", "[", "\"homoProfileMaxDeviation\"",
                  "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"\"SCF N = 8\"",
                ",",
                "\"complete spectrum: levels, shells (keys identical)\"",
                ",", RowBox[{"{", RowBox[{RowBox[{"scfSpectrumComparison",
                      "[", "\"levels\"", "]"}], ",", RowBox[
                     {"scfSpectrumComparison", "[", "\"shellsUsed\"",
                      "]"}]}], "}"}]}], "}"}], ",",
            RowBox[{"{", RowBox[{"\"SCF N = 8\"", ",",
                "\"complete spectrum: eps, WL vs Rust\"", ",",
                RowBox[{"scfSpectrumComparison", "[", "\"maxAbsDeviation\"",
                  "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"\"SCF N = 8\"",
                ",", "\"KS gap / LUMO / sea top\"", ",", RowBox[
                 {"{", RowBox[{RowBox[{"scfSpectrumComparison", "[",
                      "\"ksGapDeviation\"", "]"}], ",", RowBox[
                     {"scfSpectrumComparison", "[", "\"epsLumoDeviation\"",
                      "]"}], ",", RowBox[{"scfSpectrumComparison", "[",
                      "\"seaTopDeviation\"", "]"}]}], "}"}]}], "}"}]}],
          "}"}]}], ";", RowBox[{"Grid", "[",
        RowBox[{RowBox[{"Prepend", "[", RowBox[
             {RowBox[{RowBox[{"(", RowBox[{RowBox[{"{", RowBox[{RowBox[
                         {"#1", "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], ",", RowBox[{"#1",
                          "\[LeftDoubleBracket]", "2",
                          "\[RightDoubleBracket]"}], ",", RowBox[
                         {"StringRiffle", "[", RowBox[{RowBox[{RowBox[{"(",
                          RowBox[{RowBox[{"If", "[", RowBox[{RowBox[
                          {"IntegerQ", "[", "#1", "]"}], ",", RowBox[
                          {"ToString", "[", "#1", "]"}], ",", RowBox[
                          {"sciLabel", "[", "#1", "]"}]}], "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Flatten", "[", RowBox[{"{",
                          RowBox[{"#1", "\[LeftDoubleBracket]", "3",
                          "\[RightDoubleBracket]"}], "}"}], "]"}]}], ",",
                          "\" / \""}], "]"}]}], "}"}], "&"}], ")"}], "/@",
                "findingsRows"}], ",", RowBox[{"{", RowBox[{"\"part\"", ",",
                  "\"quantity\"", ",", "\"value\""}], "}"}]}], "]"}], ",",
          RowBox[{"Frame", "\[Rule]", "All"}], ",",
          RowBox[{"Alignment", "\[Rule]", "Left"}]}], "]"}]}]], "Input"],
  Cell["The facts quoted in the text cells are checked against the committed \
files, so that the prose cannot drift from the outputs: the free-spectrum \
window and shells, the closed-shell limit 1300, and the parameter set of the \
self-consistent comparison.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"textParameterChecks", "=",
        RowBox[{"Association", "[", RowBox[
           {RowBox[{"\"freeSpectraWindowFourMAndShellsUpTo16\"", "\[Rule]",
              RowBox[{"AllTrue", "[", RowBox[{"freeConfigurations", ",",
                  RowBox[{RowBox[{"Module", "[", RowBox[{RowBox[{"{",
                          RowBox[{"t", "=", RowBox[{"freeTables", "[", "#1",
                          "]"}]}], "}"}], ",", RowBox[{RowBox[{RowBox[{"Max",
                          "[", RowBox[{"Abs", "[", RowBox[{"columnOf", "[",
                          RowBox[{"t", ",", "\"eps\""}], "]"}], "]"}], "]"}],
                          "<", RowBox[{"4", " ", RowBox[{"#1",
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}]}]}], "&&", RowBox[
                          {RowBox[{"Sort", "[", RowBox[{"DeleteDuplicates",
                          "[", RowBox[{"Round", "[", RowBox[{"columnOf", "[",
                          RowBox[{"t", ",", "\"n2\""}], "]"}], "]"}], "]"}],
                          "]"}], "===", RowBox[{"representableShells", "[",
                          "16", "]"}]}], "&&", RowBox[{"AllTrue", "[",
                          RowBox[{RowBox[{"columnOf", "[", RowBox[{"t", ",",
                          "\"weight\""}], "]"}], ",", RowBox[{RowBox[{"#1",
                          "\[Equal]", "0"}], "&"}]}], "]"}]}]}], "]"}],
                    "&"}]}], "]"}]}], ",", RowBox[
             {"\"closedShellTablesStopAbove1300\"", "\[Rule]",
              RowBox[{"AllTrue", "[", RowBox[{RowBox[{"{", RowBox[{"1", ",",
                      "3"}], "}"}], ",", RowBox[{RowBox[{"Module", "[",
                      RowBox[{RowBox[{"{", RowBox[{"tab", "=", RowBox[
                          {"rustClosedShells", "[", "#1", "]"}]}], "}"}],
                        ",", RowBox[{RowBox[{RowBox[{"tab",
                          "\[LeftDoubleBracket]", RowBox[{RowBox[{"-", "1"}],
                          ",", "1"}], "\[RightDoubleBracket]"}], ">",
                          "1300"}], "&&", RowBox[{RowBox[{"tab",
                          "\[LeftDoubleBracket]", RowBox[{RowBox[{"-", "2"}],
                          ",", "1"}], "\[RightDoubleBracket]"}],
                          "\[LessEqual]", "1300"}]}]}], "]"}], "&"}]}],
                "]"}]}], ",", RowBox[{"\"scfParameterSetAsStated\"",
              "\[Rule]", RowBox[{RowBox[{"scfSetupChecks", "[",
                  "\"runParametersAsStated\"", "]"}], "&&", RowBox[
                 {"scfSetupChecks", "[", "\"runIsLambdaHat2OfN8\"", "]"}],
                "&&", RowBox[{RowBox[{RowBox[{"scfRun", "[",
                      "\"parameters\"", "]"}], "[", "\"mixBeta\"", "]"}],
                  "\[Equal]", "0.4`"}], "&&", RowBox[{RowBox[
                   {RowBox[{"scfRun", "[", "\"parameters\"", "]"}], "[",
                    "\"mixHistory\"", "]"}], "\[Equal]", "6"}], "&&",
                RowBox[{RowBox[{RowBox[{"scfRun", "[", "\"parameters\"",
                      "]"}], "[", "\"tol\"", "]"}], "\[Equal]", FractionBox[
                   "1", SuperscriptBox["10", "10"]]}]}]}]}], "]"}]}], ";",
      "textParameterChecks"}]], "Input"], Cell["All checks are collected in \
notebookChecks; the report \
artifacts/dirac16complex/kohn-sham/mathematica-report.json records every \
check, the measurements printed by the verifier, the full comparison records \
and the SHA-256 of every input file read (numbers only, no timings and no \
absolute paths, so a repeated run on the same machine gives the same file; \
engine.binary is the platform-specific binary name).", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"notebookChecks", "=",
        RowBox[{"Join", "[", RowBox[{RowBox[{"Association", "[",
              RowBox[{"\"theory_packageChecksAllPass\"", "\[Rule]",
                RowBox[{RowBox[{RowBox[{"theoryCheckSummary", "[",
                      "\"checkCount\"", "]"}], ">", "0"}], "&&",
                  RowBox[{RowBox[{"theoryCheckSummary", "[", "\"failed\"",
                      "]"}], "===", RowBox[{"{", "}"}]}]}]}], "]"}], ",",
            RowBox[{"KeyMap", "[", RowBox[{RowBox[{RowBox[{"\"geometry_\"",
                    "<>", "#1"}], "&"}], ",", "geometryChecks"}], "]"}], ",",
            RowBox[{"KeyMap", "[", RowBox[{RowBox[{RowBox[{"\"reduction_\"",
                    "<>", "#1"}], "&"}], ",", "reductionChecks"}], "]"}],
            ",", RowBox[{"KeyMap", "[", RowBox[{RowBox[{RowBox[
                   {"\"blocks_\"", "<>", "#1"}], "&"}], ",", "blockChecks"}],
              "]"}], ",", RowBox[{"KeyMap", "[", RowBox[{RowBox[
                 {RowBox[{"\"realForm_\"", "<>", "#1"}], "&"}], ",",
                "realFormChecks"}], "]"}], ",", RowBox[{"KeyMap", "[",
              RowBox[{RowBox[{RowBox[{"\"pruefer_\"", "<>", "#1"}], "&"}],
                ",", "pruferChecks"}], "]"}], ",", RowBox[{"KeyMap", "[",
              RowBox[{RowBox[{RowBox[{"\"box_\"", "<>", "#1"}], "&"}], ",",
                "boxChecks"}], "]"}], ",", RowBox[{"KeyMap", "[",
              RowBox[{RowBox[{RowBox[{"\"splitting_\"", "<>", "#1"}], "&"}],
                ",", "splittingChecks"}], "]"}], ",",
            RowBox[{"KeyMap", "[", RowBox[{RowBox[{RowBox[{"\"shooting_\"",
                    "<>", "#1"}], "&"}], ",", "shootingChecks"}], "]"}], ",",
            RowBox[{"KeyMap", "[", RowBox[{RowBox[{RowBox[{"\"scf_\"", "<>",
                    "#1"}], "&"}], ",", "scfChecks"}], "]"}], ",",
            RowBox[{"KeyMap", "[", RowBox[{RowBox[{RowBox[{"\"engine_\"",
                    "<>", "#1"}], "&"}], ",", "engineChecks"}], "]"}], ",",
            RowBox[{"KeyMap", "[", RowBox[{RowBox[{RowBox[{"\"text_\"", "<>",
                    "#1"}], "&"}], ",", "textParameterChecks"}], "]"}], ",",
            RowBox[{"Association", "[", RowBox[{"\"figuresExported\"",
                "\[Rule]", RowBox[{RowBox[{RowBox[{"Length", "[",
                      "figureFiles", "]"}], "\[Equal]", "6"}], "&&",
                  RowBox[{"AllTrue", "[", RowBox[{"figureFiles", ",",
                      RowBox[{RowBox[{"FileExistsQ", "[", RowBox[
                          {"FileNameJoin", "[", RowBox[{"{", RowBox[
                          {"figureDirectory", ",", "#1"}], "}"}], "]"}],
                          "]"}], "&"}]}], "]"}]}]}], "]"}]}], "]"}]}], ";",
      RowBox[{"notebookChecks", "=", RowBox[{"TrueQ", "/@",
          "notebookChecks"}]}], ";",
      RowBox[{RowBox[{"jsonReady", "[", "a_Association", "]"}], ":=",
        RowBox[{"jsonReady", "/@", "a"}]}], ";",
      RowBox[{RowBox[{"jsonReady", "[", "l_List", "]"}], ":=",
        RowBox[{"jsonReady", "/@", "l"}]}], ";",
      RowBox[{RowBox[{"jsonReady", "[", "x_Real", "]"}], ":=",
        RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{"y", "=",
                RowBox[{"N", "[", "x", "]"}]}], "}"}], ",",
            RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Abs", "[", "y",
                    "]"}], "<", FractionBox["1", SuperscriptBox["10",
                    "300"]]}], ",", "0.`", ",", "y"}], "]"}]}], "]"}]}], ";",
      RowBox[{RowBox[{"jsonReady", "[", "x_Rational", "]"}], ":=",
        RowBox[{"N", "[", "x", "]"}]}], ";",
      RowBox[{RowBox[{"jsonReady", "[", "x_Integer", "]"}], ":=", "x"}], ";",
      RowBox[{RowBox[{"jsonReady", "[", "x_String", "]"}], ":=", "x"}], ";",
      RowBox[{RowBox[{"jsonReady", "[", "True", "]"}], ":=", "True"}], ";",
      RowBox[{RowBox[{"jsonReady", "[", "False", "]"}], ":=", "False"}], ";",
      RowBox[{RowBox[{"jsonReady", "[", "Null", "]"}], ":=", "Null"}], ";",
      RowBox[{RowBox[{"jsonReady", "[", "_Missing", "]"}], ":=", "Null"}],
      ";", RowBox[{RowBox[{"jsonReady", "[", "_DirectedInfinity", "]"}],
        ":=", "Null"}], ";", RowBox[{RowBox[{"jsonReady", "[", "x_", "]"}],
        ":=", RowBox[{"ToString", "[", RowBox[{"x", ",", "InputForm"}],
          "]"}]}], ";", RowBox[{"reportMeasurements", "=",
        RowBox[{"Association", "[", RowBox[
           {RowBox[{"\"theoryPackageCheckCount\"", "\[Rule]",
              RowBox[{"theoryCheckSummary", "[", "\"checkCount\"", "]"}]}],
            ",", RowBox[{"\"zeroModeSplittingC_m1_H1_L3\"", "\[Rule]",
              RowBox[{"N", "[", "cSplittingM1L3", "]"}]}], ",",
            RowBox[{"\"zeroModeSlopeMaxDeviation\"", "\[Rule]",
              "zeroModeSlopeDeviation"}], ",", RowBox[
             {"\"boxExactLevelCount\"", "\[Rule]", RowBox[{"Total", "[",
                RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1", "[", "\"levels\"",
                        "]"}], "&"}], ")"}], "/@", RowBox[{"Values", "[",
                    "boxComparison", "]"}]}], "]"}]}], ",",
            RowBox[{"\"boxExactVsRustMaxAbsDeviation\"", "\[Rule]",
              RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                     {RowBox[{"#1", "[", "\"maxAbsDeviation\"", "]"}], "&"}],
                    ")"}], "/@", RowBox[{"Values", "[", "boxComparison",
                    "]"}]}], "]"}]}], ",", RowBox[
             {"\"boxNDSolveVsExactMaxAbsDeviation\"", "\[Rule]",
              RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                     {RowBox[{"#1", "[", "\"k0VsExactBoxMaxAbsDeviation\"",
                        "]"}], "&"}], ")"}], "/@", RowBox[{"Values", "[",
                    "freeSpectrumResults", "]"}]}], "]"}]}], ",",
            RowBox[{"\"freeSpectraLevelCount\"", "\[Rule]", RowBox[{"Total",
                "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1", "[",
                        "\"levels\"", "]"}], "&"}], ")"}], "/@",
                  RowBox[{"Values", "[", "freeSpectrumResults", "]"}]}],
                "]"}]}], ",", RowBox[{"\"freeSpectraMaxAbsDeviation\"",
              "\[Rule]", RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                     {RowBox[{"#1", "[", "\"maxAbsDeviation\"", "]"}], "&"}],
                    ")"}], "/@", RowBox[{"Values", "[",
                    "freeSpectrumResults", "]"}]}], "]"}]}], ",",
            RowBox[{"\"freeSpectraMaxScalarChargeDeviation\"", "\[Rule]",
              RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                     {RowBox[{"#1", "[", "\"maxScalarChargeDeviation\"",
                        "]"}], "&"}], ")"}], "/@", RowBox[{"Values", "[",
                    "freeSpectrumResults", "]"}]}], "]"}]}], ",",
            RowBox[{"\"freeSpectraMaxPressureChargeDeviation\"", "\[Rule]",
              RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                     {RowBox[{"#1", "[", "\"maxPressureChargeDeviation\"",
                        "]"}], "&"}], ")"}], "/@", RowBox[{"Values", "[",
                    "freeSpectrumResults", "]"}]}], "]"}]}], ",",
            RowBox[{"\"freeSpectraMaxMatchingResidual\"", "\[Rule]",
              RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                     {RowBox[{"#1", "[", "\"maxMatchingResidual\"", "]"}],
                      "&"}], ")"}], "/@", RowBox[{"Values", "[",
                    "freeSpectrumResults", "]"}]}], "]"}]}], ",",
            RowBox[{"\"closedShellEntries_m1_L3\"", "\[Rule]",
              RowBox[{RowBox[{"closedShellComparison", "[", "1", "]"}], "[",
                "\"entries\"", "]"}]}], ",", RowBox[
             {"\"closedShellEntries_m3_L3\"", "\[Rule]", RowBox[{
                RowBox[{"closedShellComparison", "[", "3", "]"}], "[",
                "\"entries\"", "]"}]}], ",", RowBox[
             {"\"closedShellsMaxAbsDeviation\"", "\[Rule]", RowBox[{"Max",
                "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1", "[",
                        "\"maxAbsDeviation\"", "]"}], "&"}], ")"}], "/@",
                  RowBox[{"Values", "[", "closedShellComparison", "]"}]}],
                "]"}]}], ",", RowBox[{"\"scfLambdaHat\"", "\[Rule]",
              "scfLambdaHat"}], ",", RowBox[{"\"scfIterations\"", "\[Rule]",
              RowBox[{"scfComparison", "[", "\"iterations\"", "]"}]}], ",",
            RowBox[{"\"scfFinalResidual\"", "\[Rule]", RowBox[{"Max", "[",
                RowBox[{RowBox[{"scfComparison", "[", "\"finalResidualN\"",
                    "]"}], ",", RowBox[{"scfComparison", "[",
                    "\"finalResidualS\"", "]"}]}], "]"}]}], ",",
            RowBox[{"\"scfEpsHomo\"", "\[Rule]", RowBox[{"scfComparison",
