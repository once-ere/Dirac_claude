                      "x"}]}], "]"}], "]"}], ",", RowBox[{"{",
                RowBox[{RowBox[{"\"[\"", "\[Rule]", "\"{\""}], ",",
                  RowBox[{"\"]\"", "\[Rule]", "\"}\""}]}], "}"}]}], "]"}],
          "]"}]}], ";", RowBox[{"rustBasisRe", "=",
        RowBox[{"ArrayReshape", "[", RowBox[
           {RowBox[{"Round", "[", RowBox[{"rustConstantKS", "[",
                "\"BLOCK_BASIS_RE\"", "]"}], "]"}], ",",
            RowBox[{"{", RowBox[{"8", ",", "2", ",", "16"}], "}"}]}],
          "]"}]}], ";", RowBox[{"rustBasisIm", "=",
        RowBox[{"ArrayReshape", "[", RowBox[
           {RowBox[{"Round", "[", RowBox[{"rustConstantKS", "[",
                "\"BLOCK_BASIS_IM\"", "]"}], "]"}], ",",
            RowBox[{"{", RowBox[{"8", ",", "2", ",", "16"}], "}"}]}],
          "]"}]}], ";", RowBox[{"rustBasis", "=", FractionBox[
         TemplateBox[{RowBox[{"Flatten", "[", RowBox[{RowBox[{"rustBasisRe",
                 "+", RowBox[{"\[ImaginaryI]", " ", "rustBasisIm"}]}], ",",
               "1"}], "]"}]}, "Transpose", SyntaxForm -> SuperscriptBox],
         SqrtBox["32"]]}], ";", RowBox[{"rustJ", "=",
        RowBox[{"Simplify", "[", RowBox[{TemplateBox[{"rustBasis"},
             "ConjugateTranspose", SyntaxForm -> SuperscriptBox], ".",
            "jOperator", ".", "rustBasis"}], "]"}]}], ";",
      RowBox[{"rustC1", "=", RowBox[{"Simplify", "[",
          RowBox[{TemplateBox[{"rustBasis"}, "ConjugateTranspose",
             SyntaxForm -> SuperscriptBox], ".", RowBox[
             {"(", RowBox[{"\[ImaginaryI]", " ", RowBox[{RowBox[{"gam", "[",
                    "2", "]"}], ".", RowBox[{"gam", "[", "3", "]"}]}]}],
              ")"}], ".", "rustBasis"}], "]"}]}], ";",
      RowBox[{"rustOdeBlocks", "=", RowBox[{"Simplify", "[",
          RowBox[{TemplateBox[{"rustBasis"}, "ConjugateTranspose",
             SyntaxForm -> SuperscriptBox], ".", "odeMatrix16", ".",
            "rustBasis"}], "]"}]}], ";", RowBox[{"fixturePath", "=",
        RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"repositoryRoot",
              ",", "\"artifacts\"", ",", "\"dirac16complex\"", ",",
              "\"arbitrary-field\"", ",", "\"algebra-fixture.json\""}],
            "}"}], "]"}]}], ";", RowBox[{"fixtureHash", "=",
        RowBox[{"ToLowerCase", "[", RowBox[{"FileHash", "[",
            RowBox[{"fixturePath", ",", "\"SHA256\"", ",", "All", ",",
              "\"HexString\""}], "]"}], "]"}]}], ";",
      RowBox[{"registerSource", "[", "fixturePath", "]"}], ";",
      RowBox[{"realFormChecks", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"realFormIsBlockODEWithSMinusJ\"", "\[Rule]",
              RowBox[{RowBox[{"AllTrue", "[", RowBox[{RowBox[{"{", RowBox[
