                        RowBox[{RowBox[{"#1", "\[LeftDoubleBracket]", RowBox[
                          {"All", ",", "\"eps\""}],
                          "\[RightDoubleBracket]"}], "&"}]}], "]"}],
                    "]"}]}]}], ";", RowBox[{"Association", "[",
                RowBox[{RowBox[{"\"table\"", "\[Rule]", "table"}], ",",
                  RowBox[{"\"shellsUsed\"", "\[Rule]", "used"}], ",",
                  RowBox[{"\"statesInWindow\"", "\[Rule]", RowBox[{"Length",
