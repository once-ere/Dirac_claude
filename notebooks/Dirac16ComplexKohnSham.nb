                          "&"}], ")"}], "/@", RowBox[{"rustBlockLabels",
                        "\[LeftDoubleBracket]", RowBox[{"All", ",", "2"}],
                        "\[RightDoubleBracket]"}]}], "]"}], "]"}]}]}]}],
          "]"}]}], ";", RowBox[
       {"{", RowBox[{RowBox[{"realFormFromBlock", "[", RowBox[{"-", "1"}],
            "]"}], ",", "rustBlockLabels", ",", "realFormChecks"}], "}"}]}]],
   "Input"], Cell["Pruefer angle, boundary conditions and the y-current",
   "Subsection"], Cell["Writing a = r cos(theta), b = -r sin(theta) turns the \
real system into theta' = s (eps - v_v) + kappa k cos(2 theta) - M_eff sin(2 \
theta) (derived below by solving for theta' and r'). Boundary conditions \
(STAGE4_SPEC E4.5 in block form): tip bag chi_2(-L) = 0, i.e. b(-L) = 0, i.e. \
theta(-L) = 0; brane parity + chi_2(0) = 0, i.e. b(0) = 0, i.e. theta(0) = n \
pi; brane parity - chi_1(0) = 0, i.e. a(0) = 0, i.e. theta(0) = pi/2 + n pi. \
The variational equation of theta with respect to eps has the solution d \
theta(0)/d eps = s Integral exp(...) dy, so Theta(eps) := theta(0; eps) is \
strictly monotone (increasing for s = +1, decreasing for s = -1): every level \
in an energy window corresponds to exactly one integer n between Theta at the \
window edges (oscillation count), and n is the Pruefer index of the Rust \
output. The y-current chi^dagger (j sigma1) chi = 2 j Re(chi_1^* chi_2) \
vanishes when chi_1 = 0 or chi_2 = 0, i.e. at the brane for either parity and \
at the tip for the bag; a real standing wave chi = (a, i b) carries no \
current anywhere.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"pruferSystem", "=",
        RowBox[{"{", RowBox[{RowBox[{RowBox[{SuperscriptBox["aP", "\[Prime]",
                 MultilineFunction -> None], "[", "yy", "]"}], "-",
              RowBox[{"(", RowBox[{RowBox[{RowBox[{"meff", "[", "yy", "]"}],
                    " ", RowBox[{"aP", "[", "yy", "]"}]}], "+", RowBox[
                   {RowBox[{"(", RowBox[{RowBox[{"s", " ", RowBox[{"(",
                          RowBox[{"eps", "-", RowBox[{"vv", "[", "yy",
                          "]"}]}], ")"}]}], "-", RowBox[{"kappaKS", " ",
                          "kk"}]}], ")"}], " ", RowBox[{"bP", "[", "yy",
                      "]"}]}]}], ")"}]}], ",", RowBox[
             {RowBox[{SuperscriptBox["bP", "\[Prime]", MultilineFunction ->
                  None], "[", "yy", "]"}], "-", RowBox[{"(", RowBox[
                 {RowBox[{RowBox[{"-", RowBox[{"(", RowBox[{RowBox[{"s", " ",
                          RowBox[{"(", RowBox[{"eps", "-", RowBox[{"vv", "[",
                          "yy", "]"}]}], ")"}]}], "+", RowBox[{"kappaKS",
                          " ", "kk"}]}], ")"}]}], " ", RowBox[{"aP", "[",
                      "yy", "]"}]}], "-", RowBox[{RowBox[{"meff", "[", "yy",
                      "]"}], " ", RowBox[{"bP", "[", "yy", "]"}]}]}],
                ")"}]}]}], "}"}]}], ";", RowBox[{"polarRules", "=",
        RowBox[{"{", RowBox[{RowBox[{"aP", "\[Rule]", RowBox[{"Function",
                "[", RowBox[{"t", ",", RowBox[{RowBox[{"rP", "[", "t", "]"}],
                    " ", RowBox[{"Cos", "[", RowBox[{"thP", "[", "t", "]"}],
                      "]"}]}]}], "]"}]}], ",", RowBox[{"bP", "\[Rule]",
              RowBox[{"Function", "[", RowBox[{"t", ",", RowBox[
                   {RowBox[{"-", RowBox[{"rP", "[", "t", "]"}]}], " ",
                    RowBox[{"Sin", "[", RowBox[{"thP", "[", "t", "]"}],
                      "]"}]}]}], "]"}]}]}], "}"}]}], ";",
      RowBox[{"pruferSolved", "=", RowBox[{"First", "[",
          RowBox[{"Solve", "[", RowBox[{RowBox[{"Thread", "[",
                RowBox[{RowBox[{"(", RowBox[{"pruferSystem", "/.",
                      "\[VeryThinSpace]", "polarRules"}], ")"}], "\[Equal]",
                  "0"}], "]"}], ",", RowBox[{"{", RowBox[
                 {RowBox[{SuperscriptBox["thP", "\[Prime]",
                     MultilineFunction -> None], "[", "yy", "]"}], ",",
                  RowBox[{SuperscriptBox["rP", "\[Prime]",
                     MultilineFunction -> None], "[", "yy", "]"}]}], "}"}]}],
            "]"}], "]"}]}], ";", RowBox[{"thetaRHS", "=",
        RowBox[{"Simplify", "[", RowBox[{RowBox[{SuperscriptBox["thP",
               "\[Prime]", MultilineFunction -> None], "[", "yy", "]"}],
            "/.", "\[VeryThinSpace]", "pruferSolved"}], "]"}]}], ";",
      RowBox[{"variationalCoefficient", "=",
        RowBox[{SubscriptBox["\[PartialD]", RowBox[
            {RowBox[{"thP", "[", "yy", "]"}]}]], "thetaRHS"}]}], ";",
      RowBox[{RowBox[{"dThetaCandidate", "[", "t_", "]"}], ":=",
        RowBox[{"s", " ", RowBox[{"Exp", "[", RowBox[{"gG", "[", "t", "]"}],
            "]"}], " ", RowBox[{SubsuperscriptBox["\[Integral]",
             RowBox[{"-", "lL"}], "t"], RowBox[{RowBox[{"Exp", "[",
                RowBox[{"-", RowBox[{"gG", "[", "u", "]"}]}], "]"}],
              RowBox[{"\[DifferentialD]", "u"}]}]}]}]}], ";",
      RowBox[{RowBox[{"currentOf", "[", "chi_", "]"}], ":=",
        RowBox[{RowBox[{"Conjugate", "[", "chi", "]"}], ".",
          RowBox[{"(", RowBox[{"jj", " ", "sigma1"}], ")"}], ".", "chi"}]}],
      ";", RowBox[{"complexChi", "=",
        RowBox[{"{", RowBox[{RowBox[{"c1", "+", RowBox[{"\[ImaginaryI]", " ",
                "d1"}]}], ",", RowBox[{"c2", "+", RowBox[{"\[ImaginaryI]",
                " ", "d2"}]}]}], "}"}]}], ";",
      RowBox[{"pruferChecks", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"pruferEquation\"", "\[Rule]",
              RowBox[{RowBox[{"Simplify", "[", RowBox[{"TrigReduce", "[",
                    RowBox[{"thetaRHS", "-", RowBox[{"(", RowBox[{RowBox[
                          {"s", " ", RowBox[{"(", RowBox[{"eps", "-", RowBox[
                          {"vv", "[", "yy", "]"}]}], ")"}]}], "+", RowBox[
                          {"kappaKS", " ", "kk", " ", RowBox[{"Cos", "[",
                          RowBox[{"2", " ", RowBox[{"thP", "[", "yy",
                          "]"}]}], "]"}]}], "-", RowBox[{RowBox[{"meff", "[",
                          "yy", "]"}], " ", RowBox[{"Sin", "[", RowBox[{"2",
                          " ", RowBox[{"thP", "[", "yy", "]"}]}], "]"}]}]}],
                        ")"}]}], "]"}], "]"}], "===", "0"}]}], ",",
            RowBox[{"\"variationalCoefficient\"", "\[Rule]",
              RowBox[{RowBox[{"Simplify", "[", RowBox[{"TrigReduce", "[",
                    RowBox[{"variationalCoefficient", "-", RowBox[{"(",
                        RowBox[{RowBox[{RowBox[{"-", "2"}], " ", "kappaKS",
                          " ", "kk", " ", RowBox[{"Sin", "[", RowBox[{"2",
                          " ", RowBox[{"thP", "[", "yy", "]"}]}], "]"}]}],
                          "-", RowBox[{"2", " ", RowBox[{"meff", "[", "yy",
                          "]"}], " ", RowBox[{"Cos", "[", RowBox[{"2", " ",
                          RowBox[{"thP", "[", "yy", "]"}]}], "]"}]}]}],
                        ")"}]}], "]"}], "]"}], "===", "0"}]}], ",",
            RowBox[{"\"pruferMonotoneInEps\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"Simplify", "[", RowBox[
                     {RowBox[{SubscriptBox["\[PartialD]", RowBox[{"yy"}]],
                        RowBox[{"dThetaCandidate", "[", "yy", "]"}]}], "-",
                      RowBox[{"(", RowBox[{"s", "+", RowBox[{RowBox[
                          {SuperscriptBox["gG", "\[Prime]",
                          MultilineFunction -> None], "[", "yy", "]"}], " ",
                          RowBox[{"dThetaCandidate", "[", "yy", "]"}]}]}],
                        ")"}]}], "]"}], "===", "0"}], "&&", RowBox[
                 {RowBox[{"dThetaCandidate", "[", RowBox[{"-", "lL"}], "]"}],
                  "===", "0"}]}]}], ",", RowBox[{"\"bagIsThetaZero\"",
              "\[Rule]", RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[
                       {"-", RowBox[{"rP", "[", "yy", "]"}]}], " ",
                      RowBox[{"Sin", "[", RowBox[{"thP", "[", "yy", "]"}],
                        "]"}]}], "/.", "\[VeryThinSpace]", RowBox[
                     {RowBox[{"thP", "[", "yy", "]"}], "\[Rule]", "0"}]}],
                  ")"}], "===", "0"}]}], ",", RowBox[
             {"\"parityPlusTargetsNPi\"", "\[Rule]", RowBox[{RowBox[
                 {"Sort", "[", RowBox[{"t", "/.", "\[VeryThinSpace]",
                    RowBox[{"Solve", "[", RowBox[{RowBox[{RowBox[{RowBox[
                          {"Sin", "[", "t", "]"}], "\[Equal]", "0"}], "&&",
                          RowBox[{RowBox[{"-", "10"}], "<", "t", "<",
                          "10"}]}], ",", "t"}], "]"}]}], "]"}], "===",
                RowBox[{"Sort", "[", RowBox[{"\[Pi]", " ", RowBox[{"Range",
                      "[", RowBox[{RowBox[{"-", "3"}], ",", "3"}], "]"}]}],
                  "]"}]}]}], ",", RowBox[
             {"\"parityMinusTargetsHalfPiPlusNPi\"", "\[Rule]",
              RowBox[{RowBox[{"Sort", "[", RowBox[{"t", "/.",
                    "\[VeryThinSpace]", RowBox[{"Solve", "[", RowBox[
                       {RowBox[{RowBox[{RowBox[{"Cos", "[", "t", "]"}],
                          "\[Equal]", "0"}], "&&", RowBox[{RowBox[{"-",
                          "10"}], "<", "t", "<", "10"}]}], ",", "t"}],
                      "]"}]}], "]"}], "===", RowBox[{"Sort", "[",
                  RowBox[{FractionBox["\[Pi]", "2"], "+", RowBox[{"\[Pi]",
                      " ", RowBox[{"Range", "[", RowBox[{RowBox[{"-", "3"}],
                          ",", "2"}], "]"}]}]}], "]"}]}]}], ",",
            RowBox[{"\"currentVanishesForEitherComponentZero\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"Simplify", "[", RowBox[
                     {RowBox[{"ComplexExpand", "[", RowBox[{"currentOf", "[",
                          "complexChi", "]"}], "]"}], "-", RowBox[{"2", " ",
                        "jj", " ", RowBox[{"(", RowBox[{RowBox[{"c1", " ",
                          "c2"}], "+", RowBox[{"d1", " ", "d2"}]}],
                          ")"}]}]}], "]"}], "===", "0"}], "&&",
                RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[
                       {"ComplexExpand", "[", RowBox[{"currentOf", "[",
                          "complexChi", "]"}], "]"}], "/.",
                      "\[VeryThinSpace]", RowBox[{"{", RowBox[{RowBox[{"c2",
                          "\[Rule]", "0"}], ",", RowBox[{"d2", "\[Rule]",
                          "0"}]}], "}"}]}], "]"}], "===", "0"}], "&&",
                RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[
                       {"ComplexExpand", "[", RowBox[{"currentOf", "[",
                          "complexChi", "]"}], "]"}], "/.",
                      "\[VeryThinSpace]", RowBox[{"{", RowBox[{RowBox[{"c1",
                          "\[Rule]", "0"}], ",", RowBox[{"d1", "\[Rule]",
                          "0"}]}], "}"}]}], "]"}], "===", "0"}]}]}], ",",
            RowBox[{"\"standingWaveCarriesNoCurrent\"", "\[Rule]",
              RowBox[{RowBox[{"Simplify", "[", RowBox[{"ComplexExpand", "[",
                    RowBox[{"currentOf", "[", "realPair", "]"}], "]"}],
                  "]"}], "===", "0"}]}]}], "]"}]}], ";",
      RowBox[{"{", RowBox[{"thetaRHS", ",", "pruferChecks"}], "}"}]}]],
   "Input"], Cell["The k = 0, lambda = 0 box problem: exact solution",
   "Section"], Cell["At k = 0 and lambda = 0 (M_eff = M constant, v_v = 0) \
the real system of block type s is a' = M a + s eps b, b' = -s eps a - M b on \
[-L, 0]. Eliminating b gives a'' = -(eps^2 - M^2) a, so with p = sqrt(eps^2 - \
M^2) and the tip bag b(-L) = 0 (equivalently a'(-L) = M a(-L)) the solution \
is a = cos(p(y+L)) + (M/p) sin(p(y+L)), b = -(s eps/p) sin(p(y+L)). Brane \
parity +: b(0) = 0, i.e. sin(pL) = 0, p = n pi/L, eps = +-sqrt(M^2 + (n \
pi/L)^2), n = 1, 2, ...; brane parity -: a(0) = 0, i.e. p cos(pL) + M sin(pL) \
= 0, i.e. tan(pL) = -p/M, one root p_j in ((j - 1/2) pi/L, j pi/L) for j = 1, \
2, .... Below threshold (|eps| < M, p = i q) the brane values are a(0) = \
cosh(qL) + (M/q) sinh(qL) > 0 (no parity - level) and b(0) = -(s eps/q) \
sinh(qL), which vanishes only at eps = 0: there q = M and the solution is the \
brane zero mode a = e^{M(y+L)}, b = 0 (parity +, normalisable even for L -> \
infinity, localised at the brane). At the threshold eps = +-M neither \
condition holds. Level labels (the Pruefer index n of the Rust output, Theta \
= n pi or pi/2 + n pi): parity +, s = +1: eps = sign(n) sqrt(M^2 + (n \
pi/L)^2), n = 0 the zero mode; parity -, s = +1: n >= 0 gives +sqrt(M^2 + \
p_(n+1)^2), n < 0 gives -sqrt(M^2 + p_(-n)^2); the s = -1 levels are \
eps_(-1)(n) = -eps_(+1)(n) (the s = -1 system is the s = +1 system at -eps)."\
, "Text"], Cell[BoxData[RowBox[{RowBox[{RowBox[{"boxA", "[", "y_", "]"}],
        ":=", RowBox[{RowBox[{"Cos", "[", RowBox[{"pB", " ", RowBox[{"(",
                RowBox[{"y", "+", "lB"}], ")"}]}], "]"}], "+",
          FractionBox[RowBox[{"mB", " ", RowBox[{"Sin", "[", RowBox[
                {"pB", " ", RowBox[{"(", RowBox[{"y", "+", "lB"}], ")"}]}],
               "]"}]}], "pB"]}]}], ";",
      RowBox[{RowBox[{"boxB", "[", "y_", "]"}], ":=",
        RowBox[{"-", FractionBox[RowBox[{RowBox[{"(", RowBox[{"sB", " ",
                 "eB"}], ")"}], " ", RowBox[{"Sin", "[", RowBox[{"pB", " ",
                 RowBox[{"(", RowBox[{"y", "+", "lB"}], ")"}]}], "]"}]}],
           "pB"]}]}], ";", RowBox[
       {RowBox[{"boxODE", "[", RowBox[{"a_", ",", "b_", ",", "e_"}], "]"}],
        ":=", RowBox[{"{", RowBox[{RowBox[{RowBox[{SubscriptBox[
                 "\[PartialD]", RowBox[{"yy"}]], "a"}], "-", RowBox[{"(",
                RowBox[{RowBox[{"mB", " ", "a"}], "+", RowBox[{"sB", " ",
                    "e", " ", "b"}]}], ")"}]}], ",",
            RowBox[{RowBox[{SubscriptBox["\[PartialD]", RowBox[{"yy"}]],
                "b"}], "-", RowBox[{"(", RowBox[{RowBox[{RowBox[{"-", "sB"}],
                    " ", "e", " ", "a"}], "-", RowBox[{"mB", " ", "b"}]}],
                ")"}]}]}], "}"}]}], ";", RowBox[{"boxAssume", "=",
        RowBox[{RowBox[{"mB", ">", "0"}], "&&", RowBox[{"pB", ">", "0"}],
          "&&", RowBox[{"lB", ">", "0"}], "&&", RowBox[{"qB", ">", "0"}],
          "&&", RowBox[{"yy", "\[Element]", TemplateBox[{}, "Reals"]}]}]}],
      ";", RowBox[{"boxChecks", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"boxSolutionSolvesODE\"", "\[Rule]",
              RowBox[{"AllTrue", "[", RowBox[{RowBox[{"Tuples", "[",
                    RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"1", ",",
                          RowBox[{"-", "1"}]}], "}"}], ",", RowBox[{"{",
                          RowBox[{"1", ",", RowBox[{"-", "1"}]}], "}"}]}],
                      "}"}], "]"}], ",", RowBox[{RowBox[{RowBox[{"Simplify",
                        "[", RowBox[{RowBox[{RowBox[{"boxODE", "[", RowBox[
                          {RowBox[{"boxA", "[", "yy", "]"}], ",", RowBox[
                          {"boxB", "[", "yy", "]"}], ",", "eB"}], "]"}],
                          "/.", "\[VeryThinSpace]", RowBox[{"{", RowBox[
                          {RowBox[{"sB", "\[Rule]", RowBox[{"#1",
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}]}], ",", RowBox[{"eB",
                          "\[Rule]", RowBox[{RowBox[{"#1",
                          "\[LeftDoubleBracket]", "2",
                          "\[RightDoubleBracket]"}], " ", SqrtBox[RowBox[
                          {SuperscriptBox["mB", "2"], "+", SuperscriptBox[
                          "pB", "2"]}]]}]}]}], "}"}]}], ",", "boxAssume"}],
                        "]"}], "===", RowBox[{"{", RowBox[{"0", ",", "0"}],
                        "}"}]}], "&"}]}], "]"}]}], ",",
            RowBox[{"\"boxSolutionSatisfiesTipBag\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"Simplify", "[", RowBox[{"boxB", "[",
                      RowBox[{"-", "lB"}], "]"}], "]"}], "===", "0"}], "&&",
                RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"(",
                        RowBox[{RowBox[{SubscriptBox["\[PartialD]", RowBox[
                          {"yy"}]], RowBox[{"boxA", "[", "yy", "]"}]}], "/.",
                          "\[VeryThinSpace]", RowBox[{"yy", "\[Rule]",
                          RowBox[{"-", "lB"}]}]}], ")"}], "-", RowBox[
                       {"mB", " ", RowBox[{"boxA", "[", RowBox[{"-", "lB"}],
                          "]"}]}]}], "]"}], "===", "0"}]}]}], ",",
            RowBox[{"\"parityPlusIsSinPL\"", "\[Rule]", RowBox[{
                RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"boxB", "[",
                        "0", "]"}], "+", FractionBox[RowBox[{RowBox[{"(",
                          RowBox[{"sB", " ", "eB"}], ")"}], " ", RowBox[
                          {"Sin", "[", RowBox[{"pB", " ", "lB"}], "]"}]}],
                       "pB"]}], "]"}], "===", "0"}], "&&", RowBox[
                 {RowBox[{"Simplify", "[", RowBox[{RowBox[{RowBox[{"boxB",
                          "[", "0", "]"}], "/.", "\[VeryThinSpace]",
                        RowBox[{"pB", "\[Rule]", FractionBox[RowBox[{"nB",
                          " ", "\[Pi]"}], "lB"]}]}], ",", RowBox[
                       {RowBox[{"nB", "\[Element]", TemplateBox[{},
                          "Integers"]}], "&&", RowBox[{"lB", ">", "0"}]}]}],
                    "]"}], "===", "0"}]}]}], ",",
            RowBox[{"\"parityMinusIsTanPLMinusPOverM\"", "\[Rule]",
              RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"pB", " ",
                      RowBox[{"boxA", "[", "0", "]"}]}], "-", RowBox[
                     {"(", RowBox[{RowBox[{"pB", " ", RowBox[{"Cos", "[",
                          RowBox[{"pB", " ", "lB"}], "]"}]}], "+", RowBox[
                         {"mB", " ", RowBox[{"Sin", "[", RowBox[{"pB", " ",
                          "lB"}], "]"}]}]}], ")"}]}], "]"}], "===", "0"}]}],
            ",", RowBox[{"\"parityMinusBracketSignChange\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"Simplify", "[", RowBox[
                     {RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[{"mB", " ",
                          RowBox[{"Sin", "[", RowBox[{"pB", " ", "lB"}],
                          "]"}]}], "+", RowBox[{"pB", " ", RowBox[{"Cos",
                          "[", RowBox[{"pB", " ", "lB"}], "]"}]}]}], "/.",
                          "\[VeryThinSpace]", RowBox[{"pB", "\[Rule]",
                          FractionBox[RowBox[{RowBox[{"(", RowBox[{"jB", "-",
                          FractionBox["1", "2"]}], ")"}], " ", "\[Pi]"}],
                          "lB"]}]}], ")"}], "-", RowBox[{"mB", " ",
                          SuperscriptBox[RowBox[{"(", RowBox[{"-", "1"}],
                          ")"}], RowBox[{"jB", "+", "1"}]]}]}], ",",
                      RowBox[{"jB", "\[Element]", TemplateBox[{},
                         "Integers"]}]}], "]"}], "===", "0"}], "&&",
                RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[
                       {RowBox[{"(", RowBox[{RowBox[{RowBox[{"mB", " ",
                          RowBox[{"Sin", "[", RowBox[{"pB", " ", "lB"}],
                          "]"}]}], "+", RowBox[{"pB", " ", RowBox[{"Cos",
                          "[", RowBox[{"pB", " ", "lB"}], "]"}]}]}], "/.",
                          "\[VeryThinSpace]", RowBox[{"pB", "\[Rule]",
                          FractionBox[RowBox[{"jB", " ", "\[Pi]"}],
                          "lB"]}]}], ")"}], "-", FractionBox[RowBox[{"jB",
                          " ", "\[Pi]", " ", SuperscriptBox[RowBox[{"(",
                          RowBox[{"-", "1"}], ")"}], "jB"]}], "lB"]}], ",",
                      RowBox[{"jB", "\[Element]", TemplateBox[{},
                         "Integers"]}]}], "]"}], "===", "0"}]}]}], ",",
            RowBox[{"\"zeroModeSolvesODEBothTypes\"", "\[Rule]",
              RowBox[{"AllTrue", "[", RowBox[{RowBox[{"{", RowBox[{"1", ",",
                      RowBox[{"-", "1"}]}], "}"}], ",", RowBox[
                   {RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[
                          {"boxODE", "[", RowBox[{RowBox[{"Exp", "[", RowBox[
                          {"mB", " ", "yy"}], "]"}], ",", "0", ",", "0"}],
                          "]"}], "/.", "\[VeryThinSpace]", RowBox[{"sB",
                          "\[Rule]", "#1"}]}], "]"}], "===", RowBox[
                       {"{", RowBox[{"0", ",", "0"}], "}"}]}], "&"}]}],
                "]"}]}], ",", RowBox[{"\"zeroModeNormalisableOnHalfLine\"",
              "\[Rule]", RowBox[{RowBox[{"Integrate", "[", RowBox[
                   {RowBox[{"Exp", "[", RowBox[{"2", " ", "mB", " ", "yy"}],
                      "]"}], ",", RowBox[{"{", RowBox[{"yy", ",", RowBox[
                         {"-", "\[Infinity]"}], ",", "0"}], "}"}], ",",
                    RowBox[{"Assumptions", "\[Rule]", RowBox[{"mB", ">",
                        "0"}]}]}], "]"}], "===", FractionBox["1",
                 RowBox[{"2", " ", "mB"}]]}]}], ",",
            RowBox[{"\"belowThresholdParityPlusOnlyAtEpsZero\"", "\[Rule]",
              RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[
                     {"ComplexExpand", "[", RowBox[{RowBox[{"boxB", "[", "0",
                          "]"}], "/.", "\[VeryThinSpace]", RowBox[{"pB",
                          "\[Rule]", RowBox[{"\[ImaginaryI]", " ",
                          "qB"}]}]}], "]"}], "+", FractionBox[RowBox[
                      {RowBox[{"(", RowBox[{"sB", " ", "eB"}], ")"}], " ",
                       RowBox[{"Sinh", "[", RowBox[{"qB", " ", "lB"}],
                         "]"}]}], "qB"]}], "]"}], "===", "0"}]}], ",",
            RowBox[{"\"belowThresholdNoParityMinusLevel\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"Simplify", "[", RowBox[
                     {RowBox[{"ComplexExpand", "[", RowBox[{RowBox[{"boxA",
                          "[", "0", "]"}], "/.", "\[VeryThinSpace]", RowBox[
                          {"pB", "\[Rule]", RowBox[{"\[ImaginaryI]", " ",
                          "qB"}]}]}], "]"}], "-", RowBox[{"(", RowBox[
                         {RowBox[{"Cosh", "[", RowBox[{"qB", " ", "lB"}],
                          "]"}], "+", FractionBox[RowBox[{"mB", " ", RowBox[
                          {"Sinh", "[", RowBox[{"qB", " ", "lB"}], "]"}]}],
                          "qB"]}], ")"}]}], "]"}], "===", "0"}], "&&",
                RowBox[{"Simplify", "[", RowBox[{RowBox[{RowBox[
                       {RowBox[{"Cosh", "[", RowBox[{"qB", " ", "lB"}],
                          "]"}], "+", FractionBox[RowBox[{"mB", " ", RowBox[
                          {"Sinh", "[", RowBox[{"qB", " ", "lB"}], "]"}]}],
                         "qB"]}], ">", "0"}], ",", "boxAssume"}], "]"}]}]}],
            ",", RowBox[{"\"belowThresholdAtEpsZeroIsZeroMode\"", "\[Rule]",
              RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"TrigToExp",
                      "[", RowBox[{RowBox[{"ComplexExpand", "[", RowBox[
                          {RowBox[{"{", RowBox[{RowBox[{"boxA", "[", "yy",
                          "]"}], ",", RowBox[{"boxB", "[", "yy", "]"}]}],
                          "}"}], "/.", "\[VeryThinSpace]", RowBox[{"pB",
                          "\[Rule]", RowBox[{"\[ImaginaryI]", " ",
                          "qB"}]}]}], "]"}], "/.", "\[VeryThinSpace]",
                        RowBox[{"{", RowBox[{RowBox[{"eB", "\[Rule]", "0"}],
                          ",", RowBox[{"qB", "\[Rule]", "mB"}]}], "}"}]}],
                      "]"}], "-", RowBox[{"{", RowBox[{RowBox[{"Exp", "[",
                          RowBox[{"mB", " ", RowBox[{"(", RowBox[{"yy", "+",
                          "lB"}], ")"}]}], "]"}], ",", "0"}], "}"}]}], "]"}],
                "===", RowBox[{"{", RowBox[{"0", ",", "0"}], "}"}]}]}], ",",
            RowBox[{"\"thresholdIsNoLevel\"", "\[Rule]", RowBox[{
                RowBox[{UnderscriptBox["\[Limit]", RowBox[{"pB", "\[Rule]",
                     "0"}]], RowBox[{"{", RowBox[{RowBox[{"boxA", "[", "0",
                        "]"}], ",", RowBox[{"boxB", "[", "0", "]"}]}],
                    "}"}]}], "===", RowBox[{"{", RowBox[{RowBox[{"1", "+",
                      RowBox[{"mB", " ", "lB"}]}], ",", RowBox[
                     {RowBox[{"-", "sB"}], " ", "eB", " ", "lB"}]}],
                  "}"}]}]}]}], "]"}]}], ";", "boxChecks"}]], "Input"],
  Cell["Zero-mode splitting. By first-order perturbation theory \
(Hellmann-Feynman) the k = 0 zero mode chi = (e^{My}, 0) of block type j = -s \
moves as eps = j c k + O(k^2) with c = Integral kappa |chi|^2 / Integral \
|chi|^2 = Integral_{-L}^0 e^{-Hy - a4} e^{2My} dy / Integral_{-L}^0 e^{2My} \
dy, because the k-derivative of the block Hamiltonian h_j is j kappa sigma3 \
and sigma3 = +1 on (1, 0). The integral is done here, c is written in the \
manifestly positive product form e^{-a4} (2M/(2M - H)) (1 - e^{-(2M - \
H)L})/(1 - e^{-2ML}) (every factor positive for 2M > H) and compared with the \
closed form measured by the exact package \
(reduction_zeroModeSplittingCoefficient); the numerical slope is checked in \
the shooting section.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"splitAssume", "=",
        RowBox[{RowBox[{"mB", ">", "0"}], "&&", RowBox[{"hH", ">", "0"}],
          "&&", RowBox[{"lB", ">", "0"}], "&&",
          RowBox[{RowBox[{"2", " ", "mB"}], ">", "hH"}], "&&",
          RowBox[{"a4", "\[Element]", TemplateBox[{}, "Reals"]}]}]}], ";",
      RowBox[{"cSplitting", "=", RowBox[{"Simplify", "[",
          RowBox[{FractionBox[RowBox[{"Integrate", "[", RowBox[
                {RowBox[{RowBox[{"Exp", "[", RowBox[{RowBox[{RowBox[{"-",
                          "hH"}], " ", "yy"}], "-", "a4"}], "]"}], " ",
                   RowBox[{"Exp", "[", RowBox[{"2", " ", "mB", " ", "yy"}],
                     "]"}]}], ",", RowBox[{"{", RowBox[{"yy", ",", RowBox[
                      {"-", "lB"}], ",", "0"}], "}"}], ",", RowBox[
                  {"Assumptions", "\[Rule]", "splitAssume"}]}], "]"}],
             RowBox[{"Integrate", "[", RowBox[{RowBox[{"Exp", "[",
                   RowBox[{"2", " ", "mB", " ", "yy"}], "]"}], ",",
                 RowBox[{"{", RowBox[{"yy", ",", RowBox[{"-", "lB"}], ",",
                     "0"}], "}"}], ",", RowBox[{"Assumptions", "\[Rule]",
                   "splitAssume"}]}], "]"}]], ",", "splitAssume"}], "]"}]}],
      ";", RowBox[{"packageSplittingRaw", "=",
        RowBox[{RowBox[{"theoryRun", "[", "\"measurements\"", "]"}], "[",
          "\"reduction_zeroModeSplittingCoefficient\"", "]"}]}], ";",
      RowBox[{"packageSplitting", "=", RowBox[{"Module", "[",
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"expr", "=", RowBox[
                   {"If", "[", RowBox[{RowBox[{"StringQ", "[",
                        "packageSplittingRaw", "]"}], ",", RowBox[{"Block",
                        "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"$Context",
                          "=", "\"KSPackageImport`\""}], ",", RowBox[
                          {"$ContextPath", "=", RowBox[{"{", "\"System`\"",
                          "}"}]}]}], "}"}], ",", RowBox[{"ToExpression", "[",
                          "packageSplittingRaw", "]"}]}], "]"}], ",",
                      "packageSplittingRaw"}], "]"}]}], ",", RowBox[
                 {"names", "=", RowBox[{"Association", "[", RowBox[
                     {RowBox[{"\"LL\"", "\[Rule]", "lB"}], ",", RowBox[
                       {"\"H\"", "\[Rule]", "hH"}], ",", RowBox[{"\"M\"",
                        "\[Rule]", "mB"}], ",", RowBox[{"\"a4c\"", "\[Rule]",
                        "a4"}]}], "]"}]}]}], "}"}], ",",
            RowBox[{"expr", "/.", "\[VeryThinSpace]", RowBox[{RowBox[
                 {"sym_Symbol", "/;", RowBox[{RowBox[{RowBox[{"Context", "[",
                        "sym", "]"}], "=!=", "\"System`\""}], "&&",
                    RowBox[{"KeyExistsQ", "[", RowBox[{"names", ",",
                        RowBox[{"SymbolName", "[", "sym", "]"}]}], "]"}]}]}],
                "\[RuleDelayed]", RowBox[{"names", "[", RowBox[{"SymbolName",
                    "[", "sym", "]"}], "]"}]}]}]}], "]"}]}], ";",
      RowBox[{"cSplittingM1L3", "=", RowBox[{"cSplitting", "/.",
          "\[VeryThinSpace]", RowBox[{"{", RowBox[{RowBox[{"mB", "\[Rule]",
                "1"}], ",", RowBox[{"hH", "\[Rule]", "1"}], ",",
              RowBox[{"lB", "\[Rule]", "3"}], ",", RowBox[{"a4", "\[Rule]",
                "0"}]}], "}"}]}]}], ";", RowBox[{"splittingChecks", "=",
        RowBox[{"Association", "[", RowBox[
           {RowBox[{"\"splittingEqualsPackageClosedForm\"", "\[Rule]",
              RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"cSplitting",
                      "-", "packageSplitting"}], ",", "splitAssume"}], "]"}],
                "===", "0"}]}], ",", RowBox[
             {"\"splittingAtM1H1L3Is2Over1PlusExpMinus3\"", "\[Rule]",
              RowBox[{RowBox[{"Simplify", "[", RowBox[{"cSplittingM1L3", "-",
                    FractionBox["2", RowBox[{"1", "+", RowBox[{"Exp", "[",
                         RowBox[{"-", "3"}], "]"}]}]]}], "]"}], "===",
                "0"}]}], ",", RowBox[{"\"splittingPositiveProductForm\"",
              "\[Rule]", RowBox[{RowBox[{RowBox[{"Simplify", "[", RowBox[
                     {RowBox[{RowBox[{"cSplitting", "-", FractionBox[RowBox[
                          {RowBox[{"Exp", "[", RowBox[{"-", "a4"}], "]"}],
                          " ", RowBox[{"(", RowBox[{"2", " ", "mB"}], ")"}],
                          " ", RowBox[{"(", RowBox[{"1", "-", RowBox[{"Exp",
                          "[", RowBox[{"-", "xB"}], "]"}]}], ")"}]}], RowBox[
                          {RowBox[{"(", RowBox[{RowBox[{"2", " ", "mB"}],
                          "-", "hH"}], ")"}], " ", RowBox[{"(", RowBox[{"1",
                          "-", RowBox[{"Exp", "[", RowBox[{RowBox[{"-",
                          "2"}], " ", "mB", " ", "lB"}], "]"}]}], ")"}]}]]}],
                        "/.", "\[VeryThinSpace]", RowBox[{"xB", "\[Rule]",
                          RowBox[{RowBox[{"(", RowBox[{RowBox[{"2", " ",
                          "mB"}], "-", "hH"}], ")"}], " ", "lB"}]}]}], ",",
                      "splitAssume"}], "]"}], "===", "0"}], "&&",
                RowBox[{"Simplify", "[", RowBox[{RowBox[{RowBox[
                       {RowBox[{"(", RowBox[{RowBox[{"2", " ", "mB"}], "-",
                          "hH"}], ")"}], " ", "lB"}], ">", "0"}], ",",
                    "splitAssume"}], "]"}], "&&", RowBox[{"Simplify", "[",
                  RowBox[{RowBox[{RowBox[{"1", "-", RowBox[{"Exp", "[",
                          RowBox[{"-", "xB"}], "]"}]}], ">", "0"}], ",",
                    RowBox[{"xB", ">", "0"}]}], "]"}], "&&", RowBox[
                 {"Simplify", "[", RowBox[{RowBox[{RowBox[{FractionBox[
                         RowBox[{"2", " ", "mB"}], RowBox[{RowBox[{"2", " ",
                          "mB"}], "-", "hH"}]], ">", "0"}], "&&", RowBox[
                       {RowBox[{"1", "-", RowBox[{"Exp", "[", RowBox[
                          {RowBox[{"-", "2"}], " ", "mB", " ", "lB"}],
                          "]"}]}], ">", "0"}]}], ",", "splitAssume"}],
                  "]"}]}]}]}], "]"}]}], ";",
      RowBox[{"{", RowBox[{"cSplitting", ",", RowBox[{"N", "[",
            RowBox[{"cSplittingM1L3", ",", "12"}], "]"}], ",",
          "splittingChecks"}], "}"}]}]], "Input"],
  Cell["Comparison with the Rust free spectra. For each of the six files \
spectrum/free-spectrum-m{1,3}-L{2,3,4}.csv (window -4m <= eps <= 4m, shells \
n2 <= 16) the k = 0 rows (n2 = 0, both parities, both block types) are \
compared with the exact levels above, level by level through the Pruefer \
index. The roots p_j of the parity - condition are computed by bisection in \
exact arithmetic on the bracket ((j - 1/2) pi/L, j pi/L), whose end values of \
M sin(pL) + p cos(pL) have opposite signs (checked above), to 30 significant \
digits.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"readTable", "[", "path_String",
          "]"}], ":=", RowBox[{"Module", "[",
          RowBox[{RowBox[{"{", RowBox[{"data", "=", RowBox[{"Import", "[",
                  RowBox[{RowBox[{"registerSource", "[", "path", "]"}], ",",
                    "\"CSV\""}], "]"}]}], "}"}], ",",
            RowBox[{"Association", "[", RowBox[{RowBox[{"\"header\"",
                  "\[Rule]", RowBox[{"First", "[", "data", "]"}]}], ",",
                RowBox[{"\"index\"", "\[Rule]", RowBox[{"AssociationThread",
                    "[", RowBox[{RowBox[{"First", "[", "data", "]"}],
                      "\[Rule]", RowBox[{"Range", "[", RowBox[{"Length", "[",
                          RowBox[{"First", "[", "data", "]"}], "]"}],
                        "]"}]}], "]"}]}], ",", RowBox[{"\"rows\"", "\[Rule]",
                  RowBox[{"Rest", "[", "data", "]"}]}]}], "]"}]}], "]"}]}],
      ";", RowBox[{RowBox[{"columnOf", "[", RowBox[{"table_", ",",
            "name_String"}], "]"}], ":=",
        RowBox[{RowBox[{"table", "[", "\"rows\"", "]"}],
          "\[LeftDoubleBracket]", RowBox[{"All", ",",
            RowBox[{RowBox[{"table", "[", "\"index\"", "]"}], "[", "name",
              "]"}]}], "\[RightDoubleBracket]"}]}], ";",
      RowBox[{"freeConfigurations", "=",
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", "2"}], "}"}],
            ",", RowBox[{"{", RowBox[{"1", ",", "3"}], "}"}], ",",
            RowBox[{"{", RowBox[{"1", ",", "4"}], "}"}], ",",
            RowBox[{"{", RowBox[{"3", ",", "2"}], "}"}], ",",
            RowBox[{"{", RowBox[{"3", ",", "3"}], "}"}], ",",
            RowBox[{"{", RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], ";",
      RowBox[{RowBox[{"freeFileName", "[", RowBox[
           {"{", RowBox[{"mv_", ",", "lv_"}], "}"}], "]"}], ":=",
        RowBox[{"\"free-spectrum-m\"", "<>", RowBox[{"ToString", "[", "mv",
            "]"}], "<>", "\"-L\"", "<>", RowBox[{"ToString", "[", "lv",
            "]"}], "<>", "\".csv\""}]}], ";",
      RowBox[{"freeTables", "=", RowBox[{"AssociationMap", "[",
          RowBox[{RowBox[{RowBox[{"readTable", "[", RowBox[{"FileNameJoin",
                  "[", RowBox[{"{", RowBox[{"rustRoot", ",", "\"spectrum\"",
                      ",", RowBox[{"freeFileName", "[", "#1", "]"}]}], "}"}],
                  "]"}], "]"}], "&"}], ",", "freeConfigurations"}], "]"}]}],
      ";", RowBox[{RowBox[{"oddBoxMomentum", "[",
          RowBox[{"mv_", ",", "lv_", ",", "j_"}], "]"}], ":=",
        RowBox[{RowBox[{"oddBoxMomentum", "[", RowBox[{"mv", ",", "lv", ",",
              "j"}], "]"}], "=", RowBox[{"Module", "[",
            RowBox[{RowBox[{"{", RowBox[{"g", ",", RowBox[{"a", "=",
                    FractionBox[RowBox[{RowBox[{"(", RowBox[{"j", "-",
                          FractionBox["1", "2"]}], ")"}], " ", "\[Pi]"}],
                     "lv"]}], ",", RowBox[{"b", "=", FractionBox[RowBox[
                      {"j", " ", "\[Pi]"}], "lv"]}], ",", "ga", ",", "c"}],
                "}"}], ",", RowBox[{RowBox[{RowBox[{"g", "[", "p_", "]"}],
                  ":=", RowBox[{"N", "[", RowBox[{RowBox[{RowBox[{"mv", " ",
                          RowBox[{"Sin", "[", RowBox[{"p", " ", "lv"}],
                          "]"}]}], "+", RowBox[{"p", " ", RowBox[{"Cos", "[",
                          RowBox[{"p", " ", "lv"}], "]"}]}]}], ",", "40"}],
                    "]"}]}], ";", RowBox[{"ga", "=", RowBox[{"Sign", "[",
                    RowBox[{"g", "[", "a", "]"}], "]"}]}], ";",
                RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"c", "=",
                        FractionBox[RowBox[{"a", "+", "b"}], "2"]}], ";",
                      RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Sign", "[",
                          RowBox[{"g", "[", "c", "]"}], "]"}], "\[Equal]",
                          "ga"}], ",", RowBox[{"a", "=", "c"}], ",", RowBox[
                          {"b", "=", "c"}]}], "]"}]}], ",", RowBox[
                     {"{", "110", "}"}]}], "]"}], ";", RowBox[{"N", "[",
                  RowBox[{FractionBox[RowBox[{"a", "+", "b"}], "2"], ",",
                    "30"}], "]"}]}]}], "]"}]}]}], ";",
      RowBox[{RowBox[{"analyticBoxLevel", "[", RowBox[{"mv_", ",", "lv_",
            ",", "parity_", ",", "s_", ",", "n_"}], "]"}], ":=",
        RowBox[{"s", " ", RowBox[{"If", "[", RowBox[{RowBox[{"parity",
                "\[Equal]", "1"}], ",", RowBox[{"If", "[", RowBox[
                 {RowBox[{"n", "\[Equal]", "0"}], ",", "0", ",",
                  RowBox[{RowBox[{"Sign", "[", "n", "]"}], " ", SqrtBox[
                     RowBox[{SuperscriptBox["mv", "2"], "+", SuperscriptBox[
                        RowBox[{"(", FractionBox[RowBox[{"n", " ", "\[Pi]"}],
                          "lv"], ")"}], "2"]}]]}]}], "]"}], ",",
              RowBox[{"If", "[", RowBox[{RowBox[{"n", "\[GreaterEqual]",
                    "0"}], ",", SqrtBox[RowBox[{SuperscriptBox["mv", "2"],
                     "+", SuperscriptBox[RowBox[{"oddBoxMomentum", "[",
                        RowBox[{"mv", ",", "lv", ",", RowBox[{"n", "+",
                          "1"}]}], "]"}], "2"]}]], ",", RowBox[{"-",
                    SqrtBox[RowBox[{SuperscriptBox["mv", "2"], "+",
                       SuperscriptBox[RowBox[{"oddBoxMomentum", "[", RowBox[
                          {"mv", ",", "lv", ",", RowBox[{"-", "n"}]}], "]"}],
                        "2"]}]]}]}], "]"}]}], "]"}]}]}], ";",
      RowBox[{RowBox[{"analyticBoxLevels", "[", RowBox[{"mv_", ",", "lv_"}],
          "]"}], ":=", RowBox[{"Module", "[",
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"plusMax", "=", RowBox[
                   {"Floor", "[", FractionBox[RowBox[{"lv", " ", SqrtBox[
                        "15"], " ", "mv"}], "\[Pi]"], "]"}]}], ",",
                RowBox[{"minusMax", "=", "1"}]}], "}"}], ",",
            RowBox[{RowBox[{"While", "[", RowBox[{RowBox[{SqrtBox[RowBox[
                      {SuperscriptBox["mv", "2"], "+", SuperscriptBox[
                        RowBox[{"oddBoxMomentum", "[", RowBox[{"mv", ",",
                          "lv", ",", RowBox[{"minusMax", "+", "1"}]}], "]"}],
                        "2"]}]], "<", RowBox[{"4", " ", "mv"}]}], ",",
                  RowBox[{"minusMax", "++"}]}], "]"}], ";", RowBox[{"Select",
                "[", RowBox[{RowBox[{"Flatten", "[", RowBox[{"Table", "[",
                      RowBox[{RowBox[{"Join", "[", RowBox[{RowBox[{"Table",
                          "[", RowBox[{RowBox[{"Association", "[", RowBox[
                          {RowBox[{"\"parity\"", "\[Rule]", "1"}], ",",
                          RowBox[{"\"s\"", "\[Rule]", "s"}], ",", RowBox[
                          {"\"index\"", "\[Rule]", "n"}], ",", RowBox[
                          {"\"eps\"", "\[Rule]", RowBox[{"N", "[", RowBox[
                          {RowBox[{"analyticBoxLevel", "[", RowBox[{"mv",
                          ",", "lv", ",", "1", ",", "s", ",", "n"}], "]"}],
                          ",", "30"}], "]"}]}]}], "]"}], ",", RowBox[{"{",
                          RowBox[{"n", ",", RowBox[{"-", "plusMax"}], ",",
                          "plusMax"}], "}"}]}], "]"}], ",", RowBox[{"Table",
                          "[", RowBox[{RowBox[{"Association", "[", RowBox[
                          {RowBox[{"\"parity\"", "\[Rule]", RowBox[{"-",
                          "1"}]}], ",", RowBox[{"\"s\"", "\[Rule]", "s"}],
                          ",", RowBox[{"\"index\"", "\[Rule]", "n"}], ",",
                          RowBox[{"\"eps\"", "\[Rule]", RowBox[{"N", "[",
                          RowBox[{RowBox[{"analyticBoxLevel", "[", RowBox[
                          {"mv", ",", "lv", ",", RowBox[{"-", "1"}], ",",
                          "s", ",", "n"}], "]"}], ",", "30"}], "]"}]}]}],
                          "]"}], ",", RowBox[{"{", RowBox[{"n", ",", RowBox[
                          {"-", "minusMax"}], ",", RowBox[{"minusMax", "-",
                          "1"}]}], "}"}]}], "]"}]}], "]"}], ",", RowBox[
                         {"{", RowBox[{"s", ",", RowBox[{"{", RowBox[{"1",
                          ",", RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}],
                    "]"}], ",", RowBox[{RowBox[{RowBox[{"Abs", "[", RowBox[
                         {"#1", "[", "\"eps\"", "]"}], "]"}], "<", RowBox[
                       {"4", " ", "mv"}]}], "&"}]}], "]"}]}]}], "]"}]}], ";",
      RowBox[{RowBox[{"rustRowsK0", "[", "config_", "]"}], ":=",
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"t", "=",
                RowBox[{"freeTables", "[", "config", "]"}]}], "}"}], ",",
            RowBox[{"Select", "[", RowBox[{RowBox[{"t", "[", "\"rows\"",
                  "]"}], ",", RowBox[{RowBox[{RowBox[{"#1",
                      "\[LeftDoubleBracket]", RowBox[{RowBox[{"t", "[",
                          "\"index\"", "]"}], "[", "\"n2\"", "]"}],
                      "\[RightDoubleBracket]"}], "\[Equal]", "0"}], "&"}]}],
              "]"}]}], "]"}]}], ";",
      RowBox[{RowBox[{"keyOf", "[", "r_", "]"}], ":=",
        RowBox[{"Lookup", "[", RowBox[{"r", ",", RowBox[
             {"{", RowBox[{"\"parity\"", ",", "\"s\"", ",", "\"index\""}],
              "}"}]}], "]"}]}], ";", RowBox[{"boxComparison", "=",
        RowBox[{"Association", "[", RowBox[{"Table", "[",
            RowBox[{RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                     {RowBox[{"t", "=", RowBox[{"freeTables", "[", "config",
                          "]"}]}], ",", "exact", ",", "rust", ",", "dev"}],
                    "}"}], ",", RowBox[{RowBox[{"exact", "=", RowBox[
                       {"SortBy", "[", RowBox[{RowBox[{"analyticBoxLevels",
                          "@@", "config"}], ",", "keyOf"}], "]"}]}], ";",
                    RowBox[{"rust", "=", RowBox[{"SortBy", "[", RowBox[
                         {RowBox[{RowBox[{"(", RowBox[{RowBox[{"Association",
                          "[", RowBox[{RowBox[{"\"parity\"", "\[Rule]",
                          RowBox[{"Round", "[", RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{RowBox[{"t", "[",
                          "\"index\"", "]"}], "[", "\"parity\"", "]"}],
                          "\[RightDoubleBracket]"}], "]"}]}], ",", RowBox[
                          {"\"s\"", "\[Rule]", RowBox[{"Round", "[", RowBox[
                          {"#1", "\[LeftDoubleBracket]", RowBox[{RowBox[{"t",
                          "[", "\"index\"", "]"}], "[", "\"s\"", "]"}],
                          "\[RightDoubleBracket]"}], "]"}]}], ",", RowBox[
                          {"\"index\"", "\[Rule]", RowBox[{"Round", "[",
                          RowBox[{"#1", "\[LeftDoubleBracket]", RowBox[
                          {RowBox[{"t", "[", "\"index\"", "]"}], "[",
                          "\"index\"", "]"}], "\[RightDoubleBracket]"}],
                          "]"}]}], ",", RowBox[{"\"eps\"", "\[Rule]", RowBox[
                          {"#1", "\[LeftDoubleBracket]", RowBox[{RowBox[{"t",
                          "[", "\"index\"", "]"}], "[", "\"eps\"", "]"}],
                          "\[RightDoubleBracket]"}]}]}], "]"}], "&"}], ")"}],
                          "/@", RowBox[{"rustRowsK0", "[", "config", "]"}]}],
                          ",", "keyOf"}], "]"}]}], ";", RowBox[{"dev", "=",
                      RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"keyOf",
                          "/@", "exact"}], "===", RowBox[{"keyOf", "/@",
                          "rust"}]}], ",", RowBox[{"Max", "[", RowBox[{"Abs",
                          "[", RowBox[{RowBox[{"rust",
                          "\[LeftDoubleBracket]", RowBox[{"All", ",",
                          "\"eps\""}], "\[RightDoubleBracket]"}], "-", RowBox[
                          {"N", "[", RowBox[{"exact", "\[LeftDoubleBracket]",
                          RowBox[{"All", ",", "\"eps\""}],
                          "\[RightDoubleBracket]"}], "]"}]}], "]"}], "]"}],
                          ",", "\[Infinity]"}], "]"}]}], ";", RowBox[
                     {RowBox[{"freeFileName", "[", "config", "]"}],
                      "\[Rule]", RowBox[{"Association", "[", RowBox[
                         {RowBox[{"\"levels\"", "\[Rule]", RowBox[{"Length",
                          "[", "exact", "]"}]}], ",", RowBox[
                          {"\"rustLevels\"", "\[Rule]", RowBox[{"Length",
                          "[", "rust", "]"}]}], ",", RowBox[
                          {"\"keysIdentical\"", "\[Rule]", RowBox[{RowBox[
                          {"keyOf", "/@", "exact"}], "===", RowBox[{"keyOf",
                          "/@", "rust"}]}]}], ",", RowBox[
                          {"\"maxAbsDeviation\"", "\[Rule]", "dev"}]}],
                        "]"}]}]}]}], "]"}], ",", RowBox[{"{", RowBox[
                 {"config", ",", "freeConfigurations"}], "}"}]}], "]"}],
          "]"}]}], ";", RowBox[{"boxLevelsExact", "=",
        RowBox[{"AssociationMap", "[", RowBox[
           {RowBox[{RowBox[{"analyticBoxLevels", "@@", "#1"}], "&"}], ",",
            "freeConfigurations"}], "]"}]}], ";",
      RowBox[{"Dataset", "[", "boxComparison", "]"}]}]], "Input"],
  Cell["NDSolve shooting for the k != 0 single-particle problem", "Section"],
  Cell["The eigenvalue problem of one block type s at momentum k is solved by \
NDSolve shooting with the Pruefer angle derived above: theta' = s (eps - \
v_v(y)) + kappa(y) k cos(2 theta) - M_eff(y) sin(2 theta), theta(-L) = 0 (the \
tip bag b(-L) = 0), integrated to the brane; the level condition is \
Theta(eps) := theta(0; eps) = n pi (brane parity +, b(0) = 0) or pi/2 + n pi \
(parity -, a(0) = 0). Because Theta is strictly monotone in eps (increasing \
for s = +1, decreasing for s = -1), the integers n between Theta at the two \
window edges enumerate every level in the window exactly once (oscillation \
count: no level is missed), and n is the Pruefer index of the Rust output. \
The variational equation theta_eps' = s + (-2 kappa k sin(2 theta) - 2 M_eff \
cos(2 theta)) theta_eps, theta_eps(-L) = 0 (its coefficient was derived \
symbolically above), is integrated together with theta and gives the exact \
derivative dTheta/deps. The integration runs in u = y + L in [0, L], so that \
NDSolve never has to land on the endpoint y = 0 (landing there produced \
step-size warnings in a trial). ParametricNDSolveValue returns (Theta, \
dTheta/deps) as a function of (eps, k, s). For a constant potential NDSolve \
runs with its automatic method (non-stiff/stiff switching) at PrecisionGoal \
13, AccuracyGoal 14; for the spline potentials of the self-consistent loop, \
whose third derivative jumps at each of the 301 nodes, the automatic method \
needed about 4600 steps per integration in a trial, and the explicit \
Runge-Kutta method of order 5 is used instead at PrecisionGoal 12, \
AccuracyGoal 13 (about 700 steps, Theta error about 1e-12 against a \
WorkingPrecision 24 reference in the same trial). Level search in a group (k, \
s, parity): Theta at the two window edges gives the targets; Theta is sampled \
at n_levels + 1 further equally spaced energies (a group without levels costs \
two integrations); each root of Theta(eps) - target is found by Newton's \
method with the exact derivative, started at the linear interpolation inside \
the sample cell that brackets the target and safeguarded by that bracket (a \
step that leaves it is replaced by bisection), and stopped after a Newton \
step below 1e-10 max(1, |eps|) (the error after such a step is of the order \
of its square, below the integration error). At every root the linear \
two-component system (a(-L) = 1, b(-L) = 0, with the accumulators \
Integral(a^2 + b^2), Integral(-2ab) and Integral(-kappa k (a^2 - b^2))) is \
integrated separately; it gives the matching residual |b(0)|/|chi(0)| (parity \
+) or |a(0)|/|chi(0)| (parity -) and the charges of the state of block type \
s, the scalar charge Integral(-2 s a b)/Integral(a^2 + b^2) (the scalar \
density of type s is -2 s a b, derived above) and the 3-space pressure charge \
Integral(-s kappa k (a^2 - b^2))/Integral(a^2 + b^2), i.e. the columns \
scalar_charge and pressure_charge of the Rust files. Both codes shoot on the \
same Pruefer form; they share no code: NDSolve versus CVODE, Newton with the \
variational derivative versus bracketing plus Illinois regula falsi in Rust, \
and the symbolic derivation of the Pruefer equation above.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"smoothOptions", "=",
        RowBox[{"{", RowBox[{RowBox[{"PrecisionGoal", "\[Rule]", "13"}], ",",
            RowBox[{"AccuracyGoal", "\[Rule]", "14"}]}], "}"}]}], ";",
      RowBox[{"splineOptions", "=", RowBox[
         {"{", RowBox[{RowBox[{"Method", "\[Rule]", RowBox[{"{",
                RowBox[{"\"ExplicitRungeKutta\"", ",", RowBox[
                   {"\"DifferenceOrder\"", "\[Rule]", "5"}]}], "}"}]}], ",",
            RowBox[{"PrecisionGoal", "\[Rule]", "12"}], ",",
            RowBox[{"AccuracyGoal", "\[Rule]", "13"}]}], "}"}]}], ";",
      RowBox[{RowBox[{"pruferThetaD", "[", RowBox[{"mF_", ",", "vF_", ",",
            "lv_", ",", "hv_", ",", "av_", ",", "opts_List"}], "]"}], ":=",
        RowBox[{"ParametricNDSolveValue", "[",
          RowBox[{RowBox[{"{", RowBox[{RowBox[{RowBox[{SuperscriptBox["thS",
                     "\[Prime]", MultilineFunction -> None], "[", "uS",
                    "]"}], "\[Equal]", RowBox[{RowBox[{"sS", " ", RowBox[
                       {"(", RowBox[{"epsS", "-", RowBox[{"vF", "[", RowBox[
                          {"uS", "-", "lv"}], "]"}]}], ")"}]}], "+",
                    RowBox[{RowBox[{"Exp", "[", RowBox[{RowBox[{RowBox[
                          {"-", "hv"}], " ", RowBox[{"(", RowBox[{"uS", "-",
                          "lv"}], ")"}]}], "-", "av"}], "]"}], " ", "kS",
                      " ", RowBox[{"Cos", "[", RowBox[{"2", " ", RowBox[
                          {"thS", "[", "uS", "]"}]}], "]"}]}], "-",
                    RowBox[{RowBox[{"mF", "[", RowBox[{"uS", "-", "lv"}],
                        "]"}], " ", RowBox[{"Sin", "[", RowBox[{"2", " ",
                          RowBox[{"thS", "[", "uS", "]"}]}], "]"}]}]}]}],
                ",", RowBox[{RowBox[{SuperscriptBox["teS", "\[Prime]",
                     MultilineFunction -> None], "[", "uS", "]"}],
                  "\[Equal]", RowBox[{"sS", "+", RowBox[{RowBox[{"(",
                        RowBox[{RowBox[{RowBox[{"-", "2"}], " ", RowBox[
                          {"Exp", "[", RowBox[{RowBox[{RowBox[{"-", "hv"}],
                          " ", RowBox[{"(", RowBox[{"uS", "-", "lv"}],
                          ")"}]}], "-", "av"}], "]"}], " ", "kS", " ",
                          RowBox[{"Sin", "[", RowBox[{"2", " ", RowBox[
                          {"thS", "[", "uS", "]"}]}], "]"}]}], "-", RowBox[
                          {"2", " ", RowBox[{"mF", "[", RowBox[{"uS", "-",
                          "lv"}], "]"}], " ", RowBox[{"Cos", "[", RowBox[
                          {"2", " ", RowBox[{"thS", "[", "uS", "]"}]}],
                          "]"}]}]}], ")"}], " ", RowBox[{"teS", "[", "uS",
                        "]"}]}]}]}], ",", RowBox[{RowBox[{"thS", "[", "0",
                    "]"}], "\[Equal]", "0"}], ",", RowBox[
                 {RowBox[{"teS", "[", "0", "]"}], "\[Equal]", "0"}]}], "}"}],
            ",", RowBox[{"{", RowBox[{RowBox[{"thS", "[", "lv", "]"}], ",",
                RowBox[{"teS", "[", "lv", "]"}]}], "}"}], ",",
            RowBox[{"{", RowBox[{"uS", ",", "0", ",", "lv"}], "}"}], ",",
            RowBox[{"{", RowBox[{"epsS", ",", "kS", ",", "sS"}], "}"}], ",",
            RowBox[{"Sequence", "@@", "opts"}], ",",
            RowBox[{"MaxSteps", "\[Rule]", "\[Infinity]"}]}], "]"}]}], ";",
      RowBox[{RowBox[{"linearEnds", "[", RowBox[{"mF_", ",", "vF_", ",",
            "lv_", ",", "hv_", ",", "av_", ",", "opts_List"}], "]"}], ":=",
        RowBox[{"ParametricNDSolveValue", "[",
          RowBox[{RowBox[{"{", RowBox[{RowBox[{RowBox[{SuperscriptBox["aS",
                     "\[Prime]", MultilineFunction -> None], "[", "uS",
                    "]"}], "\[Equal]", RowBox[{RowBox[{RowBox[{"mF", "[",
                        RowBox[{"uS", "-", "lv"}], "]"}], " ", RowBox[
                       {"aS", "[", "uS", "]"}]}], "+", RowBox[
                     {RowBox[{"(", RowBox[{RowBox[{"sS", " ", RowBox[{"(",
                          RowBox[{"epsS", "-", RowBox[{"vF", "[", RowBox[
                          {"uS", "-", "lv"}], "]"}]}], ")"}]}], "-", RowBox[
                          {RowBox[{"Exp", "[", RowBox[{RowBox[{RowBox[{"-",
                          "hv"}], " ", RowBox[{"(", RowBox[{"uS", "-",
                          "lv"}], ")"}]}], "-", "av"}], "]"}], " ", "kS"}]}],
                        ")"}], " ", RowBox[{"bS", "[", "uS", "]"}]}]}]}],
                ",", RowBox[{RowBox[{SuperscriptBox["bS", "\[Prime]",
                     MultilineFunction -> None], "[", "uS", "]"}],
                  "\[Equal]", RowBox[{RowBox[{RowBox[{"-", RowBox[{"(",
                          RowBox[{RowBox[{"sS", " ", RowBox[{"(", RowBox[
                          {"epsS", "-", RowBox[{"vF", "[", RowBox[{"uS", "-",
                          "lv"}], "]"}]}], ")"}]}], "+", RowBox[{RowBox[
                          {"Exp", "[", RowBox[{RowBox[{RowBox[{"-", "hv"}],
                          " ", RowBox[{"(", RowBox[{"uS", "-", "lv"}],
                          ")"}]}], "-", "av"}], "]"}], " ", "kS"}]}],
                          ")"}]}], " ", RowBox[{"aS", "[", "uS", "]"}]}],
                    "-", RowBox[{RowBox[{"mF", "[", RowBox[{"uS", "-",
                          "lv"}], "]"}], " ", RowBox[{"bS", "[", "uS",
                        "]"}]}]}]}], ",", RowBox[{RowBox[{SuperscriptBox[
                     "nS", "\[Prime]", MultilineFunction -> None], "[", "uS",
                    "]"}], "\[Equal]", RowBox[{SuperscriptBox[RowBox[
                      {"aS", "[", "uS", "]"}], "2"], "+", SuperscriptBox[
                     RowBox[{"bS", "[", "uS", "]"}], "2"]}]}], ",",
                RowBox[{RowBox[{SuperscriptBox["qS", "\[Prime]",
                     MultilineFunction -> None], "[", "uS", "]"}],
                  "\[Equal]", RowBox[{RowBox[{"-", "2"}], " ", RowBox[
                     {"aS", "[", "uS", "]"}], " ", RowBox[{"bS", "[", "uS",
                      "]"}]}]}], ",", RowBox[{RowBox[{SuperscriptBox["pS",
                     "\[Prime]", MultilineFunction -> None], "[", "uS",
                    "]"}], "\[Equal]", RowBox[{RowBox[{"-", RowBox[{"Exp",
                        "[", RowBox[{RowBox[{RowBox[{"-", "hv"}], " ",
                          RowBox[{"(", RowBox[{"uS", "-", "lv"}], ")"}]}],
                          "-", "av"}], "]"}]}], " ", "kS", " ", RowBox[
                     {"(", RowBox[{SuperscriptBox[RowBox[{"aS", "[", "uS",
                          "]"}], "2"], "-", SuperscriptBox[RowBox[{"bS", "[",
                          "uS", "]"}], "2"]}], ")"}]}]}], ",",
                RowBox[{RowBox[{"aS", "[", "0", "]"}], "\[Equal]", "1"}],
                ",", RowBox[{RowBox[{"bS", "[", "0", "]"}], "\[Equal]",
                  "0"}], ",", RowBox[{RowBox[{"nS", "[", "0", "]"}],
                  "\[Equal]", "0"}], ",", RowBox[{RowBox[{"qS", "[", "0",
                    "]"}], "\[Equal]", "0"}], ",", RowBox[
                 {RowBox[{"pS", "[", "0", "]"}], "\[Equal]", "0"}]}], "}"}],
            ",", RowBox[{"{", RowBox[{RowBox[{"aS", "[", "lv", "]"}], ",",
                RowBox[{"bS", "[", "lv", "]"}], ",", RowBox[{"nS", "[", "lv",
                  "]"}], ",", RowBox[{"qS", "[", "lv", "]"}], ",",
                RowBox[{"pS", "[", "lv", "]"}]}], "}"}], ",",
            RowBox[{"{", RowBox[{"uS", ",", "0", ",", "lv"}], "}"}], ",",
            RowBox[{"{", RowBox[{"epsS", ",", "kS", ",", "sS"}], "}"}], ",",
            RowBox[{"Sequence", "@@", "opts"}], ",",
            RowBox[{"MaxSteps", "\[Rule]", "\[Infinity]"}]}], "]"}]}], ";",
      RowBox[{RowBox[{"newtonRoot", "[", RowBox[{"g_", ",",
            RowBox[{"{", RowBox[{"a0_", ",", "b0_"}], "}"}], ",",
            RowBox[{"{", RowBox[{"fa0_", ",", "fb0_"}], "}"}], ",", "x0_"}],
          "]"}], ":=", RowBox[{"Module", "[",
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"a", "=", RowBox[{"N", "[",
                    "a0", "]"}]}], ",", RowBox[{"b", "=", RowBox[{"N", "[",
                    "b0", "]"}]}], ",", RowBox[{"fa", "=", "fa0"}], ",",
                RowBox[{"x", "=", RowBox[{"N", "[", "x0", "]"}]}], ",", "f",
                ",", "d", ",", "xn", ",", RowBox[{"iterations", "=", "0"}]}],
              "}"}], ",", RowBox[{RowBox[{"If", "[", RowBox[
                 {RowBox[{"fa0", "\[Equal]", "0.`"}], ",", RowBox[{"Return",
                    "[", RowBox[{"{", RowBox[{"a", ",", "0"}], "}"}],
                    "]"}]}], "]"}], ";", RowBox[{"If", "[", RowBox[
                 {RowBox[{"fb0", "\[Equal]", "0.`"}], ",", RowBox[{"Return",
                    "[", RowBox[{"{", RowBox[{"b", ",", "0"}], "}"}],
                    "]"}]}], "]"}], ";", RowBox[{"While", "[",
                RowBox[{RowBox[{"iterations", "<", "60"}], ",", RowBox[
                   {RowBox[{"iterations", "++"}], ";", RowBox[
                     {RowBox[{"{", RowBox[{"f", ",", "d"}], "}"}], "=",
                      RowBox[{"g", "[", "x", "]"}]}], ";", RowBox[{"If", "[",
                      RowBox[{RowBox[{"f", "\[Equal]", "0.`"}], ",",
                        RowBox[{"Break", "[", "]"}]}], "]"}], ";",
                    RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"f", " ",
                          "fa"}], "<", "0"}], ",", RowBox[{"b", "=", "x"}],
                        ",", RowBox[{RowBox[{"a", "=", "x"}], ";", RowBox[
                          {"fa", "=", "f"}]}]}], "]"}], ";", RowBox[
                     {"xn", "=", RowBox[{"x", "-", FractionBox["f", "d"]}]}],
                    ";", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Min",
                          "[", RowBox[{"a", ",", "b"}], "]"}], "<", "xn",
                          "<", RowBox[{"Max", "[", RowBox[{"a", ",", "b"}],
                          "]"}]}], ",", RowBox[{"If", "[", RowBox[{RowBox[
                          {RowBox[{"Abs", "[", RowBox[{"xn", "-", "x"}],
                          "]"}], "\[LessEqual]", FractionBox[RowBox[{"Max",
                          "[", RowBox[{"1", ",", RowBox[{"Abs", "[", "x",
                          "]"}]}], "]"}], SuperscriptBox["10", "10"]]}], ",",
                          RowBox[{RowBox[{"x", "=", "xn"}], ";", RowBox[
                          {"Break", "[", "]"}]}]}], "]"}], ",", RowBox[
                         {"xn", "=", FractionBox[RowBox[{"a", "+", "b"}],
                          "2"]}]}], "]"}], ";", RowBox[{"x", "=", "xn"}]}]}],
                "]"}], ";", RowBox[{"{", RowBox[{"x", ",", "iterations"}],
                "}"}]}]}], "]"}]}], ";",
      RowBox[{RowBox[{"rootInBracket", "[", RowBox[{"theta_", ",", "k_", ",",
            "s_", ",", "target_", ",", RowBox[{"{", RowBox[{"lo_", ",",
                "hi_"}], "}"}], ",", "x0_"}], "]"}], ":=",
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"flo", "=", RowBox[
                   {RowBox[{"First", "[", RowBox[{"theta", "[", RowBox[
                         {RowBox[{"N", "[", "lo", "]"}], ",", "k", ",",
                          "s"}], "]"}], "]"}], "-", "target"}]}], ",",
                RowBox[{"fhi", "=", RowBox[{RowBox[{"First", "[", RowBox[
                       {"theta", "[", RowBox[{RowBox[{"N", "[", "hi", "]"}],
                          ",", "k", ",", "s"}], "]"}], "]"}], "-",
                    "target"}]}]}], "}"}], ",", RowBox[{"If", "[",
              RowBox[{RowBox[{RowBox[{"flo", " ", "fhi"}], ">", "0"}], ",",
                RowBox[{"{", RowBox[{"$Failed", ",", "60"}], "}"}], ",",
                RowBox[{"newtonRoot", "[", RowBox[{RowBox[{RowBox[
                       {RowBox[{"theta", "[", RowBox[{"#1", ",", "k", ",",
                          "s"}], "]"}], "-", RowBox[{"{", RowBox[{"target",
                          ",", "0"}], "}"}]}], "&"}], ",", RowBox[{"{",
                      RowBox[{"lo", ",", "hi"}], "}"}], ",", RowBox[
                     {"{", RowBox[{"flo", ",", "fhi"}], "}"}], ",", "x0"}],
                  "]"}]}], "]"}]}], "]"}]}], ";",
      RowBox[{RowBox[{"groupLevels", "[", RowBox[{"theta_", ",", "ends_",
            ",", "k_", ",", "s_", ",", "parity_", ",",
            RowBox[{"{", RowBox[{"lo_", ",", "hi_"}], "}"}]}], "]"}], ":=",
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"tlo", ",",
                "thi", ",", RowBox[{"off", "=", RowBox[{"If", "[",
                    RowBox[{RowBox[{"parity", "\[Equal]", "1"}], ",", "0",
                      ",", FractionBox["\[Pi]", "2"]}], "]"}]}], ",", "ns",
                ",", "es", ",", "vals"}], "}"}], ",",
            RowBox[{RowBox[{"tlo", "=", RowBox[{"First", "[", RowBox[
                   {"theta", "[", RowBox[{RowBox[{"N", "[", "lo", "]"}], ",",
                      "k", ",", "s"}], "]"}], "]"}]}], ";", RowBox[{"thi",
                "=", RowBox[{"First", "[", RowBox[{"theta", "[", RowBox[
                     {RowBox[{"N", "[", "hi", "]"}], ",", "k", ",", "s"}],
                    "]"}], "]"}]}], ";", RowBox[{"ns", "=", RowBox[
                 {"Range", "[", RowBox[{RowBox[{"Ceiling", "[", FractionBox[
                       RowBox[{RowBox[{"Min", "[", RowBox[{"tlo", ",",
                          "thi"}], "]"}], "-", "off"}], "\[Pi]"], "]"}], ",",
                    RowBox[{"Floor", "[", FractionBox[RowBox[{RowBox[{"Max",
                          "[", RowBox[{"tlo", ",", "thi"}], "]"}], "-",
                         "off"}], "\[Pi]"], "]"}]}], "]"}]}], ";",
              RowBox[{"If", "[", RowBox[{RowBox[{"ns", "===", RowBox[
                     {"{", "}"}]}], ",", RowBox[{"Return", "[", RowBox[
                     {"{", "}"}], "]"}]}], "]"}], ";", RowBox[{"es", "=",
                RowBox[{"N", "[", RowBox[{"Subdivide", "[", RowBox[{"lo",
                      ",", "hi", ",", RowBox[{RowBox[{"Length", "[", "ns",
                          "]"}], "+", "1"}]}], "]"}], "]"}]}], ";",
              RowBox[{"vals", "=", RowBox[{"Join", "[", RowBox[
                   {RowBox[{"{", "tlo", "}"}], ",", RowBox[{RowBox[{"(",
                        RowBox[{RowBox[{"First", "[", RowBox[{"theta", "[",
                          RowBox[{"#1", ",", "k", ",", "s"}], "]"}], "]"}],
                          "&"}], ")"}], "/@", RowBox[{"es",
                        "\[LeftDoubleBracket]", RowBox[{"2", ";;", RowBox[
                          {"-", "2"}]}], "\[RightDoubleBracket]"}]}], ",",
                    RowBox[{"{", "thi", "}"}]}], "]"}]}], ";",
              RowBox[{"Table", "[", RowBox[{RowBox[{"Module", "[",
                    RowBox[{RowBox[{"{", RowBox[{RowBox[{"target", "=",
                          RowBox[{"N", "[", RowBox[{"off", "+", RowBox[{"n",
                          " ", "\[Pi]"}]}], "]"}]}], ",", "cell", ",", "x0",
                          ",", "root", ",", "e"}], "}"}], ",", RowBox[
                       {RowBox[{"cell", "=", RowBox[{"SelectFirst", "[",
                          RowBox[{RowBox[{"Range", "[", RowBox[{RowBox[
                          {"Length", "[", "es", "]"}], "-", "1"}], "]"}],
                          ",", RowBox[{RowBox[{RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"vals", "\[LeftDoubleBracket]", "#1",
                          "\[RightDoubleBracket]"}], "-", "target"}], ")"}],
                          " ", RowBox[{"(", RowBox[{RowBox[{"vals",
                          "\[LeftDoubleBracket]", RowBox[{"#1", "+", "1"}],
                          "\[RightDoubleBracket]"}], "-", "target"}],
                          ")"}]}], "\[LessEqual]", "0"}], "&"}]}], "]"}]}],
                        ";", RowBox[{"x0", "=", RowBox[{RowBox[{"es",
                          "\[LeftDoubleBracket]", "cell",
                          "\[RightDoubleBracket]"}], "+", FractionBox[RowBox[
                          {RowBox[{"(", RowBox[{"target", "-", RowBox[
                          {"vals", "\[LeftDoubleBracket]", "cell",
                          "\[RightDoubleBracket]"}]}], ")"}], " ", RowBox[
                          {"(", RowBox[{RowBox[{"es", "\[LeftDoubleBracket]",
                          RowBox[{"cell", "+", "1"}],
                          "\[RightDoubleBracket]"}], "-", RowBox[{"es",
                          "\[LeftDoubleBracket]", "cell",
                          "\[RightDoubleBracket]"}]}], ")"}]}], RowBox[
                          {RowBox[{"vals", "\[LeftDoubleBracket]", RowBox[
                          {"cell", "+", "1"}], "\[RightDoubleBracket]"}],
                          "-", RowBox[{"vals", "\[LeftDoubleBracket]",
                          "cell", "\[RightDoubleBracket]"}]}]]}]}], ";",
                        RowBox[{"root", "=", RowBox[{"newtonRoot", "[",
                          RowBox[{RowBox[{RowBox[{RowBox[{"theta", "[",
                          RowBox[{"#1", ",", "k", ",", "s"}], "]"}], "-",
                          RowBox[{"{", RowBox[{"target", ",", "0"}], "}"}]}],
                          "&"}], ",", RowBox[{"es", "\[LeftDoubleBracket]",
                          RowBox[{"{", RowBox[{"cell", ",", RowBox[{"cell",
                          "+", "1"}]}], "}"}], "\[RightDoubleBracket]"}],
                          ",", RowBox[{RowBox[{"vals",
                          "\[LeftDoubleBracket]", RowBox[{"{", RowBox[
                          {"cell", ",", RowBox[{"cell", "+", "1"}]}], "}"}],
                          "\[RightDoubleBracket]"}], "-", "target"}], ",",
                          "x0"}], "]"}]}], ";", RowBox[{"e", "=", RowBox[
                          {"ends", "[", RowBox[{RowBox[{"root",
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], ",", "k", ",", "s"}],
                          "]"}]}], ";", RowBox[{"Association", "[", RowBox[
                          {RowBox[{"\"parity\"", "\[Rule]", "parity"}], ",",
                          RowBox[{"\"s\"", "\[Rule]", "s"}], ",", RowBox[
                          {"\"index\"", "\[Rule]", "n"}], ",", RowBox[
                          {"\"eps\"", "\[Rule]", RowBox[{"root",
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}]}], ",", RowBox[
                          {"\"iterations\"", "\[Rule]", RowBox[{"root",
                          "\[LeftDoubleBracket]", "2",
                          "\[RightDoubleBracket]"}]}], ",", RowBox[
                          {"\"matching\"", "\[Rule]", FractionBox[RowBox[
                          {"If", "[", RowBox[{RowBox[{"parity", "\[Equal]",
                          "1"}], ",", RowBox[{"Abs", "[", RowBox[{"e",
                          "\[LeftDoubleBracket]", "2",
                          "\[RightDoubleBracket]"}], "]"}], ",", RowBox[
                          {"Abs", "[", RowBox[{"e", "\[LeftDoubleBracket]",
                          "1", "\[RightDoubleBracket]"}], "]"}]}], "]"}],
                          SqrtBox[RowBox[{SuperscriptBox[RowBox[{"e",
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "2"], "+",
                          SuperscriptBox[RowBox[{"e", "\[LeftDoubleBracket]",
                          "2", "\[RightDoubleBracket]"}], "2"]}]]]}], ",",
                          RowBox[{"\"scalarCharge\"", "\[Rule]", FractionBox[
                          RowBox[{"s", " ", RowBox[{"e",
                          "\[LeftDoubleBracket]", "4",
                          "\[RightDoubleBracket]"}]}], RowBox[{"e",
                          "\[LeftDoubleBracket]", "3",
                          "\[RightDoubleBracket]"}]]}], ",", RowBox[
                          {"\"pressureCharge\"", "\[Rule]", FractionBox[
                          RowBox[{"s", " ", RowBox[{"e",
                          "\[LeftDoubleBracket]", "5",
                          "\[RightDoubleBracket]"}]}], RowBox[{"e",
                          "\[LeftDoubleBracket]", "3",
                          "\[RightDoubleBracket]"}]]}]}], "]"}]}]}], "]"}],
                  ",", RowBox[{"{", RowBox[{"n", ",", "ns"}], "}"}]}],
                "]"}]}]}], "]"}]}], ";",
      RowBox[{RowBox[{"shellLevels", "[", RowBox[{"theta_", ",", "ends_",
            ",", "k_", ",", "window_"}], "]"}], ":=",
        RowBox[{"Join", "@@", RowBox[{"Flatten", "[",
            RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"groupLevels", "[",
                    RowBox[{"theta", ",", "ends", ",", "k", ",", "s", ",",
                      "parity", ",", "window"}], "]"}], ",", RowBox[
                   {"{", RowBox[{"parity", ",", RowBox[{"{", RowBox[{"1",
                          ",", RowBox[{"-", "1"}]}], "}"}]}], "}"}], ",",
                  RowBox[{"{", RowBox[{"s", ",", RowBox[{"{", RowBox[
                         {"1", ",", RowBox[{"-", "1"}]}], "}"}]}], "}"}]}],
                "]"}], ",", "1"}], "]"}]}]}], ";",
      RowBox[{RowBox[{"freePotential", "[", "mv_", "]"}], ":=",
        RowBox[{"{", RowBox[{RowBox[{RowBox[{"Evaluate", "[", RowBox[
                 {"N", "[", "mv", "]"}], "]"}], "&"}], ",",
            RowBox[{"0.`", "&"}]}], "}"}]}], ";",
      RowBox[{RowBox[{"representableShells", "[", "max_", "]"}], ":=",
        RowBox[{"Select", "[", RowBox[{RowBox[{"Range", "[", RowBox[{"0",
                ",", "max"}], "]"}], ",", RowBox[
             {RowBox[{RowBox[{"SquaresR", "[", RowBox[{"3", ",", "#1"}],
                  "]"}], ">", "0"}], "&"}]}], "]"}]}], ";",
      RowBox[{RowBox[{"fullKey", "[", "r_", "]"}], ":=",
        RowBox[{"Lookup", "[", RowBox[{"r", ",", RowBox[
             {"{", RowBox[{"\"n2\"", ",", "\"parity\"", ",", "\"s\"", ",",
                "\"index\""}], "}"}]}], "]"}]}], ";",
      RowBox[{"toolTest", "=", RowBox[{"Module", "[",
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"theta", "=", RowBox[
                   {"pruferThetaD", "[", RowBox[{RowBox[{"1.`", "&"}], ",",
                      RowBox[{"0.`", "&"}], ",", "3.`", ",", "1.`", ",",
                      "0.`", ",", "smoothOptions"}], "]"}]}], ",",
                RowBox[{"ends", "=", RowBox[{"linearEnds", "[", RowBox[
                     {RowBox[{"1.`", "&"}], ",", RowBox[{"0.`", "&"}], ",",
                      "3.`", ",", "1.`", ",", "0.`", ",", "smoothOptions"}],
                    "]"}]}], ",", "lev", ",", "fd"}], "}"}], ",",
            RowBox[{RowBox[{"lev", "=", RowBox[{"groupLevels", "[",
                  RowBox[{"theta", ",", "ends", ",", "0.`", ",", "1", ",",
                    "1", ",", RowBox[{"{", RowBox[{RowBox[{"-", "2.`"}], ",",
                        "2.`"}], "}"}]}], "]"}]}], ";", RowBox[{"fd", "=",
                FractionBox[RowBox[{RowBox[{"First", "[", RowBox[{"theta",
                       "[", RowBox[{RowBox[{RowBox[{"0.7`",
                          "\[VeryThinSpace]"}], "+", FractionBox["1",
                          SuperscriptBox["10", "5"]]}], ",", "0.5`", ",",
                         "1"}], "]"}], "]"}], "-", RowBox[{"First", "[",
                     RowBox[{"theta", "[", RowBox[{RowBox[{RowBox[{"0.7`",
                          "\[VeryThinSpace]"}], "-", FractionBox["1",
                          SuperscriptBox["10", "5"]]}], ",", "0.5`", ",",
                         "1"}], "]"}], "]"}]}], FractionBox["2",
                  SuperscriptBox["10", "5"]]]}], ";", RowBox[{"Association",
                "[", RowBox[{RowBox[{"\"levels\"", "\[Rule]", RowBox[
                     {"lev", "\[LeftDoubleBracket]", RowBox[{"All", ",",
                        "\"index\""}], "\[RightDoubleBracket]"}]}], ",",
                  RowBox[{"\"maxDeviationFromExactBox\"", "\[Rule]",
                    RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[
                         {RowBox[{"lev", "\[LeftDoubleBracket]", RowBox[
                          {"All", ",", "\"eps\""}],
                          "\[RightDoubleBracket]"}], "-", RowBox[{"N", "[",
                          RowBox[{RowBox[{"(", RowBox[{RowBox[
                          {"analyticBoxLevel", "[", RowBox[{"1", ",", "3",
                          ",", "1", ",", "1", ",", "#1"}], "]"}], "&"}],
                          ")"}], "/@", RowBox[{"lev", "\[LeftDoubleBracket]",
                          RowBox[{"All", ",", "\"index\""}],
                          "\[RightDoubleBracket]"}]}], "]"}]}], "]"}],
                      "]"}]}], ",", RowBox[
                   {"\"variationalDerivativeVsCentralDifference\"",
                    "\[Rule]", FractionBox[RowBox[{"Abs", "[", RowBox[
                        {RowBox[{"Last", "[", RowBox[{"theta", "[", RowBox[
                          {"0.7`", ",", "0.5`", ",", "1"}], "]"}], "]"}],
                         "-", "fd"}], "]"}], RowBox[{"Abs", "[", "fd",
                       "]"}]]}]}], "]"}]}]}], "]"}]}], ";", "toolTest"}]],
   "Input"], Cell["Zero-mode splitting, numerically: the parity +, index 0 \
level of each block type at small k (m = H = 1, L = 3, a4 = 0) gives the \
slope d eps/dk at k = 0 by Richardson extrapolation, (4 eps(h) - \
eps(2h))/(2h) = d eps/dk + O(h^2), h = 2e-4. The exact slope is -s c (j = \
-s).", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"zeroModeSlope", "=",
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"theta", "=", RowBox[
                   {"pruferThetaD", "[", RowBox[{RowBox[{"1.`", "&"}], ",",
                      RowBox[{"0.`", "&"}], ",", "3.`", ",", "1.`", ",",
                      "0.`", ",", "smoothOptions"}], "]"}]}], ",",
                RowBox[{"h", "=", FractionBox["2", SuperscriptBox["10",
                    "4"]]}], ",", "level"}], "}"}], ",",
            RowBox[{RowBox[{RowBox[{"level", "[", RowBox[{"k_", ",", "s_"}],
                  "]"}], ":=", RowBox[{"First", "[", RowBox[{"rootInBracket",
                    "[", RowBox[{"theta", ",", RowBox[{"N", "[", "k", "]"}],
                      ",", "s", ",", "0.`", ",", RowBox[{"{", RowBox[
                         {RowBox[{"-", "0.2`"}], ",", "0.2`"}], "}"}], ",",
                      "0.`"}], "]"}], "]"}]}], ";", RowBox[{"Association",
                "[", RowBox[{"Table", "[", RowBox[{RowBox[{"s", "\[Rule]",
                      FractionBox[RowBox[{RowBox[{"4", " ", RowBox[{"level",
                          "[", RowBox[{"h", ",", "s"}], "]"}]}], "-",
                         RowBox[{"level", "[", RowBox[{RowBox[{"2", " ",
                          "h"}], ",", "s"}], "]"}]}], RowBox[{"2", " ",
                         "h"}]]}], ",", RowBox[{"{", RowBox[{"s", ",",
                        RowBox[{"{", RowBox[{"1", ",", RowBox[{"-", "1"}]}],
                          "}"}]}], "}"}]}], "]"}], "]"}]}]}], "]"}]}], ";",
      RowBox[{"zeroModeSlopeDeviation", "=",
        RowBox[{"Max", "[", RowBox[{RowBox[{"Abs", "[", RowBox[{
                RowBox[{"zeroModeSlope", "[", "1", "]"}], "+",
                RowBox[{"N", "[", "cSplittingM1L3", "]"}]}], "]"}], ",",
            RowBox[{"Abs", "[", RowBox[{RowBox[{"zeroModeSlope", "[",
                  RowBox[{"-", "1"}], "]"}], "-", RowBox[{"N", "[",
                  "cSplittingM1L3", "]"}]}], "]"}]}], "]"}]}], ";",
      RowBox[{"{", RowBox[{"zeroModeSlope", ",",
          RowBox[{"N", "[", "cSplittingM1L3", "]"}], ",",
          "zeroModeSlopeDeviation"}], "}"}]}]], "Input"],
  Cell["The six Rust free-spectrum files are recomputed completely: every \
representable shell n2 <= 16 (lattice multiplicity g(n2) = SquaresR[3, n2], \
the number of integer vectors with n1^2 + n2^2 + n3^2 = n2), both parities, \
both block types, every level in -4m <= eps <= 4m, with k = 0.25 m sqrt(n2) \
(torus spacing Delta k = 0.25 m). The two lists are matched by the key (n2, \
parity, s, Pruefer index); a missing or extra level makes the key lists \
differ. Compared: eps, the k and multiplicity (4 g) columns, scalar_charge \
and pressure_charge; the k = 0 levels are also compared with the exact box \
levels.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"freeSpectrumRun", "[", "config_",
          "]"}], ":=", RowBox[{"Module", "[",
          RowBox[{RowBox[{"{", RowBox[{"mv", ",", "lv", ",", "t", ",", "idx",
                ",", "mF", ",", "vF", ",", "theta", ",", "ends", ",", "dk",
                ",", RowBox[{"mine", "=", RowBox[{"{", "}"}]}], ",", "rust",
                ",", "keysOK", ",", "matched"}], "}"}], ",",
            RowBox[{RowBox[{RowBox[{"{", RowBox[{"mv", ",", "lv"}], "}"}],
                "=", "config"}], ";", RowBox[{"t", "=", RowBox[{"freeTables",
                  "[", "config", "]"}]}], ";", RowBox[{"idx", "=",
                RowBox[{"t", "[", "\"index\"", "]"}]}], ";",
              RowBox[{RowBox[{"{", RowBox[{"mF", ",", "vF"}], "}"}], "=",
                RowBox[{"freePotential", "[", "mv", "]"}]}], ";",
              RowBox[{"theta", "=", RowBox[{"pruferThetaD", "[",
                  RowBox[{"mF", ",", "vF", ",", RowBox[{"N", "[", "lv",
                      "]"}], ",", "1.`", ",", "0.`", ",", "smoothOptions"}],
                  "]"}]}], ";", RowBox[{"ends", "=", RowBox[{"linearEnds",
                  "[", RowBox[{"mF", ",", "vF", ",", RowBox[{"N", "[", "lv",
                      "]"}], ",", "1.`", ",", "0.`", ",", "smoothOptions"}],
                  "]"}]}], ";", RowBox[{"dk", "=", RowBox[{"0.25`", " ",
                  "mv"}]}], ";", RowBox[{"Do", "[", RowBox[
                 {RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{"k", "=",
                          RowBox[{"dk", " ", SqrtBox[RowBox[{"N", "[", "n2",
                          "]"}]]}]}], "}"}], ",", RowBox[{"mine", "=",
                        RowBox[{"Join", "[", RowBox[{"mine", ",", RowBox[
                          {RowBox[{"(", RowBox[{RowBox[{"Join", "[", RowBox[
                          {"#1", ",", RowBox[{"Association", "[", RowBox[
                          {RowBox[{"\"n2\"", "\[Rule]", "n2"}], ",", RowBox[
                          {"\"k\"", "\[Rule]", "k"}], ",", RowBox[
                          {"\"multiplicity\"", "\[Rule]", RowBox[{"4", " ",
                          RowBox[{"SquaresR", "[", RowBox[{"3", ",", "n2"}],
                          "]"}]}]}]}], "]"}]}], "]"}], "&"}], ")"}], "/@",
                          RowBox[{"shellLevels", "[", RowBox[{"theta", ",",
                          "ends", ",", "k", ",", RowBox[{"{", RowBox[{RowBox[
                          {RowBox[{"-", "4.`"}], " ", "mv"}], ",", RowBox[
                          {"4.`", " ", "mv"}]}], "}"}]}], "]"}]}]}],
                          "]"}]}]}], "]"}], ",", RowBox[{"{", RowBox[
                     {"n2", ",", RowBox[{"representableShells", "[", "16",
                        "]"}]}], "}"}]}], "]"}], ";", RowBox[{"rust", "=",
                RowBox[{RowBox[{"(", RowBox[{RowBox[{"Association", "[",
                        RowBox[{RowBox[{"\"n2\"", "\[Rule]", RowBox[{"Round",
                          "[", RowBox[{"#1", "\[LeftDoubleBracket]", RowBox[
                          {"idx", "[", "\"n2\"", "]"}],
                          "\[RightDoubleBracket]"}], "]"}]}], ",", RowBox[
                          {"\"parity\"", "\[Rule]", RowBox[{"Round", "[",
                          RowBox[{"#1", "\[LeftDoubleBracket]", RowBox[
                          {"idx", "[", "\"parity\"", "]"}],
                          "\[RightDoubleBracket]"}], "]"}]}], ",", RowBox[
                          {"\"s\"", "\[Rule]", RowBox[{"Round", "[", RowBox[
                          {"#1", "\[LeftDoubleBracket]", RowBox[{"idx", "[",
                          "\"s\"", "]"}], "\[RightDoubleBracket]"}], "]"}]}],
                          ",", RowBox[{"\"index\"", "\[Rule]", RowBox[
                          {"Round", "[", RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"idx", "[",
                          "\"index\"", "]"}], "\[RightDoubleBracket]"}],
                          "]"}]}], ",", RowBox[{"\"eps\"", "\[Rule]", RowBox[
                          {"#1", "\[LeftDoubleBracket]", RowBox[{"idx", "[",
                          "\"eps\"", "]"}], "\[RightDoubleBracket]"}]}], ",",
                          RowBox[{"\"k\"", "\[Rule]", RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"idx", "[",
                          "\"k\"", "]"}], "\[RightDoubleBracket]"}]}], ",",
                          RowBox[{"\"multiplicity\"", "\[Rule]", RowBox[
                          {"#1", "\[LeftDoubleBracket]", RowBox[{"idx", "[",
                          "\"multiplicity\"", "]"}],
                          "\[RightDoubleBracket]"}]}], ",", RowBox[
                          {"\"scalarCharge\"", "\[Rule]", RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"idx", "[",
                          "\"scalar_charge\"", "]"}],
                          "\[RightDoubleBracket]"}]}], ",", RowBox[
                          {"\"pressureCharge\"", "\[Rule]", RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"idx", "[",
                          "\"pressure_charge\"", "]"}],
                          "\[RightDoubleBracket]"}]}]}], "]"}], "&"}], ")"}],
                  "/@", RowBox[{"t", "[", "\"rows\"", "]"}]}]}], ";",
              RowBox[{"mine", "=", RowBox[{"SortBy", "[", RowBox[{"mine",
                    ",", "fullKey"}], "]"}]}], ";", RowBox[{"rust", "=",
                RowBox[{"SortBy", "[", RowBox[{"rust", ",", "fullKey"}],
                  "]"}]}], ";", RowBox[{"keysOK", "=", RowBox[
                 {RowBox[{"fullKey", "/@", "mine"}], "===", RowBox[
                   {"fullKey", "/@", "rust"}]}]}], ";", RowBox[{"matched",
                "=", RowBox[{"If", "[", RowBox[{"keysOK", ",", TemplateBox[
                     {RowBox[{"{", RowBox[{"mine", ",", "rust"}], "}"}]},
                     "Transpose", SyntaxForm -> SuperscriptBox], ",",
                    RowBox[{"{", "}"}]}], "]"}]}], ";", RowBox[{
                "Association", "[", RowBox[{RowBox[{"\"levels\"", "\[Rule]",
                    RowBox[{"Length", "[", "mine", "]"}]}], ",",
                  RowBox[{"\"rustLevels\"", "\[Rule]", RowBox[{"Length", "[",
                      "rust", "]"}]}], ",", RowBox[{"\"keysIdentical\"",
                    "\[Rule]", "keysOK"}], ",", RowBox[
                   {"\"maxAbsDeviation\"", "\[Rule]", RowBox[{"If", "[",
                      RowBox[{"keysOK", ",", RowBox[{"Max", "[", RowBox[
                          {RowBox[{"(", RowBox[{RowBox[{"Abs", "[", RowBox[
                          {RowBox[{"#1", "\[LeftDoubleBracket]", RowBox[{"1",
                          ",", "\"eps\""}], "\[RightDoubleBracket]"}], "-",
                          RowBox[{"#1", "\[LeftDoubleBracket]", RowBox[{"2",
                          ",", "\"eps\""}], "\[RightDoubleBracket]"}]}],
                          "]"}], "&"}], ")"}], "/@", "matched"}], "]"}], ",",
                        "\[Infinity]"}], "]"}]}], ",", RowBox[
                   {"\"maxScalarChargeDeviation\"", "\[Rule]", RowBox[
                     {"If", "[", RowBox[{"keysOK", ",", RowBox[{"Max", "[",
                          RowBox[{RowBox[{"(", RowBox[{RowBox[{"Abs", "[",
                          RowBox[{RowBox[{"#1", "\[LeftDoubleBracket]",
                          RowBox[{"1", ",", "\"scalarCharge\""}],
                          "\[RightDoubleBracket]"}], "-", RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"2", ",",
                          "\"scalarCharge\""}], "\[RightDoubleBracket]"}]}],
                          "]"}], "&"}], ")"}], "/@", "matched"}], "]"}], ",",
                        "\[Infinity]"}], "]"}]}], ",", RowBox[
                   {"\"maxPressureChargeDeviation\"", "\[Rule]", RowBox[
                     {"If", "[", RowBox[{"keysOK", ",", RowBox[{"Max", "[",
                          RowBox[{RowBox[{"(", RowBox[{RowBox[{"Abs", "[",
                          RowBox[{RowBox[{"#1", "\[LeftDoubleBracket]",
                          RowBox[{"1", ",", "\"pressureCharge\""}],
                          "\[RightDoubleBracket]"}], "-", RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"2", ",",
                          "\"pressureCharge\""}],
                          "\[RightDoubleBracket]"}]}], "]"}], "&"}], ")"}],
                          "/@", "matched"}], "]"}], ",", "\[Infinity]"}],
                      "]"}]}], ",", RowBox[{"\"kColumnMaxDeviation\"",
                    "\[Rule]", RowBox[{"If", "[", RowBox[{"keysOK", ",",
                        RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"Abs", "[", RowBox[{RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"1", ",",
                          "\"k\""}], "\[RightDoubleBracket]"}], "-", RowBox[
                          {"#1", "\[LeftDoubleBracket]", RowBox[{"2", ",",
                          "\"k\""}], "\[RightDoubleBracket]"}]}], "]"}],
                          "&"}], ")"}], "/@", "matched"}], "]"}], ",",
                        "\[Infinity]"}], "]"}]}], ",", RowBox[
                   {"\"multiplicityColumnIdentical\"", "\[Rule]", RowBox[
                     {"keysOK", "&&", RowBox[{"AllTrue", "[", RowBox[
                         {"matched", ",", RowBox[{RowBox[{RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"1", ",",
                          "\"multiplicity\""}], "\[RightDoubleBracket]"}],
                          "\[Equal]", RowBox[{"#1", "\[LeftDoubleBracket]",
                          RowBox[{"2", ",", "\"multiplicity\""}],
                          "\[RightDoubleBracket]"}]}], "&"}]}], "]"}]}]}],
                  ",", RowBox[{"\"k0VsExactBoxMaxAbsDeviation\"", "\[Rule]",
                    RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                          {RowBox[{"k0", "=", RowBox[{"SortBy", "[", RowBox[
                          {RowBox[{"Select", "[", RowBox[{"mine", ",", RowBox[
                          {RowBox[{RowBox[{"#1", "[", "\"n2\"", "]"}],
                          "\[Equal]", "0"}], "&"}]}], "]"}], ",", "keyOf"}],
                          "]"}]}], ",", RowBox[{"exact", "=", RowBox[
                          {"SortBy", "[", RowBox[{RowBox[{"boxLevelsExact",
                          "[", "config", "]"}], ",", "keyOf"}], "]"}]}]}],
                          "}"}], ",", RowBox[{"If", "[", RowBox[{RowBox[
                          {RowBox[{"keyOf", "/@", "k0"}], "===", RowBox[
                          {"keyOf", "/@", "exact"}]}], ",", RowBox[{"Max",
