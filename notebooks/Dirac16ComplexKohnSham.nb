                          ",", "\[Infinity]"}], "]"}]}], "]"}]}], ",",
                  RowBox[{"\"maxMatchingResidual\"", "\[Rule]", RowBox[
                     {"Max", "[", RowBox[{"mine", "\[LeftDoubleBracket]",
                        RowBox[{"All", ",", "\"matching\""}],
                        "\[RightDoubleBracket]"}], "]"}]}], ",",
                  RowBox[{"\"maxRootIterations\"", "\[Rule]", RowBox[
                     {"Max", "[", RowBox[{"mine", "\[LeftDoubleBracket]",
                        RowBox[{"All", ",", "\"iterations\""}],
                        "\[RightDoubleBracket]"}], "]"}]}], ",",
                  RowBox[{"\"mine\"", "\[Rule]", "mine"}]}], "]"}]}]}],
          "]"}]}], ";", RowBox[{"freeSpectrumResults", "=",
        RowBox[{"AssociationMap", "[", RowBox[{"freeSpectrumRun", ",",
            "freeConfigurations"}], "]"}]}], ";",
      RowBox[{"Dataset", "[", RowBox[{"KeyMap", "[",
          RowBox[{"freeFileName", ",", RowBox[{RowBox[{"(", RowBox[
                 {RowBox[{"KeyDrop", "[", RowBox[{"#1", ",", "\"mine\""}],
                    "]"}], "&"}], ")"}], "/@", "freeSpectrumResults"}]}],
          "]"}], "]"}]}]], "Input"], Cell["Closed shells. The Rust study \
picks its particle numbers from the closed shells of the free spectrum at L = \
3 (spectrum/summary.json: closedShells_m1_L3_N_epsHomo and \
closedShells_m3_L3_N_epsHomo, also written as closed-shells-m{1,3}-L3.csv): \
the particle states (eps >= 0) sorted by eps, grouped into degenerate levels \
(|eps_j - eps_i| <= 1e-9 max(1, |eps_i|)), with the cumulative multiplicity 4 \
g(n2) recorded after each group until it exceeds 1300. Here the particle \
states are those with s (target - Theta(0)) >= 0 (equivalent to eps >= 0 by \
the monotonicity of Theta; exact for the k = 0 zero mode, where Theta(0) = 0 \
identically), computed in the window [-0.5 m, 1.7 m] over the shells n2 = 0, \
1, 2, ... until two consecutive shells have no level in the window (the \
stopping rule of the Rust code). The table is complete when its last energy \
lies inside the window and its count exceeds 1300; that no shell beyond the \
stop has a level in the window is the stopping-rule assumption (the lowest \
|eps| of a shell grows with k), supported here by the measured increase of \
the lowest particle level with n2. N_mid and N_large are the closed-shell \
numbers (N > 8) nearest 100 and 1000.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"closedShellRun", "[", "mv_", "]"}],
        ":=", RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{"mF", ",", "vF", ",", "theta", ",", "ends",
                ",", RowBox[{"window", "=", RowBox[{"{", RowBox[
                     {RowBox[{RowBox[{"-", "0.5`"}], " ", "mv"}], ",",
                      RowBox[{"1.7`", " ", "mv"}]}], "}"}]}], ",",
                RowBox[{"states", "=", RowBox[{"{", "}"}]}], ",",
                RowBox[{"empty", "=", "0"}], ",", RowBox[{"used", "=", "0"}],
                ",", "particles", ",", RowBox[{"total", "=", "0"}], ",",
                RowBox[{"table", "=", RowBox[{"{", "}"}]}], ",",
                RowBox[{"i", "=", "1"}], ",", "lowest"}], "}"}], ",",
            RowBox[{RowBox[{RowBox[{"{", RowBox[{"mF", ",", "vF"}], "}"}],
                "=", RowBox[{"freePotential", "[", "mv", "]"}]}], ";",
              RowBox[{"theta", "=", RowBox[{"pruferThetaD", "[",
                  RowBox[{"mF", ",", "vF", ",", "3.`", ",", "1.`", ",",
                    "0.`", ",", "smoothOptions"}], "]"}]}], ";",
              RowBox[{"ends", "=", RowBox[{"linearEnds", "[", RowBox[
                   {"mF", ",", "vF", ",", "3.`", ",", "1.`", ",", "0.`", ",",
                    "smoothOptions"}], "]"}]}], ";", RowBox[{"Do", "[",
                RowBox[{RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                         {RowBox[{"k", "=", RowBox[{"0.25`", " ", "mv", " ",
                          SqrtBox[RowBox[{"N", "[", "n2", "]"}]]}]}], ",",
                          "lev"}], "}"}], ",", RowBox[{RowBox[{"lev", "=",
                          RowBox[{"shellLevels", "[", RowBox[{"theta", ",",
                          "ends", ",", "k", ",", "window"}], "]"}]}], ";",
                        RowBox[{"lev", "=", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"Join", "[", RowBox[{"#1", ",", RowBox[
                          {"Association", "[", RowBox[{RowBox[{"\"n2\"",
                          "\[Rule]", "n2"}], ",", RowBox[{"\"k\"", "\[Rule]",
                          "k"}], ",", RowBox[{"\"multiplicity\"", "\[Rule]",
                          RowBox[{"4", " ", RowBox[{"SquaresR", "[", RowBox[
                          {"3", ",", "n2"}], "]"}]}]}], ",", RowBox[
                          {"\"particle\"", "\[Rule]", RowBox[{RowBox[{RowBox[
                          {"#1", "[", "\"s\"", "]"}], " ", RowBox[{"(",
                          RowBox[{RowBox[{"N", "[", RowBox[{RowBox[{"If",
                          "[", RowBox[{RowBox[{RowBox[{"#1", "[",
                          "\"parity\"", "]"}], "\[Equal]", "1"}], ",", "0",
                          ",", FractionBox["\[Pi]", "2"]}], "]"}], "+",
                          RowBox[{RowBox[{"#1", "[", "\"index\"", "]"}], " ",
                          "\[Pi]"}]}], "]"}], "-", RowBox[{"First", "[",
                          RowBox[{"theta", "[", RowBox[{"0.`", ",", "k", ",",
                          RowBox[{"#1", "[", "\"s\"", "]"}]}], "]"}],
                          "]"}]}], ")"}]}], "\[GreaterEqual]", "0"}]}]}],
                          "]"}]}], "]"}], "&"}], ")"}], "/@", "lev"}]}], ";",
                        RowBox[{"used", "++"}], ";", RowBox[{"If", "[",
                          RowBox[{RowBox[{"lev", "===", RowBox[{"{", "}"}]}],
                          ",", RowBox[{"empty", "++"}], ",", RowBox[{"empty",
                          "=", "0"}]}], "]"}], ";", RowBox[{"states", "=",
                          RowBox[{"Join", "[", RowBox[{"states", ",",
                          "lev"}], "]"}]}], ";", RowBox[{"If", "[", RowBox[
                          {RowBox[{"empty", "\[GreaterEqual]", "2"}], ",",
                          RowBox[{"Break", "[", "]"}]}], "]"}]}]}], "]"}],
                  ",", RowBox[{"{", RowBox[{"n2", ",", RowBox[
                       {"representableShells", "[", "5000", "]"}]}], "}"}]}],
                "]"}], ";", RowBox[{"particles", "=", RowBox[{"SortBy", "[",
                  RowBox[{RowBox[{"Select", "[", RowBox[{"states", ",",
                        RowBox[{RowBox[{"#1", "[", "\"particle\"", "]"}],
                          "&"}]}], "]"}], ",", RowBox[{RowBox[{"#1", "[",
                        "\"eps\"", "]"}], "&"}]}], "]"}]}], ";",
              RowBox[{"While", "[", RowBox[{RowBox[{"i", "\[LessEqual]",
                    RowBox[{"Length", "[", "particles", "]"}]}], ",",
                  RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                         {RowBox[{"e", "=", RowBox[{"particles",
                          "\[LeftDoubleBracket]", RowBox[{"i", ",",
