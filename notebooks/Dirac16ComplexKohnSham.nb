                    "closedShellComparison", "]"}], ",", RowBox[
                   {RowBox[{RowBox[{"#1", "[", "\"countsIdentical\"", "]"}],
                      "&&", RowBox[{RowBox[{"#1", "[", "\"maxAbsDeviation\"",
                          "]"}], "\[LessEqual]", FractionBox["1",
                         SuperscriptBox["10", "8"]]}], "&&", RowBox[{"#1",
                        "[", "\"csvEqualsSummary\"", "]"}], "&&", RowBox[
                       {"#1", "[", "\"complete\"", "]"}], "&&", RowBox[
                       {"#1", "[", "\"branchMatchesEpsSign\"", "]"}]}],
                    "&"}]}], "]"}]}], ",", RowBox[
             {"\"closedShellStoppingRuleSupported\"", "\[Rule]",
              RowBox[{"AllTrue", "[", RowBox[{RowBox[{"Values", "[",
                    "closedShellComparison", "]"}], ",", RowBox[
                   {RowBox[{"#1", "[",
                      "\"lowestParticleLevelIncreasesWithN2\"", "]"}],
                    "&"}]}], "]"}]}], ",", RowBox[
             {"\"closedShellNumbersEqualRust\"", "\[Rule]",
              RowBox[{RowBox[{"Values", "[", "closedShellNumbers", "]"}],
                "\[Equal]", RowBox[{"Round", "[", RowBox[{"Lookup", "[",
                    RowBox[{RowBox[{"spectrumSummary", "[", "\"reference\"",
                        "]"}], ",", RowBox[{"{", RowBox[{"\"nMid\"", ",",
                          "\"nLarge\"", ",", "\"nMidM3\""}], "}"}]}], "]"}],
                  "]"}]}]}]}], "]"}]}], ";", "shootingChecks"}]], "Input"],
  Cell["A self-consistent Kohn-Sham loop in Wolfram Language (N = 8, \
lambda_hat_2, T = 0, L = 3, m = H = 1)", "Section"],
  Cell["Parameter set: the Rust run scf/m1_L3_N8_lamp2_T0 (N = 8 particles, T \
= 0, L = 3, m = H = 1, a4 = 0, torus spacing Delta k = 0.25 m, i.e. l = 2 \
pi/(0.25 m), and the coupling lambda_hat_2 of the configuration (m, L, N) = \
(1, 3, 8) listed in spectrum/summary.json, the larger of the two couplings of \
the study, with lambda = lambda_hat/m^6). The discrete Kohn-Sham problem is \
the one the Rust code defines: the potentials M_eff(y) = m + (15/16) lambda \
S_p(y) and v_x(y) = v_v(y) = -(lambda/16) n_p(y) are tabulated on the uniform \
301-point grid of [-L, 0] and interpolated by the natural cubic spline \
(spline.rs; here an Interpolation of the node values and the spline's node \
derivatives with InterpolationOrder 3, a piecewise cubic Hermite interpolant, \
which is the natural spline itself because a cubic is fixed by its end values \
and derivatives; checked below against the explicit spline formula), clamped \
to the grid; the proper densities are n_p = e^{-6Hy} n_c and S_p = e^{-6Hy} \
S_c with the coordinate densities n_c = Sum mult w (a^2 + b^2)/l^3 and S_c = \
Sum mult w (-2 s a b)/l^3 of the normalised orbitals on the grid; the energy \
E = Sum mult w eps - Integral[(lambda/2) S_p^2 + e_x] dV_p with dV_p = \
e^{6Hy} l^3 dy and e_x = -(lambda/32)(n_p^2 + S_p^2) uses the composite \
Simpson rule on the grid (shooting.rs: simpson). These are the definitions of \
the discrete problem; the computation itself (NDSolve, root search, mixing) \
is independent. Scope: this notebook compares one self-consistent parameter \
set; the other Rust runs are cross-checked by the independent Python \
reference solver (scripts/ks_reference_solver.py, \
scripts/check_dirac16complex_kohn_sham.py), not here.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"scfLabel", "=", "\"m1_L3_N8_lamp2_T0\""}],
      ";", RowBox[{"scfRecord", "=", RowBox[{"SelectFirst", "[",
          RowBox[{RowBox[{"scfSummary", "[", "\"runs\"", "]"}], ",",
            RowBox[{RowBox[{RowBox[{"#1", "[", "\"label\"", "]"}], "===",
                "scfLabel"}], "&"}]}], "]"}]}], ";",
      RowBox[{"scfDirectory", "=", RowBox[{"FileNameJoin", "[",
          RowBox[{"{", RowBox[{"rustRoot", ",", "\"scf\"", ",", "scfLabel"}],
            "}"}], "]"}]}], ";", RowBox[{"scfRun", "=",
        RowBox[{"Import", "[", RowBox[{RowBox[{"registerSource", "[",
              RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[
                   {"scfDirectory", ",", "\"run.json\""}], "}"}], "]"}],
              "]"}], ",", "\"RawJSON\""}], "]"}]}], ";",
      RowBox[{"scfProfiles", "=", RowBox[{"readTable", "[",
          RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"scfDirectory",
                ",", "\"profiles.csv\""}], "}"}], "]"}], "]"}]}], ";",
      RowBox[{"scfLevelsTable", "=", RowBox[{"readTable", "[",
          RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"scfDirectory",
                ",", "\"levels.csv\""}], "}"}], "]"}], "]"}]}], ";",
      RowBox[{"scfHistory", "=", RowBox[{"readTable", "[",
          RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"scfDirectory",
                ",", "\"history.csv\""}], "}"}], "]"}], "]"}]}], ";",
      RowBox[{"coupling8", "=", RowBox[{"SelectFirst", "[",
          RowBox[{RowBox[{RowBox[{"spectrumSummary", "[", "\"reference\"",
                "]"}], "[", "\"couplings\"", "]"}], ",",
            RowBox[{RowBox[{RowBox[{RowBox[{"#1", "[", "\"N\"", "]"}],
                  "\[Equal]", "8"}], "&&", RowBox[{RowBox[{"#1", "[",
                    "\"m\"", "]"}], "\[Equal]", "1"}], "&&", RowBox[
                 {RowBox[{"#1", "[", "\"L\"", "]"}], "\[Equal]", "3"}]}],
              "&"}]}], "]"}]}], ";",
      RowBox[{RowBox[{"{", RowBox[{"scfMass", ",", "scfLength", ",", "scfH",
            ",", "scfA4", ",", "scfGridN", ",", "scfDk", ",", "scfLambdaHat",
            ",", "scfLambda", ",", "scfN", ",", "scfTol"}], "}"}], "=",
        RowBox[{"N", "[", RowBox[{"Lookup", "[", RowBox[
             {RowBox[{"scfRun", "[", "\"parameters\"", "]"}], ",",
              RowBox[{"{", RowBox[{"\"m\"", ",", "\"L\"", ",", "\"H\"", ",",
                  "\"a4_0\"", ",", "\"gridPoints\"", ",", "\"deltaKOverM\"",
                  ",", "\"lambdaHat\"", ",", "\"lambda\"", ",", "\"N\"", ",",
                  "\"tol\""}], "}"}]}], "]"}], "]"}]}], ";",
      RowBox[{"scfGridN", "=", RowBox[{"Round", "[", "scfGridN", "]"}]}],
      ";", RowBox[{"scfGrid", "=", RowBox[{"Table", "[",
          RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"i", "\[Equal]",
                  RowBox[{"scfGridN", "-", "1"}]}], ",", "0.`", ",",
                RowBox[{RowBox[{"-", "scfLength"}], "+", FractionBox[
                   RowBox[{"scfLength", " ", "i"}], RowBox[{"scfGridN", "-",
                     "1.`"}]]}]}], "]"}], ",", RowBox[
             {"{", RowBox[{"i", ",", "0", ",", RowBox[{"scfGridN", "-",
                  "1"}]}], "}"}]}], "]"}]}], ";",
      RowBox[{"scfDy", "=", FractionBox["scfLength",
         RowBox[{"scfGridN", "-", "1.`"}]]}], ";",
      RowBox[{"scfEll", "=", FractionBox[RowBox[{"2.`", " ", "\[Pi]"}],
         RowBox[{"scfDk", " ", "scfMass"}]]}], ";",
      RowBox[{"scfVolume", "=", SuperscriptBox["scfEll", "3"]}], ";",
      RowBox[{"scfDensityFactor", "=", RowBox[{"Exp", "[",
          RowBox[{RowBox[{"-", "6.`"}], " ", "scfH", " ", "scfGrid"}],
          "]"}]}], ";", RowBox[{RowBox[{"naturalSplineSecond", "[",
          "values_List", "]"}], ":=", RowBox[{"Module", "[",
          RowBox[{RowBox[{"{", RowBox[{"n", "=", RowBox[{"Length", "[",
                  "values", "]"}]}], "}"}], ",", RowBox[{"Join", "[",
              RowBox[{RowBox[{"{", "0.`", "}"}], ",", RowBox[{"LinearSolve",
                  "[", RowBox[{RowBox[{"SparseArray", "[", RowBox[
                       {RowBox[{"{", RowBox[{RowBox[{RowBox[{"Band", "[",
                          RowBox[{"{", RowBox[{"1", ",", "1"}], "}"}], "]"}],
                          "\[Rule]", "4.`"}], ",", RowBox[{RowBox[{"Band",
                          "[", RowBox[{"{", RowBox[{"1", ",", "2"}], "}"}],
                          "]"}], "\[Rule]", "1.`"}], ",", RowBox[{RowBox[
                          {"Band", "[", RowBox[{"{", RowBox[{"2", ",", "1"}],
                          "}"}], "]"}], "\[Rule]", "1.`"}]}], "}"}], ",",
                        RowBox[{"{", RowBox[{RowBox[{"n", "-", "2"}], ",",
                          RowBox[{"n", "-", "2"}]}], "}"}]}], "]"}], ",",
                    FractionBox[RowBox[{"6.`", " ", RowBox[{"(", RowBox[
                          {RowBox[{"values", "\[LeftDoubleBracket]", RowBox[
                          {"3", ";;", "All"}], "\[RightDoubleBracket]"}],
                          "-", RowBox[{"2", " ", RowBox[{"values",
                          "\[LeftDoubleBracket]", RowBox[{"2", ";;", RowBox[
                          {"-", "2"}]}], "\[RightDoubleBracket]"}]}], "+",
                          RowBox[{"values", "\[LeftDoubleBracket]", RowBox[
                          {"1", ";;", RowBox[{"-", "3"}]}],
                          "\[RightDoubleBracket]"}]}], ")"}]}],
                     SuperscriptBox["scfDy", "2"]]}], "]"}], ",",
                RowBox[{"{", "0.`", "}"}]}], "]"}]}], "]"}]}], ";",
      RowBox[{RowBox[{"naturalSpline", "[", "values_List", "]"}], ":=",
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"n", "=", RowBox[{"Length", "[",
                    "values", "]"}]}], ",", RowBox[{"sec", "=", RowBox[
                   {"naturalSplineSecond", "[", "values", "]"}]}], ",",
                "der", ",", "f"}], "}"}], ",", RowBox[
             {RowBox[{"der", "=", RowBox[{"Append", "[", RowBox[
                   {RowBox[{"Table", "[", RowBox[{RowBox[{FractionBox[RowBox[
                          {RowBox[{"values", "\[LeftDoubleBracket]", RowBox[
                          {"i", "+", "1"}], "\[RightDoubleBracket]"}], "-",
                          RowBox[{"values", "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}]}], "scfDy"], "-",
                          RowBox[{FractionBox["1", "6"], " ", "scfDy", " ",
                          RowBox[{"(", RowBox[{RowBox[{"2", " ", RowBox[
                          {"sec", "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}]}], "+", RowBox[{"sec",
                          "\[LeftDoubleBracket]", RowBox[{"i", "+", "1"}],
                          "\[RightDoubleBracket]"}]}], ")"}]}]}], ",",
                        RowBox[{"{", RowBox[{"i", ",", RowBox[{"n", "-",
                          "1"}]}], "}"}]}], "]"}], ",", RowBox[{FractionBox[
                       RowBox[{RowBox[{"values", "\[LeftDoubleBracket]", "n",
                          "\[RightDoubleBracket]"}], "-", RowBox[{"values",
                          "\[LeftDoubleBracket]", RowBox[{"n", "-", "1"}],
                          "\[RightDoubleBracket]"}]}], "scfDy"], "+",
                      RowBox[{FractionBox["1", "6"], " ", "scfDy", " ",
                        RowBox[{"(", RowBox[{RowBox[{"sec",
                          "\[LeftDoubleBracket]", RowBox[{"n", "-", "1"}],
                          "\[RightDoubleBracket]"}], "+", RowBox[{"2", " ",
                          RowBox[{"sec", "\[LeftDoubleBracket]", "n",
                          "\[RightDoubleBracket]"}]}]}], ")"}]}]}]}],
                  "]"}]}], ";", RowBox[{"f", "=", RowBox[{"Interpolation",
                  "[", RowBox[{TemplateBox[{RowBox[{"{", RowBox[{RowBox[
                          {"List", "/@", "scfGrid"}], ",", "values", ",",
                          "der"}], "}"}]}, "Transpose", SyntaxForm ->
                      SuperscriptBox], ",", RowBox[{"InterpolationOrder",
                      "\[Rule]", "3"}]}], "]"}]}], ";", RowBox[{"Function",
                "[", RowBox[{"y", ",", RowBox[{"f", "[", RowBox[{"Clip", "[",
                      RowBox[{"y", ",", RowBox[{"{", RowBox[{RowBox[{"-",
                          "scfLength"}], ",", "0.`"}], "}"}]}], "]"}],
                    "]"}]}], "]"}]}]}], "]"}]}], ";",
      RowBox[{RowBox[{"splineExplicit", "[", RowBox[{"values_List", ",",
            "sec_List", ",", "y_"}], "]"}], ":=",
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"i", "=", RowBox[{"Clip", "[",
                    RowBox[{RowBox[{"Floor", "[", FractionBox[RowBox[{"y",
                          "+", "scfLength"}], "scfDy"], "]"}], ",",
                      RowBox[{"{", RowBox[{"0", ",", RowBox[{RowBox[
                          {"Length", "[", "values", "]"}], "-", "2"}]}],
                        "}"}]}], "]"}]}], ",", "a", ",", "b"}], "}"}], ",",
            RowBox[{RowBox[{"a", "=", FractionBox[RowBox[{RowBox[{"-",
                     "scfLength"}], "+", RowBox[{RowBox[{"(", RowBox[
                        {"i", "+", "1"}], ")"}], " ", "scfDy"}], "-", "y"}],
                 "scfDy"]}], ";", RowBox[{"b", "=", RowBox[{"1", "-",
                  "a"}]}], ";", RowBox[{RowBox[{"a", " ", RowBox[{"values",
                    "\[LeftDoubleBracket]", RowBox[{"i", "+", "1"}],
                    "\[RightDoubleBracket]"}]}], "+", RowBox[{"b", " ",
                  RowBox[{"values", "\[LeftDoubleBracket]", RowBox[{"i", "+",
                      "2"}], "\[RightDoubleBracket]"}]}], "+",
                RowBox[{FractionBox["1", "6"], " ", RowBox[{"(", RowBox[
                     {RowBox[{RowBox[{"(", RowBox[{SuperscriptBox["a", "3"],
                          "-", "a"}], ")"}], " ", RowBox[{"sec",
                          "\[LeftDoubleBracket]", RowBox[{"i", "+", "1"}],
                          "\[RightDoubleBracket]"}]}], "+", RowBox[
                       {RowBox[{"(", RowBox[{SuperscriptBox["b", "3"], "-",
                          "b"}], ")"}], " ", RowBox[{"sec",
                          "\[LeftDoubleBracket]", RowBox[{"i", "+", "2"}],
                          "\[RightDoubleBracket]"}]}]}], ")"}], " ",
                  SuperscriptBox["scfDy", "2"]}]}]}]}], "]"}]}], ";",
      RowBox[{RowBox[{"simpsonRule", "[", "f_List", "]"}], ":=",
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"n", "=", RowBox[{"Length", "[",
                    "f", "]"}]}], ",", RowBox[{"total", "=", "0.`"}], ",",
                RowBox[{"i", "=", "1"}]}], "}"}], ",",
            RowBox[{RowBox[{"While", "[", RowBox[{RowBox[{RowBox[{"i", "+",
                      "2"}], "\[LessEqual]", "n"}], ",", RowBox[
                   {RowBox[{"total", "+=", RowBox[{FractionBox["1", "3"],
                        " ", "scfDy", " ", RowBox[{"(", RowBox[{RowBox[
                          {"f", "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}], "+", RowBox[{"4", " ",
                          RowBox[{"f", "\[LeftDoubleBracket]", RowBox[{"i",
                          "+", "1"}], "\[RightDoubleBracket]"}]}], "+",
                          RowBox[{"f", "\[LeftDoubleBracket]", RowBox[{"i",
                          "+", "2"}], "\[RightDoubleBracket]"}]}], ")"}]}]}],
                    ";", RowBox[{"i", "+=", "2"}]}]}], "]"}], ";",
              RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"i", "+", "1"}],
                    "\[LessEqual]", "n"}], ",", RowBox[{"total", "+=",
                    RowBox[{FractionBox["1", "2"], " ", "scfDy", " ",
                      RowBox[{"(", RowBox[{RowBox[{"f",
                          "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}], "+", RowBox[{"f",
                          "\[LeftDoubleBracket]", RowBox[{"i", "+", "1"}],
                          "\[RightDoubleBracket]"}]}], ")"}]}]}]}], "]"}],
              ";", "total"}]}], "]"}]}], ";",
      RowBox[{"splineTest", "=", RowBox[{"Module", "[",
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"values", "=", RowBox[
                   {RowBox[{"Sin", "[", RowBox[{"3", " ", "scfGrid"}], "]"}],
                    " ", RowBox[{"Exp", "[", "scfGrid", "]"}]}]}], ",", "f",
                ",", "sec", ",", RowBox[{"probes", "=", RowBox[{"N", "[",
                    RowBox[{"Range", "[", RowBox[{RowBox[{RowBox[{"-",
                          "scfLength"}], "+", "0.0037`"}], ",", RowBox[
                         {"-", "0.0011`"}], ",", "0.0173`"}], "]"}],
                    "]"}]}]}], "}"}], ",", RowBox[{RowBox[{"f", "=",
                RowBox[{"naturalSpline", "[", "values", "]"}]}], ";",
              RowBox[{"sec", "=", RowBox[{"naturalSplineSecond", "[",
                  "values", "]"}]}], ";", RowBox[{"Association", "[",
                RowBox[{RowBox[{"\"nodes\"", "\[Rule]", RowBox[{"Max", "[",
                      RowBox[{"Abs", "[", RowBox[{RowBox[{"f", "/@",
                          "scfGrid"}], "-", "values"}], "]"}], "]"}]}], ",",
                  RowBox[{"\"offNodes\"", "\[Rule]", RowBox[{"Max", "[",
                      RowBox[{"Abs", "[", RowBox[{RowBox[{"f", "/@",
                          "probes"}], "-", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"splineExplicit", "[", RowBox[{"values",
                          ",", "sec", ",", "#1"}], "]"}], "&"}], ")"}], "/@",
                          "probes"}]}], "]"}], "]"}]}], ",", RowBox[
                   {"\"probes\"", "\[Rule]", RowBox[{"Length", "[", "probes",
                      "]"}]}]}], "]"}]}]}], "]"}]}], ";",
      RowBox[{"scfSetupChecks", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"runIsLambdaHat2OfN8\"", "\[Rule]",
              RowBox[{RowBox[{"scfRecord", "=!=", RowBox[{"Missing", "[",
                    "\"NotFound\"", "]"}]}], "&&", RowBox[
                 {RowBox[{RowBox[{"scfRun", "[", "\"parameters\"", "]"}],
                    "[", "\"lambdaHat\"", "]"}], "\[Equal]", RowBox[
                   {"coupling8", "[", "\"lambdaHat2\"", "]"}]}], "&&",
                RowBox[{RowBox[{RowBox[{"scfRun", "[", "\"parameters\"",
                      "]"}], "[", "\"lambda\"", "]"}], "\[Equal]",
                  FractionBox[RowBox[{"coupling8", "[", "\"lambdaHat2\"",
                     "]"}], SuperscriptBox["scfMass", "6"]]}]}]}], ",",
            RowBox[{"\"runParametersAsStated\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"{", RowBox[{"scfMass", ",",
                      "scfLength", ",", "scfH", ",", "scfA4", ",", "scfDk",
                      ",", "scfN"}], "}"}], "\[Equal]", RowBox[{"{",
                    RowBox[{"1.`", ",", "3.`", ",", "1.`", ",", "0.`", ",",
                      "0.25`", ",", "8.`"}], "}"}]}], "&&", RowBox[
                 {"scfGridN", "\[Equal]", "301"}], "&&", RowBox[
                 {RowBox[{RowBox[{"scfRun", "[", "\"parameters\"", "]"}],
                    "[", "\"T\"", "]"}], "\[Equal]", "0"}], "&&",
                RowBox[{RowBox[{RowBox[{"scfRun", "[", "\"parameters\"",
                      "]"}], "[", "\"occupationSmearing\"", "]"}],
                  "\[Equal]", "0"}], "&&", RowBox[{"TrueQ", "[",
                  RowBox[{"scfRun", "[",
                    "\"exactZeroTemperatureOccupations\"", "]"}], "]"}],
                "&&", RowBox[{"TrueQ", "[", RowBox[{"scfRun", "[",
                    "\"converged\"", "]"}], "]"}]}]}], ",",
            RowBox[{"\"gridEqualsProfilesY\"", "\[Rule]",
              RowBox[{RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[
                     {"scfGrid", "-", RowBox[{"columnOf", "[", RowBox[
                         {"scfProfiles", ",", "\"y\""}], "]"}]}], "]"}],
                  "]"}], "\[LessEqual]", FractionBox["1", SuperscriptBox[
                  "10", "15"]]}]}], ",", RowBox[{"\"torusLengthEqualsRun\"",
              "\[Rule]", RowBox[{RowBox[{"Abs", "[", RowBox[{"scfEll", "-",
                    RowBox[{RowBox[{"scfRun", "[", "\"parameters\"", "]"}],
                      "[", "\"ell\"", "]"}]}], "]"}], "\[LessEqual]",
                FractionBox["scfEll", SuperscriptBox["10", "12"]]}]}], ",",
            RowBox[{"\"volumeFactorEqualsProfiles\"", "\[Rule]",
              RowBox[{RowBox[{"Max", "[", FractionBox[RowBox[{"Abs", "[",
                     RowBox[{FractionBox["1", "scfDensityFactor"], "-",
                       RowBox[{"columnOf", "[", RowBox[{"scfProfiles", ",",
                          "\"volume_factor\""}], "]"}]}], "]"}], FractionBox[
                    "1", "scfDensityFactor"]], "]"}], "\[LessEqual]",
                FractionBox["1", SuperscriptBox["10", "14"]]}]}], ",",
            RowBox[{"\"hermiteInterpolantIsNaturalSpline\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"splineTest", "[", "\"nodes\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "14"]]}], "&&", RowBox[{RowBox[{"splineTest", "[",
                    "\"offNodes\"", "]"}], "\[LessEqual]", FractionBox["1",
                   SuperscriptBox["10", "13"]]}]}]}], ",",
            RowBox[{"\"simpsonExactForCubics\"", "\[Rule]",
              RowBox[{RowBox[{"Abs", "[", RowBox[{RowBox[{"simpsonRule", "[",
                      RowBox[{SuperscriptBox["scfGrid", "3"], "-", RowBox[
                         {"2", " ", SuperscriptBox["scfGrid", "2"]}], "+",
                        "1"}], "]"}], "-", RowBox[{"(", RowBox[{"scfLength",
                        "-", FractionBox[RowBox[{"2", " ", SuperscriptBox[
                          "scfLength", "3"]}], "3"], "-", FractionBox[
                         SuperscriptBox["scfLength", "4"], "4"]}], ")"}]}],
                  "]"}], "\[LessEqual]", FractionBox["1", SuperscriptBox[
                  "10", "12"]]}]}]}], "]"}]}], ";",
      RowBox[{"{", RowBox[{"splineTest", ",", "scfSetupChecks"}], "}"}]}]],
   "Input"], Cell["The loop. Occupations: at T = 0 the aufbau fills the N = 8 \
lowest particle-branch states; in this run these are the k = 0, parity +, \
index 0 levels of the two block types (4 states each: the four blocks of each \
type; lattice multiplicity 1), the continuation of the brane zero modes. The \
loop therefore solves only these two levels in each iteration (Newton on \
Theta bracketed by the energy window of the Rust run and started at the \
eigenvalue of the previous iteration, 0 in the first); that they are the \
eight lowest particle states of the final potential, with a gap to the next \
one, is verified afterwards from the complete spectrum in the window (next \
cells). One iteration: potentials from the input densities (spline) -> the \
two levels by Pruefer shooting -> their normalised profiles (linear system, \
NDSolve with the spline options above, normalised by the accumulated \
Integral(a^2 + b^2)) sampled on the grid -> output densities. Mixing: \
Anderson (Pulay) on the pair (n_c, S_c) with beta = 0.4 and a history of 6 \
(the values of the Rust run; a different mixing converges to the same fixed \
point), starting from zero densities (the free potential). Convergence: \
max|Delta n_c|/D and max|Delta S_c|/D below 1e-12 with D = max(max|n_c|, \
max|S_c|), the Rust residual definition with a tolerance 100 times smaller \
than the Rust run's 1e-10, so that the fixed point of this loop is determined \
more tightly than the one it is compared with.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"scfPotential", "[", "dens_", "]"}],
        ":=", RowBox[{"{", RowBox[{RowBox[{"naturalSpline", "[",
              RowBox[{"scfMass", "+", RowBox[{FractionBox["15", "16"], " ",
                  "scfLambda", " ", "scfDensityFactor", " ", RowBox[
                   {"dens", "\[LeftDoubleBracket]", "2",
                    "\[RightDoubleBracket]"}]}]}], "]"}], ",",
            RowBox[{"naturalSpline", "[", RowBox[{FractionBox["1", "16"],
                " ", RowBox[{"(", RowBox[{"-", "scfLambda"}], ")"}], " ",
                "scfDensityFactor", " ", RowBox[{"dens",
                  "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
              "]"}]}], "}"}]}], ";",
      RowBox[{RowBox[{"profileOnGrid", "[", RowBox[{"pot_", ",", "k_", ",",
            "s_", ",", "eps_"}], "]"}], ":=",
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"mF", "=", RowBox[{"pot",
                    "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
                ",", RowBox[{"vF", "=", RowBox[{"pot",
                    "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}],
                ",", "sol", ",", "norm", ",", RowBox[{"us", "=",
                  RowBox[{"scfGrid", "+", "scfLength"}]}], ",", "a0", ",",
                "b0"}], "}"}], ",", RowBox[{RowBox[{"sol", "=",
                RowBox[{"NDSolveValue", "[", RowBox[{RowBox[{"{", RowBox[
                       {RowBox[{RowBox[{SuperscriptBox["aS", "\[Prime]",
                          MultilineFunction -> None], "[", "uS", "]"}],
                          "\[Equal]", RowBox[{RowBox[{RowBox[{"mF", "[",
                          RowBox[{"uS", "-", "scfLength"}], "]"}], " ",
                          RowBox[{"aS", "[", "uS", "]"}]}], "+", RowBox[
                          {RowBox[{"(", RowBox[{RowBox[{"s", " ", RowBox[
                          {"(", RowBox[{"eps", "-", RowBox[{"vF", "[", RowBox[
                          {"uS", "-", "scfLength"}], "]"}]}], ")"}]}], "-",
                          RowBox[{RowBox[{"Exp", "[", RowBox[{RowBox[{RowBox[
                          {"-", "scfH"}], " ", RowBox[{"(", RowBox[{"uS",
                          "-", "scfLength"}], ")"}]}], "-", "scfA4"}], "]"}],
                          " ", "k"}]}], ")"}], " ", RowBox[{"bS", "[", "uS",
                          "]"}]}]}]}], ",", RowBox[{RowBox[{SuperscriptBox[
                          "bS", "\[Prime]", MultilineFunction -> None], "[",
                          "uS", "]"}], "\[Equal]", RowBox[{RowBox[{RowBox[
                          {"-", RowBox[{"(", RowBox[{RowBox[{"s", " ", RowBox[
                          {"(", RowBox[{"eps", "-", RowBox[{"vF", "[", RowBox[
                          {"uS", "-", "scfLength"}], "]"}]}], ")"}]}], "+",
                          RowBox[{RowBox[{"Exp", "[", RowBox[{RowBox[{RowBox[
                          {"-", "scfH"}], " ", RowBox[{"(", RowBox[{"uS",
                          "-", "scfLength"}], ")"}]}], "-", "scfA4"}], "]"}],
                          " ", "k"}]}], ")"}]}], " ", RowBox[{"aS", "[",
                          "uS", "]"}]}], "-", RowBox[{RowBox[{"mF", "[",
                          RowBox[{"uS", "-", "scfLength"}], "]"}], " ",
                          RowBox[{"bS", "[", "uS", "]"}]}]}]}], ",",
                        RowBox[{RowBox[{SuperscriptBox["nS", "\[Prime]",
                          MultilineFunction -> None], "[", "uS", "]"}],
                          "\[Equal]", RowBox[{SuperscriptBox[RowBox[{"aS",
                          "[", "uS", "]"}], "2"], "+", SuperscriptBox[RowBox[
                          {"bS", "[", "uS", "]"}], "2"]}]}], ",", RowBox[
                         {RowBox[{"aS", "[", "0", "]"}], "\[Equal]", "1"}],
                        ",", RowBox[{RowBox[{"bS", "[", "0", "]"}],
                          "\[Equal]", "0"}], ",", RowBox[{RowBox[{"nS", "[",
                          "0", "]"}], "\[Equal]", "0"}]}], "}"}], ",",
                    RowBox[{"{", RowBox[{"aS", ",", "bS", ",", "nS"}], "}"}],
                    ",", RowBox[{"{", RowBox[{"uS", ",", "0", ",",
                        "scfLength"}], "}"}], ",", RowBox[{"Sequence", "@@",
                      "splineOptions"}], ",", RowBox[{"MaxSteps", "\[Rule]",
                      "\[Infinity]"}], ",", RowBox[{"InterpolationOrder",
                      "\[Rule]", "All"}]}], "]"}]}], ";", RowBox[{"norm",
                "=", RowBox[{RowBox[{"sol", "\[LeftDoubleBracket]", "3",
                    "\[RightDoubleBracket]"}], "[", "scfLength", "]"}]}],
              ";", RowBox[{RowBox[{"{", RowBox[{"a0", ",", "b0"}], "}"}],
                "=", RowBox[{"{", RowBox[{RowBox[{RowBox[{"sol",
                        "\[LeftDoubleBracket]", "1",
                        "\[RightDoubleBracket]"}], "[", "scfLength", "]"}],
                    ",", RowBox[{RowBox[{"sol", "\[LeftDoubleBracket]", "2",
                        "\[RightDoubleBracket]"}], "[", "scfLength", "]"}]}],
                  "}"}]}], ";", RowBox[{"Association", "[", RowBox[
                 {RowBox[{"\"a\"", "\[Rule]", FractionBox[RowBox[
                      {RowBox[{"sol", "\[LeftDoubleBracket]", "1",
                         "\[RightDoubleBracket]"}], "/@", "us"}], SqrtBox[
                      "norm"]]}], ",", RowBox[{"\"b\"", "\[Rule]",
                    FractionBox[RowBox[{RowBox[{"sol",
                         "\[LeftDoubleBracket]", "2",
                         "\[RightDoubleBracket]"}], "/@", "us"}], SqrtBox[
                      "norm"]]}], ",", RowBox[{"\"matching\"", "\[Rule]",
                    FractionBox[RowBox[{"Abs", "[", "b0", "]"}], SqrtBox[
                      RowBox[{SuperscriptBox["a0", "2"], "+", SuperscriptBox[
                         "b0", "2"]}]]]}]}], "]"}]}]}], "]"}]}], ";",
      RowBox[{"scfWindow", "=", RowBox[{"N", "[",
          RowBox[{"{", RowBox[{RowBox[{"scfRun", "[", "\"windowLo\"", "]"}],
              ",", RowBox[{"scfRun", "[", "\"windowHi\"", "]"}]}], "}"}],
          "]"}]}], ";", RowBox[{RowBox[{"scfOutput", "[",
          RowBox[{"dens_", ",", "start_List"}], "]"}], ":=",
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"pot", "=", RowBox[{"scfPotential",
                    "[", "dens", "]"}]}], ",", "theta", ",", "roots", ",",
                "profiles", ",", "nc", ",", "sc"}], "}"}], ",",
            RowBox[{RowBox[{"theta", "=", RowBox[{"pruferThetaD", "[",
                  RowBox[{RowBox[{"pot", "\[LeftDoubleBracket]", "1",
                      "\[RightDoubleBracket]"}], ",", RowBox[{"pot",
                      "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
                    ",", "scfLength", ",", "scfH", ",", "scfA4", ",",
                    "splineOptions"}], "]"}]}], ";", RowBox[{"roots", "=",
                RowBox[{"MapThread", "[", RowBox[{RowBox[{RowBox[
                       {"rootInBracket", "[", RowBox[{"theta", ",", "0.`",
                          ",", "#1", ",", "0.`", ",", "scfWindow", ",",
                          "#2"}], "]"}], "&"}], ",", RowBox[{"{", RowBox[
                       {RowBox[{"{", RowBox[{"1", ",", RowBox[{"-", "1"}]}],
                          "}"}], ",", "start"}], "}"}]}], "]"}]}], ";",
              RowBox[{"profiles", "=", RowBox[{"MapThread", "[",
                  RowBox[{RowBox[{RowBox[{"profileOnGrid", "[", RowBox[
                         {"pot", ",", "0.`", ",", "#1", ",", "#2"}], "]"}],
                      "&"}], ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[
                          {"1", ",", RowBox[{"-", "1"}]}], "}"}], ",",
                        RowBox[{"roots", "\[LeftDoubleBracket]", RowBox[
                          {"All", ",", "1"}], "\[RightDoubleBracket]"}]}],
                      "}"}]}], "]"}]}], ";", RowBox[{"nc", "=", FractionBox[
                 RowBox[{UnderoverscriptBox["\[Sum]", "j", "2"], RowBox[
                    {"4.`", " ", RowBox[{"(", RowBox[{SuperscriptBox[RowBox[
                          {RowBox[{"profiles", "\[LeftDoubleBracket]", "j",
                          "\[RightDoubleBracket]"}], "[", "\"a\"", "]"}],
                          "2"], "+", SuperscriptBox[RowBox[{RowBox[
                          {"profiles", "\[LeftDoubleBracket]", "j",
                          "\[RightDoubleBracket]"}], "[", "\"b\"", "]"}],
                          "2"]}], ")"}]}]}], "scfVolume"]}], ";",
              RowBox[{"sc", "=", FractionBox[RowBox[{UnderoverscriptBox[
                    "\[Sum]", "j", "2"], RowBox[{"4.`", " ", RowBox[
                      {"(", RowBox[{RowBox[{"-", "2"}], " ", RowBox[
                          {RowBox[{"{", RowBox[{"1", ",", RowBox[{"-",
                          "1"}]}], "}"}], "\[LeftDoubleBracket]", "j",
                          "\[RightDoubleBracket]"}], " ", RowBox[{RowBox[
                          {"profiles", "\[LeftDoubleBracket]", "j",
                          "\[RightDoubleBracket]"}], "[", "\"a\"", "]"}],
                         " ", RowBox[{RowBox[{"profiles",
                          "\[LeftDoubleBracket]", "j",
                          "\[RightDoubleBracket]"}], "[", "\"b\"", "]"}]}],
                       ")"}]}]}], "scfVolume"]}], ";", RowBox[{"Association",
                "[", RowBox[{RowBox[{"\"eps\"", "\[Rule]", RowBox[{"roots",
                      "\[LeftDoubleBracket]", RowBox[{"All", ",", "1"}],
                      "\[RightDoubleBracket]"}]}], ",", RowBox[
                   {"\"rootIterations\"", "\[Rule]", RowBox[{"roots",
                      "\[LeftDoubleBracket]", RowBox[{"All", ",", "2"}],
                      "\[RightDoubleBracket]"}]}], ",", RowBox[
                   {"\"profiles\"", "\[Rule]", "profiles"}], ",",
                  RowBox[{"\"densities\"", "\[Rule]", RowBox[{"{", RowBox[
                       {"nc", ",", "sc"}], "}"}]}], ",", RowBox[
                   {"\"potential\"", "\[Rule]", "pot"}]}], "]"}]}]}],
          "]"}]}], ";", RowBox[{RowBox[{"andersonStep", "[",
          RowBox[{"history_", ",", "x_", ",", "r_", ",", "beta_"}], "]"}],
        ":=", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Length", "[",
                "history", "]"}], "<", "2"}], ",",
            RowBox[{"x", "+", RowBox[{"beta", " ", "r"}]}], ",",
            RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                   {RowBox[{"dX", "=", RowBox[{"Differences", "[", RowBox[
                         {"history", "\[LeftDoubleBracket]", RowBox[{"All",
                          ",", "1"}], "\[RightDoubleBracket]"}], "]"}]}],
                    ",", RowBox[{"dF", "=", RowBox[{"Differences", "[",
                        RowBox[{"history", "\[LeftDoubleBracket]", RowBox[
                          {"All", ",", "2"}], "\[RightDoubleBracket]"}],
                        "]"}]}], ",", "g"}], "}"}], ",", RowBox[
                 {RowBox[{"g", "=", RowBox[{"LeastSquares", "[", RowBox[
                       {TemplateBox[{"dF"}, "Transpose", SyntaxForm ->
                          SuperscriptBox], ",", "r"}], "]"}]}], ";",
                  RowBox[{"x", "+", RowBox[{"beta", " ", "r"}], "-",
                    RowBox[{TemplateBox[{RowBox[{"(", RowBox[{"dX", "+",
                          RowBox[{"beta", " ", "dF"}]}], ")"}]}, "Transpose",
                       SyntaxForm -> SuperscriptBox], ".", "g"}]}]}]}],
              "]"}]}], "]"}]}], ";", RowBox[{"scfInput", "=",
        RowBox[{"{", RowBox[{RowBox[{"ConstantArray", "[", RowBox[{"0.`",
                ",", "scfGridN"}], "]"}], ",", RowBox[{"ConstantArray", "[",
              RowBox[{"0.`", ",", "scfGridN"}], "]"}]}], "}"}]}], ";",
      RowBox[{"scfMixHistory", "=", RowBox[{"{", "}"}]}], ";",
      RowBox[{"scfResiduals", "=", RowBox[{"{", "}"}]}], ";",
      RowBox[{"scfConverged", "=", "False"}], ";",
      RowBox[{"scfStart", "=", RowBox[{"{", RowBox[{"0.`", ",", "0.`"}],
          "}"}]}], ";", RowBox[{"scfRootIterations", "=",
        RowBox[{"{", "}"}]}], ";", RowBox[{"Do", "[",
        RowBox[{RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                 {RowBox[{"out", "=", RowBox[{"scfOutput", "[", RowBox[
                       {"scfInput", ",", "scfStart"}], "]"}]}], ",",
                  RowBox[{"x", "=", RowBox[{"Flatten", "[", "scfInput",
                      "]"}]}], ",", "r", ",", "scale", ",", "resN", ",",
                  "resS"}], "}"}], ",", RowBox[{RowBox[{"scfStart", "=",
                  RowBox[{"out", "[", "\"eps\"", "]"}]}], ";",
                RowBox[{"scfRootIterations", "=", RowBox[{"Join", "[",
                    RowBox[{"scfRootIterations", ",", RowBox[{"out", "[",
                        "\"rootIterations\"", "]"}]}], "]"}]}], ";",
                RowBox[{"r", "=", RowBox[{RowBox[{"Flatten", "[", RowBox[
                       {"out", "[", "\"densities\"", "]"}], "]"}], "-",
                    "x"}]}], ";", RowBox[{"scale", "=", RowBox[{"Max", "[",
                    RowBox[{RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[
                          {RowBox[{"out", "[", "\"densities\"", "]"}],
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "]"}], "]"}], ",",
                      RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[
                          {RowBox[{"out", "[", "\"densities\"", "]"}],
                          "\[LeftDoubleBracket]", "2",
                          "\[RightDoubleBracket]"}], "]"}], "]"}]}], "]"}]}],
                ";", RowBox[{"resN", "=", FractionBox[RowBox[{"Max", "[",
                     RowBox[{"Abs", "[", RowBox[{RowBox[{RowBox[{"out", "[",
                          "\"densities\"", "]"}], "\[LeftDoubleBracket]",
                          "1", "\[RightDoubleBracket]"}], "-", RowBox[
                          {"scfInput", "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}]}], "]"}], "]"}],
                   "scale"]}], ";", RowBox[{"resS", "=", FractionBox[
                   RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[
                        {RowBox[{RowBox[{"out", "[", "\"densities\"", "]"}],
                          "\[LeftDoubleBracket]", "2",
                          "\[RightDoubleBracket]"}], "-", RowBox[{"scfInput",
                          "\[LeftDoubleBracket]", "2",
                          "\[RightDoubleBracket]"}]}], "]"}], "]"}],
                   "scale"]}], ";", RowBox[{"AppendTo", "[", RowBox[
                   {"scfResiduals", ",", RowBox[{"{", RowBox[{"iteration",
                        ",", "resN", ",", "resS"}], "}"}]}], "]"}], ";",
                RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"resN", "<",
                        FractionBox["1", SuperscriptBox["10", "12"]]}], "&&",
                      RowBox[{"resS", "<", FractionBox["1", SuperscriptBox[
                          "10", "12"]]}]}], ",", RowBox[{RowBox[
                       {"scfConverged", "=", "True"}], ";", RowBox[{"Break",
                        "[", "]"}]}]}], "]"}], ";", RowBox[{"scfMixHistory",
                  "=", RowBox[{"Take", "[", RowBox[{RowBox[{"Append", "[",
                        RowBox[{"scfMixHistory", ",", RowBox[{"{", RowBox[
                          {"x", ",", "r"}], "}"}]}], "]"}], ",", RowBox[
                       {"-", RowBox[{"Min", "[", RowBox[{RowBox[{RowBox[
                          {"Length", "[", "scfMixHistory", "]"}], "+", "1"}],
                          ",", "7"}], "]"}]}]}], "]"}]}], ";",
                RowBox[{"scfInput", "=", RowBox[{"Partition", "[",
                    RowBox[{RowBox[{"andersonStep", "[", RowBox[
                         {"scfMixHistory", ",", "x", ",", "r", ",", "0.4`"}],
                        "]"}], ",", "scfGridN"}], "]"}]}]}]}], "]"}], ",",
          RowBox[{"{", RowBox[{"iteration", ",", "0", ",", "80"}], "}"}]}],
        "]"}], ";", RowBox[{"scfFinal", "=", RowBox[{"scfOutput", "[",
          RowBox[{"scfInput", ",", "scfStart"}], "]"}]}], ";",
      RowBox[{"{", RowBox[{"scfConverged", ",", RowBox[{"Length", "[",
            "scfResiduals", "]"}], ",", RowBox[{"scfResiduals",
            "\[LeftDoubleBracket]", RowBox[{"-", "1"}],
            "\[RightDoubleBracket]"}], ",", RowBox[{"scfFinal", "[",
            "\"eps\"", "]"}]}], "}"}]}]], "Input"],
  Cell["Comparison with the Rust run (run.json, profiles.csv). The potentials \
are compared on the grid with a tolerance set by the convergence criterion of \
the two loops: both stop when the coordinate densities change by less than \
tol D (Rust tol = 1e-10), which the factor e^{6HL} of the proper densities \
amplifies at the tip, so the admissible difference of M_eff is 10 (15/16) \
|lambda| e^{6HL} tol D and that of v_x is 10 (|lambda|/16) e^{6HL} tol D \
(factor 10 as margin). Densities are compared relative to D (the residual \
scale of the loops). Eigenvalues and energies are compared absolutely with \
1e-9. The Rust HOMO profile (homo_a, homo_b) is the orbital of the first \
state of the degenerate highest occupied group in the Rust ordering; the two \
block types are degenerate at k = 0 with profiles (a, b) and (a, -b) (the s = \
-1 equation at k = 0 is the s = +1 equation with b -> -b), so it is compared \
with both and the matching type is reported.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"scfPot", "=",
        RowBox[{"scfFinal", "[", "\"potential\"", "]"}]}], ";",
      RowBox[{"scfMeff", "=", RowBox[
         {RowBox[{"scfPot", "\[LeftDoubleBracket]", "1",
            "\[RightDoubleBracket]"}], "/@", "scfGrid"}]}], ";",
      RowBox[{"scfVx", "=", RowBox[{RowBox[{"scfPot", "\[LeftDoubleBracket]",
            "2", "\[RightDoubleBracket]"}], "/@", "scfGrid"}]}], ";",
      RowBox[{RowBox[{"{", RowBox[{"scfNc", ",", "scfSc"}], "}"}], "=",
        RowBox[{"scfFinal", "[", "\"densities\"", "]"}]}], ";",
      RowBox[{"scfNp", "=", RowBox[{"scfDensityFactor", " ", "scfNc"}]}],
      ";", RowBox[{"scfSp", "=", RowBox[{"scfDensityFactor", " ",
          "scfSc"}]}], ";", RowBox[{"scfScale", "=",
        RowBox[{"Max", "[", RowBox[{RowBox[{"Max", "[", RowBox[{"Abs", "[",
                "scfNc", "]"}], "]"}], ",", RowBox[{"Max", "[",
              RowBox[{"Abs", "[", "scfSc", "]"}], "]"}]}], "]"}]}], ";",
      RowBox[{"scfKsSum", "=", RowBox[{"4.`", " ",
          RowBox[{"Total", "[", RowBox[{"scfFinal", "[", "\"eps\"", "]"}],
            "]"}]}]}], ";", RowBox[{"scfHartree", "=",
        RowBox[{"simpsonRule", "[", FractionBox[RowBox[{"scfLambda", " ",
             SuperscriptBox["scfSp", "2"], " ", "scfVolume"}],
           RowBox[{"2", " ", "scfDensityFactor"}]], "]"}]}], ";",
      RowBox[{"scfExchange", "=", RowBox[{"simpsonRule", "[",
          RowBox[{"-", FractionBox[RowBox[{"scfLambda", " ", RowBox[
                {"(", RowBox[{SuperscriptBox["scfNp", "2"], "+",
                   SuperscriptBox["scfSp", "2"]}], ")"}], " ", "scfVolume"}],
             RowBox[{"32", " ", "scfDensityFactor"}]]}], "]"}]}], ";",
      RowBox[{"scfEnergy", "=", RowBox[{"scfKsSum", "-", "scfHartree", "-",
          "scfExchange"}]}], ";", RowBox[{"scfLs", "=",
        RowBox[{FractionBox[RowBox[{"scfLambda", " ", SuperscriptBox["scfSp",
              "2"]}], "2"], "-", RowBox[{FractionBox["1", "32"], " ",
            "scfLambda", " ", RowBox[{"(", RowBox[{SuperscriptBox["scfNp",
                 "2"], "+", SuperscriptBox["scfSp", "2"]}], ")"}]}]}]}], ";",
      RowBox[{"potentialBoundM", "=", RowBox[{FractionBox["10", "16"], " ",
          "15", " ", RowBox[{"Abs", "[", "scfLambda", "]"}], " ",
          RowBox[{"Exp", "[", RowBox[{"6", " ", "scfH", " ", "scfLength"}],
            "]"}], " ", "scfTol", " ", "scfScale"}]}], ";",
      RowBox[{"potentialBoundV", "=", RowBox[{FractionBox["10", "16"], " ",
          RowBox[{"Abs", "[", "scfLambda", "]"}], " ",
          RowBox[{"Exp", "[", RowBox[{"6", " ", "scfH", " ", "scfLength"}],
            "]"}], " ", "scfTol", " ", "scfScale"}]}], ";",
      RowBox[{RowBox[{"homoDistance", "[", "j_", "]"}], ":=",
        RowBox[{"Max", "[", RowBox[{RowBox[{"Abs", "[", RowBox[{
                RowBox[{RowBox[{RowBox[{"scfFinal", "[", "\"profiles\"",
                      "]"}], "\[LeftDoubleBracket]", "j",
                    "\[RightDoubleBracket]"}], "[", "\"a\"", "]"}], "-",
                RowBox[{"columnOf", "[", RowBox[{"scfProfiles", ",",
                    "\"homo_a\""}], "]"}]}], "]"}], ",",
            RowBox[{"Abs", "[", RowBox[{RowBox[{RowBox[{RowBox[{"scfFinal",
                      "[", "\"profiles\"", "]"}], "\[LeftDoubleBracket]",
                    "j", "\[RightDoubleBracket]"}], "[", "\"b\"", "]"}], "-",
                RowBox[{"columnOf", "[", RowBox[{"scfProfiles", ",",
                    "\"homo_b\""}], "]"}]}], "]"}]}], "]"}]}], ";",
      RowBox[{"scfComparison", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"iterations\"", "\[Rule]", RowBox[{"Length", "[",
                "scfResiduals", "]"}]}], ",", RowBox[{"\"finalResidualN\"",
              "\[Rule]", RowBox[{"scfResiduals", "\[LeftDoubleBracket]",
                RowBox[{RowBox[{"-", "1"}], ",", "2"}],
                "\[RightDoubleBracket]"}]}], ",",
            RowBox[{"\"finalResidualS\"", "\[Rule]", RowBox[{"scfResiduals",
                "\[LeftDoubleBracket]", RowBox[{RowBox[{"-", "1"}], ",",
                  "3"}], "\[RightDoubleBracket]"}]}], ",",
            RowBox[{"\"rustIterations\"", "\[Rule]", RowBox[{"scfRun", "[",
                "\"iterations\"", "]"}]}], ",", RowBox[
             {"\"rustFinalResidualN\"", "\[Rule]", RowBox[{"scfRun", "[",
                "\"finalResidualN\"", "]"}]}], ",",
            RowBox[{"\"rustFinalResidualS\"", "\[Rule]", RowBox[{"scfRun",
                "[", "\"finalResidualS\"", "]"}]}], ",",
            RowBox[{"\"epsHomo\"", "\[Rule]", RowBox[{"First", "[",
                RowBox[{"scfFinal", "[", "\"eps\"", "]"}], "]"}]}], ",",
            RowBox[{"\"rustEpsHomo\"", "\[Rule]", RowBox[{"scfRun", "[",
                "\"epsHomo\"", "]"}]}], ",", RowBox[{"\"epsHomoDeviation\"",
              "\[Rule]", RowBox[{"Max", "[", RowBox[{"Abs", "[",
                  RowBox[{RowBox[{"scfFinal", "[", "\"eps\"", "]"}], "-",
                    RowBox[{"scfRun", "[", "\"epsHomo\"", "]"}]}], "]"}],
                "]"}]}], ",", RowBox[{"\"muDeviation\"", "\[Rule]",
              RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[
                   {RowBox[{"scfFinal", "[", "\"eps\"", "]"}], "-",
                    RowBox[{"scfRun", "[", "\"mu\"", "]"}]}], "]"}], "]"}]}],
            ",", RowBox[{"\"blockTypeSplitting\"", "\[Rule]",
              RowBox[{"Abs", "[", RowBox[{RowBox[{RowBox[{"scfFinal", "[",
                      "\"eps\"", "]"}], "\[LeftDoubleBracket]", "1",
                    "\[RightDoubleBracket]"}], "-", RowBox[{RowBox[
                     {"scfFinal", "[", "\"eps\"", "]"}],
                    "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}],
                "]"}]}], ",", RowBox[{"\"energy\"", "\[Rule]", "scfEnergy"}],
            ",", RowBox[{"\"rustEnergy\"", "\[Rule]", RowBox[{"scfRun", "[",
                "\"energy\"", "]"}]}], ",", RowBox[{"\"energyDeviation\"",
              "\[Rule]", RowBox[{"Abs", "[", RowBox[{"scfEnergy", "-",
                  RowBox[{"scfRun", "[", "\"energy\"", "]"}]}], "]"}]}], ",",
            RowBox[{"\"ksSumDeviation\"", "\[Rule]", RowBox[{"Abs", "[",
                RowBox[{"scfKsSum", "-", RowBox[{"scfRun", "[", "\"ksSum\"",
                    "]"}]}], "]"}]}], ",", RowBox[{"\"hartreeDeviation\"",
              "\[Rule]", RowBox[{"Abs", "[", RowBox[{"scfHartree", "-",
                  RowBox[{"scfRun", "[", "\"hartreeEnergy\"", "]"}]}],
                "]"}]}], ",", RowBox[{"\"exchangeDeviation\"", "\[Rule]",
              RowBox[{"Abs", "[", RowBox[{"scfExchange", "-", RowBox[
                   {"scfRun", "[", "\"exchangeEnergy\"", "]"}]}], "]"}]}],
            ",", RowBox[{"\"freeEnergyDeviation\"", "\[Rule]",
              RowBox[{"Abs", "[", RowBox[{"scfEnergy", "-", RowBox[
                   {"scfRun", "[", "\"freeEnergy\"", "]"}]}], "]"}]}], ",",
            RowBox[{"\"grandPotentialDeviation\"", "\[Rule]",
              RowBox[{"Abs", "[", RowBox[{"scfEnergy", "-", RowBox[
                   {"scfN", " ", RowBox[{"First", "[", RowBox[{"scfFinal",
                        "[", "\"eps\"", "]"}], "]"}]}], "-", RowBox[
                   {"scfRun", "[", "\"grandPotential\"", "]"}]}], "]"}]}],
            ",", RowBox[{"\"nFromDensityDeviation\"", "\[Rule]",
              RowBox[{"Abs", "[", RowBox[{RowBox[{"scfVolume", " ",
                    RowBox[{"simpsonRule", "[", "scfNc", "]"}]}], "-",
                  RowBox[{"scfRun", "[", "\"nFromDensity\"", "]"}]}],
                "]"}]}], ",", RowBox[{"\"mEffMaxAbsDeviation\"", "\[Rule]",
              RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[{"scfMeff", "-",
                    RowBox[{"columnOf", "[", RowBox[{"scfProfiles", ",",
                        "\"M_eff\""}], "]"}]}], "]"}], "]"}]}], ",",
            RowBox[{"\"mEffTolerance\"", "\[Rule]", "potentialBoundM"}], ",",
            RowBox[{"\"vxMaxAbsDeviation\"", "\[Rule]", RowBox[{"Max", "[",
                RowBox[{"Abs", "[", RowBox[{"scfVx", "-", RowBox[{"columnOf",
                      "[", RowBox[{"scfProfiles", ",", "\"v_x\""}], "]"}]}],
                  "]"}], "]"}]}], ",", RowBox[{"\"vxTolerance\"", "\[Rule]",
              "potentialBoundV"}], ",", RowBox[{"\"mEffMinusMRange\"",
              "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"Min", "[", RowBox[
                     {"scfMeff", "-", "scfMass"}], "]"}], ",", RowBox[
                   {"Max", "[", RowBox[{"scfMeff", "-", "scfMass"}], "]"}]}],
                "}"}]}], ",", RowBox[{"\"vxRange\"", "\[Rule]",
              RowBox[{"{", RowBox[{RowBox[{"Min", "[", "scfVx", "]"}], ",",
                  RowBox[{"Max", "[", "scfVx", "]"}]}], "}"}]}], ",",
            RowBox[{"\"ncMaxDeviationOverD\"", "\[Rule]", FractionBox[RowBox[
                {"Max", "[", RowBox[{"Abs", "[", RowBox[{"scfNc", "-",
                     RowBox[{"columnOf", "[", RowBox[{"scfProfiles", ",",
                         "\"n_c\""}], "]"}]}], "]"}], "]"}], "scfScale"]}],
            ",", RowBox[{"\"scMaxDeviationOverD\"", "\[Rule]",
              FractionBox[RowBox[{"Max", "[", RowBox[{"Abs", "[",
                   RowBox[{"scfSc", "-", RowBox[{"columnOf", "[", RowBox[
                        {"scfProfiles", ",", "\"S_c\""}], "]"}]}], "]"}],
                 "]"}], "scfScale"]}], ",", RowBox[
             {"\"npMaxRelativeDeviation\"", "\[Rule]", FractionBox[RowBox[
                {"Max", "[", RowBox[{"Abs", "[", RowBox[{"scfNp", "-",
                     RowBox[{"columnOf", "[", RowBox[{"scfProfiles", ",",
                         "\"n_p\""}], "]"}]}], "]"}], "]"}], RowBox[
                {"Max", "[", RowBox[{"Abs", "[", "scfNp", "]"}], "]"}]]}],
            ",", RowBox[{"\"spMaxRelativeDeviation\"", "\[Rule]",
              FractionBox[RowBox[{"Max", "[", RowBox[{"Abs", "[",
                   RowBox[{"scfSp", "-", RowBox[{"columnOf", "[", RowBox[
                        {"scfProfiles", ",", "\"S_p\""}], "]"}]}], "]"}],
                 "]"}], RowBox[{"Max", "[", RowBox[{"Abs", "[", "scfSp",
                   "]"}], "]"}]]}], ",", RowBox[
             {"\"lsMaxRelativeDeviation\"", "\[Rule]", FractionBox[RowBox[
                {"Max", "[", RowBox[{"Abs", "[", RowBox[{"scfLs", "-",
                     RowBox[{"columnOf", "[", RowBox[{"scfProfiles", ",",
                         "\"L_s\""}], "]"}]}], "]"}], "]"}], RowBox[
                {"Max", "[", RowBox[{"Abs", "[", "scfLs", "]"}], "]"}]]}],
            ",", RowBox[{"\"maxLambdaSOverMDeviation\"", "\[Rule]",
              RowBox[{"Abs", "[", RowBox[{FractionBox[RowBox[{"Max", "[",
                     RowBox[{"Abs", "[", RowBox[{"scfLambda", " ", "scfSp"}],
                       "]"}], "]"}], "scfMass"], "-", RowBox[{"scfRun", "[",
                    "\"maxLambdaSOverM\"", "]"}]}], "]"}]}], ",",
            RowBox[{"\"maxVxOverMDeviation\"", "\[Rule]", RowBox[{"Abs", "[",
                RowBox[{FractionBox[RowBox[{"Max", "[", RowBox[{"Abs", "[",
                       "scfVx", "]"}], "]"}], "scfMass"], "-", RowBox[
                   {"scfRun", "[", "\"maxVxOverM\"", "]"}]}], "]"}]}], ",",
            RowBox[{"\"homoProfileBlockType\"", "\[Rule]", RowBox[{"If", "[",
                RowBox[{RowBox[{RowBox[{"homoDistance", "[", "2", "]"}],
                    "\[LessEqual]", RowBox[{"homoDistance", "[", "1",
                      "]"}]}], ",", RowBox[{"-", "1"}], ",", "1"}], "]"}]}],
            ",", RowBox[{"\"homoProfileMaxDeviation\"", "\[Rule]",
              RowBox[{"Min", "[", RowBox[{RowBox[{"homoDistance", "[", "1",
                    "]"}], ",", RowBox[{"homoDistance", "[", "2", "]"}]}],
                "]"}]}], ",", RowBox[{"\"homoTypesRelatedByBSignFlip\"",
              "\[Rule]", RowBox[{"Max", "[", RowBox[{RowBox[{"Abs", "[",
                    RowBox[{RowBox[{RowBox[{RowBox[{"scfFinal", "[",
                          "\"profiles\"", "]"}], "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "[", "\"a\"", "]"}],
                      "-", RowBox[{RowBox[{RowBox[{"scfFinal", "[",
                          "\"profiles\"", "]"}], "\[LeftDoubleBracket]", "2",
                          "\[RightDoubleBracket]"}], "[", "\"a\"", "]"}]}],
                    "]"}], ",", RowBox[{"Abs", "[", RowBox[{RowBox[
                       {RowBox[{RowBox[{"scfFinal", "[", "\"profiles\"",
                          "]"}], "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "[", "\"b\"", "]"}],
                      "+", RowBox[{RowBox[{RowBox[{"scfFinal", "[",
                          "\"profiles\"", "]"}], "\[LeftDoubleBracket]", "2",
                          "\[RightDoubleBracket]"}], "[", "\"b\"", "]"}]}],
                    "]"}]}], "]"}]}], ",", RowBox[
             {"\"maxProfileMatchingResidual\"", "\[Rule]", RowBox[{"Max",
                "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1", "[",
                        "\"matching\"", "]"}], "&"}], ")"}], "/@",
                  RowBox[{"scfFinal", "[", "\"profiles\"", "]"}]}],
                "]"}]}]}], "]"}]}], ";", RowBox[{"Dataset", "[",
        "scfComparison", "]"}]}]], "Input"], Cell["The complete spectrum of \
the final potential. All levels in the energy window of the Rust run \
(run.json windowLo, windowHi) are computed for every shell n2 = 0, 1, 2, ... \
(both parities, both block types; the s = -1 levels directly from the s = -1 \
equation with the vector potential) until two consecutive shells have no \
level in the window (the Rust stopping rule), and compared with levels.csv \
key by key. Branches (normal ordering with respect to the free Dirac sea): a \
state is a particle state when its free partner, the level with the same \
(shell, parity, s, Pruefer index) at lambda = 0, has eps_free >= 0, i.e. s \
(target - Theta_free(0)) >= 0 by the monotonicity of the free Theta; the \
eps_free column is compared for the shells n2 <= 16 with the free spectrum \
computed above. The aufbau of N = 8 on the particle states of this spectrum \
must give back the two occupied levels of the loop, and the lowest unoccupied \
particle level (LUMO), the KS gap and the highest sea level are compared with \
run.json.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"scfFinalTheta", "=",
        RowBox[{"pruferThetaD", "[", RowBox[
           {RowBox[{"scfPot", "\[LeftDoubleBracket]", "1",
              "\[RightDoubleBracket]"}], ",", RowBox[{"scfPot",
              "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",",
            "scfLength", ",", "scfH", ",", "scfA4", ",", "splineOptions"}],
          "]"}]}], ";", RowBox[{"scfFinalEnds", "=",
        RowBox[{"linearEnds", "[", RowBox[
           {RowBox[{"scfPot", "\[LeftDoubleBracket]", "1",
              "\[RightDoubleBracket]"}], ",", RowBox[{"scfPot",
              "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",",
            "scfLength", ",", "scfH", ",", "scfA4", ",", "splineOptions"}],
          "]"}]}], ";", RowBox[{"scfFreeTheta", "=",
        RowBox[{"pruferThetaD", "[", RowBox[
           {RowBox[{RowBox[{"Evaluate", "[", "scfMass", "]"}], "&"}], ",",
            RowBox[{"0.`", "&"}], ",", "scfLength", ",", "scfH", ",",
            "scfA4", ",", "smoothOptions"}], "]"}]}], ";",
      RowBox[{"scfSpectrum", "=", RowBox[{"Module", "[",
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"states", "=", RowBox[
                   {"{", "}"}]}], ",", RowBox[{"empty", "=", "0"}], ",",
                RowBox[{"used", "=", "0"}]}], "}"}], ",",
            RowBox[{RowBox[{"Do", "[", RowBox[{RowBox[{"Module", "[",
                    RowBox[{RowBox[{"{", RowBox[{RowBox[{"k", "=", RowBox[
                          {"scfDk", " ", "scfMass", " ", SqrtBox[RowBox[
                          {"N", "[", "n2", "]"}]]}]}], ",", "lev"}], "}"}],
                      ",", RowBox[{RowBox[{"lev", "=", RowBox[{"shellLevels",
                          "[", RowBox[{"scfFinalTheta", ",", "scfFinalEnds",
                          ",", "k", ",", "scfWindow"}], "]"}]}], ";",
                        RowBox[{"lev", "=", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"Join", "[", RowBox[{"#1", ",", RowBox[
                          {"Association", "[", RowBox[{RowBox[{"\"n2\"",
                          "\[Rule]", "n2"}], ",", RowBox[{"\"k\"", "\[Rule]",
                          "k"}], ",", RowBox[{"\"multiplicity\"", "\[Rule]",
                          RowBox[{"4", " ", RowBox[{"SquaresR", "[", RowBox[
                          {"3", ",", "n2"}], "]"}]}]}], ",", RowBox[
                          {"\"branch\"", "\[Rule]", RowBox[{"If", "[", RowBox[
                          {RowBox[{RowBox[{RowBox[{"#1", "[", "\"s\"", "]"}],
                          " ", RowBox[{"(", RowBox[{RowBox[{"N", "[", RowBox[
                          {RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"#1",
                          "[", "\"parity\"", "]"}], "\[Equal]", "1"}], ",",
                          "0", ",", FractionBox["\[Pi]", "2"]}], "]"}], "+",
                          RowBox[{RowBox[{"#1", "[", "\"index\"", "]"}], " ",
                          "\[Pi]"}]}], "]"}], "-", RowBox[{"First", "[",
                          RowBox[{"scfFreeTheta", "[", RowBox[{"0.`", ",",
                          "k", ",", RowBox[{"#1", "[", "\"s\"", "]"}]}],
                          "]"}], "]"}]}], ")"}]}], "\[GreaterEqual]", "0"}],
                          ",", "1", ",", RowBox[{"-", "1"}]}], "]"}]}]}],
                          "]"}]}], "]"}], "&"}], ")"}], "/@", "lev"}]}], ";",
                        RowBox[{"used", "++"}], ";", RowBox[{"If", "[",
                          RowBox[{RowBox[{"lev", "===", RowBox[{"{", "}"}]}],
                          ",", RowBox[{"empty", "++"}], ",", RowBox[{"empty",
                          "=", "0"}]}], "]"}], ";", RowBox[{"states", "=",
                          RowBox[{"Join", "[", RowBox[{"states", ",",
                          "lev"}], "]"}]}], ";", RowBox[{"If", "[", RowBox[
                          {RowBox[{"empty", "\[GreaterEqual]", "2"}], ",",
                          RowBox[{"Break", "[", "]"}]}], "]"}]}]}], "]"}],
                  ",", RowBox[{"{", RowBox[{"n2", ",", RowBox[
                       {"representableShells", "[", "5000", "]"}]}], "}"}]}],
                "]"}], ";", RowBox[{"Association", "[", RowBox[
                 {RowBox[{"\"states\"", "\[Rule]", "states"}], ",",
                  RowBox[{"\"shellsUsed\"", "\[Rule]", "used"}]}], "]"}]}]}],
          "]"}]}], ";", RowBox[{"scfRustLevels", "=",
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"t", "=", "scfLevelsTable"}], ",",
                RowBox[{"idx", "=", RowBox[{"scfLevelsTable", "[",
                    "\"index\"", "]"}]}]}], "}"}], ",",
            RowBox[{RowBox[{"(", RowBox[{RowBox[{"Association", "[",
                    RowBox[{RowBox[{"\"n2\"", "\[Rule]", RowBox[{"Round",
                          "[", RowBox[{"#1", "\[LeftDoubleBracket]", RowBox[
                          {"idx", "[", "\"n2\"", "]"}],
                          "\[RightDoubleBracket]"}], "]"}]}], ",", RowBox[
                       {"\"parity\"", "\[Rule]", RowBox[{"Round", "[",
                          RowBox[{"#1", "\[LeftDoubleBracket]", RowBox[
                          {"idx", "[", "\"parity\"", "]"}],
                          "\[RightDoubleBracket]"}], "]"}]}], ",", RowBox[
                       {"\"s\"", "\[Rule]", RowBox[{"Round", "[", RowBox[
                          {"#1", "\[LeftDoubleBracket]", RowBox[{"idx", "[",
                          "\"s\"", "]"}], "\[RightDoubleBracket]"}], "]"}]}],
                      ",", RowBox[{"\"index\"", "\[Rule]", RowBox[{"Round",
                          "[", RowBox[{"#1", "\[LeftDoubleBracket]", RowBox[
                          {"idx", "[", "\"index\"", "]"}],
                          "\[RightDoubleBracket]"}], "]"}]}], ",", RowBox[
                       {"\"eps\"", "\[Rule]", RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"idx", "[",
                          "\"eps\"", "]"}], "\[RightDoubleBracket]"}]}], ",",
                      RowBox[{"\"branch\"", "\[Rule]", RowBox[{"Round", "[",
                          RowBox[{"#1", "\[LeftDoubleBracket]", RowBox[
                          {"idx", "[", "\"branch\"", "]"}],
                          "\[RightDoubleBracket]"}], "]"}]}], ",", RowBox[
                       {"\"epsFree\"", "\[Rule]", RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"idx", "[",
                          "\"eps_free\"", "]"}], "\[RightDoubleBracket]"}]}],
                      ",", RowBox[{"\"weight\"", "\[Rule]", RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"idx", "[",
                          "\"weight\"", "]"}], "\[RightDoubleBracket]"}]}],
                      ",", RowBox[{"\"multiplicity\"", "\[Rule]", RowBox[
                         {"#1", "\[LeftDoubleBracket]", RowBox[{"idx", "[",
                          "\"multiplicity\"", "]"}],
                          "\[RightDoubleBracket]"}]}]}], "]"}], "&"}], ")"}],
              "/@", RowBox[{"t", "[", "\"rows\"", "]"}]}]}], "]"}]}], ";",
      RowBox[{"scfSpectrumComparison", "=", RowBox[{"Module", "[",
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"mine", "=", RowBox[
                   {"SortBy", "[", RowBox[{RowBox[{"scfSpectrum", "[",
                        "\"states\"", "]"}], ",", "fullKey"}], "]"}]}], ",",
                RowBox[{"rust", "=", RowBox[{"SortBy", "[", RowBox[
                     {"scfRustLevels", ",", "fullKey"}], "]"}]}], ",",
                "keysOK", ",", "pairs", ",", "freeLookup", ",", "freeDev",
                ",", "particles", ",", "groups", ",", "homoGroup", ",",
                "lumo", ",", "seaTop"}], "}"}], ",",
            RowBox[{RowBox[{"keysOK", "=", RowBox[{RowBox[{"fullKey", "/@",
                    "mine"}], "===", RowBox[{"fullKey", "/@", "rust"}]}]}],
              ";", RowBox[{"pairs", "=", RowBox[{"If", "[", RowBox[
                   {"keysOK", ",", TemplateBox[{RowBox[{"{", RowBox[{"mine",
                          ",", "rust"}], "}"}]}, "Transpose", SyntaxForm ->
                      SuperscriptBox], ",", RowBox[{"{", "}"}]}], "]"}]}],
              ";", RowBox[{"freeLookup", "=", RowBox[{"Association", "[",
                  RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[{"fullKey",
                          "[", "#1", "]"}], "\[Rule]", RowBox[{"#1", "[",
                          "\"eps\"", "]"}]}], "&"}], ")"}], "/@", RowBox[
                     {RowBox[{"freeSpectrumResults", "[", RowBox[{"{",
                          RowBox[{"1", ",", "3"}], "}"}], "]"}], "[",
                      "\"mine\"", "]"}]}], "]"}]}], ";", RowBox[{"freeDev",
                "=", RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                       {RowBox[{"Abs", "[", RowBox[{RowBox[{"Lookup", "[",
                          RowBox[{"freeLookup", ",", RowBox[{"Key", "[",
                          RowBox[{"fullKey", "[", RowBox[{"#1",
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "]"}], "]"}]}], "]"}],
                          "-", RowBox[{"#1", "\[LeftDoubleBracket]", RowBox[
                          {"2", ",", "\"epsFree\""}],
                          "\[RightDoubleBracket]"}]}], "]"}], "&"}], ")"}],
                    "/@", RowBox[{"Select", "[", RowBox[{"pairs", ",",
                        RowBox[{RowBox[{"KeyExistsQ", "[", RowBox[
                          {"freeLookup", ",", RowBox[{"fullKey", "[", RowBox[
                          {"#1", "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "]"}]}], "]"}], "&"}]}],
                      "]"}]}], "]"}]}], ";", RowBox[{"particles", "=",
                RowBox[{"SortBy", "[", RowBox[{RowBox[{"Select", "[",
                      RowBox[{"mine", ",", RowBox[{RowBox[{RowBox[{"#1", "[",
                          "\"branch\"", "]"}], "\[Equal]", "1"}], "&"}]}],
                      "]"}], ",", RowBox[{RowBox[{"#1", "[", "\"eps\"",
                        "]"}], "&"}]}], "]"}]}], ";", RowBox[{"groups", "=",
                RowBox[{"Split", "[", RowBox[{"particles", ",", RowBox[
                     {RowBox[{RowBox[{"Abs", "[", RowBox[{RowBox[{"#2", "[",
                          "\"eps\"", "]"}], "-", RowBox[{"#1", "[",
                          "\"eps\"", "]"}]}], "]"}], "\[LessEqual]",
                        FractionBox[RowBox[{"Max", "[", RowBox[{"1", ",",
                          RowBox[{"Abs", "[", RowBox[{"#1", "[", "\"eps\"",
                          "]"}], "]"}]}], "]"}], SuperscriptBox["10",
                          "9"]]}], "&"}]}], "]"}]}], ";",
              RowBox[{"homoGroup", "=", RowBox[{"First", "[", "groups",
                  "]"}]}], ";", RowBox[{"lumo", "=", RowBox[{"groups",
                  "\[LeftDoubleBracket]", RowBox[{"2", ",", "1", ",",
                    "\"eps\""}], "\[RightDoubleBracket]"}]}], ";",
              RowBox[{"seaTop", "=", RowBox[{"Max", "[", RowBox[
                   {RowBox[{"Select", "[", RowBox[{"mine", ",", RowBox[
                         {RowBox[{RowBox[{"#1", "[", "\"branch\"", "]"}],
                          "\[Equal]", RowBox[{"-", "1"}]}], "&"}]}], "]"}],
                    "\[LeftDoubleBracket]", RowBox[{"All", ",", "\"eps\""}],
                    "\[RightDoubleBracket]"}], "]"}]}], ";",
              RowBox[{"Association", "[", RowBox[{RowBox[{"\"levels\"",
                    "\[Rule]", RowBox[{"Length", "[", "mine", "]"}]}], ",",
                  RowBox[{"\"rustLevels\"", "\[Rule]", RowBox[{"Length", "[",
                      "rust", "]"}]}], ",", RowBox[{"\"rustStatesRecord\"",
                    "\[Rule]", RowBox[{"scfRun", "[", "\"states\"", "]"}]}],
                  ",", RowBox[{"\"keysIdentical\"", "\[Rule]", "keysOK"}],
                  ",", RowBox[{"\"shellsUsed\"", "\[Rule]", RowBox[
                     {"scfSpectrum", "[", "\"shellsUsed\"", "]"}]}], ",",
                  RowBox[{"\"rustShellsUsed\"", "\[Rule]", RowBox[{"scfRun",
                      "[", "\"shellsUsed\"", "]"}]}], ",", RowBox[
                   {"\"maxAbsDeviation\"", "\[Rule]", RowBox[{"If", "[",
                      RowBox[{"keysOK", ",", RowBox[{"Max", "[", RowBox[
                          {RowBox[{"(", RowBox[{RowBox[{"Abs", "[", RowBox[
                          {RowBox[{"#1", "\[LeftDoubleBracket]", RowBox[{"1",
                          ",", "\"eps\""}], "\[RightDoubleBracket]"}], "-",
                          RowBox[{"#1", "\[LeftDoubleBracket]", RowBox[{"2",
                          ",", "\"eps\""}], "\[RightDoubleBracket]"}]}],
                          "]"}], "&"}], ")"}], "/@", "pairs"}], "]"}], ",",
                        "\[Infinity]"}], "]"}]}], ",", RowBox[
                   {"\"branchesIdentical\"", "\[Rule]", RowBox[{"keysOK",
                      "&&", RowBox[{"AllTrue", "[", RowBox[{"pairs", ",",
                          RowBox[{RowBox[{RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"1", ",",
                          "\"branch\""}], "\[RightDoubleBracket]"}],
                          "\[Equal]", RowBox[{"#1", "\[LeftDoubleBracket]",
                          RowBox[{"2", ",", "\"branch\""}],
                          "\[RightDoubleBracket]"}]}], "&"}]}], "]"}]}]}],
                  ",", RowBox[{"\"epsFreeComparedStates\"", "\[Rule]",
                    RowBox[{"Count", "[", RowBox[{"pairs", ",", RowBox[
                         {"p_", "/;", RowBox[{"KeyExistsQ", "[", RowBox[
                          {"freeLookup", ",", RowBox[{"fullKey", "[", RowBox[
                          {"p", "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "]"}]}], "]"}]}]}],
                      "]"}]}], ",", RowBox[{"\"epsFreeMaxAbsDeviation\"",
                    "\[Rule]", "freeDev"}], ",", RowBox[
                   {"\"multiplicitiesIdentical\"", "\[Rule]", RowBox[
                     {"keysOK", "&&", RowBox[{"AllTrue", "[", RowBox[
                         {"pairs", ",", RowBox[{RowBox[{RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"1", ",",
                          "\"multiplicity\""}], "\[RightDoubleBracket]"}],
                          "\[Equal]", RowBox[{"#1", "\[LeftDoubleBracket]",
                          RowBox[{"2", ",", "\"multiplicity\""}],
                          "\[RightDoubleBracket]"}]}], "&"}]}], "]"}]}]}],
                  ",", RowBox[{"\"aufbauGroupCount\"", "\[Rule]", RowBox[
                     {"Total", "[", RowBox[{"homoGroup",
                        "\[LeftDoubleBracket]", RowBox[{"All", ",",
                          "\"multiplicity\""}], "\[RightDoubleBracket]"}],
                      "]"}]}], ",", RowBox[{"\"aufbauGroupKeys\"", "\[Rule]",
                    RowBox[{"Sort", "[", RowBox[{"fullKey", "/@",
                        "homoGroup"}], "]"}]}], ",", RowBox[
                   {"\"aufbauGroupIsLoopOccupation\"", "\[Rule]", RowBox[
                     {RowBox[{RowBox[{"Sort", "[", RowBox[{"fullKey", "/@",
                          "homoGroup"}], "]"}], "===", RowBox[{"{", RowBox[
                          {RowBox[{"{", RowBox[{"0", ",", "1", ",", RowBox[
                          {"-", "1"}], ",", "0"}], "}"}], ",", RowBox[{"{",
                          RowBox[{"0", ",", "1", ",", "1", ",", "0"}],
                          "}"}]}], "}"}]}], "&&", RowBox[{RowBox[{"Total",
                          "[", RowBox[{"homoGroup", "\[LeftDoubleBracket]",
                          RowBox[{"All", ",", "\"multiplicity\""}],
                          "\[RightDoubleBracket]"}], "]"}], "\[Equal]",
                        "scfN"}]}]}], ",", RowBox[{"\"rustOccupiedKeys\"",
                    "\[Rule]", RowBox[{"Sort", "[", RowBox[{"fullKey", "/@",
                        RowBox[{"Select", "[", RowBox[{"rust", ",", RowBox[
                          {RowBox[{RowBox[{"#1", "[", "\"weight\"", "]"}],
                          ">", "0"}], "&"}]}], "]"}]}], "]"}]}], ",",
                  RowBox[{"\"aufbauHomoDeviationFromLoop\"", "\[Rule]",
                    RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[
                         {RowBox[{"homoGroup", "\[LeftDoubleBracket]",
                          RowBox[{"All", ",", "\"eps\""}],
                          "\[RightDoubleBracket]"}], "-", RowBox[{"First",
                          "[", RowBox[{"scfFinal", "[", "\"eps\"", "]"}],
                          "]"}]}], "]"}], "]"}]}], ",", RowBox[
                   {"\"epsLumo\"", "\[Rule]", "lumo"}], ",", RowBox[
                   {"\"epsLumoDeviation\"", "\[Rule]", RowBox[{"Abs", "[",
                      RowBox[{"lumo", "-", RowBox[{"scfRun", "[",
                          "\"epsLumo\"", "]"}]}], "]"}]}], ",", RowBox[
                   {"\"ksGap\"", "\[Rule]", RowBox[{"lumo", "-", RowBox[
                       {"First", "[", RowBox[{"scfFinal", "[", "\"eps\"",
                          "]"}], "]"}]}]}], ",", RowBox[
                   {"\"ksGapDeviation\"", "\[Rule]", RowBox[{"Abs", "[",
                      RowBox[{"lumo", "-", RowBox[{"First", "[", RowBox[
                          {"scfFinal", "[", "\"eps\"", "]"}], "]"}], "-",
                        RowBox[{"scfRun", "[", "\"ksGap\"", "]"}]}], "]"}]}],
                  ",", RowBox[{"\"seaTop\"", "\[Rule]", "seaTop"}], ",",
                  RowBox[{"\"seaTopDeviation\"", "\[Rule]", RowBox[{"Abs",
                      "[", RowBox[{"seaTop", "-", RowBox[{"scfRun", "[",
                          "\"seaTop\"", "]"}]}], "]"}]}], ",", RowBox[
                   {"\"branchOverlap\"", "\[Rule]", RowBox[{"seaTop", ">",
                      RowBox[{"First", "[", RowBox[{"scfFinal", "[",
                          "\"eps\"", "]"}], "]"}]}]}], ",", RowBox[
                   {"\"rustBranchOverlap\"", "\[Rule]", RowBox[{"scfRun",
                      "[", "\"branchOverlap\"", "]"}]}], ",", RowBox[
                   {"\"maxMatchingResidual\"", "\[Rule]", RowBox[{"Max", "[",
                      RowBox[{"mine", "\[LeftDoubleBracket]", RowBox[{"All",
                          ",", "\"matching\""}], "\[RightDoubleBracket]"}],
                      "]"}]}], ",", RowBox[{"\"maxRootIterations\"",
                    "\[Rule]", RowBox[{"Max", "[", RowBox[{"mine",
                        "\[LeftDoubleBracket]", RowBox[{"All", ",",
                          "\"iterations\""}], "\[RightDoubleBracket]"}],
                      "]"}]}]}], "]"}]}]}], "]"}]}], ";",
      RowBox[{"Dataset", "[", RowBox[{"KeyDrop", "[",
          RowBox[{"scfSpectrumComparison", ",", RowBox[
             {"{", RowBox[{"\"aufbauGroupKeys\"", ",",
                "\"rustOccupiedKeys\""}], "}"}]}], "]"}], "]"}]}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"scfResult", "=",
        RowBox[{"Join", "[", RowBox[{"scfComparison", ",",
            RowBox[{"Association", "[", RowBox[{RowBox[{"\"spectrum\"",
                  "\[Rule]", "scfSpectrumComparison"}], ",", RowBox[
                 {"\"splineTest\"", "\[Rule]", "splineTest"}], ",",
                RowBox[{"\"setup\"", "\[Rule]", "scfSetupChecks"}], ",",
                RowBox[{"\"label\"", "\[Rule]", "scfLabel"}], ",",
                RowBox[{"\"lambdaHat\"", "\[Rule]", "scfLambdaHat"}], ",",
                RowBox[{"\"lambda\"", "\[Rule]", "scfLambda"}], ",",
                RowBox[{"\"residualHistory\"", "\[Rule]", "scfResiduals"}],
                ",", RowBox[{"\"rustResidualHistory\"", "\[Rule]",
                  TemplateBox[{RowBox[{"{", RowBox[{RowBox[{"columnOf", "[",
                          RowBox[{"scfHistory", ",", "\"iteration\""}],
                          "]"}], ",", RowBox[{"columnOf", "[", RowBox[
                          {"scfHistory", ",", "\"residual_n\""}], "]"}], ",",
                        RowBox[{"columnOf", "[", RowBox[{"scfHistory", ",",
                          "\"residual_S\""}], "]"}]}], "}"}]}, "Transpose",
                   SyntaxForm -> SuperscriptBox]}]}], "]"}]}], "]"}]}], ";",
      RowBox[{"scfChecks", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"scfSetup\"", "\[Rule]", RowBox[{"And", "@@",
                RowBox[{"Values", "[", "scfSetupChecks", "]"}]}]}], ",",
            RowBox[{"\"scfLoopConverged\"", "\[Rule]", RowBox[{
                "scfConverged", "&&", RowBox[{RowBox[{"scfResiduals",
                    "\[LeftDoubleBracket]", RowBox[{RowBox[{"-", "1"}], ",",
                      "2"}], "\[RightDoubleBracket]"}], "<", FractionBox["1",
                   SuperscriptBox["10", "12"]]}], "&&", RowBox[
                 {RowBox[{"scfResiduals", "\[LeftDoubleBracket]", RowBox[
                     {RowBox[{"-", "1"}], ",", "3"}],
                    "\[RightDoubleBracket]"}], "<", FractionBox["1",
                   SuperscriptBox["10", "12"]]}], "&&", RowBox[
                 {RowBox[{"Max", "[", RowBox[{"Join", "[", RowBox[
                       {"scfRootIterations", ",", RowBox[{"scfFinal", "[",
                          "\"rootIterations\"", "]"}]}], "]"}], "]"}], "<",
                  "60"}]}]}], ",", RowBox[{"\"scfEpsHomoEqualsRust\"",
              "\[Rule]", RowBox[{RowBox[{RowBox[{"scfComparison", "[",
                    "\"epsHomoDeviation\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "9"]]}], "&&",
                RowBox[{RowBox[{"scfComparison", "[", "\"muDeviation\"",
                    "]"}], "\[LessEqual]", FractionBox["1", SuperscriptBox[
                    "10", "9"]]}], "&&", RowBox[{RowBox[{"scfComparison",
                    "[", "\"blockTypeSplitting\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "12"]]}]}]}], ",",
            RowBox[{"\"scfEnergyEqualsRust\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"scfComparison", "[",
                    "\"energyDeviation\"", "]"}], "\[LessEqual]", FractionBox[
                   "1", SuperscriptBox["10", "9"]]}], "&&", RowBox[
                 {RowBox[{"scfComparison", "[", "\"freeEnergyDeviation\"",
                    "]"}], "\[LessEqual]", FractionBox["1", SuperscriptBox[
                    "10", "9"]]}], "&&", RowBox[{RowBox[{"scfComparison",
                    "[", "\"grandPotentialDeviation\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "9"]]}]}]}], ",", RowBox[{"\"scfEnergyPartsEqualRust\"",
              "\[Rule]", RowBox[{RowBox[{RowBox[{"scfComparison", "[",
                    "\"ksSumDeviation\"", "]"}], "\[LessEqual]", FractionBox[
                   "1", SuperscriptBox["10", "9"]]}], "&&", RowBox[
                 {RowBox[{"scfComparison", "[", "\"hartreeDeviation\"",
                    "]"}], "\[LessEqual]", FractionBox["1", SuperscriptBox[
                    "10", "9"]]}], "&&", RowBox[{RowBox[{"scfComparison",
                    "[", "\"exchangeDeviation\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "9"]]}], "&&",
                RowBox[{RowBox[{"scfComparison", "[",
                    "\"nFromDensityDeviation\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "9"]]}]}]}], ",",
            RowBox[{"\"scfMeffEqualsRust\"", "\[Rule]", RowBox[{
                RowBox[{RowBox[{"scfComparison", "[",
                    "\"mEffMaxAbsDeviation\"", "]"}], "\[LessEqual]",
                  "potentialBoundM"}], "&&", RowBox[{RowBox[{"scfComparison",
                    "[", "\"maxLambdaSOverMDeviation\"", "]"}],
                  "\[LessEqual]", "potentialBoundM"}]}]}], ",",
            RowBox[{"\"scfVxEqualsRust\"", "\[Rule]", RowBox[{RowBox[
                 {RowBox[{"scfComparison", "[", "\"vxMaxAbsDeviation\"",
                    "]"}], "\[LessEqual]", "potentialBoundV"}], "&&",
                RowBox[{RowBox[{"scfComparison", "[",
                    "\"maxVxOverMDeviation\"", "]"}], "\[LessEqual]",
                  "potentialBoundV"}]}]}], ",", RowBox[
             {"\"scfDensitiesEqualRust\"", "\[Rule]", RowBox[{RowBox[
                 {RowBox[{"scfComparison", "[", "\"ncMaxDeviationOverD\"",
                    "]"}], "\[LessEqual]", FractionBox["1", SuperscriptBox[
                    "10", "9"]]}], "&&", RowBox[{RowBox[{"scfComparison",
                    "[", "\"scMaxDeviationOverD\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "9"]]}], "&&",
                RowBox[{RowBox[{"scfComparison", "[",
                    "\"lsMaxRelativeDeviation\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "6"]]}]}]}], ",",
            RowBox[{"\"scfHomoProfileEqualsRust\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"scfComparison", "[",
                    "\"homoProfileMaxDeviation\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "8"]]}], "&&",
                RowBox[{RowBox[{"scfComparison", "[",
                    "\"homoTypesRelatedByBSignFlip\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "10"]]}], "&&",
                RowBox[{RowBox[{"scfComparison", "[",
                    "\"maxProfileMatchingResidual\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "8"]]}]}]}], ",",
            RowBox[{"\"scfSpectrumSameLevelKeys\"", "\[Rule]",
              RowBox[{RowBox[{"scfSpectrumComparison", "[",
                  "\"keysIdentical\"", "]"}], "&&", RowBox[
                 {RowBox[{"scfSpectrumComparison", "[", "\"levels\"", "]"}],
                  "\[Equal]", RowBox[{"scfRun", "[", "\"states\"", "]"}]}],
                "&&", RowBox[{RowBox[{"scfSpectrumComparison", "[",
                    "\"shellsUsed\"", "]"}], "\[Equal]", RowBox[{"scfRun",
                    "[", "\"shellsUsed\"", "]"}]}], "&&", RowBox[
                 {"scfSpectrumComparison", "[",
                  "\"multiplicitiesIdentical\"", "]"}]}]}], ",",
            RowBox[{"\"scfSpectrumEigenvalues\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"scfSpectrumComparison", "[",
                    "\"maxAbsDeviation\"", "]"}], "\[LessEqual]", FractionBox[
                   "1", SuperscriptBox["10", "8"]]}], "&&", RowBox[
                 {RowBox[{"scfSpectrumComparison", "[",
                    "\"maxMatchingResidual\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "8"]]}], "&&",
                RowBox[{RowBox[{"scfSpectrumComparison", "[",
                    "\"maxRootIterations\"", "]"}], "<", "60"}]}]}], ",",
            RowBox[{"\"scfSpectrumBranches\"", "\[Rule]",
              RowBox[{RowBox[{"scfSpectrumComparison", "[",
                  "\"branchesIdentical\"", "]"}], "&&", RowBox[
                 {RowBox[{"scfSpectrumComparison", "[",
                    "\"epsFreeMaxAbsDeviation\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "8"]]}], "&&",
                RowBox[{RowBox[{"scfSpectrumComparison", "[",
                    "\"epsFreeComparedStates\"", "]"}], ">", "0"}]}]}], ",",
            RowBox[{"\"scfAufbauReproducesLoopOccupation\"", "\[Rule]",
              RowBox[{RowBox[{"scfSpectrumComparison", "[",
                  "\"aufbauGroupIsLoopOccupation\"", "]"}], "&&",
                RowBox[{RowBox[{"scfSpectrumComparison", "[",
                    "\"rustOccupiedKeys\"", "]"}], "===", RowBox[
                   {"scfSpectrumComparison", "[", "\"aufbauGroupKeys\"",
                    "]"}]}], "&&", RowBox[{RowBox[{"scfSpectrumComparison",
                    "[", "\"aufbauHomoDeviationFromLoop\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "9"]]}]}]}], ",", RowBox[
             {"\"scfGapLumoSeaTopEqualRust\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"scfSpectrumComparison", "[",
                    "\"ksGapDeviation\"", "]"}], "\[LessEqual]", FractionBox[
                   "1", SuperscriptBox["10", "8"]]}], "&&", RowBox[
                 {RowBox[{"scfSpectrumComparison", "[",
                    "\"epsLumoDeviation\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "8"]]}], "&&",
                RowBox[{RowBox[{"scfSpectrumComparison", "[",
                    "\"seaTopDeviation\"", "]"}], "\[LessEqual]", FractionBox[
                   "1", SuperscriptBox["10", "8"]]}], "&&", RowBox[
                 {RowBox[{"scfSpectrumComparison", "[", "\"branchOverlap\"",
                    "]"}], "===", RowBox[{"scfRun", "[", "\"branchOverlap\"",
                    "]"}]}]}]}]}], "]"}]}], ";", "scfChecks"}]], "Input"],
  Cell["The Rust binary: print-config", "Section"],
  Cell["The binary is expected at \
studies/dirac16complex_kohn_sham/target/release/ (cargo build --release in \
that directory). RunProcess runs print-config from the repository root; the \
planet_Mercury-style contract requires exit code 0 and SUCCESS as the last \
stdout line. The printed fixture hash and tolerances are compared with the \
fixture file and the committed summary.json files; the printed equations (the \
real block system, the boundary conditions, the exchange closed form and the \
pseudo-potential) are parsed into Wolfram Language expressions and compared \
with the forms derived in this notebook: the real system with the derived \
rustRealForm at v_v = 0, the exchange potentials with the derivatives of the \
printed e_x, and M_eff with m + lambda S (Hartree, U'(S) = lambda S) + v_s. \
The line threads (machine dependent) is not used.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"binaryPath", "=",
        RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"repositoryRoot",
              ",", "\"studies\"", ",", "\"dirac16complex_kohn_sham\"", ",",
              "\"target\"", ",", "\"release\"", ",", RowBox[{"If", "[",
                RowBox[{RowBox[{"$OperatingSystem", "===", "\"Windows\""}],
                  ",", "\"dirac16complex_kohn_sham.exe\"", ",",
                  "\"dirac16complex_kohn_sham\""}], "]"}]}], "}"}], "]"}]}],
      ";", RowBox[{"printConfig", "=", RowBox[{"If", "[",
          RowBox[{RowBox[{"FileExistsQ", "[", "binaryPath", "]"}], ",",
            RowBox[{"RunProcess", "[", RowBox[{RowBox[{"{", RowBox[
                   {"binaryPath", ",", "\"print-config\""}], "}"}], ",",
                RowBox[{"ProcessDirectory", "\[Rule]", "repositoryRoot"}]}],
              "]"}], ",", RowBox[{"Association", "[", RowBox[{RowBox[
                 {"\"ExitCode\"", "\[Rule]", RowBox[{"-", "1"}]}], ",",
                RowBox[{"\"StandardOutput\"", "\[Rule]", "\"\""}], ",",
                RowBox[{"\"StandardError\"", "\[Rule]", RowBox[
                   {"\"binary not found: \"", "<>", "binaryPath"}]}]}],
              "]"}]}], "]"}]}], ";", RowBox[{"printConfigLines", "=",
        RowBox[{"Select", "[", RowBox[{RowBox[{"StringTrim", "/@",
              RowBox[{"StringSplit", "[", RowBox[{RowBox[{"printConfig", "[",
                    "\"StandardOutput\"", "]"}], ",", RowBox[{"{",
                    RowBox[{"\"\\r\\n\"", ",", "\"\\n\""}], "}"}]}], "]"}]}],
            ",", RowBox[{RowBox[{"#1", "=!=", "\"\""}], "&"}]}], "]"}]}],
      ";", RowBox[{RowBox[{"printedValue", "[", "key_String", "]"}], ":=",
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"line", "=",
                RowBox[{"SelectFirst", "[", RowBox[{"printConfigLines", ",",
                    RowBox[{RowBox[{"StringMatchQ", "[", RowBox[{"#1", ",",
                          RowBox[{"key", "~~", RowBox[{"\" \"", "..."}],
                          "~~", "\"=\"", "~~", "___"}]}], "]"}], "&"}], ",",
                    "\"\""}], "]"}]}], "}"}], ",",
            RowBox[{"If", "[", RowBox[{RowBox[{"line", "===", "\"\""}], ",",
                "\"\"", ",", RowBox[{"StringTrim", "[", RowBox[{"StringDrop",
                    "[", RowBox[{"line", ",", RowBox[{RowBox[
                         {"StringPosition", "[", RowBox[{"line", ",",
                          "\"=\""}], "]"}], "\[LeftDoubleBracket]", RowBox[
                         {"1", ",", "1"}], "\[RightDoubleBracket]"}]}],
                    "]"}], "]"}]}], "]"}]}], "]"}]}], ";",
      RowBox[{RowBox[{"printedFormula", "[", "text_String", "]"}], ":=",
        RowBox[{"ToExpression", "[", RowBox[{RowBox[{"StringReplace", "[",
              RowBox[{"text", ",", RowBox[{"{", RowBox[{RowBox[
                     {RowBox[{"RegularExpression", "[",
                        "\"\\\\bkappa\\\\b\"", "]"}], "\[Rule]",
                      "\"kappaP\""}], ",", RowBox[{RowBox[
                       {"RegularExpression", "[", "\"\\\\blambda\\\\b\"",
                        "]"}], "\[Rule]", "\"lamP\""}], ",", RowBox[
                     {RowBox[{"RegularExpression", "[", "\"\\\\beps\\\\b\"",
                        "]"}], "\[Rule]", "\"epsP\""}], ",", RowBox[
                     {RowBox[{"RegularExpression", "[", "\"\\\\bS_p\\\\b\"",
                        "]"}], "\[Rule]", "\"sdP\""}], ",", RowBox[
                     {RowBox[{"RegularExpression", "[", "\"\\\\bS\\\\b\"",
                        "]"}], "\[Rule]", "\"sdP\""}], ",", RowBox[
                     {RowBox[{"RegularExpression", "[", "\"\\\\bM\\\\b\"",
                        "]"}], "\[Rule]", "\"mP\""}], ",", RowBox[
                     {RowBox[{"RegularExpression", "[", "\"\\\\bm\\\\b\"",
                        "]"}], "\[Rule]", "\"mP\""}], ",", RowBox[
                     {RowBox[{"RegularExpression", "[", "\"\\\\bn\\\\b\"",
                        "]"}], "\[Rule]", "\"ndP\""}], ",", RowBox[
                     {RowBox[{"RegularExpression", "[", "\"\\\\ba\\\\b\"",
                        "]"}], "\[Rule]", "\"aP\""}], ",", RowBox[
                     {RowBox[{"RegularExpression", "[", "\"\\\\bb\\\\b\"",
                        "]"}], "\[Rule]", "\"bP\""}], ",", RowBox[
                     {RowBox[{"RegularExpression", "[", "\"\\\\bs\\\\b\"",
                        "]"}], "\[Rule]", "\"sP\""}], ",", RowBox[
                     {RowBox[{"RegularExpression", "[", "\"\\\\bk\\\\b\"",
                        "]"}], "\[Rule]", "\"kP\""}]}], "}"}]}], "]"}], ",",
            "InputForm"}], "]"}]}], ";",
      RowBox[{RowBox[{"printedNumber", "[", RowBox[{"text_String", ",",
            "name_String"}], "]"}], ":=", RowBox[{"Module", "[",
          RowBox[{RowBox[{"{", RowBox[{"hit", "=", RowBox[{"StringCases",
                  "[", RowBox[{"text", ",", RowBox[{RowBox[{"name", "~~",
                        "\" \"", "~~", RowBox[{"v", ":", RowBox[{"(", RowBox[
                          {RowBox[{"(", RowBox[{"DigitCharacter", "|",
                          "\".\"", "|", "\"e\"", "|", "\"-\"", "|",
                          "\"+\""}], ")"}], ".."}], ")"}]}]}],
                      "\[RuleDelayed]", "v"}]}], "]"}]}], "}"}], ",",
            RowBox[{"If", "[", RowBox[{RowBox[{"hit", "===", RowBox[
                   {"{", "}"}]}], ",", RowBox[{"Missing", "[",
                  "\"NotPrinted\"", "]"}], ",", RowBox[{"ToExpression", "[",
                  RowBox[{"StringReplace", "[", RowBox[{RowBox[{"First", "[",
                        "hit", "]"}], ",", RowBox[{"\"e\"", "\[Rule]",
                        "\"*^\""}]}], "]"}], "]"}]}], "]"}]}], "]"}]}], ";",
      RowBox[{"printedReduction", "=", RowBox[{"StringCases", "[",
          RowBox[{RowBox[{"printedValue", "[", "\"reduction\"", "]"}], ",",
            RowBox[{RowBox[{"\"real system a' = \"", "~~", RowBox[
                 {"ra", ":", RowBox[{"Shortest", "[", "__", "]"}]}], "~~",
                "\", b' = \"", "~~", "rb__"}], "\[RuleDelayed]",
              RowBox[{"{", RowBox[{"ra", ",", "rb"}], "}"}]}]}], "]"}]}],
      ";", RowBox[{"printedExchange", "=", RowBox[{"StringCases", "[",
          RowBox[{RowBox[{"printedValue", "[", "\"exchange\"", "]"}], ",",
            RowBox[{RowBox[{"\"e_x = \"", "~~", RowBox[{"ex", ":",
                  RowBox[{"Shortest", "[", "__", "]"}]}], "~~",
                "\" (exact\"", "~~", RowBox[{"Shortest", "[", "__", "]"}],
                "~~", "\"v_s = \"", "~~", RowBox[{"vs", ":", RowBox[
                   {"Shortest", "[", "__", "]"}]}], "~~", "\", v_x = \"",
                "~~", "vx__"}], "\[RuleDelayed]", RowBox[{"{",
                RowBox[{"ex", ",", "vs", ",", "vx"}], "}"}]}]}], "]"}]}],
      ";", RowBox[{"printedPseudo", "=", RowBox[{"StringCases", "[",
          RowBox[{RowBox[{"printedValue", "[", "\"pseudo-potential\"", "]"}],
            ",", RowBox[{RowBox[{"\"M_eff = \"", "~~", RowBox[{"me", ":",
                  RowBox[{"Shortest", "[", "__", "]"}]}], "~~",
                "\", eps -> eps - v_x(y)\"", "~~", "___"}], "\[RuleDelayed]",
              "me"}]}], "]"}]}], ";", RowBox[{"printedTolerances", "=",
        RowBox[{RowBox[{"(", RowBox[{RowBox[{"printedNumber", "[",
                RowBox[{RowBox[{"printedValue", "[", "\"tolerances\"", "]"}],
                  ",", "#1"}], "]"}], "&"}], ")"}], "/@",
          RowBox[{"{", RowBox[{"\"rtol\"", ",", "\"atol\"", ",",
              "\"max_step\""}], "}"}]}]}], ";",
      RowBox[{"expectedRealForm", "=",
        RowBox[{"{", RowBox[{RowBox[{RowBox[{"mP", " ", "aP"}], "+",
              RowBox[{RowBox[{"(", RowBox[{RowBox[{"sP", " ", "epsP"}], "-",
                    RowBox[{"kappaP", " ", "kP"}]}], ")"}], " ", "bP"}]}],
            ",", RowBox[{RowBox[{RowBox[{"-", RowBox[{"(", RowBox[
                     {RowBox[{"sP", " ", "epsP"}], "+", RowBox[{"kappaP",
                        " ", "kP"}]}], ")"}]}], " ", "aP"}], "-",
              RowBox[{"mP", " ", "bP"}]}]}], "}"}]}], ";",
      RowBox[{"engineChecks", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"binaryFound\"", "\[Rule]", RowBox[{
                "FileExistsQ", "[", "binaryPath", "]"}]}], ",",
            RowBox[{"\"exitCodeZero\"", "\[Rule]", RowBox[{RowBox[
                 {"printConfig", "[", "\"ExitCode\"", "]"}], "===", "0"}]}],
            ",", RowBox[{"\"lastLineSUCCESS\"", "\[Rule]",
              RowBox[{RowBox[{"printConfigLines", "=!=", RowBox[{"{",
                    "}"}]}], "&&", RowBox[{RowBox[{"Last", "[",
                    "printConfigLines", "]"}], "===", "\"SUCCESS\""}]}]}],
            ",", RowBox[{"\"printedFixtureHashMatches\"", "\[Rule]",
              RowBox[{RowBox[{"ToLowerCase", "[", RowBox[{"printedValue",
                    "[", "\"fixture sha256\"", "]"}], "]"}], "===",
                "fixtureHash"}]}], ",", RowBox[
             {"\"summariesRecordFixtureHash\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"ToLowerCase", "[", RowBox[
                     {RowBox[{"spectrumSummary", "[", "\"fixture\"", "]"}],
                      "[", "\"sha256\"", "]"}], "]"}], "===",
                  "fixtureHash"}], "&&", RowBox[{RowBox[{"ToLowerCase", "[",
                    RowBox[{RowBox[{"scfSummary", "[", "\"fixture\"", "]"}],
                      "[", "\"sha256\"", "]"}], "]"}], "===",
                  "fixtureHash"}]}]}], ",", RowBox[
             {"\"printedTolerancesMatchSummaries\"", "\[Rule]",
              RowBox[{RowBox[{"AllTrue", "[", RowBox[{"printedTolerances",
                    ",", "NumberQ"}], "]"}], "&&", RowBox[
                 {"printedTolerances", "\[Equal]", RowBox[{"N", "[",
                    RowBox[{"Lookup", "[", RowBox[{RowBox[{"spectrumSummary",
                          "[", "\"tolerances\"", "]"}], ",", RowBox[{"{",
                          RowBox[{"\"rtol\"", ",", "\"atol\"", ",",
                          "\"maxStep\""}], "}"}]}], "]"}], "]"}]}], "&&",
                RowBox[{"printedTolerances", "\[Equal]", RowBox[{"N", "[",
                    RowBox[{"Lookup", "[", RowBox[{RowBox[{"scfSummary", "[",
                          "\"tolerances\"", "]"}], ",", RowBox[{"{", RowBox[
                          {"\"rtol\"", ",", "\"atol\"", ",", "\"maxStep\""}],
                          "}"}]}], "]"}], "]"}]}], "&&", RowBox[
                 {RowBox[{"printedTolerances", "\[LeftDoubleBracket]",
                    RowBox[{"1", ";;", "2"}], "\[RightDoubleBracket]"}],
                  "\[Equal]", RowBox[{"N", "[", RowBox[{"Lookup", "[",
                      RowBox[{RowBox[{"scfRun", "[", "\"parameters\"", "]"}],
                        ",", RowBox[{"{", RowBox[{"\"rtol\"", ",",
                          "\"atol\""}], "}"}]}], "]"}], "]"}]}]}]}], ",",
            RowBox[{"\"printedRealSystemIsDerivedForm\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"Length", "[", "printedReduction",
                    "]"}], "\[Equal]", "1"}], "&&", RowBox[
                 {RowBox[{"Simplify", "[", RowBox[{RowBox[{"printedFormula",
                        "/@", RowBox[{"First", "[", "printedReduction",
                          "]"}]}], "-", "expectedRealForm"}], "]"}], "===",
                  RowBox[{"{", RowBox[{"0", ",", "0"}], "}"}]}], "&&",
                RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"(",
                        RowBox[{RowBox[{"rustRealForm", "[", "sP", "]"}],
                          "/.", "\[VeryThinSpace]", RowBox[{"{", RowBox[
                          {RowBox[{RowBox[{"meff", "[", "yy", "]"}],
                          "\[Rule]", "mP"}], ",", RowBox[{RowBox[{"vv", "[",
                          "yy", "]"}], "\[Rule]", "0"}], ",", RowBox[
                          {RowBox[{"aR", "[", "yy", "]"}], "\[Rule]", "aP"}],
                          ",", RowBox[{RowBox[{"bR", "[", "yy", "]"}],
                          "\[Rule]", "bP"}], ",", RowBox[{"eps", "\[Rule]",
                          "epsP"}], ",", RowBox[{"kk", "\[Rule]", FractionBox[
                          RowBox[{"kP", " ", "kappaP"}], "kappaKS"]}]}],
                          "}"}]}], ")"}], "-", "expectedRealForm"}], "]"}],
                  "===", RowBox[{"{", RowBox[{"0", ",", "0"}], "}"}]}]}]}],
            ",", RowBox[{"\"printedBoundaryConditionsAreDerived\"",
              "\[Rule]", RowBox[{RowBox[{"StringContainsQ", "[",
                  RowBox[{RowBox[{"printedValue", "[", "\"boundary\"", "]"}],
                    ",", "\"b(0) = 0 / a(0) = 0\""}], "]"}], "&&",
                RowBox[{"StringContainsQ", "[", RowBox[{RowBox[
                     {"printedValue", "[", "\"boundary\"", "]"}], ",",
                    "\"b(-L) = 0\""}], "]"}]}]}], ",",
            RowBox[{"\"printedExchangeClosedFormAndPotentials\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"Length", "[", "printedExchange",
                    "]"}], "\[Equal]", "1"}], "&&", RowBox[{"Module", "[",
                  RowBox[{RowBox[{"{", RowBox[{"ex", "=", RowBox[
                         {"printedFormula", "[", RowBox[{"printedExchange",
                          "\[LeftDoubleBracket]", RowBox[{"1", ",", "1"}],
                          "\[RightDoubleBracket]"}], "]"}]}], "}"}], ",",
                    RowBox[{RowBox[{RowBox[{"Simplify", "[", RowBox[{"ex",
                          "+", RowBox[{FractionBox["1", "32"], " ", "lamP",
                          " ", RowBox[{"(", RowBox[{SuperscriptBox["ndP",
                          "2"], "+", SuperscriptBox["sdP", "2"]}], ")"}]}]}],
                          "]"}], "===", "0"}], "&&", RowBox[{RowBox[
                         {"Simplify", "[", RowBox[{RowBox[{SubscriptBox[
                          "\[PartialD]", RowBox[{"sdP"}]], "ex"}], "-",
                          RowBox[{"printedFormula", "[", RowBox[
                          {"printedExchange", "\[LeftDoubleBracket]", RowBox[
                          {"1", ",", "2"}], "\[RightDoubleBracket]"}],
                          "]"}]}], "]"}], "===", "0"}], "&&", RowBox[
                       {RowBox[{"Simplify", "[", RowBox[{RowBox[{SubscriptBox[
                          "\[PartialD]", RowBox[{"ndP"}]], "ex"}], "-",
                          RowBox[{"printedFormula", "[", RowBox[
                          {"printedExchange", "\[LeftDoubleBracket]", RowBox[
                          {"1", ",", "3"}], "\[RightDoubleBracket]"}],
                          "]"}]}], "]"}], "===", "0"}]}]}], "]"}]}]}], ",",
            RowBox[{"\"printedPseudoPotentialIsHartreePlusExchange\"",
              "\[Rule]", RowBox[{RowBox[{RowBox[{"Length", "[",
                    "printedPseudo", "]"}], "\[Equal]", "1"}], "&&",
                RowBox[{RowBox[{"Length", "[", "printedExchange", "]"}],
                  "\[Equal]", "1"}], "&&", RowBox[{RowBox[{"Simplify", "[",
                    RowBox[{RowBox[{"printedFormula", "[", RowBox[{"First",
                          "[", "printedPseudo", "]"}], "]"}], "-", RowBox[
                       {"(", RowBox[{"mP", "+", RowBox[{"lamP", " ", "sdP"}],
                          "+", RowBox[{SubscriptBox["\[PartialD]", RowBox[
                          {"sdP"}]], RowBox[{"printedFormula", "[", RowBox[
                          {"printedExchange", "\[LeftDoubleBracket]", RowBox[
                          {"1", ",", "1"}], "\[RightDoubleBracket]"}],
                          "]"}]}]}], ")"}]}], "]"}], "===", "0"}]}]}], ",",
            RowBox[{"\"printedMixingMatchesRun\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"printedNumber", "[", RowBox[
                     {RowBox[{"printedValue", "[", "\"mixing\"", "]"}], ",",
                      "\"beta\""}], "]"}], "\[Equal]", RowBox[{"N", "[",
                    RowBox[{RowBox[{"scfRun", "[", "\"parameters\"", "]"}],
                      "[", "\"mixBeta\"", "]"}], "]"}]}], "&&",
                RowBox[{RowBox[{"printedNumber", "[", RowBox[{RowBox[
                       {"printedValue", "[", "\"mixing\"", "]"}], ",",
                      "\"history\""}], "]"}], "\[Equal]", RowBox[{"N", "[",
                    RowBox[{RowBox[{"scfRun", "[", "\"parameters\"", "]"}],
                      "[", "\"mixHistory\"", "]"}], "]"}]}], "&&",
                RowBox[{RowBox[{"printedNumber", "[", RowBox[{RowBox[
                       {"printedValue", "[", "\"mixing\"", "]"}], ",",
                      "\"tolerance\""}], "]"}], "\[Equal]", RowBox[
                   {"N", "[", RowBox[{RowBox[{"scfRun", "[",
                        "\"parameters\"", "]"}], "[", "\"tol\"", "]"}],
                    "]"}]}]}]}]}], "]"}]}], ";",
      RowBox[{"{", RowBox[{RowBox[{"Select", "[", RowBox[{"printConfigLines",
              ",", RowBox[{RowBox[{"StringStartsQ", "[", RowBox[{"#1", ",",
                    RowBox[{"\"reduction\"", "|", "\"boundary\"", "|",
                      "\"exchange\"", "|", "\"pseudo-potential\""}]}], "]"}],
                "&"}]}], "]"}], ",", "engineChecks"}], "}"}]}]], "Input"],
  Cell["Figures", "Section"], Cell["Rust CVODE values are drawn as dots, the \
Mathematica computation (exact formulas, NDSolve shooting, the Wolfram \
Language loop) as lines. Colours follow a fixed categorical order (blue, \
orange, aqua, yellow), axes and grid are recessive, every plot with two or \
more series carries a legend, and every plotted number is also in the report. \
The PNG files go to artifacts/dirac16complex/kohn-sham/figures/mathematica/. \
As in the Stage-3 notebook, the one message a headless kernel can print at \
the first PNG export (ImportExport`RegisterFormat::interr, the optional \
ImageMetadataTools paclet cannot be installed) is quieted by name (the PNG is \
written regardless), and the PNG text chunk \"Creation Time\" is removed so \
that repeated runs give byte-identical files.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"vizColors", "=",
        RowBox[{"RGBColor", "/@", RowBox[{"{", RowBox[{"\"#2a78d6\"", ",",
              "\"#eb6834\"", ",", "\"#1baf7a\"", ",", "\"#eda100\""}],
            "}"}]}]}], ";", RowBox[{"vizMuted", "=",
        RowBox[{"RGBColor", "[", "\"#898781\"", "]"}]}], ";",
      RowBox[{RowBox[{"vizStyle", "[", RowBox[{"title_String", ",",
            "xlabel_", ",", "ylabel_"}], "]"}], ":=",
        RowBox[{"{", RowBox[{RowBox[{"Frame", "\[Rule]", "True"}], ",",
