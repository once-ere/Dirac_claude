                          "]"}], ";", RowBox[{"i", "=", "j"}]}]}], "]"}]}],
                "]"}], ";", RowBox[{"lowest", "=", RowBox[{"Min", "/@",
                  RowBox[{"Values", "[", RowBox[{"GroupBy", "[", RowBox[
