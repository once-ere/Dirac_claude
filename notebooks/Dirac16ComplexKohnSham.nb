                      RowBox[{"rustBlockLabels", "\[LeftDoubleBracket]",
                        RowBox[{"All", ",", "1"}],
                        "\[RightDoubleBracket]"}]}], "]"}], "]"}]}]}], ",",
            RowBox[{"\"rustLabelC1IsIGamma2Gamma3\"", "\[Rule]",
              RowBox[{"rustC1", "===", RowBox[{"DiagonalMatrix", "[",
