                          {RowBox[{"#1", "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "-", "target"}], "]"}],
                          "&"}]}], "]"}], "]"}], "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}]}], "]"}]}]}], "]"}]}]}],
          "]"}]}], ";", RowBox[{"closedShellResults", "=",
        RowBox[{"AssociationMap", "[", RowBox[{"closedShellRun", ",",
