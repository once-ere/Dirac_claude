                    RowBox[{RowBox[{RowBox[{"Simplify", "[", RowBox[
                          {RowBox[{"realFormFromBlock", "[", "#1", "]"}],
                          "-", RowBox[{"rustRealForm", "[", RowBox[{"-",
                          "#1"}], "]"}]}], "]"}], "===", RowBox[{"{",
                          RowBox[{"0", ",", "0"}], "}"}]}], "&"}]}], "]"}],
                "&&", RowBox[{RowBox[{"Simplify", "[", RowBox[
                     {RowBox[{"realFormFromBlock", "[", "1", "]"}], "-",
                      RowBox[{"rustRealForm", "[", "1", "]"}]}], "]"}],
                  "=!=", RowBox[{"{", RowBox[{"0", ",", "0"}], "}"}]}]}]}],
            ",", RowBox[{"\"sMinusOneIsMirrorOfSPlusOne\"", "\[Rule]",
              RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[
                     {"rustRealForm", "[", RowBox[{"-", "1"}], "]"}], "-",
                    RowBox[{"(", RowBox[{RowBox[{"rustRealForm", "[", "1",
                          "]"}], "/.", "\[VeryThinSpace]", RowBox[{"{",
                          RowBox[{RowBox[{"eps", "\[Rule]", RowBox[{"-",
                          "eps"}]}], ",", RowBox[{RowBox[{"vv", "[", "yy",
                          "]"}], "\[Rule]", RowBox[{"-", RowBox[{"vv", "[",
                          "yy", "]"}]}]}]}], "}"}]}], ")"}]}], "]"}], "===",
                RowBox[{"{", RowBox[{"0", ",", "0"}], "}"}]}]}], ",",
            RowBox[{"\"scalarDensityIsMinus2sab\"", "\[Rule]",
              RowBox[{"AllTrue", "[", RowBox[{RowBox[{"{", RowBox[{"1", ",",
                      RowBox[{"-", "1"}]}], "}"}], ",", RowBox[
                   {RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[
                          {"ComplexExpand", "[", RowBox[{RowBox[{"Conjugate",
                          "[", "realPair", "]"}], ".", RowBox[{"(", RowBox[
                          {"#1", " ", "sigma2"}], ")"}], ".", "realPair"}],
                          "]"}], "-", RowBox[{RowBox[{"-", "2"}], " ",
                          RowBox[{"(", RowBox[{"-", "#1"}], ")"}], " ",
                          RowBox[{"aR", "[", "yy", "]"}], " ", RowBox[{"bR",
                          "[", "yy", "]"}]}]}], "]"}], "===", "0"}], "&"}]}],
                "]"}]}], ",", RowBox[{"\"numberDensityIsA2PlusB2\"",
              "\[Rule]", RowBox[{RowBox[{"Simplify", "[", RowBox[
                   {RowBox[{"ComplexExpand", "[", RowBox[{RowBox[
                         {"Conjugate", "[", "realPair", "]"}], ".",
                        "realPair"}], "]"}], "-", RowBox[{"(", RowBox[
                       {SuperscriptBox[RowBox[{"aR", "[", "yy", "]"}], "2"],
                        "+", SuperscriptBox[RowBox[{"bR", "[", "yy", "]"}],
                         "2"]}], ")"}]}], "]"}], "===", "0"}]}], ",",
            RowBox[{"\"rustGammasEqualPackage\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"Length", "[", "rustGammaValuesKS",
                    "]"}], "\[Equal]", RowBox[{"8", " ", "16", " ", "16"}]}],
                "&&", RowBox[{RowBox[{"ArrayReshape", "[", RowBox[
                     {RowBox[{"Round", "[", "rustGammaValuesKS", "]"}], ",",
                      RowBox[{"{", RowBox[{"8", ",", "16", ",", "16"}],
                        "}"}]}], "]"}], "===", "gammas"}], "&&",
                RowBox[{RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[
                       {"rustGammaValuesKS", "-", RowBox[{"Round", "[",
                          "rustGammaValuesKS", "]"}]}], "]"}], "]"}],
                  "\[Equal]", "0"}]}]}], ",", RowBox[
             {"\"rustFixtureHashIsFixture\"", "\[Rule]", RowBox[{
                RowBox[{"First", "[", RowBox[{"StringCases", "[", RowBox[
                     {"generatedKS", ",", RowBox[{RowBox[
                         {"\"FIXTURE_SHA256: &str = \\\"\"", "~~", RowBox[
                          {"h", ":", RowBox[{"(", RowBox[
                          {"HexadecimalCharacter", ".."}], ")"}]}], "~~",
                          "\"\\\"\""}], "\[RuleDelayed]", RowBox[
                         {"ToLowerCase", "[", "h", "]"}]}]}], "]"}], "]"}],
                "===", "fixtureHash"}]}], ",", RowBox[
             {"\"rustBasisUnitary\"", "\[Rule]", RowBox[{RowBox[{"Simplify",
                  "[", RowBox[{TemplateBox[{"rustBasis"},
                     "ConjugateTranspose", SyntaxForm -> SuperscriptBox],
                    ".", "rustBasis"}], "]"}], "===", "id16"}]}], ",",
            RowBox[{"\"rustBasisBlockDiagonalisesWithJMinusS\"", "\[Rule]",
              RowBox[{RowBox[{"AllTrue", "[", RowBox[{RowBox[
                     {"offBlockEntries", "[", "rustOdeBlocks", "]"}], ",",
                    RowBox[{RowBox[{"#1", "===", "0"}], "&"}]}], "]"}], "&&",
                RowBox[{"AllTrue", "[", RowBox[{RowBox[{"Range", "[", "8",
                      "]"}], ",", RowBox[{RowBox[{RowBox[{"Simplify", "[",
                          RowBox[{RowBox[{"blockPart", "[", RowBox[
                          {"rustOdeBlocks", ",", "#1"}], "]"}], "-", RowBox[
                          {"blockFormula", "[", RowBox[{"-", RowBox[
                          {"rustBlockLabels", "\[LeftDoubleBracket]", RowBox[
                          {"#1", ",", "1"}], "\[RightDoubleBracket]"}]}],
                          "]"}]}], "]"}], "===", "zero2"}], "&"}]}],
