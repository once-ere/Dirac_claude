              "\[Rule]", RowBox[{RowBox[{"closedForm2", "[", "\"evolution\"",
                  "]"}], "&&", RowBox[{"closedForm2", "[", "\"volumeRate\"",
                  "]"}]}]}], ",", RowBox[
