                          {RowBox[{"hilbertN", "[", RowBox[{"complexSpinor",
                          "[", "#1", "]"}], "]"}], ",", "1.`"}], "]"}]],
                          "&"}], ")"}], "/@", "nd"}], "]"}]}], ";",
                    RowBox[{"tStar", "=", RowBox[{"Log", "[", FractionBox[
                         "exp5Mass", "q"], "]"}]}], ";", RowBox[{"iA", "=",
                      RowBox[{"First", "[", RowBox[{"FirstPosition", "[",
                          RowBox[{"ts", ",", RowBox[{"tt_", "/;", RowBox[
                          {"tt", "\[GreaterEqual]", RowBox[{"tStar", "+",
                          "1.5`"}]}]}], ",", RowBox[{"{", "1", "}"}]}],
                          "]"}], "]"}]}], ";", RowBox[{"iB", "=", RowBox[
                       {"Length", "[", "ts", "]"}]}], ";", RowBox[{"growthR",
                      "=", RowBox[{RowBox[{"Log", "[", RowBox[{"hilbertN",
                          "[", RowBox[{"complexSpinor", "[", RowBox[{"ys",
                          "\[LeftDoubleBracket]", "iB",
                          "\[RightDoubleBracket]"}], "]"}], "]"}], "]"}],
                        "-", RowBox[{"Log", "[", RowBox[{"hilbertN", "[",
                          RowBox[{"complexSpinor", "[", RowBox[{"ys",
                          "\[LeftDoubleBracket]", "iA",
                          "\[RightDoubleBracket]"}], "]"}], "]"}], "]"}]}]}],
                    ";", RowBox[{"growthN", "=", RowBox[{RowBox[{"Log", "[",
                          RowBox[{"hilbertN", "[", RowBox[{"complexSpinor",
                          "[", RowBox[{"nd", "\[LeftDoubleBracket]", "iB",
                          "\[RightDoubleBracket]"}], "]"}], "]"}], "]"}],
                        "-", RowBox[{"Log", "[", RowBox[{"hilbertN", "[",
                          RowBox[{"complexSpinor", "[", RowBox[{"nd",
                          "\[LeftDoubleBracket]", "iA",
                          "\[RightDoubleBracket]"}], "]"}], "]"}], "]"}]}]}],
                    ";", RowBox[{"lead", "=", RowBox[{"2", " ", RowBox[
