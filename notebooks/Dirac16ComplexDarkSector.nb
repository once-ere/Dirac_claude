                "]"}], "&"}], ")"}], "/@", "exp5RunResults"}], "]"}]}]],
   "Input"],
  Cell[BoxData[RowBox[{RowBox[{"exp5Result", "=",
        RowBox[{"Association", "[", RowBox[{RowBox[{"\"symbolic\"",
              "\[Rule]", "exp5Symbolic"}], ",", RowBox[{"\"runCount\"",
