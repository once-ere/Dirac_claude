                          "\[RightDoubleBracket]"}], "]"}]}]}], ";",
                    RowBox[{"first", "=", RowBox[{"lead", "-", RowBox[
                         {FractionBox["1", "2"], " ", RowBox[{"(", RowBox[
                          {RowBox[{"Log", "[", RowBox[{"1", "-", FractionBox[
                          SuperscriptBox["exp5Mass", "2"], SuperscriptBox[
                          "qb", "2"]]}], "]"}], "-", RowBox[{"Log", "[",
                          RowBox[{"1", "-", FractionBox[SuperscriptBox[
                          "exp5Mass", "2"], SuperscriptBox["qa", "2"]]}],
                          "]"}]}], ")"}]}]}]}], ";", RowBox[{"high", "=",
                      RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"spec", "[",
                          "\"id\"", "]"}], "===", "\"q0p1_Cp\""}], ",",
                          RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                          {"hp", "=", RowBox[{"integrateLinear", "[", RowBox[
                          {RowBox[{RowBox[{"SetPrecision", "[", RowBox[
                          {"exp5Mass", ",", "\[Infinity]"}], "]"}], " ",
                          "exp5GenM"}], ",", "exp5GenQ", ",", RowBox[
                          {"Function", "[", RowBox[{RowBox[{"{", "tt", "}"}],
                          ",", RowBox[{RowBox[{"SetPrecision", "[", RowBox[
