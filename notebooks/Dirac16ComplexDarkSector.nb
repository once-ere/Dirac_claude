                  ",", RowBox[{"\"maxKreinDriftNormalised\"", "\[Rule]",
                    RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"#1", "[", "\"kreinDriftNormalised\"",
                          "]"}], "&"}], ")"}], "/@", RowBox[{"Values", "[",
                          "exp5RunResults", "]"}]}], "]"}]}], ",",
                  RowBox[{"\"maxRelDevNDSolveVsRustGrowth\"", "\[Rule]",
                    RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"#1", "[",
                          "\"relDevNDSolveVsRustGrowth\"", "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Values", "[",
                          "exp5RunResults", "]"}]}], "]"}]}]}], "]"}]}], ",",
            RowBox[{"\"wkb\"", "\[Rule]", RowBox[{RowBox[{"(", RowBox[
                   {RowBox[{"KeyTake", "[", RowBox[{"#1", ",", RowBox[
                         {"{", RowBox[{"\"lnNormGrowthRust\"", ",",
                          "\"wkbLeading\"", ",", "\"wkbFirstOrder\"", ",",
                          "\"relDevRustVsWkbLeading\"", ",",
                          "\"relDevRustVsWkbFirstOrder\"", ",",
                          "\"finalNormHilbertRust\""}], "}"}]}], "]"}],
                    "&"}], ")"}], "/@", "exp5RunResults"}]}]}], "]"}]}], ";",
      RowBox[{"exp5Checks", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"exp5SymbolicReduction\"", "\[Rule]",
              RowBox[{"And", "@@", RowBox[{"Values", "[", "exp5Symbolic",
                  "]"}]}]}], ",", RowBox[{"\"exp5FiniteDifferenceRHS\"",
              "\[Rule]", RowBox[{RowBox[{"exp5Result", "[",
                  "\"finiteDifference\"", "]"}], "[", "\"allPass\"", "]"}]}],
            ",", RowBox[{"\"exp5NDSolveAgreement\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{RowBox[{"exp5Result", "[",
                      "\"ndsolve\"", "]"}], "[",
                    "\"maxRelativeStateDeviation\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "6"]]}], "&&",
                RowBox[{RowBox[{RowBox[{"exp5Result", "[", "\"ndsolve\"",
                      "]"}], "[", "\"ndsolveSelfRelativeError\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "9"]]}], "&&", RowBox[{RowBox[{RowBox[{"exp5Result", "[",
                      "\"ndsolve\"", "]"}], "[",
                    "\"maxKreinDriftNormalised\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "9"]]}]}]}], ",",
            RowBox[{"\"exp5WKBGrowth\"", "\[Rule]", RowBox[{"AllTrue", "[",
                RowBox[{RowBox[{"Values", "[", "exp5RunResults", "]"}], ",",
                  RowBox[{RowBox[{RowBox[{RowBox[{"Abs", "[", RowBox[{"#1",
                          "[", "\"relDevRustVsWkbLeading\"", "]"}], "]"}],
                        "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                          "2"]]}], "&&", RowBox[{RowBox[{"Abs", "[", RowBox[
                          {"#1", "[", "\"relDevRustVsWkbFirstOrder\"", "]"}],
                          "]"}], "\[LessEqual]", FractionBox["2",
                         SuperscriptBox["10", "3"]]}]}], "&"}]}], "]"}]}]}],
          "]"}]}], ";", RowBox[
       {"{", RowBox[{RowBox[{"exp5Result", "[", "\"finiteDifference\"",
            "]"}], ",", RowBox[{"exp5Result", "[", "\"ndsolve\"", "]"}], ",",
          "exp5Checks"}], "}"}]}]], "Input"],
  Cell["The Rust binary: print-config", "Section"],
  Cell["The binary is expected at \
studies/dirac16complex_cosmology/target/release/ (build it with cargo build \
--release in that directory). RunProcess runs print-config; the \
planet_Mercury-style contract requires exit code 0 and SUCCESS as the last \
stdout line. The printed fixture hash and default tolerances are compared \
with generated.rs, the fixture file and the committed summary.json files.",
   "Text"],
  Cell[BoxData[RowBox[{RowBox[{"binaryPath", "=",
        RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"repositoryRoot",
              ",", "\"studies\"", ",", "\"dirac16complex_cosmology\"", ",",
              "\"target\"", ",", "\"release\"", ",", RowBox[{"If", "[",
                RowBox[{RowBox[{"$OperatingSystem", "===", "\"Windows\""}],
                  ",", "\"dirac16complex_cosmology.exe\"", ",",
                  "\"dirac16complex_cosmology\""}], "]"}]}], "}"}], "]"}]}],
      ";", RowBox[{"printConfig", "=", RowBox[{"If", "[",
          RowBox[{RowBox[{"FileExistsQ", "[", "binaryPath", "]"}], ",",
            RowBox[{"RunProcess", "[", RowBox[{RowBox[{"{", RowBox[
                   {"binaryPath", ",", "\"print-config\""}], "}"}], ",",
                RowBox[{"ProcessDirectory", "\[Rule]", "repositoryRoot"}]}],
              "]"}], ",", RowBox[{"Association", "[", RowBox[{RowBox[
                 {"\"ExitCode\"", "\[Rule]", RowBox[{"-", "1"}]}], ",",
                RowBox[{"\"StandardOutput\"", "\[Rule]", "\"\""}], ",",
                RowBox[{"\"StandardError\"", "\[Rule]", RowBox[
                   {"\"binary not found: \"", "<>", "binaryPath"}]}]}],
              "]"}]}], "]"}]}], ";", RowBox[{"printConfigLines", "=",
        RowBox[{"Select", "[", RowBox[{RowBox[{"StringTrim", "/@",
              RowBox[{"StringSplit", "[", RowBox[{RowBox[{"printConfig", "[",
                    "\"StandardOutput\"", "]"}], ",", RowBox[{"{",
                    RowBox[{"\"\\r\\n\"", ",", "\"\\n\""}], "}"}]}], "]"}]}],
            ",", RowBox[{RowBox[{"#1", "=!=", "\"\""}], "&"}]}], "]"}]}],
      ";", RowBox[{"printedHash", "=", RowBox[{"StringCases", "[",
          RowBox[{RowBox[{"StringJoin", "[", RowBox[{"Riffle", "[",
                RowBox[{"printConfigLines", ",", "\"\\n\""}], "]"}], "]"}],
            ",", RowBox[{RowBox[{"\"fixture sha256\"", "~~", "Whitespace",
                "~~", "\"=\"", "~~", "Whitespace", "~~", RowBox[{"hash", ":",
                  RowBox[{"(", RowBox[{"HexadecimalCharacter", ".."}],
                    ")"}]}]}], "\[RuleDelayed]", RowBox[{"ToLowerCase", "[",
                "hash", "]"}]}]}], "]"}]}], ";",
      RowBox[{RowBox[{"printedTolerance", "[", "e_String", "]"}], ":=",
        RowBox[{"First", "[", RowBox[{RowBox[{"StringCases", "[",
              RowBox[{RowBox[{"SelectFirst", "[", RowBox[{"printConfigLines",
                    ",", RowBox[{RowBox[{"StringStartsQ", "[", RowBox[
                         {"#1", ",", RowBox[{"e", "<>",
                          "\": default rtol\""}]}], "]"}], "&"}], ",",
                    "\"\""}], "]"}], ",", RowBox[{RowBox[{"\"rtol = \"",
                    "~~", RowBox[{"v", ":", RowBox[{"(", RowBox[{RowBox[
                          {"Except", "[", "\",\"", "]"}], ".."}], ")"}]}],
                    "~~", "\",\""}], "\[RuleDelayed]", RowBox[
                   {"ToExpression", "[", RowBox[{"StringReplace", "[",
                      RowBox[{"v", ",", RowBox[{"\"e\"", "\[Rule]",
                          "\"*^\""}]}], "]"}], "]"}]}]}], "]"}], ",",
            RowBox[{"Missing", "[", "\"NotPrinted\"", "]"}]}], "]"}]}], ";",
      RowBox[{"engineChecks", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"binaryFound\"", "\[Rule]", RowBox[{
                "FileExistsQ", "[", "binaryPath", "]"}]}], ",",
            RowBox[{"\"exitCodeZero\"", "\[Rule]", RowBox[{RowBox[
                 {"printConfig", "[", "\"ExitCode\"", "]"}], "===", "0"}]}],
            ",", RowBox[{"\"lastLineSUCCESS\"", "\[Rule]",
              RowBox[{RowBox[{"printConfigLines", "=!=", RowBox[{"{",
                    "}"}]}], "&&", RowBox[{RowBox[{"Last", "[",
                    "printConfigLines", "]"}], "===", "\"SUCCESS\""}]}]}],
            ",", RowBox[{"\"printedFixtureHashMatches\"", "\[Rule]",
              RowBox[{"printedHash", "===", RowBox[{"{", "fixtureHash",
                  "}"}]}]}], ",", RowBox[{"\"summariesRecordFixtureHash\"",
              "\[Rule]", RowBox[{"AllTrue", "[", RowBox[{"experiments", ",",
                  RowBox[{RowBox[{RowBox[{"ToLowerCase", "[", RowBox[
                         {RowBox[{RowBox[{"summaries", "[", "#1", "]"}], "[",
                          "\"fixture\"", "]"}], "[", "\"sha256\"", "]"}],
                        "]"}], "===", "fixtureHash"}], "&"}]}], "]"}]}], ",",
            RowBox[{"\"printedTolerancesMatchSummaries\"", "\[Rule]",
              RowBox[{"AllTrue", "[", RowBox[{"experiments", ",",
                  RowBox[{RowBox[{RowBox[{"NumberQ", "[", RowBox[
                         {"printedTolerance", "[", "#1", "]"}], "]"}], "&&",
                      RowBox[{RowBox[{"Abs", "[", RowBox[{RowBox[
                          {"printedTolerance", "[", "#1", "]"}], "-", RowBox[
                          {"rustTolerance", "[", "#1", "]"}]}], "]"}],
                        "\[LessEqual]", FractionBox[RowBox[{"rustTolerance",
                          "[", "#1", "]"}], SuperscriptBox["10", "15"]]}]}],
                    "&"}]}], "]"}]}]}], "]"}]}], ";",
      RowBox[{"{", RowBox[{RowBox[{"printConfigLines",
            "\[LeftDoubleBracket]", RowBox[{RowBox[{"-", "3"}], ";;",
              "All"}], "\[RightDoubleBracket]"}], ",", "engineChecks"}],
        "}"}]}]], "Input"], Cell["Figures", "Section"],
  Cell["Rust CVODE samples are drawn as dots, the Mathematica computation \
(NDSolve or NIntegrate) as lines. Colours follow a fixed categorical order \
(blue, orange, aqua, yellow, magenta), axes and grid are recessive, and every \
plot with two or more series carries a legend. The PNG files go to \
artifacts/dirac16complex/numerics/figures/mathematica/. In a headless kernel \
the first PNG export can report that the optional ImageMetadataTools paclet \
cannot be installed (ImportExport`RegisterFormat::interr); that single \
message is quieted by name (the PNG is written regardless), and the PNG text \
chunk \"Creation Time\" is removed so that repeated runs give byte-identical \
files.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"vizColors", "=",
        RowBox[{"RGBColor", "/@", RowBox[{"{", RowBox[{"\"#2a78d6\"", ",",
              "\"#eb6834\"", ",", "\"#1baf7a\"", ",", "\"#eda100\"", ",",
              "\"#e87ba4\""}], "}"}]}]}], ";",
      RowBox[{"vizMuted", "=", RowBox[{"RGBColor", "[", "\"#898781\"",
          "]"}]}], ";", RowBox[{RowBox[{"vizStyle", "[",
          RowBox[{"title_String", ",", "xlabel_", ",", "ylabel_"}], "]"}],
        ":=", RowBox[{"{", RowBox[{RowBox[{"Frame", "\[Rule]", "True"}], ",",
            RowBox[{"Axes", "\[Rule]", "False"}], ",",
            RowBox[{"Background", "\[Rule]", RowBox[{"RGBColor", "[",
                "\"#fcfcfb\"", "]"}]}], ",", RowBox[{"ImageSize", "\[Rule]",
              "760"}], ",", RowBox[{"AspectRatio", "\[Rule]", "0.58`"}], ",",
            RowBox[{"FrameStyle", "\[Rule]", RowBox[{"Directive", "[",
                RowBox[{RowBox[{"RGBColor", "[", "\"#c3c2b7\"", "]"}], ",",
                  RowBox[{"AbsoluteThickness", "[", "1", "]"}]}], "]"}]}],
            ",", RowBox[{"FrameTicksStyle", "\[Rule]", RowBox[{"Directive",
                "[", RowBox[{RowBox[{"RGBColor", "[", "\"#52514e\"", "]"}],
                  ",", RowBox[{"FontFamily", "\[Rule]", "\"Arial\""}], ",",
                  RowBox[{"FontSize", "\[Rule]", "12"}]}], "]"}]}], ",",
            RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",",
            RowBox[{"GridLinesStyle", "\[Rule]", RowBox[{"Directive", "[",
                RowBox[{RowBox[{"RGBColor", "[", "\"#e1e0d9\"", "]"}], ",",
                  RowBox[{"AbsoluteThickness", "[", "0.6`", "]"}]}], "]"}]}],
            ",", RowBox[{"FrameLabel", "\[Rule]", RowBox[{"{",
                RowBox[{RowBox[{"Style", "[", RowBox[{"xlabel", ",",
                      RowBox[{"RGBColor", "[", "\"#52514e\"", "]"}], ",",
                      RowBox[{"FontFamily", "\[Rule]", "\"Arial\""}], ",",
                      "13"}], "]"}], ",", RowBox[{"Style", "[", RowBox[
                     {"ylabel", ",", RowBox[{"RGBColor", "[", "\"#52514e\"",
                        "]"}], ",", RowBox[{"FontFamily", "\[Rule]",
                        "\"Arial\""}], ",", "13"}], "]"}]}], "}"}]}], ",",
            RowBox[{"PlotLabel", "\[Rule]", RowBox[{"Style", "[",
                RowBox[{"title", ",", RowBox[{"RGBColor", "[", "\"#0b0b0b\"",
                    "]"}], ",", RowBox[{"FontFamily", "\[Rule]",
                    "\"Arial\""}], ",", "14"}], "]"}]}], ",",
            RowBox[{"LabelStyle", "\[Rule]", RowBox[{"Directive", "[",
                RowBox[{RowBox[{"RGBColor", "[", "\"#0b0b0b\"", "]"}], ",",
                  RowBox[{"FontFamily", "\[Rule]", "\"Arial\""}], ",",
                  RowBox[{"FontSize", "\[Rule]", "12"}]}], "]"}]}], ",",
            RowBox[{"ImagePadding", "\[Rule]", RowBox[{"{", RowBox[
                 {RowBox[{"{", RowBox[{"70", ",", "20"}], "}"}], ",",
                  RowBox[{"{", RowBox[{"55", ",", "35"}], "}"}]}], "}"}]}]}],
          "}"}]}], ";", RowBox[{RowBox[{"dotLineLegend", "[",
          RowBox[{"labels_List", ",", "colors_List", ",", "kinds_List"}],
          "]"}], ":=", RowBox[{"Placed", "[",
          RowBox[{RowBox[{"SwatchLegend", "[", RowBox[{"colors", ",",
                "labels", ",", RowBox[{"LegendMarkers", "\[Rule]",
                  RowBox[{RowBox[{"(", RowBox[{RowBox[{"If", "[", RowBox[
                          {RowBox[{"#1", "===", "\"dot\""}], ",", GraphicsBox[
                          {DiskBox[{0, 0}]}], ",", GraphicsBox[
                          {AbsoluteThickness[2.5], LineBox[{{-1, 0}, {1,
                          0}}]}]}], "]"}], "&"}], ")"}], "/@", "kinds"}]}],
                ",", RowBox[{"LegendMarkerSize", "\[Rule]", "16"}], ",",
                RowBox[{"LabelStyle", "\[Rule]", RowBox[{"Directive", "[",
                    RowBox[{RowBox[{"RGBColor", "[", "\"#0b0b0b\"", "]"}],
                      ",", RowBox[{"FontFamily", "\[Rule]", "\"Arial\""}],
                      ",", RowBox[{"FontSize", "\[Rule]", "12"}]}], "]"}]}],
                ",", RowBox[{"LegendLayout", "\[Rule]", RowBox[{"{",
                    RowBox[{"\"Row\"", ",", "2"}], "}"}]}]}], "]"}], ",",
            "Below"}], "]"}]}], ";",
      RowBox[{RowBox[{"exportFigure", "[", RowBox[{"name_String", ",",
            "graphic_"}], "]"}], ":=", RowBox[{"Module", "[",
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"path", "=", RowBox[
                   {"FileNameJoin", "[", RowBox[{"{", RowBox[
                       {"figureDirectory", ",", "name"}], "}"}], "]"}]}],
                ",", "bytes", ",", "out", ",", RowBox[{"i", "=", "9"}], ",",
                "n", ",", "type", ",", "stream"}], "}"}], ",",
            RowBox[{RowBox[{"Quiet", "[", RowBox[{RowBox[{"Export", "[",
                    RowBox[{"path", ",", "graphic", ",", "\"PNG\"", ",",
                      RowBox[{"ImageResolution", "\[Rule]", "110"}]}], "]"}],
                  ",", RowBox[{"{", StyleBox[RowBox[
                      {"ImportExport`RegisterFormat", "::", "interr"}],
                     "MessageName"], "}"}]}], "]"}], ";", RowBox[{"bytes",
                "=", RowBox[{"Normal", "[", RowBox[{"ReadByteArray", "[",
                    "path", "]"}], "]"}]}], ";", RowBox[{"out", "=",
                RowBox[{"Take", "[", RowBox[{"bytes", ",", "8"}], "]"}]}],
              ";", RowBox[{"While", "[", RowBox[{RowBox[{"i", "\[LessEqual]",
                    RowBox[{"Length", "[", "bytes", "]"}]}], ",",
                  RowBox[{RowBox[{"n", "=", RowBox[{"FromDigits", "[",
                        RowBox[{RowBox[{"bytes", "\[LeftDoubleBracket]",
                          RowBox[{"i", ";;", RowBox[{"i", "+", "3"}]}],
                          "\[RightDoubleBracket]"}], ",", "256"}], "]"}]}],
                    ";", RowBox[{"type", "=", RowBox[{"FromCharacterCode",
                        "[", RowBox[{"bytes", "\[LeftDoubleBracket]",
                          RowBox[{RowBox[{"i", "+", "4"}], ";;", RowBox[
                          {"i", "+", "7"}]}], "\[RightDoubleBracket]"}],
                        "]"}]}], ";", RowBox[{"If", "[", RowBox[
                       {RowBox[{"!", RowBox[{"(", RowBox[{RowBox[{"type",
                          "===", "\"tEXt\""}], "&&", RowBox[{"StringStartsQ",
                          "[", RowBox[{RowBox[{"FromCharacterCode", "[",
                          RowBox[{"bytes", "\[LeftDoubleBracket]", RowBox[
                          {RowBox[{"i", "+", "8"}], ";;", RowBox[{"i", "+",
                          "7", "+", "n"}]}], "\[RightDoubleBracket]"}],
                          "]"}], ",", "\"Creation Time\""}], "]"}]}],
                          ")"}]}], ",", RowBox[{"out", "=", RowBox[{"Join",
                          "[", RowBox[{"out", ",", RowBox[{"bytes",
                          "\[LeftDoubleBracket]", RowBox[{"i", ";;", RowBox[
                          {"i", "+", "11", "+", "n"}]}],
                          "\[RightDoubleBracket]"}]}], "]"}]}]}], "]"}], ";",
                    RowBox[{"i", "+=", RowBox[{"12", "+", "n"}]}]}]}], "]"}],
              ";", RowBox[{"stream", "=", RowBox[{"OpenWrite", "[",
                  RowBox[{"path", ",", RowBox[{"BinaryFormat", "\[Rule]",
                      "True"}]}], "]"}]}], ";", RowBox[{"BinaryWrite", "[",
                RowBox[{"stream", ",", "out"}], "]"}], ";", RowBox[{"Close",
                "[", "stream", "]"}], ";", "name"}]}], "]"}]}], ";",
      RowBox[{"figureFiles", "=", RowBox[{"{", "}"}]}], ";",
      RowBox[{RowBox[{"numberLabel", "[", "x_", "]"}], ":=",
        RowBox[{"If", "[", RowBox[{RowBox[{"x", "\[Equal]", RowBox[{"Round",
                "[", "x", "]"}]}], ",", RowBox[{"ToString", "[",
              RowBox[{"Round", "[", "x", "]"}], "]"}], ",",
            RowBox[{"ToString", "[", "x", "]"}]}], "]"}]}], ";",
      RowBox[{RowBox[{"sciLabel", "[", "x_", "]"}], ":=",
        RowBox[{"If", "[", RowBox[{RowBox[{"x", "\[Equal]", "0"}], ",",
            "\"0\"", ",", RowBox[{"Module", "[", RowBox[{RowBox[
                 {"{", RowBox[{RowBox[{"e", "=", RowBox[{"Floor", "[",
                        RowBox[{"Log10", "[", RowBox[{"Abs", "[", "x", "]"}],
                          "]"}], "]"}]}], ",", "mant"}], "}"}], ",",
                RowBox[{RowBox[{"mant", "=", RowBox[{"Round", "[",
                      FractionBox[RowBox[{"100", " ", RowBox[{"Abs", "[",
                          "x", "]"}]}], SuperscriptBox["10", "e"]], "]"}]}],
                  ";", RowBox[{"If", "[", RowBox[{RowBox[{"mant", "\[Equal]",
                        "1000"}], ",", RowBox[{RowBox[{"mant", "=", "100"}],
                        ";", RowBox[{"e", "=", RowBox[{"e", "+", "1"}]}]}]}],
                    "]"}], ";", RowBox[{RowBox[{"If", "[", RowBox[
                       {RowBox[{"x", "<", "0"}], ",", "\"-\"", ",", "\"\""}],
                      "]"}], "<>", RowBox[{"ToString", "[", RowBox[
                       {"Quotient", "[", RowBox[{"mant", ",", "100"}], "]"}],
                      "]"}], "<>", "\".\"", "<>", RowBox[{"IntegerString",
                      "[", RowBox[{RowBox[{"Mod", "[", RowBox[{"mant", ",",
                          "100"}], "]"}], ",", "10", ",", "2"}], "]"}], "<>",
                    "\"e\"", "<>", RowBox[{"ToString", "[", "e", "]"}]}]}]}],
              "]"}]}], "]"}]}], ";",
      RowBox[{"{", RowBox[{RowBox[{"Length", "[", "vizColors", "]"}], ",",
          RowBox[{"DirectoryQ", "[", "figureDirectory", "]"}]}], "}"}]}]],
   "Input"], Cell[BoxData[RowBox[{"Module", "[",
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"res", "=", RowBox[{
                "exp1RunResults", "[", "\"A1_K2_mix\"", "]"}]}], ",", "ts",
            ",", "rhoR", ",", "p0R", ",", "ndObs", ",", "g"}], "}"}], ",",
        RowBox[{RowBox[{"ts", "=", RowBox[{"res", "[", "\"t\"", "]"}]}], ";",
          RowBox[{"rhoR", "=", TemplateBox[{RowBox[{"{", RowBox[{"ts", ",",
                  RowBox[{RowBox[{"res", "[", "\"observables\"", "]"}],
                    "\[LeftDoubleBracket]", RowBox[{"All", ",", "\"rho\""}],
                    "\[RightDoubleBracket]"}]}], "}"}]}, "Transpose",
             SyntaxForm -> SuperscriptBox]}], ";",
          RowBox[{"p0R", "=", TemplateBox[{RowBox[{"{", RowBox[{"ts", ",",
                  RowBox[{RowBox[{"res", "[", "\"observables\"", "]"}],
                    "\[LeftDoubleBracket]", RowBox[{"All", ",", "\"p_0\""}],
                    "\[RightDoubleBracket]"}]}], "}"}]}, "Transpose",
             SyntaxForm -> SuperscriptBox]}], ";",
          RowBox[{"ndObs", "=", RowBox[{RowBox[{"(", RowBox[
                 {RowBox[{"observables1", "[", RowBox[{RowBox[{"SelectFirst",
                        "[", RowBox[{RowBox[{RowBox[{"summaries", "[",
                          "\"exp1\"", "]"}], "[", "\"runs\"", "]"}], ",",
                          RowBox[{RowBox[{RowBox[{"#1", "[", "\"id\"", "]"}],
                          "===", "\"A1_K2_mix\""}], "&"}]}], "]"}], ",",
                      RowBox[{"complexSpinor", "[", "#1", "]"}]}], "]"}],
                  "&"}], ")"}], "/@", RowBox[{"res", "[", "\"ndsolve\"",
                "]"}]}]}], ";", RowBox[{"g", "=", RowBox[{"Legended", "[",
              RowBox[{RowBox[{"Show", "[", RowBox[{RowBox[{"ListLinePlot",
                      "[", RowBox[{RowBox[{"{", RowBox[{TemplateBox[
                          {RowBox[{"{", RowBox[{"ts", ",", RowBox[{"ndObs",
                          "\[LeftDoubleBracket]", RowBox[{"All", ",",
                          "\"rho\""}], "\[RightDoubleBracket]"}]}], "}"}]},
                          "Transpose", SyntaxForm -> SuperscriptBox], ",",
                          TemplateBox[{RowBox[{"{", RowBox[{"ts", ",", RowBox[
                          {"ndObs", "\[LeftDoubleBracket]", RowBox[{"All",
                          ",", "\"p_0\""}], "\[RightDoubleBracket]"}]}],
                          "}"}]}, "Transpose", SyntaxForm ->
                          SuperscriptBox]}], "}"}], ",", RowBox[{"PlotStyle",
