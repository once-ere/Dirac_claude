                    ";", RowBox[{"qa", "=", RowBox[{"q", " ", RowBox[{"Exp",
                          "[", RowBox[{"ts", "\[LeftDoubleBracket]", "iA",
                          "\[RightDoubleBracket]"}], "]"}]}]}], ";",
                    RowBox[{"qb", "=", RowBox[{"q", " ", RowBox[{"Exp", "[",
