                      ",", "tStar", ",", "iA", ",", "iB", ",", "growthR",
                      ",", "growthN", ",", "lead", ",", "first", ",", "qa",
                      ",", "qb", ",", "uR", ",", "high"}], "}"}], ",",
                  RowBox[{RowBox[{"run", "=", RowBox[{"readRun", "[",
                        RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[
                          {"numericsRoot", ",", "\"exp5\"", ",", RowBox[
                          {"spec", "[", "\"file\"", "]"}]}], "}"}], "]"}],
                        "]"}]}], ";", RowBox[{"ts", "=", RowBox[{"columnOf",
                        "[", RowBox[{"run", ",", "\"t\""}], "]"}]}], ";",
                    RowBox[{"ys", "=", RowBox[{"columnsOf", "[", RowBox[
                         {"run", ",", "spinorNames"}], "]"}]}], ";",
                    RowBox[{"q", "=", RowBox[{"N", "[", RowBox[{"spec", "[",
                          "\"q\"", "]"}], "]"}]}], ";", RowBox[{"fd", "=",
                      RowBox[{"fdCheck", "[", RowBox[{"ts", ",", "ys", ",",
                          RowBox[{"rhs5", "[", "q", "]"}], ",", RowBox[
                          {"Association", "[", RowBox[{"\"spinor\"",
                          "\[Rule]", RowBox[{"Range", "[", "32", "]"}]}],
                          "]"}], ",", RowBox[{"rustTolerance", "[",
                          "\"exp5\"", "]"}]}], "]"}]}], ";", RowBox[
                     {"nd", "=", RowBox[{"integrateLinear", "[", RowBox[
                         {RowBox[{"exp5Mass", " ", RowBox[{"N", "[",
                          "exp5GenM", "]"}]}], ",", RowBox[{"N", "[",
                          "exp5GenQ", "]"}], ",", RowBox[{"Function", "[",
                          RowBox[{RowBox[{"{", "tt", "}"}], ",", RowBox[
                          {"q", " ", RowBox[{"Exp", "[", "tt", "]"}]}]}],
                          "]"}], ",", RowBox[{"ys", "\[LeftDoubleBracket]",
                          "1", "\[RightDoubleBracket]"}], ",", RowBox[
                          {"{", RowBox[{RowBox[{"ts", "\[LeftDoubleBracket]",
                          "1", "\[RightDoubleBracket]"}], ",", RowBox[{"ts",
                          "\[LeftDoubleBracket]", RowBox[{"-", "1"}],
                          "\[RightDoubleBracket]"}]}], "}"}], ",", "ts", ",",
                          RowBox[{"Method", "\[Rule]", RowBox[{"{", RowBox[
