                     {"Max", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1",
                          "[", "\"ndsolveMaxAbsDeviation\"", "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Values", "[",
                          "exp1RunResults", "]"}]}], "]"}]}], ",",
                  RowBox[{"\"maxExactErrorNDSolve\"", "\[Rule]", RowBox[
