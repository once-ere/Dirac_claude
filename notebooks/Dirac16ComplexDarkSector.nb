              RowBox[{RowBox[{"exp2Result", "[", "\"finiteDifference\"",
                  "]"}], "[", "\"allPass\"", "]"}]}], ",",
            RowBox[{"\"exp2NDSolveAgreement\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{RowBox[{"exp2Result", "[",
                      "\"ndsolve\"", "]"}], "[",
                    "\"lnScaleMaxAbsDeviation\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "6"]]}], "&&",
                RowBox[{RowBox[{RowBox[{"exp2Result", "[", "\"ndsolve\"",
                      "]"}], "[", "\"hubbleMaxDeviationOverTheta\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "6"]]}], "&&", RowBox[{RowBox[{RowBox[{"exp2Result", "[",
                      "\"ndsolve\"", "]"}], "[",
                    "\"spinorMaxPhaseAlignedDeviation\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "6"]]}], "&&", RowBox[{RowBox[{RowBox[{"exp2Result", "[",
                      "\"ndsolve\"", "]"}], "[", "\"spinorMaxAbsDeviation\"",
                    "]"}], "\[LessEqual]", FractionBox["1", SuperscriptBox[
                    "10", "5"]]}]}]}], ",", RowBox[
             {"\"exp2NDSolveAccuracy\"", "\[Rule]", RowBox[{RowBox[
                 {RowBox[{RowBox[{"exp2Result", "[", "\"ndsolve\"", "]"}],
                    "[", "\"ndsolveBackwardSelfErrorOverTheta\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "9"]]}], "&&", RowBox[{RowBox[{RowBox[{"exp2Result", "[",
                      "\"ndsolve\"", "]"}], "[",
                    "\"ndsolveMaxRelativeConstraintResidual\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "9"]]}], "&&", RowBox[{RowBox[{RowBox[{"exp2Result", "[",
                      "\"ndsolve\"", "]"}], "[",
                    "\"ndsolveHubbleVsExactOverTheta\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "9"]]}], "&&", RowBox[{RowBox[{RowBox[{"exp2Result", "[",
                      "\"ndsolve\"", "]"}], "[", "\"ndsolveSpinorVsExact\"",
                    "]"}], "\[LessEqual]", FractionBox["1", SuperscriptBox[
                    "10", "8"]]}]}]}], ",", RowBox[
             {"\"exp2RustMatchesClosedForm\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{RowBox[{"exp2Result", "[",
                      "\"ndsolve\"", "]"}], "[",
                    "\"rustHubbleVsExactOverTheta\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "6"]]}], "&&",
                RowBox[{RowBox[{RowBox[{"exp2Result", "[", "\"ndsolve\"",
                      "]"}], "[",
                    "\"rustLnScaleVsExactAmplificationNormalised\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "9"]]}], "&&", RowBox[{RowBox[{RowBox[{"exp2Result", "[",
                      "\"ndsolve\"", "]"}], "[", "\"rustSpinorVsExact\"",
                    "]"}], "\[LessEqual]", FractionBox["1", SuperscriptBox[
                    "10", "6"]]}], "&&", RowBox[{RowBox[{RowBox[
                     {"exp2Result", "[", "\"ndsolve\"", "]"}], "[",
                    "\"rustSpinorVsExactMinusRustReported\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "12"]]}]}]}]}], "]"}]}], ";",
      RowBox[{"{", RowBox[{RowBox[{"exp2Result", "[", "\"finiteDifference\"",
            "]"}], ",", RowBox[{"exp2Result", "[", "\"ndsolve\"", "]"}], ",",
          "exp2Checks"}], "}"}]}]], "Input"],
  Cell["EXP-3: 4D-effective late universe, the condensate as dark energy",
   "Section"], Cell["Background: extra dimensions stabilised by assumption \
(b, c constant); the 3-space scale factor a(t) obeys the 4D-effective \
Friedmann equation. This is an assumption of the experiment, not a \
consequence of the 8D equations (EXP-2 shows that in 8D Einstein gravity b \
and c evolve). The reduction in the frame diag(b0, a, a, a, 1, c0, c0, c0) \
again gives i du/dt = -i M_eff gamma^4 u. The Einstein tensor of the 4D FRW \
metric gives G^0_0 = -3 H^2 (Friedmann: H^2 = kappa_4 rho/3) and G^i_i = -(2 \
H' + 3 H^2). Condensate: rho_psi = m S + (lambda/2) S^2 = m S0 sigma (1 + x0 \
sigma), p_psi = (lambda/2) S^2, sigma = S/S0; in units of 3 H0^2/kappa_4 with \
Omega_psi = rho_psi(a = 1): rho_psi = A sigma (1 + x0 sigma), A = \
Omega_psi/(1 + x0), w = x0 sigma/(1 + x0 sigma). Continuity d rho/dN = -3 \
(rho + p) holds exactly for sigma = a^-3, and q = -1 - d ln E/dN equals (2 \
Omega_r a^-4 + Omega_m a^-3 + rho + 3 p)/(2 E^2). In N = ln a the Rust state \
is (H0 t, D_C, u, ln sigma) with d(H0 t)/dN = 1/E, dD_C/dN = -1/(a E), du/dN \
= -i (h/H0) u/E, h/H0 = (M_eff/H0)(-i gamma^4), M_eff/H0 = mu (1 + 2 x0 \
sigma)/(1 + 2 x0), and d ln sigma/dN = -3 + (ds/dN)/s with sigma = a^-3 \
s(u)/s(u0).", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"frame3", "=", RowBox[{"DiagonalMatrix", "[",
          RowBox[{"{", RowBox[{"bZero", ",", RowBox[{"aF", "[", "x4", "]"}],
              ",", RowBox[{"aF", "[", "x4", "]"}], ",", RowBox[{"aF", "[",
                "x4", "]"}], ",", "1", ",", "cZero", ",", "cZero", ",",
              "cZero"}], "}"}], "]"}]}], ";",
      RowBox[{"reduction3", "=", RowBox[{"reduceModeEquation", "[",
          RowBox[{"frame3", ",", FractionBox["1", SqrtBox[RowBox[{"bZero",
                " ", SuperscriptBox[RowBox[{"aF", "[", "x4", "]"}], "3"],
                " ", SuperscriptBox["cZero", "3"]}]]], ",", "mM", ",",
            "x4"}], "]"}]}], ";", RowBox[{"hDerived3", "=",
        RowBox[{"derivedHamiltonian", "[", RowBox[{"reduction3", ",",
            "Simplify"}], "]"}]}], ";", RowBox[{"einstein3", "=",
        RowBox[{"Simplify", "[", RowBox[{RowBox[{"einsteinMixedOf", "[",
              RowBox[{RowBox[{"DiagonalMatrix", "[", RowBox[{"{", RowBox[
                     {RowBox[{"-", "1"}], ",", SuperscriptBox[RowBox[
                        {"aF", "[", "tFRW", "]"}], "2"], ",", SuperscriptBox[
                       RowBox[{"aF", "[", "tFRW", "]"}], "2"], ",",
                      SuperscriptBox[RowBox[{"aF", "[", "tFRW", "]"}],
                       "2"]}], "}"}], "]"}], ",", RowBox[{"{", RowBox[
                   {"tFRW", ",", "y1", ",", "y2", ",", "y3"}], "}"}], ",",
                "Simplify"}], "]"}], "/.", "\[VeryThinSpace]",
            RowBox[{"{", RowBox[{RowBox[{RowBox[{SuperscriptBox["aF",
                     "\[Prime]", MultilineFunction -> None], "[", "tFRW",
                    "]"}], "\[Rule]", RowBox[{"hubble", " ", RowBox[
                     {"aF", "[", "tFRW", "]"}]}]}], ",", RowBox[
                 {RowBox[{SuperscriptBox["aF", "\[Prime]\[Prime]",
                     MultilineFunction -> None], "[", "tFRW", "]"}],
                  "\[Rule]", RowBox[{RowBox[{"(", RowBox[{"dHubble", "+",
                        SuperscriptBox["hubble", "2"]}], ")"}], " ",
                    RowBox[{"aF", "[", "tFRW", "]"}]}]}]}], "}"}]}], "]"}]}],
      ";", RowBox[{"exp3Symbolic", "=", RowBox[{"Module", "[",
          RowBox[{RowBox[{"{", RowBox[{"nS", ",", "sigma", ",", "rho", ",",
                "p", ",", "e2"}], "}"}], ",", RowBox[{RowBox[{"sigma", "=",
                RowBox[{"Exp", "[", RowBox[{RowBox[{"-", "3"}], " ", "nS"}],
                  "]"}]}], ";", RowBox[{"rho", "=", RowBox[{"ampA", " ",
                  "sigma", " ", RowBox[{"(", RowBox[{"1", "+", RowBox[
                       {"xX", " ", "sigma"}]}], ")"}]}]}], ";",
              RowBox[{"p", "=", RowBox[{"ampA", " ", "xX", " ",
                  SuperscriptBox["sigma", "2"]}]}], ";", RowBox[{"e2", "=",
                RowBox[{RowBox[{"omR", " ", RowBox[{"Exp", "[", RowBox[
                       {RowBox[{"-", "4"}], " ", "nS"}], "]"}]}], "+",
                  RowBox[{"omM", " ", RowBox[{"Exp", "[", RowBox[
                       {RowBox[{"-", "3"}], " ", "nS"}], "]"}]}], "+",
                  "rho"}]}], ";", RowBox[{"Association", "[", RowBox[
                 {RowBox[{"\"reductionLinear\"", "\[Rule]", RowBox[
                     {"reduction3", "[", "\"residualIsLinear\"", "]"}]}],
                  ",", RowBox[{"\"derivedHamiltonianEqualsRustForm\"",
                    "\[Rule]", RowBox[{RowBox[{"Simplify", "[", RowBox[
                         {"hDerived3", "-", RowBox[{"modeHamiltonian", "[",
                          RowBox[{"mM", ",", RowBox[{"ConstantArray", "[",
                          RowBox[{"0", ",", "8"}], "]"}]}], "]"}]}], "]"}],
                      "===", "zero16"}]}], ",", RowBox[
                   {"\"friedmannConstraint\"", "\[Rule]", RowBox[
                     {RowBox[{"Simplify", "[", RowBox[{RowBox[{"einstein3",
                          "\[LeftDoubleBracket]", RowBox[{"1", ",", "1"}],
                          "\[RightDoubleBracket]"}], "+", RowBox[{"3", " ",
                          SuperscriptBox["hubble", "2"]}]}], "]"}], "===",
                      "0"}]}], ",", RowBox[{"\"spatialEquation\"", "\[Rule]",
                    RowBox[{RowBox[{RowBox[{"Simplify", "[", RowBox[
                          {RowBox[{"einstein3", "\[LeftDoubleBracket]",
                          RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}],
                          "+", RowBox[{"2", " ", "dHubble"}], "+", RowBox[
                          {"3", " ", SuperscriptBox["hubble", "2"]}]}],
                          "]"}], "===", "0"}], "&&", RowBox[{RowBox[
                         {"Simplify", "[", RowBox[{"einstein3", "-", RowBox[
                          {"DiagonalMatrix", "[", RowBox[{"Diagonal", "[",
                          "einstein3", "]"}], "]"}]}], "]"}], "===",
                        RowBox[{"ConstantArray", "[", RowBox[{"0", ",",
                          RowBox[{"{", RowBox[{"4", ",", "4"}], "}"}]}],
                          "]"}]}]}]}], ",", RowBox[
                   {"\"condensateDensityForm\"", "\[Rule]", RowBox[
                     {RowBox[{"Simplify", "[", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"mC", " ", "sZero", " ", "sigma"}], "+",
                          RowBox[{FractionBox["1", "2"], " ", "lamC", " ",
                          SuperscriptBox[RowBox[{"(", RowBox[{"sZero", " ",
                          "sigma"}], ")"}], "2"]}]}], ")"}], "-", RowBox[
                          {"mC", " ", "sZero", " ", "sigma", " ", RowBox[
                          {"(", RowBox[{"1", "+", FractionBox[RowBox[{RowBox[
                          {"(", RowBox[{"lamC", " ", "sZero"}], ")"}], " ",
                          "sigma"}], RowBox[{"2", " ", "mC"}]]}], ")"}]}]}],
                        "]"}], "===", "0"}]}], ",", RowBox[{"\"continuity\"",
                    "\[Rule]", RowBox[{RowBox[{"Simplify", "[", RowBox[
                         {RowBox[{SubscriptBox["\[PartialD]", RowBox[
                          {"nS"}]], "rho"}], "+", RowBox[{"3", " ", RowBox[
                          {"(", RowBox[{"rho", "+", "p"}], ")"}]}]}], "]"}],
                      "===", "0"}]}], ",", RowBox[{"\"equationOfState\"",
                    "\[Rule]", RowBox[{RowBox[{"Simplify", "[", RowBox[
                         {FractionBox["p", "rho"], "-", FractionBox[RowBox[
                          {"xX", " ", "sigma"}], RowBox[{"1", "+", RowBox[
                          {"xX", " ", "sigma"}]}]]}], "]"}], "===", "0"}]}],
                  ",", RowBox[{"\"deceleration\"", "\[Rule]", RowBox[
                     {RowBox[{"Simplify", "[", RowBox[{RowBox[{"-", "1"}],
                          "-", RowBox[{SubscriptBox["\[PartialD]", RowBox[
                          {"nS"}]], FractionBox[RowBox[{"Log", "[", "e2",
                          "]"}], "2"]}], "-", FractionBox[RowBox[{RowBox[
                          {"2", " ", "omR", " ", RowBox[{"Exp", "[", RowBox[
                          {RowBox[{"-", "4"}], " ", "nS"}], "]"}]}], "+",
                          RowBox[{"omM", " ", RowBox[{"Exp", "[", RowBox[
                          {RowBox[{"-", "3"}], " ", "nS"}], "]"}]}], "+",
                          "rho", "+", RowBox[{"3", " ", "p"}]}], RowBox[
                          {"2", " ", "e2"}]]}], "]"}], "===", "0"}]}]}],
                "]"}]}]}], "]"}]}], ";", "exp3Symbolic"}]], "Input"],
  Cell["Runs: x0 in {-0.462654, -0.433107, -0.3, -0.2, 0} (w0 = x0/(1 + x0)) \
and mu = M_eff(a = 1)/H0 in {3, 7}, as recorded in summary.json; Omega_r, \
Omega_m, Omega_psi are the inputs of the experiment. For x0 < 0 the backward \
branch stops just after the bounce E^2 = 0 (summary.json contractDeviations), \
so the rows end there. Checked: finite-difference residual of the clock (H0 \
t, D_C), spinor and ln sigma columns on the uniform N grid (with a negative \
control that flips the sign of M_eff); NDSolve re-integration of both \
branches from the CSV state at N = 0; the spinor against the exact solution \
u(N) = exp(-i Phi(N)) u(0), Phi = Integral_0^N (M_eff/H0)/E dN (NIntegrate; \
exact because h is a multiple of -i gamma^4 and u(0) is a rest eigenvector); \
ln sigma against -3N; w, rho_psi and sigma_spinor against the closed forms.",
   "Text"],
  Cell[BoxData[RowBox[{RowBox[{"exp3Parameters", "=",
        RowBox[{RowBox[{"summaries", "[", "\"exp3\"", "]"}], "[",
          "\"parameters\"", "]"}]}], ";",
      RowBox[{RowBox[{"{", RowBox[{"omegaR3", ",", "omegaM3", ",",
            "omegaPsi3"}], "}"}], "=", RowBox[{"N", "[",
          RowBox[{"{", RowBox[{RowBox[{"exp3Parameters", "[", "\"OmegaR\"",
                "]"}], ",", RowBox[{"exp3Parameters", "[", "\"OmegaM\"",
                "]"}], ",", RowBox[{"exp3Parameters", "[", "\"OmegaPsi\"",
                "]"}]}], "}"}], "]"}]}], ";",
      RowBox[{"exp3Gen", "=", RowBox[{"N", "[", RowBox[{"realBlock", "[",
            RowBox[{RowBox[{"-", "\[ImaginaryI]"}], " ", RowBox[{
                SubscriptBox["\[PartialD]", RowBox[{"mM"}]], "hDerived3"}]}],
            "]"}], "]"}]}], ";",
      RowBox[{RowBox[{"rhs3", "[", RowBox[{"spec_", ",", "massSign_"}],
          "]"}], ":=", RowBox[{"With", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"xv", "=", RowBox[{"N", "[",
                    RowBox[{"spec", "[", "\"x0\"", "]"}], "]"}]}], ",",
                RowBox[{"mu", "=", RowBox[{"N", "[", RowBox[{"spec", "[",
                      "\"mu\"", "]"}], "]"}]}], ",", RowBox[{"s0", "=",
                  RowBox[{"N", "[", RowBox[{"spec", "[", "\"s0\"", "]"}],
                    "]"}]}]}], "}"}], ",", RowBox[{"Function", "[",
              RowBox[{RowBox[{"{", RowBox[{"nn", ",", "y"}], "}"}], ",",
                RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                       {RowBox[{"sp", "=", RowBox[{"y",
                          "\[LeftDoubleBracket]", RowBox[{"3", ";;", "34"}],
                          "\[RightDoubleBracket]"}]}], ",", "s", ",",
                        "sigma", ",", "e2", ",", "e", ",", "meffH", ",",
                        "dsp"}], "}"}], ",", RowBox[{RowBox[{"s", "=",
                        RowBox[{"sp", ".", "realScalar", ".", "sp"}]}], ";",
                      RowBox[{"sigma", "=", FractionBox[RowBox[{RowBox[
                          {"Exp", "[", RowBox[{RowBox[{"-", "3"}], " ",
                          "nn"}], "]"}], " ", "s"}], "s0"]}], ";", RowBox[
                       {"e2", "=", RowBox[{RowBox[{"omegaR3", " ", RowBox[
                          {"Exp", "[", RowBox[{RowBox[{"-", "4"}], " ",
                          "nn"}], "]"}]}], "+", RowBox[{"omegaM3", " ",
                          RowBox[{"Exp", "[", RowBox[{RowBox[{"-", "3"}],
                          " ", "nn"}], "]"}]}], "+", FractionBox[RowBox[
                          {"omegaPsi3", " ", "sigma", " ", RowBox[{"(",
                          RowBox[{"1", "+", RowBox[{"xv", " ", "sigma"}]}],
                          ")"}]}], RowBox[{"1", "+", "xv"}]]}]}], ";",
                      RowBox[{"e", "=", SqrtBox["e2"]}], ";", RowBox[
                       {"meffH", "=", FractionBox[RowBox[{"massSign", " ",
                          "mu", " ", RowBox[{"(", RowBox[{"1", "+", RowBox[
                          {"2", " ", "xv", " ", "sigma"}]}], ")"}]}],
                         RowBox[{"1", "+", RowBox[{"2", " ", "xv"}]}]]}],
                      ";", RowBox[{"dsp", "=", FractionBox[RowBox[{"meffH",
                          " ", RowBox[{"exp3Gen", ".", "sp"}]}], "e"]}], ";",
                      RowBox[{"Join", "[", RowBox[{RowBox[{"{", RowBox[
                          {FractionBox["1", "e"], ",", RowBox[{"-",
                          FractionBox["1", RowBox[{RowBox[{"Exp", "[", "nn",
                          "]"}], " ", "e"}]]}]}], "}"}], ",", "dsp", ",",
                          RowBox[{"{", RowBox[{RowBox[{"-", "3"}], "+",
                          FractionBox[RowBox[{"2", " ", RowBox[{"sp", ".",
                          "realScalar", ".", "dsp"}]}], "s"]}], "}"}]}],
                        "]"}]}]}], "]"}]}], "]"}]}], "]"}]}], ";",
      RowBox[{"exp3Names", "=", RowBox[{"Join", "[",
          RowBox[{RowBox[{"{", RowBox[{"\"H0t\"", ",", "\"D_C\""}], "}"}],
            ",", "spinorNames", ",", RowBox[{"{", "\"ln_sigma\"", "}"}]}],
          "]"}]}], ";", RowBox[{"exp3RunResults", "=",
        RowBox[{"Association", "[", RowBox[{"Table", "[",
            RowBox[{RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                     {"run", ",", "ns", ",", "ys", ",", "i0", ",", "fd", ",",
                      "back", ",", "fwd", ",", "nd", ",", "xv", ",",
                      "sigmaN", ",", "wN", ",", "wClosed", ",", "rhoClosed",
                      ",", "phaseRate", ",", "phase", ",", "exactU"}], "}"}],
                  ",", RowBox[{RowBox[{"run", "=", RowBox[{"readRun", "[",
                        RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[
                          {"numericsRoot", ",", "\"exp3\"", ",", RowBox[
                          {"spec", "[", "\"file\"", "]"}]}], "}"}], "]"}],
                        "]"}]}], ";", RowBox[{"ns", "=", RowBox[{"columnOf",
                        "[", RowBox[{"run", ",", "\"N\""}], "]"}]}], ";",
                    RowBox[{"ys", "=", RowBox[{"columnsOf", "[", RowBox[
                         {"run", ",", "exp3Names"}], "]"}]}], ";",
                    RowBox[{"i0", "=", RowBox[{"First", "[", RowBox[
                         {"FirstPosition", "[", RowBox[{"ns", ",", "0.`"}],
                          "]"}], "]"}]}], ";", RowBox[{"fd", "=", RowBox[
                       {"fdCheck", "[", RowBox[{"ns", ",", "ys", ",",
                          RowBox[{"rhs3", "[", RowBox[{"spec", ",", "1"}],
                          "]"}], ",", RowBox[{"Association", "[", RowBox[
                          {RowBox[{"\"clock\"", "\[Rule]", RowBox[{"{",
                          RowBox[{"1", ",", "2"}], "}"}]}], ",", RowBox[
                          {"\"spinor\"", "\[Rule]", RowBox[{"Range", "[",
                          RowBox[{"3", ",", "34"}], "]"}]}], ",", RowBox[
                          {"\"lnSigma\"", "\[Rule]", RowBox[{"{", "35",
                          "}"}]}]}], "]"}], ",", RowBox[{"rustTolerance",
                          "[", "\"exp3\"", "]"}]}], "]"}]}], ";", RowBox[
                     {"back", "=", RowBox[{"integrateSystem", "[", RowBox[
                         {RowBox[{"rhs3", "[", RowBox[{"spec", ",", "1"}],
                          "]"}], ",", RowBox[{"ys", "\[LeftDoubleBracket]",
                          "i0", "\[RightDoubleBracket]"}], ",", RowBox[
                          {"{", RowBox[{"0.`", ",", RowBox[{"ns",
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}]}], "}"}], ",", RowBox[
                          {"Reverse", "[", RowBox[{"ns",
                          "\[LeftDoubleBracket]", RowBox[{"1", ";;", "i0"}],
                          "\[RightDoubleBracket]"}], "]"}], ",", RowBox[
                          {"Method", "\[Rule]", RowBox[{"{", RowBox[
                          {"\"ExplicitRungeKutta\"", ",", RowBox[
                          {"\"DifferenceOrder\"", "\[Rule]", "8"}]}],
                          "}"}]}], ",", RowBox[{"PrecisionGoal", "\[Rule]",
                          "13"}], ",", RowBox[{"AccuracyGoal", "\[Rule]",
                          "15"}]}], "]"}]}], ";", RowBox[{"fwd", "=",
                      RowBox[{"integrateSystem", "[", RowBox[{RowBox[{"rhs3",
                          "[", RowBox[{"spec", ",", "1"}], "]"}], ",",
                          RowBox[{"ys", "\[LeftDoubleBracket]", "i0",
                          "\[RightDoubleBracket]"}], ",", RowBox[{"{",
                          RowBox[{"0.`", ",", RowBox[{"ns",
                          "\[LeftDoubleBracket]", RowBox[{"-", "1"}],
                          "\[RightDoubleBracket]"}]}], "}"}], ",", RowBox[
                          {"ns", "\[LeftDoubleBracket]", RowBox[{"i0", ";;",
                          "All"}], "\[RightDoubleBracket]"}], ",", RowBox[
                          {"Method", "\[Rule]", RowBox[{"{", RowBox[
                          {"\"ExplicitRungeKutta\"", ",", RowBox[
                          {"\"DifferenceOrder\"", "\[Rule]", "8"}]}],
                          "}"}]}], ",", RowBox[{"PrecisionGoal", "\[Rule]",
                          "13"}], ",", RowBox[{"AccuracyGoal", "\[Rule]",
                          "15"}]}], "]"}]}], ";", RowBox[{"nd", "=",
                      RowBox[{"Join", "[", RowBox[{RowBox[{"Reverse", "[",
                          "back", "]"}], ",", RowBox[{"Rest", "[", "fwd",
                          "]"}]}], "]"}]}], ";", RowBox[{"xv", "=",
                      RowBox[{"N", "[", RowBox[{"spec", "[", "\"x0\"", "]"}],
                        "]"}]}], ";", RowBox[{"sigmaN", "=", RowBox[{"Exp",
                        "[", RowBox[{"nd", "\[LeftDoubleBracket]", RowBox[
                          {"All", ",", "35"}], "\[RightDoubleBracket]"}],
                        "]"}]}], ";", RowBox[{"wN", "=", FractionBox[
                       RowBox[{"xv", " ", "sigmaN"}], RowBox[{"1", "+",
                         RowBox[{"xv", " ", "sigmaN"}]}]]}], ";", RowBox[
                     {"wClosed", "=", FractionBox[RowBox[{"xv", " ", RowBox[
                          {"Exp", "[", RowBox[{RowBox[{"-", "3"}], " ",
                          "ns"}], "]"}]}], RowBox[{"1", "+", RowBox[{"xv",
                          " ", RowBox[{"Exp", "[", RowBox[{RowBox[{"-",
                          "3"}], " ", "ns"}], "]"}]}]}]]}], ";", RowBox[
                     {"rhoClosed", "=", FractionBox[RowBox[{"omegaPsi3", " ",
                         RowBox[{"Exp", "[", RowBox[{RowBox[{"-", "3"}], " ",
                          "ns"}], "]"}], " ", RowBox[{"(", RowBox[{"1", "+",
                          RowBox[{"xv", " ", RowBox[{"Exp", "[", RowBox[
                          {RowBox[{"-", "3"}], " ", "ns"}], "]"}]}]}],
                          ")"}]}], RowBox[{"1", "+", "xv"}]]}], ";",
                    RowBox[{RowBox[{"phaseRate", "[", "nv_", "]"}], ":=",
                      FractionBox[RowBox[{RowBox[{"N", "[", RowBox[{"spec",
                          "[", "\"mu\"", "]"}], "]"}], " ", RowBox[{"(",
                          RowBox[{"1", "+", RowBox[{"2", " ", "xv", " ",
                          RowBox[{"Exp", "[", RowBox[{RowBox[{"-", "3"}],
                          " ", "nv"}], "]"}]}]}], ")"}]}], RowBox[
                        {RowBox[{"(", RowBox[{"1", "+", RowBox[{"2", " ",
                          "xv"}]}], ")"}], " ", SqrtBox[RowBox[{RowBox[
                          {"omegaR3", " ", RowBox[{"Exp", "[", RowBox[
                          {RowBox[{"-", "4"}], " ", "nv"}], "]"}]}], "+",
                          RowBox[{"omegaM3", " ", RowBox[{"Exp", "[", RowBox[
                          {RowBox[{"-", "3"}], " ", "nv"}], "]"}]}], "+",
                          FractionBox[RowBox[{"omegaPsi3", " ", RowBox[
                          {"Exp", "[", RowBox[{RowBox[{"-", "3"}], " ",
                          "nv"}], "]"}], " ", RowBox[{"(", RowBox[{"1", "+",
                          RowBox[{"xv", " ", RowBox[{"Exp", "[", RowBox[
                          {RowBox[{"-", "3"}], " ", "nv"}], "]"}]}]}],
                          ")"}]}], RowBox[{"1", "+", "xv"}]]}]]}]]}], ";",
                    RowBox[{"phase", "=", RowBox[{"Table", "[", RowBox[
                         {RowBox[{"If", "[", RowBox[{RowBox[{"nv",
                          "\[Equal]", "0"}], ",", "0.`", ",", RowBox[
                          {"NIntegrate", "[", RowBox[{RowBox[{"phaseRate",
                          "[", "x", "]"}], ",", RowBox[{"{", RowBox[{"x",
                          ",", "0", ",", "nv"}], "}"}], ",", RowBox[
                          {"PrecisionGoal", "\[Rule]", "13"}], ",", RowBox[
                          {"AccuracyGoal", "\[Rule]", "15"}]}], "]"}]}],
                          "]"}], ",", RowBox[{"{", RowBox[{"nv", ",", "ns"}],
                          "}"}]}], "]"}]}], ";", RowBox[{"exactU", "=",
                      RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[{"Exp",
                          "[", RowBox[{RowBox[{"-", "\[ImaginaryI]"}], " ",
                          "#1"}], "]"}], " ", RowBox[{"complexSpinor", "[",
                          RowBox[{"ys", "\[LeftDoubleBracket]", RowBox[{"i0",
                          ",", RowBox[{"3", ";;", "34"}]}],
                          "\[RightDoubleBracket]"}], "]"}]}], "&"}], ")"}],
                        "/@", "phase"}]}], ";", RowBox[{RowBox[{"spec", "[",
                        "\"id\"", "]"}], "\[Rule]", RowBox[{"Association",
                        "[", RowBox[{RowBox[{"\"fd\"", "\[Rule]", "fd"}],
                          ",", RowBox[{"\"N\"", "\[Rule]", "ns"}], ",",
                          RowBox[{"\"state\"", "\[Rule]", "ys"}], ",",
                          RowBox[{"\"ndsolve\"", "\[Rule]", "nd"}], ",",
                          RowBox[{"\"x0\"", "\[Rule]", "xv"}], ",", RowBox[
                          {"\"mu\"", "\[Rule]", RowBox[{"N", "[", RowBox[
                          {"spec", "[", "\"mu\"", "]"}], "]"}]}], ",",
                          RowBox[{"\"wNDSolve\"", "\[Rule]", "wN"}], ",",
                          RowBox[{"\"wRust\"", "\[Rule]", RowBox[{"columnOf",
                          "[", RowBox[{"run", ",", "\"w\""}], "]"}]}], ",",
                          RowBox[{"\"a\"", "\[Rule]", RowBox[{"columnOf",
                          "[", RowBox[{"run", ",", "\"a\""}], "]"}]}], ",",
                          RowBox[{"\"deviations\"", "\[Rule]", RowBox[
                          {"Association", "[", RowBox[{RowBox[
                          {"\"clockMaxRelativeDeviation\"", "\[Rule]", RowBox[
                          {"Max", "[", FractionBox[RowBox[{"Abs", "[", RowBox[
                          {RowBox[{"nd", "\[LeftDoubleBracket]", RowBox[
                          {"All", ",", RowBox[{"1", ";;", "2"}]}],
                          "\[RightDoubleBracket]"}], "-", RowBox[{"ys",
                          "\[LeftDoubleBracket]", RowBox[{"All", ",", RowBox[
                          {"1", ";;", "2"}]}], "\[RightDoubleBracket]"}]}],
                          "]"}], RowBox[{"1", "+", RowBox[{"Abs", "[", RowBox[
                          {"ys", "\[LeftDoubleBracket]", RowBox[{"All", ",",
                          RowBox[{"1", ";;", "2"}]}],
                          "\[RightDoubleBracket]"}], "]"}]}]], "]"}]}], ",",
                          RowBox[{"\"spinorMaxAbsDeviation\"", "\[Rule]",
                          RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[
                          {RowBox[{"nd", "\[LeftDoubleBracket]", RowBox[
                          {"All", ",", RowBox[{"3", ";;", "34"}]}],
                          "\[RightDoubleBracket]"}], "-", RowBox[{"ys",
                          "\[LeftDoubleBracket]", RowBox[{"All", ",", RowBox[
                          {"3", ";;", "34"}]}], "\[RightDoubleBracket]"}]}],
                          "]"}], "]"}]}], ",", RowBox[{
                          "\"spinorMaxPhaseAlignedDeviation\"", "\[Rule]",
                          RowBox[{"Max", "[", RowBox[{"MapThread", "[",
                          RowBox[{RowBox[{RowBox[{"alignedDistance", "[",
                          RowBox[{RowBox[{"complexSpinor", "[", RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"3", ";;", "34"}],
                          "\[RightDoubleBracket]"}], "]"}], ",", RowBox[
                          {"complexSpinor", "[", RowBox[{"#2",
                          "\[LeftDoubleBracket]", RowBox[{"3", ";;", "34"}],
                          "\[RightDoubleBracket]"}], "]"}]}], "]"}], "&"}],
                          ",", RowBox[{"{", RowBox[{"ys", ",", "nd"}],
                          "}"}]}], "]"}], "]"}]}], ",", RowBox[
                          {"\"lnSigmaMaxAbsDeviation\"", "\[Rule]", RowBox[
                          {"Max", "[", RowBox[{"Abs", "[", RowBox[{RowBox[
                          {"nd", "\[LeftDoubleBracket]", RowBox[{"All", ",",
                          "35"}], "\[RightDoubleBracket]"}], "-", RowBox[
                          {"ys", "\[LeftDoubleBracket]", RowBox[{"All", ",",
                          "35"}], "\[RightDoubleBracket]"}]}], "]"}],
                          "]"}]}], ",", RowBox[{"\"lnSigmaNDSolveVsExact\"",
                          "\[Rule]", RowBox[{"Max", "[", RowBox[{"Abs", "[",
                          RowBox[{RowBox[{"nd", "\[LeftDoubleBracket]",
                          RowBox[{"All", ",", "35"}],
                          "\[RightDoubleBracket]"}], "+", RowBox[{"3", " ",
                          "ns"}]}], "]"}], "]"}]}], ",", RowBox[
                          {"\"wRustVsClosedFormConditionScaled\"", "\[Rule]",
                          RowBox[{"Max", "[", FractionBox[RowBox[{RowBox[
                          {"Abs", "[", RowBox[{RowBox[{"columnOf", "[",
                          RowBox[{"run", ",", "\"w\""}], "]"}], "-",
                          "wClosed"}], "]"}], " ", SuperscriptBox[RowBox[
                          {"(", RowBox[{"1", "+", RowBox[{"xv", " ", RowBox[
                          {"Exp", "[", RowBox[{RowBox[{"-", "3"}], " ",
                          "ns"}], "]"}]}]}], ")"}], "2"]}], RowBox[{"1", "+",
                          RowBox[{"Abs", "[", RowBox[{"xv", " ", RowBox[
                          {"Exp", "[", RowBox[{RowBox[{"-", "3"}], " ",
                          "ns"}], "]"}]}], "]"}]}]], "]"}]}], ",", RowBox[
                          {"\"rhoRustVsClosedForm\"", "\[Rule]", RowBox[
                          {"Max", "[", FractionBox[RowBox[{"Abs", "[", RowBox[
                          {RowBox[{"columnOf", "[", RowBox[{"run", ",",
                          "\"rho_psi\""}], "]"}], "-", "rhoClosed"}], "]"}],
                          RowBox[{"1", "+", RowBox[{"Abs", "[", "rhoClosed",
                          "]"}]}]], "]"}]}], ",", RowBox[
                          {"\"sigmaSpinorRustVsExact\"", "\[Rule]", RowBox[
                          {"Max", "[", RowBox[{"Abs", "[", RowBox[{RowBox[
                          {RowBox[{"columnOf", "[", RowBox[{"run", ",",
                          "\"sigma_spinor\""}], "]"}], " ", RowBox[{"Exp",
                          "[", RowBox[{"3", " ", "ns"}], "]"}]}], "-", "1"}],
                          "]"}], "]"}]}], ",", RowBox[{
                          "\"rustSpinorVsExact\"", "\[Rule]", RowBox[{"Max",
                          "[", RowBox[{"Norm", "/@", RowBox[{"(", RowBox[
                          {RowBox[{RowBox[{"(", RowBox[{RowBox[{
                          "complexSpinor", "[", RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"3", ";;", "34"}],
                          "\[RightDoubleBracket]"}], "]"}], "&"}], ")"}],
                          "/@", "ys"}], "-", "exactU"}], ")"}]}], "]"}]}],
                          ",", RowBox[{"\"ndsolveSpinorVsExact\"", "\[Rule]",
                          RowBox[{"Max", "[", RowBox[{"Norm", "/@", RowBox[
                          {"(", RowBox[{RowBox[{RowBox[{"(", RowBox[{RowBox[
                          {"complexSpinor", "[", RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{"3", ";;", "34"}],
                          "\[RightDoubleBracket]"}], "]"}], "&"}], ")"}],
                          "/@", "nd"}], "-", "exactU"}], ")"}]}], "]"}]}]}],
                          "]"}]}]}], "]"}]}]}]}], "]"}], ",",
              RowBox[{"{", RowBox[{"spec", ",", RowBox[{RowBox[{"summaries",
                      "[", "\"exp3\"", "]"}], "[", "\"runs\"", "]"}]}],
                "}"}]}], "]"}], "]"}]}], ";",
      RowBox[{"Dataset", "[", RowBox[
         {RowBox[{"(", RowBox[{RowBox[{"Join", "[", RowBox[
                 {RowBox[{"#1", "[", "\"deviations\"", "]"}], ",",
                  RowBox[{"Association", "[", RowBox[{RowBox[{"\"fdPass\"",
                        "\[Rule]", RowBox[{"AllTrue", "[", RowBox[{RowBox[
                          {"Values", "[", RowBox[{"#1", "[", "\"fd\"", "]"}],
                          "]"}], ",", RowBox[{"Function", "[", RowBox[{"g",
                          ",", RowBox[{"g", "[", "\"pass\"", "]"}]}],
                          "]"}]}], "]"}]}], ",", RowBox[{"\"fdResolved\"",
                        "\[Rule]", RowBox[{RowBox[{RowBox[{"#1", "[",
                          "\"fd\"", "]"}], "[", "\"spinor\"", "]"}], "[",
                          "\"resolvedRows\"", "]"}]}], ",", RowBox[
                       {"\"rows\"", "\[Rule]", RowBox[{"Length", "[",
                          RowBox[{"#1", "[", "\"N\"", "]"}], "]"}]}]}],
                    "]"}]}], "]"}], "&"}], ")"}], "/@", "exp3RunResults"}],
        "]"}]}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"exp3Control", "=",
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"spec", "=", RowBox[{"First", "[",
                    RowBox[{RowBox[{"summaries", "[", "\"exp3\"", "]"}], "[",
                      "\"runs\"", "]"}], "]"}]}], ",", "run", ",", "ns", ",",
                "ys"}], "}"}], ",", RowBox[{RowBox[{"run", "=",
                RowBox[{"readRun", "[", RowBox[{"FileNameJoin", "[",
                    RowBox[{"{", RowBox[{"numericsRoot", ",", "\"exp3\"",
                        ",", RowBox[{"spec", "[", "\"file\"", "]"}]}], "}"}],
                    "]"}], "]"}]}], ";", RowBox[{"ns", "=", RowBox[
                 {"columnOf", "[", RowBox[{"run", ",", "\"N\""}], "]"}]}],
              ";", RowBox[{"ys", "=", RowBox[{"columnsOf", "[", RowBox[
                   {"run", ",", "exp3Names"}], "]"}]}], ";",
              RowBox[{RowBox[{"fdCheck", "[", RowBox[{"ns", ",", "ys", ",",
                    RowBox[{"rhs3", "[", RowBox[{"spec", ",", RowBox[
                         {"-", "1"}]}], "]"}], ",", RowBox[{"Association",
                      "[", RowBox[{"\"spinor\"", "\[Rule]", RowBox[{"Range",
                          "[", RowBox[{"3", ",", "34"}], "]"}]}], "]"}], ",",
                    RowBox[{"rustTolerance", "[", "\"exp3\"", "]"}]}], "]"}],
                "[", "\"spinor\"", "]"}]}]}], "]"}]}], ";",
      RowBox[{"exp3Result", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"symbolic\"", "\[Rule]", "exp3Symbolic"}], ",",
            RowBox[{"\"runCount\"", "\[Rule]", RowBox[{"Length", "[",
                "exp3RunResults", "]"}]}], ",", RowBox[
             {"\"finiteDifference\"", "\[Rule]", RowBox[{"Association", "[",
                RowBox[{RowBox[{"\"maxRelativeResidual\"", "\[Rule]",
                    RowBox[{"Max", "[", RowBox[{"Flatten", "[", RowBox[
                         {RowBox[{"(", RowBox[{RowBox[{"Table", "[", RowBox[
                          {RowBox[{RowBox[{RowBox[{"#1", "[", "\"fd\"",
                          "]"}], "[", "g", "]"}], "[",
                          "\"maxRelativeResidual\"", "]"}], ",", RowBox[
                          {"{", RowBox[{"g", ",", RowBox[{"{", RowBox[
                          {"\"clock\"", ",", "\"spinor\"", ",",
                          "\"lnSigma\""}], "}"}]}], "}"}]}], "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Values", "[",
                          "exp3RunResults", "]"}]}], "]"}], "]"}]}], ",",
                  RowBox[{"\"maxRelativeTruncationEstimate\"", "\[Rule]",
                    RowBox[{"Max", "[", RowBox[{"Flatten", "[", RowBox[
                         {RowBox[{"(", RowBox[{RowBox[{"Table", "[", RowBox[
                          {RowBox[{RowBox[{RowBox[{"#1", "[", "\"fd\"",
                          "]"}], "[", "g", "]"}], "[",
                          "\"maxRelativeTruncationEstimate\"", "]"}], ",",
                          RowBox[{"{", RowBox[{"g", ",", RowBox[{"{", RowBox[
                          {"\"clock\"", ",", "\"spinor\"", ",",
                          "\"lnSigma\""}], "}"}]}], "}"}]}], "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Values", "[",
                          "exp3RunResults", "]"}]}], "]"}], "]"}]}], ",",
                  RowBox[{"\"spinorResolvedRows\"", "\[Rule]", RowBox[
                     {"Total", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[
                          {RowBox[{RowBox[{"#1", "[", "\"fd\"", "]"}], "[",
                          "\"spinor\"", "]"}], "[", "\"resolvedRows\"",
                          "]"}], "&"}], ")"}], "/@", RowBox[{"Values", "[",
                          "exp3RunResults", "]"}]}], "]"}]}], ",",
                  RowBox[{"\"interiorRows\"", "\[Rule]", RowBox[{"Total",
                      "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[
                          {RowBox[{"#1", "[", "\"fd\"", "]"}], "[",
                          "\"spinor\"", "]"}], "[", "\"interiorRows\"",
                          "]"}], "&"}], ")"}], "/@", RowBox[{"Values", "[",
                          "exp3RunResults", "]"}]}], "]"}]}], ",",
                  RowBox[{"\"allPass\"", "\[Rule]", RowBox[{"AllTrue", "[",
                      RowBox[{RowBox[{"Values", "[", "exp3RunResults", "]"}],
                        ",", RowBox[{RowBox[{"AllTrue", "[", RowBox[
                          {RowBox[{"Values", "[", RowBox[{"#1", "[",
                          "\"fd\"", "]"}], "]"}], ",", RowBox[{"Function",
                          "[", RowBox[{"g", ",", RowBox[{"g", "[",
                          "\"pass\"", "]"}]}], "]"}]}], "]"}], "&"}]}],
                      "]"}]}], ",", RowBox[
                   {"\"negativeControlFlippedMassMaxRelativeResidual\"",
                    "\[Rule]", RowBox[{"exp3Control", "[",
                      "\"maxRelativeResidual\"", "]"}]}], ",", RowBox[
                   {"\"negativeControlFails\"", "\[Rule]", RowBox[{"!",
                      RowBox[{"exp3Control", "[", "\"pass\"", "]"}]}]}]}],
                "]"}]}], ",", RowBox[{"\"ndsolve\"", "\[Rule]",
              RowBox[{"Join", "[", RowBox[{RowBox[{"Association", "[",
                    RowBox[{"\"method\"", "\[Rule]", "\"ExplicitRungeKutta \
order 8, machine precision, PrecisionGoal 13, AccuracyGoal 15, both branches \
from N = 0\""}], "]"}], ",", RowBox[{"Merge", "[", RowBox[{RowBox[
                       {RowBox[{"(", RowBox[{RowBox[{"#1", "[",
                          "\"deviations\"", "]"}], "&"}], ")"}], "/@",
                        RowBox[{"Values", "[", "exp3RunResults", "]"}]}],
                      ",", "Max"}], "]"}]}], "]"}]}]}], "]"}]}], ";",
      RowBox[{"exp3Checks", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"exp3SymbolicReduction\"", "\[Rule]",
              RowBox[{"And", "@@", RowBox[{"Values", "[", "exp3Symbolic",
                  "]"}]}]}], ",", RowBox[{"\"exp3FiniteDifferenceRHS\"",
              "\[Rule]", RowBox[{RowBox[{RowBox[{"exp3Result", "[",
                    "\"finiteDifference\"", "]"}], "[", "\"allPass\"", "]"}],
                "&&", RowBox[{RowBox[{"exp3Result", "[",
                    "\"finiteDifference\"", "]"}], "[",
                  "\"negativeControlFails\"", "]"}]}]}], ",",
            RowBox[{"\"exp3NDSolveAgreement\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{RowBox[{"exp3Result", "[",
                      "\"ndsolve\"", "]"}], "[",
                    "\"clockMaxRelativeDeviation\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "8"]]}], "&&",
                RowBox[{RowBox[{RowBox[{"exp3Result", "[", "\"ndsolve\"",
                      "]"}], "[", "\"spinorMaxAbsDeviation\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "6"]]}], "&&", RowBox[{RowBox[{RowBox[{"exp3Result", "[",
                      "\"ndsolve\"", "]"}], "[",
                    "\"lnSigmaMaxAbsDeviation\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "8"]]}], "&&",
                RowBox[{RowBox[{RowBox[{"exp3Result", "[", "\"ndsolve\"",
                      "]"}], "[", "\"lnSigmaNDSolveVsExact\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "9"]]}], "&&", RowBox[{RowBox[{RowBox[{"exp3Result", "[",
                      "\"ndsolve\"", "]"}], "[", "\"ndsolveSpinorVsExact\"",
                    "]"}], "\[LessEqual]", FractionBox["1", SuperscriptBox[
                    "10", "8"]]}]}]}], ",", RowBox[{"\"exp3ClosedForms\"",
              "\[Rule]", RowBox[{RowBox[{RowBox[{RowBox[{"exp3Result", "[",
                      "\"ndsolve\"", "]"}], "[",
                    "\"wRustVsClosedFormConditionScaled\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "7"]]}], "&&", RowBox[{RowBox[{RowBox[{"exp3Result", "[",
                      "\"ndsolve\"", "]"}], "[", "\"rhoRustVsClosedForm\"",
                    "]"}], "\[LessEqual]", FractionBox["1", SuperscriptBox[
                    "10", "7"]]}], "&&", RowBox[{RowBox[{RowBox[
                     {"exp3Result", "[", "\"ndsolve\"", "]"}], "[",
                    "\"sigmaSpinorRustVsExact\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "7"]]}], "&&",
                RowBox[{RowBox[{RowBox[{"exp3Result", "[", "\"ndsolve\"",
                      "]"}], "[", "\"rustSpinorVsExact\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "6"]]}]}]}]}], "]"}]}], ";",
      RowBox[{"{", RowBox[{RowBox[{"exp3Result", "[", "\"finiteDifference\"",
            "]"}], ",", RowBox[{"exp3Result", "[", "\"ndsolve\"", "]"}], ",",
          "exp3Checks"}], "}"}]}]], "Input"], Cell["EXP-4: dirac16complex \
quanta as dark matter, Fermi-gas EoS and pair creation", "Section"],
  Cell["Background: 3-space FRW, hidden space and extra times static, \
vielbein diag(1, a, a, a, 1, 1, 1, 1). Mode Psi = a^(-3/2) e^(i k x1) u(t): \
the reduction gives h = -i m gamma^4 - (k/a) gamma^4 gamma^1 (K = k/a, h^2 = \
(m^2 + K^2) I). (a) Thermal gas: radiation era a = (t/t_i)^(1/2), m = 1, T_i \
= 10, H_i = 0.05 (t_i = 10), a from 1 to 100; Fermi-Dirac occupation of the \
initial positive-energy (B = +1) eigenvectors is a modelling input. (b) Pair \
creation: de Sitter a = e^t (t < 0) glued C^1 to radiation a = (1 + 2t)^(1/2) \
(t > 0), H_inf = 1, each mode starting in the first-order adiabatic vacuum at \
k/a = 200. The CSV output is sparse in time (61 samples over up to 1e5 \
radians of phase per thermal mode), so finite differences cannot resolve the \
modes; the RHS is instead checked by one-interval propagation (NDSolve from \
CSV row j to row j+1) and by full re-integration on a reduced momentum grid: \
thermal nodes 0 and 2 over the whole range a in [1, 100], nodes 16 and 47 up \
to a = 10; pair modes m in {0.5, 1, 2} at nodes 16, 32, 48 and m = 0 at node \
32. At late times (t up to 1e5) the raw thermal deviation is dominated by a \
global phase difference, which is consistent with the CVODE time-accumulation \
rounding that the engine report documents for EXP-2 (this attribution is \
plausible, not proven here; the own error of NDSolve is estimated by \
re-running node 2 with a different method, explicit Runge-Kutta of order 8); \
therefore phase-aligned distances and the phase-independent bilinears (eps = \
u^dagger h u, p_1 = -K u^dagger gamma^4 gamma^1 u, s = u^dagger B C u, beta^2 \
= |P_- u|^2/|u|^2, with eps and p_1 divided by E) are compared as well.",
   "Text"],
  Cell[BoxData[RowBox[{RowBox[{"frame4", "=", RowBox[{"DiagonalMatrix", "[",
          RowBox[{"{", RowBox[{"1", ",", RowBox[{"aF", "[", "x4", "]"}], ",",
              RowBox[{"aF", "[", "x4", "]"}], ",", RowBox[{"aF", "[", "x4",
                "]"}], ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}],
          "]"}]}], ";", RowBox[{"reduction4", "=",
        RowBox[{"reduceModeEquation", "[", RowBox[{"frame4", ",",
            RowBox[{SuperscriptBox[RowBox[{"aF", "[", "x4", "]"}], RowBox[
                {RowBox[{"-", "3"}], "/", "2"}]], " ", RowBox[{"Exp", "[",
                RowBox[{"\[ImaginaryI]", " ", "kC", " ", "x1"}], "]"}]}],
            ",", "mM", ",", "x4"}], "]"}]}], ";",
      RowBox[{"hDerived4", "=", RowBox[{"derivedHamiltonian", "[",
          RowBox[{"reduction4", ",", "Simplify"}], "]"}]}], ";",
      RowBox[{"exp4Symbolic", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"reductionLinear\"", "\[Rule]",
              RowBox[{"reduction4", "[", "\"residualIsLinear\"", "]"}]}],
            ",", RowBox[{"\"reducedEquationFreeOfX1\"", "\[Rule]",
              RowBox[{"FreeQ", "[", RowBox[{RowBox[{"Simplify", "[",
                    RowBox[{"reduction4", "[", "\"rest\"", "]"}], "]"}], ",",
                  "x1"}], "]"}]}], ",", RowBox[
             {"\"derivedHamiltonianEqualsRustForm\"", "\[Rule]",
              RowBox[{RowBox[{"Simplify", "[", RowBox[{"hDerived4", "-",
                    RowBox[{"modeHamiltonian", "[", RowBox[{"mM", ",",
                        RowBox[{"{", RowBox[{"0", ",", FractionBox["kC",
                          RowBox[{"aF", "[", "x4", "]"}]], ",", "0", ",",
                          "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
                          "}"}]}], "]"}]}], "]"}], "===", "zero16"}]}], ",",
            RowBox[{"\"hamiltonianSquared\"", "\[Rule]", RowBox[{
                RowBox[{"Simplify", "[", RowBox[{RowBox[{"hDerived4", ".",
                      "hDerived4"}], "-", RowBox[{RowBox[{"(", RowBox[
                         {SuperscriptBox["mM", "2"], "+", FractionBox[
                          SuperscriptBox["kC", "2"], SuperscriptBox[RowBox[
                          {"aF", "[", "x4", "]"}], "2"]]}], ")"}], " ",
                      "id16"}]}], "]"}], "===", "zero16"}]}]}], "]"}]}], ";",
      RowBox[{"exp4GenM", "=", RowBox[{"N", "[", RowBox[{"realBlock", "[",
            RowBox[{RowBox[{"-", "\[ImaginaryI]"}], " ", RowBox[{
                SubscriptBox["\[PartialD]", RowBox[{"mM"}]], "hDerived4"}]}],
            "]"}], "]"}]}], ";", RowBox[{"exp4GenK", "=",
        RowBox[{"N", "[", RowBox[{"realBlock", "[",
            RowBox[{RowBox[{"-", "\[ImaginaryI]"}], " ", RowBox[{"(",
                RowBox[{RowBox[{SubscriptBox["\[PartialD]", RowBox[{"kC"}]],
                    "hDerived4"}], " ", RowBox[{"aF", "[", "x4", "]"}]}],
                ")"}]}], "]"}], "]"}]}], ";",
      RowBox[{RowBox[{"exp4Hamiltonian", "[", RowBox[{"mass_", ",", "kk_"}],
          "]"}], ":=", RowBox[{"N", "[", RowBox[{"hDerived4", "/.",
            "\[VeryThinSpace]", RowBox[{"{", RowBox[{RowBox[{"mM", "\[Rule]",
                  "mass"}], ",", RowBox[{"kC", "\[Rule]", "kk"}], ",",
                RowBox[{RowBox[{"aF", "[", "x4", "]"}], "\[Rule]", "1"}]}],
              "}"}]}], "]"}]}], ";",
      RowBox[{RowBox[{"betaSquared", "[", RowBox[{"mass_", ",", "kk_", ",",
            "u_"}], "]"}], ":=", RowBox[{"Module", "[",
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"h", "=", RowBox[
                   {"exp4Hamiltonian", "[", RowBox[{"mass", ",", "kk"}],
                    "]"}]}], ",", RowBox[{"e", "=", SqrtBox[RowBox[
                    {SuperscriptBox["mass", "2"], "+", SuperscriptBox["kk",
                      "2"]}]]}]}], "}"}], ",", FractionBox[SuperscriptBox[
              TemplateBox[{RowBox[{FractionBox["1", "2"], " ", RowBox[
                   {"(", RowBox[{"u", "-", FractionBox[RowBox[{"h", ".",
                         "u"}], "e"]}], ")"}]}]}, "Norm"], "2"],
             RowBox[{"hilbertN", "[", "u", "]"}]]}], "]"}]}], ";",
      RowBox[{RowBox[{"exp4Invariants", "[", RowBox[{"mass_", ",", "kk_",
            ",", "u_"}], "]"}], ":=", RowBox[{"Module", "[",
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"h", "=", RowBox[
                   {"exp4Hamiltonian", "[", RowBox[{"mass", ",", "kk"}],
                    "]"}]}], ",", RowBox[{"e", "=", SqrtBox[RowBox[
                    {SuperscriptBox["mass", "2"], "+", SuperscriptBox["kk",
                      "2"]}]]}]}], "}"}], ",", RowBox[
             {"{", RowBox[{FractionBox[RowBox[{"expectN", "[", RowBox[
                    {"u", ",", "h"}], "]"}], "e"], ",", RowBox[
                 {"-", FractionBox[RowBox[{"kk", " ", RowBox[{"expectN", "[",
                       RowBox[{"u", ",", RowBox[{"N", "[", RowBox[{RowBox[
                          {"gam", "[", "4", "]"}], ".", RowBox[{"gam", "[",
                          "1", "]"}]}], "]"}]}], "]"}]}], "e"]}], ",",
                RowBox[{"scalarDensityN", "[", "u", "]"}], ",",
                RowBox[{"betaSquared", "[", RowBox[{"mass", ",", "kk", ",",
                    "u"}], "]"}], ",", RowBox[{"hilbertN", "[", "u", "]"}]}],
              "}"}]}], "]"}]}], ";", RowBox[{"exp4Parameters", "=",
        RowBox[{RowBox[{"summaries", "[", "\"exp4\"", "]"}], "[",
          "\"parameters\"", "]"}]}], ";", "exp4Symbolic"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"thermalMass", "=",
        RowBox[{"N", "[", RowBox[{RowBox[{"exp4Parameters", "[",
              "\"thermal\"", "]"}], "[", "\"m\"", "]"}], "]"}]}], ";",
      RowBox[{"thermalTi", "=", RowBox[{"N", "[",
          RowBox[{RowBox[{"exp4Parameters", "[", "\"thermal\"", "]"}], "[",
            "\"tInitial\"", "]"}], "]"}]}], ";",
      RowBox[{"thermalModes", "=", RowBox[{"readRun", "[",
          RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"numericsRoot",
                ",", "\"exp4\"", ",", "\"thermal_modes.csv\""}], "}"}],
            "]"}], "]"}]}], ";",
      RowBox[{RowBox[{"thermalCoefficient", "[", "kk_", "]"}], ":=",
        RowBox[{"Function", "[", RowBox[{RowBox[{"{", "tt", "}"}], ",",
            RowBox[{"kk", " ", SqrtBox[FractionBox["thermalTi", "tt"]]}]}],
          "]"}]}], ";", RowBox[{"thermalSubset", "=",
        RowBox[{"Association", "[", RowBox[{RowBox[{"0", "\[Rule]",
              "100.`"}], ",", RowBox[{"2", "\[Rule]", "100.`"}], ",",
            RowBox[{"16", "\[Rule]", "10.`"}], ",", RowBox[{"47", "\[Rule]",
              "10.`"}]}], "]"}]}], ";", RowBox[{"thermalResults", "=",
        RowBox[{"Association", "[", RowBox[{"KeyValueMap", "[",
            RowBox[{RowBox[{"Function", "[", RowBox[{RowBox[{"{", RowBox[
                     {"node", ",", "aMax"}], "}"}], ",", RowBox[{"Module",
                    "[", RowBox[{RowBox[{"{", RowBox[{"rows", ",", "ts", ",",
                          "ys", ",", "kk", ",", "keep", ",", "nd", ",",
                          "tight", ",", "local", ",", "invR", ",", "invN",
                          ",", "invCSV", ",", "e0", ",", "eigen"}], "}"}],
                      ",", RowBox[{RowBox[{"rows", "=", RowBox[{"Select",
                          "[", RowBox[{RowBox[{"thermalModes", "[",
                          "\"rows\"", "]"}], ",", RowBox[{RowBox[{RowBox[
                          {"#1", "\[LeftDoubleBracket]", RowBox[{RowBox[
                          {"thermalModes", "[", "\"index\"", "]"}], "[",
                          "\"node\"", "]"}], "\[RightDoubleBracket]"}],
                          "\[Equal]", "node"}], "&"}]}], "]"}]}], ";",
                        RowBox[{"ts", "=", RowBox[{"rows",
                          "\[LeftDoubleBracket]", RowBox[{"All", ",", RowBox[
                          {RowBox[{"thermalModes", "[", "\"index\"", "]"}],
                          "[", "\"t\"", "]"}]}], "\[RightDoubleBracket]"}]}],
                        ";", RowBox[{"ys", "=", RowBox[{"rows",
                          "\[LeftDoubleBracket]", RowBox[{"All", ",", RowBox[
                          {"Lookup", "[", RowBox[{RowBox[{"thermalModes",
                          "[", "\"index\"", "]"}], ",", "spinorNames"}],
                          "]"}]}], "\[RightDoubleBracket]"}]}], ";",
                        RowBox[{"kk", "=", RowBox[{"rows",
                          "\[LeftDoubleBracket]", RowBox[{"1", ",", RowBox[
                          {RowBox[{"thermalModes", "[", "\"index\"", "]"}],
                          "[", "\"k\"", "]"}]}], "\[RightDoubleBracket]"}]}],
                        ";", RowBox[{"keep", "=", RowBox[{"Flatten", "[",
                          RowBox[{"Position", "[", RowBox[{RowBox[{"rows",
                          "\[LeftDoubleBracket]", RowBox[{"All", ",", RowBox[
                          {RowBox[{"thermalModes", "[", "\"index\"", "]"}],
                          "[", "\"a\"", "]"}]}], "\[RightDoubleBracket]"}],
                          ",", RowBox[{"av_", "/;", RowBox[{"av",
                          "\[LessEqual]", RowBox[{"aMax", " ", RowBox[{"(",
                          RowBox[{"1", "+", FractionBox["1", SuperscriptBox[
                          "10", "12"]]}], ")"}]}]}]}]}], "]"}], "]"}]}], ";",
                        RowBox[{"nd", "=", RowBox[{"integrateLinear", "[",
                          RowBox[{RowBox[{"thermalMass", " ", "exp4GenM"}],
                          ",", "exp4GenK", ",", RowBox[{"thermalCoefficient",
                          "[", "kk", "]"}], ",", RowBox[{"ys",
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], ",", RowBox[{"{", RowBox[
                          {RowBox[{"ts", "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], ",", RowBox[{"ts",
                          "\[LeftDoubleBracket]", RowBox[{"Last", "[",
                          "keep", "]"}], "\[RightDoubleBracket]"}]}], "}"}],
                          ",", RowBox[{"ts", "\[LeftDoubleBracket]", "keep",
                          "\[RightDoubleBracket]"}], ",", RowBox[{"Method",
                          "\[Rule]", "\"Adams\""}], ",", RowBox[
                          {"PrecisionGoal", "\[Rule]", "13"}], ",", RowBox[
                          {"AccuracyGoal", "\[Rule]", "15"}]}], "]"}]}], ";",
                        RowBox[{"tight", "=", RowBox[{"If", "[", RowBox[
                          {RowBox[{"node", "\[Equal]", "2"}], ",", RowBox[
                          {"Max", "[", RowBox[{"Abs", "[", RowBox[{"nd", "-",
                          RowBox[{"integrateLinear", "[", RowBox[{RowBox[
                          {"thermalMass", " ", "exp4GenM"}], ",", "exp4GenK",
                          ",", RowBox[{"thermalCoefficient", "[", "kk",
                          "]"}], ",", RowBox[{"ys", "\[LeftDoubleBracket]",
                          "1", "\[RightDoubleBracket]"}], ",", RowBox[{"{",
                          RowBox[{RowBox[{"ts", "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], ",", RowBox[{"ts",
                          "\[LeftDoubleBracket]", RowBox[{"Last", "[",
                          "keep", "]"}], "\[RightDoubleBracket]"}]}], "}"}],
                          ",", RowBox[{"ts", "\[LeftDoubleBracket]", "keep",
                          "\[RightDoubleBracket]"}], ",", RowBox[{"Method",
                          "\[Rule]", RowBox[{"{", RowBox[{
                          "\"ExplicitRungeKutta\"", ",", RowBox[{
                          "\"DifferenceOrder\"", "\[Rule]", "8"}]}], "}"}]}],
                          ",", RowBox[{"PrecisionGoal", "\[Rule]", "13"}],
                          ",", RowBox[{"AccuracyGoal", "\[Rule]", "15"}]}],
                          "]"}]}], "]"}], "]"}], ",", RowBox[{"Missing", "[",
                          "\"NotComputed\"", "]"}]}], "]"}]}], ";", RowBox[
                         {"local", "=", RowBox[{"Table", "[", RowBox[
                          {RowBox[{RowBox[{"Last", "[", RowBox[
                          {"integrateLinear", "[", RowBox[{RowBox[
                          {"thermalMass", " ", "exp4GenM"}], ",", "exp4GenK",
                          ",", RowBox[{"thermalCoefficient", "[", "kk",
                          "]"}], ",", RowBox[{"ys", "\[LeftDoubleBracket]",
                          "j", "\[RightDoubleBracket]"}], ",", RowBox[{"{",
                          RowBox[{RowBox[{"ts", "\[LeftDoubleBracket]", "j",
                          "\[RightDoubleBracket]"}], ",", RowBox[{"ts",
                          "\[LeftDoubleBracket]", RowBox[{"j", "+", "1"}],
                          "\[RightDoubleBracket]"}]}], "}"}], ",", RowBox[
                          {"{", RowBox[{"ts", "\[LeftDoubleBracket]", RowBox[
                          {"j", "+", "1"}], "\[RightDoubleBracket]"}], "}"}],
                          ",", RowBox[{"Method", "\[Rule]", "\"Adams\""}],
                          ",", RowBox[{"PrecisionGoal", "\[Rule]", "13"}],
                          ",", RowBox[{"AccuracyGoal", "\[Rule]", "15"}]}],
                          "]"}], "]"}], "-", RowBox[{"ys",
                          "\[LeftDoubleBracket]", RowBox[{"j", "+", "1"}],
                          "\[RightDoubleBracket]"}]}], ",", RowBox[{"{",
                          RowBox[{"j", ",", "1", ",", "3"}], "}"}]}],
                          "]"}]}], ";", RowBox[{"invR", "=", RowBox[{"Table",
                          "[", RowBox[{RowBox[{"exp4Invariants", "[", RowBox[
                          {"thermalMass", ",", FractionBox["kk", SqrtBox[
                          FractionBox[RowBox[{"ts", "\[LeftDoubleBracket]",
                          "j", "\[RightDoubleBracket]"}], "thermalTi"]]],
                          ",", RowBox[{"complexSpinor", "[", RowBox[{"ys",
                          "\[LeftDoubleBracket]", "j",
                          "\[RightDoubleBracket]"}], "]"}]}], "]"}], ",",
                          RowBox[{"{", RowBox[{"j", ",", "keep"}], "}"}]}],
                          "]"}]}], ";", RowBox[{"invN", "=", RowBox[{"Table",
                          "[", RowBox[{RowBox[{"exp4Invariants", "[", RowBox[
                          {"thermalMass", ",", FractionBox["kk", SqrtBox[
                          FractionBox[RowBox[{"ts", "\[LeftDoubleBracket]",
                          RowBox[{"keep", "\[LeftDoubleBracket]", "j",
                          "\[RightDoubleBracket]"}],
                          "\[RightDoubleBracket]"}], "thermalTi"]]], ",",
                          RowBox[{"complexSpinor", "[", RowBox[{"nd",
                          "\[LeftDoubleBracket]", "j",
                          "\[RightDoubleBracket]"}], "]"}]}], "]"}], ",",
                          RowBox[{"{", RowBox[{"j", ",", RowBox[{"Length",
                          "[", "keep", "]"}]}], "}"}]}], "]"}]}], ";",
                        RowBox[{"invCSV", "=", RowBox[{"MapThread", "[",
                          RowBox[{RowBox[{RowBox[{"#1", " ", RowBox[{"{",
                          RowBox[{FractionBox["1", "#2"], ",", FractionBox[
                          "1", "#2"], ",", "1", ",", "1", ",", "1"}],
                          "}"}]}], "&"}], ",", RowBox[{"{", RowBox[{RowBox[
                          {"rows", "\[LeftDoubleBracket]", RowBox[{"keep",
                          ",", RowBox[{"Lookup", "[", RowBox[{RowBox[
                          {"thermalModes", "[", "\"index\"", "]"}], ",",
                          RowBox[{"{", RowBox[{"\"eps\"", ",", "\"p1\"", ",",
                          "\"s\"", ",", "\"beta2\"", ",",
                          "\"norm_hilbert\""}], "}"}]}], "]"}]}],
                          "\[RightDoubleBracket]"}], ",", RowBox[{"rows",
                          "\[LeftDoubleBracket]", RowBox[{"keep", ",", RowBox[
                          {RowBox[{"thermalModes", "[", "\"index\"", "]"}],
                          "[", "\"E\"", "]"}]}], "\[RightDoubleBracket]"}]}],
                          "}"}]}], "]"}]}], ";", RowBox[{"e0", "=", SqrtBox[
                          RowBox[{SuperscriptBox["thermalMass", "2"], "+",
                          SuperscriptBox["kk", "2"]}]]}], ";", RowBox[
                         {"eigen", "=", RowBox[{"Max", "[", RowBox[
                          {TemplateBox[{RowBox[{RowBox[{RowBox[
                          {"exp4Hamiltonian", "[", RowBox[{"thermalMass",
                          ",", "kk"}], "]"}], ".", RowBox[{"complexSpinor",
                          "[", RowBox[{"ys", "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "]"}]}], "-", RowBox[
                          {"e0", " ", RowBox[{"complexSpinor", "[", RowBox[
                          {"ys", "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "]"}]}]}],
                          "\[Infinity]"}, "Norm2"], ",", TemplateBox[
                          {RowBox[{RowBox[{"kreinN", ".", RowBox[
                          {"complexSpinor", "[", RowBox[{"ys",
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "]"}]}], "-", RowBox[
                          {"complexSpinor", "[", RowBox[{"ys",
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "]"}]}], "\[Infinity]"},
                          "Norm2"]}], "]"}]}], ";", RowBox[{"node",
                          "\[Rule]", RowBox[{"Association", "[", RowBox[
                          {RowBox[{"\"k\"", "\[Rule]", "kk"}], ",", RowBox[
                          {"\"aMax\"", "\[Rule]", "aMax"}], ",", RowBox[
                          {"\"samples\"", "\[Rule]", RowBox[{"Length", "[",
                          "keep", "]"}]}], ",", RowBox[
                          {"\"initialEigenResidual\"", "\[Rule]", "eigen"}],
                          ",", RowBox[{"\"oneIntervalMaxAbsDeviation\"",
                          "\[Rule]", RowBox[{"Max", "[", RowBox[{"Abs", "[",
                          "local", "]"}], "]"}]}], ",", RowBox[
                          {"\"maxAbsDeviation\"", "\[Rule]", RowBox[{"Max",
                          "[", RowBox[{"Abs", "[", RowBox[{"nd", "-", RowBox[
                          {"ys", "\[LeftDoubleBracket]", "keep",
                          "\[RightDoubleBracket]"}]}], "]"}], "]"}]}], ",",
                          RowBox[{"\"maxPhaseAlignedDeviation\"", "\[Rule]",
                          RowBox[{"Max", "[", RowBox[{"MapThread", "[",
                          RowBox[{RowBox[{RowBox[{"alignedDistance", "[",
                          RowBox[{RowBox[{"complexSpinor", "[", "#1", "]"}],
                          ",", RowBox[{"complexSpinor", "[", "#2", "]"}]}],
                          "]"}], "&"}], ",", RowBox[{"{", RowBox[{RowBox[
                          {"ys", "\[LeftDoubleBracket]", "keep",
                          "\[RightDoubleBracket]"}], ",", "nd"}], "}"}]}],
                          "]"}], "]"}]}], ",", RowBox[
                          {"\"maxInvariantDeviation\"", "\[Rule]", RowBox[
                          {"Max", "[", RowBox[{"Abs", "[", RowBox[{"invN",
                          "-", "invR"}], "]"}], "]"}]}], ",", RowBox[
                          {"\"csvBilinearFormulaDeviation\"", "\[Rule]",
                          RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[
                          {"invR", "-", "invCSV"}], "]"}], "]"}]}], ",",
                          RowBox[{"\"ndsolveAdamsVsRungeKutta\"", "\[Rule]",
                          "tight"}]}], "]"}]}]}]}], "]"}]}], "]"}], ",",
              "thermalSubset"}], "]"}], "]"}]}], ";",
      RowBox[{"Dataset", "[", "thermalResults", "]"}]}]], "Input"],
  Cell["Kinetic theory. With the Fermi-Dirac occupation f(k) = 1/(e^(E_i/T_i) \
+ 1), E_i = sqrt(m^2 + k^2), 16 states per comoving k (8 particles + 8 \
antiparticles) and the momentum cut k_max = 12 T_i of the Rust grid, rho(a) = \
(16/(2 pi^2 a^3)) Integral k^2 f(k) E(k/a) dk and p(a) = (16/(2 pi^2 a^3)) \
Integral k^2 f(k) (k/a)^2/(3 E(k/a)) dk are evaluated by NIntegrate (no grid) \
and compared with the Rust mode sums (rho, p: 48 CVODE modes) and the Rust \
Gauss-Legendre kinetic columns (rho_kinetic, p_kinetic). The known \
first-order free-wave interference in p (summary.json findings) shows up here \
as the p deviation.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"thermalEOS", "=",
        RowBox[{"readRun", "[", RowBox[{"FileNameJoin", "[",
            RowBox[{"{", RowBox[{"numericsRoot", ",", "\"exp4\"", ",",
                "\"thermal_eos.csv\""}], "}"}], "]"}], "]"}]}], ";",
      RowBox[{RowBox[{"{", RowBox[{"thermalT", ",", "thermalKmax"}], "}"}],
        "=", RowBox[{"N", "[", RowBox[{"{", RowBox[
             {RowBox[{RowBox[{"exp4Parameters", "[", "\"thermal\"", "]"}],
                "[", "\"temperature\"", "]"}], ",", RowBox[{RowBox[
                 {"exp4Parameters", "[", "\"thermal\"", "]"}], "[",
                "\"kMax\"", "]"}]}], "}"}], "]"}]}], ";",
      RowBox[{RowBox[{"occupation", "[", "kk_", "]"}], ":=",
        FractionBox["1", RowBox[{RowBox[{"Exp", "[", FractionBox[
              SqrtBox[RowBox[{SuperscriptBox["thermalMass", "2"], "+",
                 SuperscriptBox["kk", "2"]}]], "thermalT"], "]"}], "+",
           "1"}]]}], ";", RowBox[{RowBox[{"kineticRho", "[",
          RowBox[{"av_", ",", "kmax_"}], "]"}], ":=",
        FractionBox[RowBox[{"16", " ", RowBox[{"NIntegrate", "[",
             RowBox[{RowBox[{SuperscriptBox["kk", "2"], " ", RowBox[
                  {"occupation", "[", "kk", "]"}], " ", SqrtBox[RowBox[
                   {SuperscriptBox["thermalMass", "2"], "+", FractionBox[
                     SuperscriptBox["kk", "2"], SuperscriptBox["av",
                      "2"]]}]]}], ",", RowBox[{"{", RowBox[{"kk", ",", "0",
                   ",", "kmax"}], "}"}], ",", RowBox[{"PrecisionGoal",
                 "\[Rule]", "13"}], ",", RowBox[{"AccuracyGoal", "\[Rule]",
                 "20"}], ",", RowBox[{"MaxRecursion", "\[Rule]", "20"}]}],
             "]"}]}], RowBox[{"2", " ", SuperscriptBox["\[Pi]", "2"], " ",
           SuperscriptBox["av", "3"]}]]}], ";",
      RowBox[{RowBox[{"kineticP", "[", RowBox[{"av_", ",", "kmax_"}], "]"}],
        ":=", FractionBox[RowBox[{"16", " ", RowBox[{"NIntegrate", "[",
             RowBox[{FractionBox[RowBox[{SuperscriptBox["kk", "2"], " ",
                  RowBox[{"occupation", "[", "kk", "]"}], " ", SuperscriptBox[
                   "kk", "2"]}], RowBox[{SuperscriptBox["av", "2"], " ",
                  RowBox[{"(", RowBox[{"3", " ", SqrtBox[RowBox[
                        {SuperscriptBox["thermalMass", "2"], "+", FractionBox[
                          SuperscriptBox["kk", "2"], SuperscriptBox["av",
                          "2"]]}]]}], ")"}]}]], ",", RowBox[{"{",
                 RowBox[{"kk", ",", "0", ",", "kmax"}], "}"}], ",", RowBox[
                {"PrecisionGoal", "\[Rule]", "13"}], ",", RowBox[
                {"AccuracyGoal", "\[Rule]", "20"}], ",", RowBox[
                {"MaxRecursion", "\[Rule]", "20"}]}], "]"}]}],
         RowBox[{"2", " ", SuperscriptBox["\[Pi]", "2"], " ",
           SuperscriptBox["av", "3"]}]]}], ";",
      RowBox[{"thermalA", "=", RowBox[{"columnOf", "[",
          RowBox[{"thermalEOS", ",", "\"a\""}], "]"}]}], ";",
      RowBox[{"kineticTable", "=", RowBox[{"Table", "[",
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"kineticRho", "[",
                  RowBox[{"av", ",", "thermalKmax"}], "]"}], ",",
                RowBox[{"kineticP", "[", RowBox[{"av", ",", "thermalKmax"}],
                  "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"av", ",",
                "thermalA"}], "}"}]}], "]"}]}], ";",
      RowBox[{"thermalKinetic", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"rhoModeSumMaxRelativeDeviation\"", "\[Rule]",
              RowBox[{"Max", "[", FractionBox[RowBox[{"Abs", "[",
                   RowBox[{RowBox[{"columnOf", "[", RowBox[{"thermalEOS",
                         ",", "\"rho\""}], "]"}], "-", RowBox[
                      {"kineticTable", "\[LeftDoubleBracket]", RowBox[
                        {"All", ",", "1"}], "\[RightDoubleBracket]"}]}],
                   "]"}], RowBox[{"kineticTable", "\[LeftDoubleBracket]",
                   RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}]],
                "]"}]}], ",", RowBox[
             {"\"rhoGaussLegendreMaxRelativeDeviation\"", "\[Rule]",
              RowBox[{"Max", "[", FractionBox[RowBox[{"Abs", "[",
                   RowBox[{RowBox[{"columnOf", "[", RowBox[{"thermalEOS",
                         ",", "\"rho_kinetic\""}], "]"}], "-", RowBox[
                      {"kineticTable", "\[LeftDoubleBracket]", RowBox[
                        {"All", ",", "1"}], "\[RightDoubleBracket]"}]}],
                   "]"}], RowBox[{"kineticTable", "\[LeftDoubleBracket]",
                   RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}]],
                "]"}]}], ",", RowBox[{"\"pModeSumMaxRelativeDeviation\"",
              "\[Rule]", RowBox[{"Max", "[", FractionBox[RowBox[{"Abs", "[",
                   RowBox[{RowBox[{"columnOf", "[", RowBox[{"thermalEOS",
                         ",", "\"p\""}], "]"}], "-", RowBox[{"kineticTable",
                       "\[LeftDoubleBracket]", RowBox[{"All", ",", "2"}],
                       "\[RightDoubleBracket]"}]}], "]"}], RowBox[
                  {"kineticTable", "\[LeftDoubleBracket]", RowBox[{"All",
                     ",", "2"}], "\[RightDoubleBracket]"}]], "]"}]}], ",",
            RowBox[{"\"pGaussLegendreMaxRelativeDeviation\"", "\[Rule]",
              RowBox[{"Max", "[", FractionBox[RowBox[{"Abs", "[",
                   RowBox[{RowBox[{"columnOf", "[", RowBox[{"thermalEOS",
                         ",", "\"p_kinetic\""}], "]"}], "-", RowBox[
                      {"kineticTable", "\[LeftDoubleBracket]", RowBox[
                        {"All", ",", "2"}], "\[RightDoubleBracket]"}]}],
                   "]"}], RowBox[{"kineticTable", "\[LeftDoubleBracket]",
                   RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}]],
                "]"}]}], ",", RowBox[{"\"wModeSumMaxAbsDeviation\"",
              "\[Rule]", RowBox[{"Max", "[", RowBox[{"Abs", "[",
                  RowBox[{RowBox[{"columnOf", "[", RowBox[{"thermalEOS", ",",
                        "\"w\""}], "]"}], "-", FractionBox[RowBox[
                      {"kineticTable", "\[LeftDoubleBracket]", RowBox[
                        {"All", ",", "2"}], "\[RightDoubleBracket]"}],
                     RowBox[{"kineticTable", "\[LeftDoubleBracket]",
                       RowBox[{"All", ",", "1"}],
                       "\[RightDoubleBracket]"}]]}], "]"}], "]"}]}], ",",
            RowBox[{"\"wAtA1\"", "\[Rule]", FractionBox[RowBox[
                {"kineticTable", "\[LeftDoubleBracket]", RowBox[{"1", ",",
                   "2"}], "\[RightDoubleBracket]"}], RowBox[{"kineticTable",
                 "\[LeftDoubleBracket]", RowBox[{"1", ",", "1"}],
                 "\[RightDoubleBracket]"}]]}], ",",
            RowBox[{"\"wAtAEnd\"", "\[Rule]", FractionBox[RowBox[
                {"kineticTable", "\[LeftDoubleBracket]", RowBox[
                  {RowBox[{"-", "1"}], ",", "2"}], "\[RightDoubleBracket]"}],
               RowBox[{"kineticTable", "\[LeftDoubleBracket]", RowBox[
                  {RowBox[{"-", "1"}], ",", "1"}],
                 "\[RightDoubleBracket]"}]]}], ",",
            RowBox[{"\"kmaxTruncationRhoAtA1\"", "\[Rule]", RowBox[{"1", "-",
                FractionBox[RowBox[{"kineticTable", "\[LeftDoubleBracket]",
                   RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}],
                 RowBox[{"kineticRho", "[", RowBox[{"1.`", ",",
                     "\[Infinity]"}], "]"}]]}]}]}], "]"}]}]}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"pairModes", "=",
        RowBox[{"readRun", "[", RowBox[{"FileNameJoin", "[",
            RowBox[{"{", RowBox[{"numericsRoot", ",", "\"exp4\"", ",",
                "\"pair_modes.csv\""}], "}"}], "]"}], "]"}]}], ";",
      RowBox[{"pairSpectrum", "=", RowBox[{"readRun", "[",
          RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"numericsRoot",
                ",", "\"exp4\"", ",", "\"pair_spectrum.csv\""}], "}"}],
            "]"}], "]"}]}], ";",
      RowBox[{RowBox[{"deSitterCoefficient", "[", "kk_", "]"}], ":=",
        RowBox[{"Function", "[", RowBox[{RowBox[{"{", "tt", "}"}], ",",
            RowBox[{"kk", " ", RowBox[{"Exp", "[", RowBox[{"-", "tt"}],
                "]"}]}]}], "]"}]}], ";",
      RowBox[{RowBox[{"radiationCoefficient", "[", "kk_", "]"}], ":=",
        RowBox[{"Function", "[", RowBox[{RowBox[{"{", "tt", "}"}], ",",
            FractionBox["kk", SqrtBox[RowBox[{"1", "+", RowBox[{"2", " ",
                  "tt"}]}]]]}], "]"}]}], ";",
      RowBox[{RowBox[{"pairBackground", "[", "tt_", "]"}], ":=",
        RowBox[{"If", "[", RowBox[{RowBox[{"tt", "<", "0"}], ",",
            RowBox[{"{", RowBox[{RowBox[{"Exp", "[", "tt", "]"}], ",",
                "1.`"}], "}"}], ",", RowBox[{"{", RowBox[{SqrtBox[
                 RowBox[{"1", "+", RowBox[{"2", " ", "tt"}]}]], ",",
                FractionBox["1", RowBox[{"1", "+", RowBox[{"2", " ",
                     "tt"}]}]]}], "}"}]}], "]"}]}], ";",
      RowBox[{"pairSubset", "=", RowBox[{"Join", "[",
          RowBox[{RowBox[{"Tuples", "[", RowBox[{"{", RowBox[
                 {RowBox[{"{", RowBox[{"0.5`", ",", "1.`", ",", "2.`"}],
                    "}"}], ",", RowBox[{"{", RowBox[{"16", ",", "32", ",",
                      "48"}], "}"}]}], "}"}], "]"}], ",",
            RowBox[{"{", RowBox[{"{", RowBox[{"0.`", ",", "32"}], "}"}],
              "}"}]}], "]"}]}], ";", RowBox[{"pairResults", "=",
        RowBox[{"Association", "[", RowBox[{"Table", "[",
            RowBox[{RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                     {RowBox[{"mass", "=", RowBox[{"pm",
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}]}], ",", RowBox[{"node",
                        "=", RowBox[{"pm", "\[LeftDoubleBracket]", "2",
                          "\[RightDoubleBracket]"}]}], ",", "rows", ",",
                      "ts", ",", "ys", ",", "kk", ",", "i0", ",", "ds", ",",
                      "rad", ",", "nd", ",", "beta2N", ",", "beta2R", ",",
                      "spec", ",", "adiabatic", ",", "u0", ",", "a0", ",",
                      "h0", ",", "e0", ",", "hdot", ",", "pPlus", ",",
                      "pMinus"}], "}"}], ",", RowBox[{RowBox[{"rows", "=",
                      RowBox[{"Select", "[", RowBox[{RowBox[{"pairModes",
                          "[", "\"rows\"", "]"}], ",", RowBox[{RowBox[
                          {RowBox[{RowBox[{"#1", "\[LeftDoubleBracket]",
                          RowBox[{RowBox[{"pairModes", "[", "\"index\"",
                          "]"}], "[", "\"m\"", "]"}],
                          "\[RightDoubleBracket]"}], "\[Equal]", "mass"}],
                          "&&", RowBox[{RowBox[{"#1", "\[LeftDoubleBracket]",
                          RowBox[{RowBox[{"pairModes", "[", "\"index\"",
                          "]"}], "[", "\"node\"", "]"}],
                          "\[RightDoubleBracket]"}], "\[Equal]", "node"}]}],
                          "&"}]}], "]"}]}], ";", RowBox[{"ts", "=",
                      RowBox[{"rows", "\[LeftDoubleBracket]", RowBox[{"All",
                          ",", RowBox[{RowBox[{"pairModes", "[", "\"index\"",
                          "]"}], "[", "\"t\"", "]"}]}],
                        "\[RightDoubleBracket]"}]}], ";", RowBox[{"ys", "=",
                      RowBox[{"rows", "\[LeftDoubleBracket]", RowBox[{"All",
                          ",", RowBox[{"Lookup", "[", RowBox[{RowBox[
                          {"pairModes", "[", "\"index\"", "]"}], ",",
                          "spinorNames"}], "]"}]}],
                        "\[RightDoubleBracket]"}]}], ";", RowBox[{"kk", "=",
                      RowBox[{"rows", "\[LeftDoubleBracket]", RowBox[
                         {"1", ",", RowBox[{RowBox[{"pairModes", "[",
                          "\"index\"", "]"}], "[", "\"k\"", "]"}]}],
                        "\[RightDoubleBracket]"}]}], ";", RowBox[{"i0", "=",
                      RowBox[{"First", "[", RowBox[{"FirstPosition", "[",
                          RowBox[{"ts", ",", "0.`"}], "]"}], "]"}]}], ";",
                    RowBox[{"ds", "=", RowBox[{"integrateLinear", "[",
                        RowBox[{RowBox[{"mass", " ", "exp4GenM"}], ",",
                          "exp4GenK", ",", RowBox[{"deSitterCoefficient",
                          "[", "kk", "]"}], ",", RowBox[{"ys",
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], ",", RowBox[{"{",
                          RowBox[{RowBox[{"ts", "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], ",", "0.`"}], "}"}],
                          ",", RowBox[{"ts", "\[LeftDoubleBracket]", RowBox[
                          {"1", ";;", "i0"}], "\[RightDoubleBracket]"}], ",",
                          RowBox[{"Method", "\[Rule]", RowBox[{"{", RowBox[
                          {"\"ExplicitRungeKutta\"", ",", RowBox[
                          {"\"DifferenceOrder\"", "\[Rule]", "8"}]}],
                          "}"}]}], ",", RowBox[{"PrecisionGoal", "\[Rule]",
                          "13"}], ",", RowBox[{"AccuracyGoal", "\[Rule]",
                          "15"}]}], "]"}]}], ";", RowBox[{"rad", "=",
                      RowBox[{"integrateLinear", "[", RowBox[{RowBox[{"mass",
                          " ", "exp4GenM"}], ",", "exp4GenK", ",", RowBox[
                          {"radiationCoefficient", "[", "kk", "]"}], ",",
                          RowBox[{"Last", "[", "ds", "]"}], ",", RowBox[
                          {"{", RowBox[{"0.`", ",", RowBox[{"ts",
                          "\[LeftDoubleBracket]", RowBox[{"-", "1"}],
                          "\[RightDoubleBracket]"}]}], "}"}], ",", RowBox[
                          {"ts", "\[LeftDoubleBracket]", RowBox[{"i0", ";;",
                          "All"}], "\[RightDoubleBracket]"}], ",", RowBox[
                          {"Method", "\[Rule]", "\"Adams\""}], ",", RowBox[
                          {"PrecisionGoal", "\[Rule]", "13"}], ",", RowBox[
                          {"AccuracyGoal", "\[Rule]", "15"}]}], "]"}]}], ";",
                    RowBox[{"nd", "=", RowBox[{"Join", "[", RowBox[{"ds",
                          ",", RowBox[{"Rest", "[", "rad", "]"}]}], "]"}]}],
                    ";", RowBox[{"beta2N", "=", RowBox[{"betaSquared", "[",
                        RowBox[{"mass", ",", FractionBox["kk", RowBox[
                          {RowBox[{"pairBackground", "[", RowBox[{"ts",
                          "\[LeftDoubleBracket]", RowBox[{"-", "1"}],
                          "\[RightDoubleBracket]"}], "]"}],
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}]], ",", RowBox[
                          {"complexSpinor", "[", RowBox[{"Last", "[", "nd",
                          "]"}], "]"}]}], "]"}]}], ";", RowBox[{"beta2R",
                      "=", RowBox[{"betaSquared", "[", RowBox[{"mass", ",",
                          FractionBox["kk", RowBox[{RowBox[{"pairBackground",
                          "[", RowBox[{"ts", "\[LeftDoubleBracket]", RowBox[
                          {"-", "1"}], "\[RightDoubleBracket]"}], "]"}],
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}]], ",", RowBox[
                          {"complexSpinor", "[", RowBox[{"Last", "[", "ys",
                          "]"}], "]"}]}], "]"}]}], ";", RowBox[{"spec", "=",
                      RowBox[{"SelectFirst", "[", RowBox[{RowBox[
                          {"pairSpectrum", "[", "\"rows\"", "]"}], ",",
                          RowBox[{RowBox[{RowBox[{RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{RowBox[
                          {"pairSpectrum", "[", "\"index\"", "]"}], "[",
                          "\"m\"", "]"}], "\[RightDoubleBracket]"}],
                          "\[Equal]", "mass"}], "&&", RowBox[{RowBox[{"#1",
                          "\[LeftDoubleBracket]", RowBox[{RowBox[
                          {"pairSpectrum", "[", "\"index\"", "]"}], "[",
                          "\"node\"", "]"}], "\[RightDoubleBracket]"}],
                          "\[Equal]", "node"}]}], "&"}]}], "]"}]}], ";",
                    RowBox[{"u0", "=", RowBox[{"complexSpinor", "[",
                        RowBox[{"ys", "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "]"}]}], ";",
                    RowBox[{"a0", "=", RowBox[{RowBox[{"pairBackground", "[",
                          RowBox[{"ts", "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "]"}],
                        "\[LeftDoubleBracket]", "1",
                        "\[RightDoubleBracket]"}]}], ";", RowBox[{"h0", "=",
                      RowBox[{"exp4Hamiltonian", "[", RowBox[{"mass", ",",
                          FractionBox["kk", "a0"]}], "]"}]}], ";",
                    RowBox[{"e0", "=", SqrtBox[RowBox[{SuperscriptBox["mass",
                          "2"], "+", SuperscriptBox[RowBox[{"(", FractionBox[
                          "kk", "a0"], ")"}], "2"]}]]}], ";", RowBox[
                     {"hdot", "=", FractionBox[RowBox[{"kk", " ", RowBox[
                          {RowBox[{"pairBackground", "[", RowBox[{"ts",
                          "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "]"}],
                          "\[LeftDoubleBracket]", "2",
                          "\[RightDoubleBracket]"}], " ", RowBox[{"N", "[",
                          RowBox[{RowBox[{"gam", "[", "4", "]"}], ".",
                          RowBox[{"gam", "[", "1", "]"}]}], "]"}]}], "a0"]}],
                    ";", RowBox[{"pPlus", "=", RowBox[{FractionBox["1", "2"],
                        " ", RowBox[{"(", RowBox[{"id16", "+", FractionBox[
                          "h0", "e0"]}], ")"}]}]}], ";", RowBox[{"pMinus",
                      "=", RowBox[{FractionBox["1", "2"], " ", RowBox[
                         {"(", RowBox[{"id16", "-", FractionBox["h0",
                          "e0"]}], ")"}]}]}], ";", RowBox[{"adiabatic", "=",
                      TemplateBox[{RowBox[{RowBox[{"pMinus", ".", "u0"}],
                          "+", FractionBox[RowBox[{"\[ImaginaryI]", " ",
                          RowBox[{"pMinus", ".", "hdot", ".", "pPlus", ".",
                          "u0"}]}], RowBox[{"4", " ", SuperscriptBox["e0",
                          "2"]}]]}], "\[Infinity]"}, "Norm2"]}], ";",
                    RowBox[{RowBox[{"{", RowBox[{"mass", ",", "node"}],
                        "}"}], "\[Rule]", RowBox[{"Association", "[",
                        RowBox[{RowBox[{"\"k\"", "\[Rule]", "kk"}], ",",
                          RowBox[{"\"initialAdiabaticResidual\"", "\[Rule]",
                          "adiabatic"}], ",", RowBox[{"\"maxAbsDeviation\"",
                          "\[Rule]", RowBox[{"Max", "[", RowBox[{"Abs", "[",
                          RowBox[{"nd", "-", "ys"}], "]"}], "]"}]}], ",",
                          RowBox[{"\"maxPhaseAlignedDeviation\"", "\[Rule]",
                          RowBox[{"Max", "[", RowBox[{"MapThread", "[",
                          RowBox[{RowBox[{RowBox[{"alignedDistance", "[",
                          RowBox[{RowBox[{"complexSpinor", "[", "#1", "]"}],
                          ",", RowBox[{"complexSpinor", "[", "#2", "]"}]}],
                          "]"}], "&"}], ",", RowBox[{"{", RowBox[{"ys", ",",
                          "nd"}], "}"}]}], "]"}], "]"}]}], ",", RowBox[
                          {"\"beta2EndNDSolve\"", "\[Rule]", "beta2N"}], ",",
                          RowBox[{"\"beta2EndRust\"", "\[Rule]", "beta2R"}],
                          ",", RowBox[{"\"beta2EndSpectrumCSV\"", "\[Rule]",
                          RowBox[{"spec", "\[LeftDoubleBracket]", RowBox[
                          {RowBox[{"pairSpectrum", "[", "\"index\"", "]"}],
                          "[", "\"beta2_end\"", "]"}],
                          "\[RightDoubleBracket]"}]}], ",", RowBox[
                          {"\"beta2RelativeDeviation\"", "\[Rule]", RowBox[
                          {"If", "[", RowBox[{RowBox[{"mass", "\[Equal]",
                          "0.`"}], ",", "0.`", ",", FractionBox[RowBox[
                          {"Abs", "[", RowBox[{"beta2N", "-", "beta2R"}],
                          "]"}], "beta2R"]}], "]"}]}]}], "]"}]}]}]}], "]"}],
              ",", RowBox[{"{", RowBox[{"pm", ",", "pairSubset"}], "}"}]}],
            "]"}], "]"}]}], ";", RowBox[{"Dataset", "[", "pairResults",
        "]"}]}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"exp4Result", "=",
        RowBox[{"Association", "[", RowBox[{RowBox[{"\"symbolic\"",
              "\[Rule]", "exp4Symbolic"}], ",", RowBox[{"\"thermal\"",
              "\[Rule]", RowBox[{"Association", "[", RowBox[
                 {RowBox[{"\"nodes\"", "\[Rule]", RowBox[{"Keys", "[",
                      "thermalResults", "]"}]}], ",", RowBox[{"\"aMax\"",
                    "\[Rule]", RowBox[{"Values", "[", "thermalSubset",
                      "]"}]}], ",", RowBox[{"\"method\"", "\[Rule]", "\"Adams\
, machine precision, PrecisionGoal 13, AccuracyGoal 15\""}], ",",
                  RowBox[{"\"maxAbsDeviation\"", "\[Rule]", RowBox[{"Max",
                      "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1", "[",
                          "\"maxAbsDeviation\"", "]"}], "&"}], ")"}], "/@",
                        RowBox[{"Values", "[", "thermalResults", "]"}]}],
                      "]"}]}], ",", RowBox[{"\"maxPhaseAlignedDeviation\"",
                    "\[Rule]", RowBox[{"Max", "[", RowBox[{RowBox[{"(",
                          RowBox[{RowBox[{"#1", "[",
                          "\"maxPhaseAlignedDeviation\"", "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Values", "[",
                          "thermalResults", "]"}]}], "]"}]}], ",",
                  RowBox[{"\"maxInvariantDeviation\"", "\[Rule]", RowBox[
                     {"Max", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1",
                          "[", "\"maxInvariantDeviation\"", "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Values", "[",
                          "thermalResults", "]"}]}], "]"}]}], ",",
                  RowBox[{"\"oneIntervalMaxAbsDeviation\"", "\[Rule]",
                    RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"#1", "[",
                          "\"oneIntervalMaxAbsDeviation\"", "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Values", "[",
                          "thermalResults", "]"}]}], "]"}]}], ",",
                  RowBox[{"\"csvBilinearFormulaDeviation\"", "\[Rule]",
                    RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"#1", "[",
                          "\"csvBilinearFormulaDeviation\"", "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Values", "[",
                          "thermalResults", "]"}]}], "]"}]}], ",",
                  RowBox[{"\"maxInitialEigenResidual\"", "\[Rule]",
                    RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"#1", "[", "\"initialEigenResidual\"",
                          "]"}], "&"}], ")"}], "/@", RowBox[{"Values", "[",
                          "thermalResults", "]"}]}], "]"}]}], ",",
                  RowBox[{"\"ndsolveAdamsVsRungeKuttaNode2\"", "\[Rule]",
                    RowBox[{RowBox[{"thermalResults", "[", "2", "]"}], "[",
                      "\"ndsolveAdamsVsRungeKutta\"", "]"}]}], ",",
                  RowBox[{"\"perNode\"", "\[Rule]", RowBox[{"KeyMap", "[",
                      RowBox[{"ToString", ",", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"KeyDrop", "[", RowBox[{"#1", ",", RowBox[
                          {"{", "\"k\"", "}"}]}], "]"}], "&"}], ")"}], "/@",
                          "thermalResults"}]}], "]"}]}]}], "]"}]}], ",",
            RowBox[{"\"kineticTheory\"", "\[Rule]", "thermalKinetic"}], ",",
            RowBox[{"\"pair\"", "\[Rule]", RowBox[{"Association", "[",
                RowBox[{RowBox[{"\"modes\"", "\[Rule]", RowBox[
                     {RowBox[{"(", RowBox[{RowBox[{RowBox[{"ToString", "[",
                          RowBox[{"#1", "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "]"}], "<>", "\"/\"",
                          "<>", RowBox[{"ToString", "[", RowBox[{"#1",
                          "\[LeftDoubleBracket]", "2",
                          "\[RightDoubleBracket]"}], "]"}]}], "&"}], ")"}],
                      "/@", RowBox[{"Keys", "[", "pairResults", "]"}]}]}],
                  ",", RowBox[{"\"method\"", "\[Rule]", "\"de Sitter segment: \
ExplicitRungeKutta order 8; radiation segment: Adams (restart at t = 0)\""}],
                  ",", RowBox[{"\"maxAbsDeviation\"", "\[Rule]", RowBox[
                     {"Max", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1",
                          "[", "\"maxAbsDeviation\"", "]"}], "&"}], ")"}],
                        "/@", RowBox[{"Values", "[", "pairResults", "]"}]}],
                      "]"}]}], ",", RowBox[{"\"maxPhaseAlignedDeviation\"",
                    "\[Rule]", RowBox[{"Max", "[", RowBox[{RowBox[{"(",
                          RowBox[{RowBox[{"#1", "[",
                          "\"maxPhaseAlignedDeviation\"", "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Values", "[", "pairResults",
                          "]"}]}], "]"}]}], ",", RowBox[
                   {"\"maxBeta2RelativeDeviation\"", "\[Rule]", RowBox[
                     {"Max", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1",
                          "[", "\"beta2RelativeDeviation\"", "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Values", "[", "pairResults",
                          "]"}]}], "]"}]}], ",", RowBox[
                   {"\"masslessBeta2EndNDSolve\"", "\[Rule]", RowBox[
                     {RowBox[{"pairResults", "[", RowBox[{"{", RowBox[{"0.`",
                          ",", "32"}], "}"}], "]"}], "[",
                      "\"beta2EndNDSolve\"", "]"}]}], ",", RowBox[
                   {"\"maxInitialAdiabaticResidual\"", "\[Rule]", RowBox[
                     {"Max", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1",
                          "[", "\"initialAdiabaticResidual\"", "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Values", "[", "pairResults",
                          "]"}]}], "]"}]}], ",", RowBox[
                   {"\"spectrumColumnVsLastRowMaxRelativeDeviation\"",
                    "\[Rule]", RowBox[{"Max", "[", RowBox[{RowBox[{"(",
                          RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{RowBox[
                          {"#1", "[", "\"beta2EndRust\"", "]"}], "\[Equal]",
                          "0.`"}], ",", "0.`", ",", FractionBox[RowBox[
                          {"Abs", "[", RowBox[{RowBox[{"#1", "[",
                          "\"beta2EndSpectrumCSV\"", "]"}], "-", RowBox[
                          {"#1", "[", "\"beta2EndRust\"", "]"}]}], "]"}],
                          RowBox[{"#1", "[", "\"beta2EndRust\"", "]"}]]}],
                          "]"}], "&"}], ")"}], "/@", RowBox[{"Values", "[",
                          "pairResults", "]"}]}], "]"}]}]}], "]"}]}]}],
          "]"}]}], ";", RowBox[{"exp4Checks", "=",
        RowBox[{"Association", "[", RowBox[
           {RowBox[{"\"exp4SymbolicReduction\"", "\[Rule]", RowBox[{"And",
                "@@", RowBox[{"Values", "[", "exp4Symbolic", "]"}]}]}], ",",
            RowBox[{"\"exp4InitialStates\"", "\[Rule]", RowBox[{
                RowBox[{RowBox[{RowBox[{"exp4Result", "[", "\"thermal\"",
                      "]"}], "[", "\"maxInitialEigenResidual\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "12"]]}], "&&", RowBox[{RowBox[{RowBox[{"exp4Result",
                      "[", "\"pair\"", "]"}], "[",
                    "\"maxInitialAdiabaticResidual\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "12"]]}]}]}], ",",
            RowBox[{"\"exp4ThermalNDSolveAgreement\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{RowBox[{"exp4Result", "[",
                      "\"thermal\"", "]"}], "[",
                    "\"oneIntervalMaxAbsDeviation\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "9"]]}], "&&",
                RowBox[{RowBox[{RowBox[{"exp4Result", "[", "\"thermal\"",
                      "]"}], "[", "\"maxPhaseAlignedDeviation\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "6"]]}], "&&", RowBox[{RowBox[{RowBox[{"exp4Result", "[",
                      "\"thermal\"", "]"}], "[", "\"maxInvariantDeviation\"",
                    "]"}], "\[LessEqual]", FractionBox["1", SuperscriptBox[
                    "10", "6"]]}], "&&", RowBox[{RowBox[{RowBox[
                     {"exp4Result", "[", "\"thermal\"", "]"}], "[",
                    "\"csvBilinearFormulaDeviation\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "12"]]}], "&&",
                RowBox[{RowBox[{RowBox[{"exp4Result", "[", "\"thermal\"",
                      "]"}], "[", "\"ndsolveAdamsVsRungeKuttaNode2\"", "]"}],
                  "\[LessEqual]", RowBox[{FractionBox["1", "10"], " ",
                    RowBox[{RowBox[{"exp4Result", "[", "\"thermal\"", "]"}],
                      "[", "\"maxAbsDeviation\"", "]"}]}]}]}]}], ",",
            RowBox[{"\"exp4KineticTheory\"", "\[Rule]", RowBox[{
                RowBox[{RowBox[{"thermalKinetic", "[",
                    "\"rhoModeSumMaxRelativeDeviation\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "6"]]}], "&&", RowBox[{RowBox[{"thermalKinetic", "[",
                    "\"rhoGaussLegendreMaxRelativeDeviation\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "9"]]}], "&&", RowBox[{RowBox[{"thermalKinetic", "[",
                    "\"pGaussLegendreMaxRelativeDeviation\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "9"]]}], "&&", RowBox[{RowBox[{"thermalKinetic", "[",
                    "\"pModeSumMaxRelativeDeviation\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "4"]]}]}]}], ",", RowBox[{"\"exp4PairNDSolveAgreement\"",
              "\[Rule]", RowBox[{RowBox[{RowBox[{RowBox[{"exp4Result", "[",
                      "\"pair\"", "]"}], "[", "\"maxPhaseAlignedDeviation\"",
                    "]"}], "\[LessEqual]", FractionBox["1", SuperscriptBox[
                    "10", "6"]]}], "&&", RowBox[{RowBox[{RowBox[
                     {"exp4Result", "[", "\"pair\"", "]"}], "[",
                    "\"maxBeta2RelativeDeviation\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "3"]]}], "&&",
                RowBox[{RowBox[{RowBox[{"exp4Result", "[", "\"pair\"", "]"}],
                    "[", "\"masslessBeta2EndNDSolve\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "10"]]}], "&&", RowBox[{RowBox[{RowBox[{"exp4Result",
                      "[", "\"pair\"", "]"}], "[",
                    "\"spectrumColumnVsLastRowMaxRelativeDeviation\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "9"]]}]}]}]}], "]"}]}], ";",
      RowBox[{"{", RowBox[{RowBox[{"KeyDrop", "[",
            RowBox[{RowBox[{"exp4Result", "[", "\"thermal\"", "]"}], ",",
              "\"perNode\""}], "]"}], ",", RowBox[{"exp4Result", "[",
            "\"pair\"", "]"}], ",", "exp4Checks"}], "}"}]}]], "Input"],
  Cell["EXP-5: extra-time sector, the ultrahyperbolic instability",
   "Section"], Cell["Background: extra times deflating, c = e^(-H t), \
vielbein diag(1, 1, 1, 1, 1, c, c, c), H = 1. Mode with extra-time momentum q \
along x5: Psi = V^(-1/2) e^(i q x5) u(t), V = e^(-3 H t). The reduction gives \
h = -i m gamma^4 - q e^(H t) gamma^4 gamma^5, with h^2 = (m^2 - q^2 e^(2 H \
t)) I (E^2 < 0 after t* = ln(m/q)/H) and h^dagger B = B h, so the Krein norm \
u^dagger B u is conserved while u^dagger u is not. The growth of ln(u^dagger \
u) over the window [t* + 1.5, t* + 3] is compared with the WKB integral W = \
Integral sqrt(Q^2 - m^2) dt (leading order 2 Delta W; first order 2 Delta W - \
(1/2) Delta ln(1 - m^2/Q^2)), with W evaluated by NIntegrate. Relative \
deviations are used because u^dagger u reaches about 1e16. A WorkingPrecision \
32 run of one case measures NDSolve's own error.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"frame5", "=", RowBox[{"DiagonalMatrix", "[",
          RowBox[{"{", RowBox[{"1", ",", "1", ",", "1", ",", "1", ",", "1",
              ",", RowBox[{"Exp", "[", RowBox[{RowBox[{"-", "hH"}], " ",
                  "x4"}], "]"}], ",", RowBox[{"Exp", "[", RowBox[
                 {RowBox[{"-", "hH"}], " ", "x4"}], "]"}], ",",
              RowBox[{"Exp", "[", RowBox[{RowBox[{"-", "hH"}], " ", "x4"}],
                "]"}]}], "}"}], "]"}]}], ";",
      RowBox[{"reduction5", "=", RowBox[{"reduceModeEquation", "[",
          RowBox[{"frame5", ",", RowBox[{RowBox[{"Exp", "[", FractionBox[
                 RowBox[{"3", " ", "hH", " ", "x4"}], "2"], "]"}], " ",
              RowBox[{"Exp", "[", RowBox[{"\[ImaginaryI]", " ", "qC", " ",
                  "x5"}], "]"}]}], ",", "mM", ",", "x4"}], "]"}]}], ";",
      RowBox[{"hDerived5", "=", RowBox[{"derivedHamiltonian", "[",
          RowBox[{"reduction5", ",", "Simplify"}], "]"}]}], ";",
      RowBox[{"exp5Symbolic", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"reductionLinear\"", "\[Rule]",
              RowBox[{"reduction5", "[", "\"residualIsLinear\"", "]"}]}],
            ",", RowBox[{"\"reducedEquationFreeOfX5\"", "\[Rule]",
              RowBox[{"FreeQ", "[", RowBox[{RowBox[{"Simplify", "[",
                    RowBox[{"reduction5", "[", "\"rest\"", "]"}], "]"}], ",",
                  "x5"}], "]"}]}], ",", RowBox[
             {"\"derivedHamiltonianEqualsRustForm\"", "\[Rule]",
              RowBox[{RowBox[{"Simplify", "[", RowBox[{"hDerived5", "-",
                    RowBox[{"modeHamiltonian", "[", RowBox[{"mM", ",",
                        RowBox[{"{", RowBox[{"0", ",", "0", ",", "0", ",",
                          "0", ",", "0", ",", RowBox[{"qC", " ", RowBox[
                          {"Exp", "[", RowBox[{"hH", " ", "x4"}], "]"}]}],
                          ",", "0", ",", "0"}], "}"}]}], "]"}]}], "]"}],
                "===", "zero16"}]}], ",", RowBox[{"\"hamiltonianSquared\"",
              "\[Rule]", RowBox[{RowBox[{"Simplify", "[", RowBox[
                   {RowBox[{"hDerived5", ".", "hDerived5"}], "-", RowBox[
                     {RowBox[{"(", RowBox[{SuperscriptBox["mM", "2"], "-",
                          RowBox[{SuperscriptBox["qC", "2"], " ", RowBox[
                          {"Exp", "[", RowBox[{"2", " ", "hH", " ", "x4"}],
                          "]"}]}]}], ")"}], " ", "id16"}]}], "]"}], "===",
                "zero16"}]}], ",", RowBox[{"\"kreinPseudoHermitian\"",
              "\[Rule]", RowBox[{RowBox[{"Simplify", "[", RowBox[
                   {RowBox[{RowBox[{TemplateBox[{"hDerived5"},
                         "ConjugateTranspose", SyntaxForm -> SuperscriptBox],
                        ".", "kreinB"}], "-", RowBox[{"kreinB", ".",
                        "hDerived5"}]}], ",", RowBox[{RowBox[{"{", RowBox[
                         {"mM", ",", "qC", ",", "hH", ",", "x4"}], "}"}],
                      "\[Element]", TemplateBox[{}, "Reals"]}]}], "]"}],
                "===", "zero16"}]}], ",", RowBox[{"\"notHermitian\"",
              "\[Rule]", RowBox[{RowBox[{"Simplify", "[", RowBox[
                   {RowBox[{TemplateBox[{"hDerived5"}, "ConjugateTranspose",
                       SyntaxForm -> SuperscriptBox], "-", "hDerived5"}],
                    ",", RowBox[{RowBox[{"{", RowBox[{"mM", ",", "qC", ",",
                          "hH", ",", "x4"}], "}"}], "\[Element]", TemplateBox[
                       {}, "Reals"]}]}], "]"}], "=!=", "zero16"}]}]}],
          "]"}]}], ";", RowBox[{"exp5GenM", "=",
        RowBox[{"realBlock", "[", RowBox[{RowBox[{"-", "\[ImaginaryI]"}],
            " ", RowBox[{SubscriptBox["\[PartialD]", RowBox[{"mM"}]],
              RowBox[{"(", RowBox[{"hDerived5", "/.", "\[VeryThinSpace]",
                  RowBox[{"hH", "\[Rule]", "1"}]}], ")"}]}]}], "]"}]}], ";",
      RowBox[{"exp5GenQ", "=", RowBox[{"realBlock", "[",
          RowBox[{RowBox[{"-", "\[ImaginaryI]"}], " ",
            RowBox[{SubscriptBox["\[PartialD]", RowBox[{"qC"}]],
              RowBox[{"(", RowBox[{"hDerived5", "/.", "\[VeryThinSpace]",
                  RowBox[{"hH", "\[Rule]", "1"}]}], ")"}]}], " ",
            RowBox[{"Exp", "[", RowBox[{"-", "x4"}], "]"}]}], "]"}]}], ";",
      "exp5Symbolic"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"exp5Mass", "=",
        RowBox[{"N", "[", RowBox[{RowBox[{RowBox[{"summaries", "[",
                "\"exp5\"", "]"}], "[", "\"parameters\"", "]"}], "[",
            "\"m\"", "]"}], "]"}]}], ";",
      RowBox[{RowBox[{"rhs5", "[", "q_", "]"}], ":=",
        RowBox[{"Function", "[", RowBox[{RowBox[{"{", RowBox[{"tt", ",",
                "y"}], "}"}], ",", RowBox[{RowBox[{"(", RowBox[
                 {RowBox[{"exp5Mass", " ", RowBox[{"N", "[", "exp5GenM",
                      "]"}]}], "+", RowBox[{"q", " ", RowBox[{"Exp", "[",
                      "tt", "]"}], " ", RowBox[{"N", "[", "exp5GenQ",
                      "]"}]}]}], ")"}], ".", "y"}]}], "]"}]}], ";",
      RowBox[{RowBox[{"wkbW", "[", RowBox[{"q_", ",", "tt_"}], "]"}], ":=",
        RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"q", " ", RowBox[
                 {"Exp", "[", "tt", "]"}]}], "\[LessEqual]", "exp5Mass"}],
            ",", "0.`", ",", RowBox[{"NIntegrate", "[", RowBox[{
                SqrtBox[RowBox[{RowBox[{SuperscriptBox["q", "2"], " ",
                     RowBox[{"Exp", "[", RowBox[{"2", " ", "s"}], "]"}]}],
                   "-", SuperscriptBox["exp5Mass", "2"]}]], ",",
                RowBox[{"{", RowBox[{"s", ",", RowBox[{"Log", "[",
                      FractionBox["exp5Mass", "q"], "]"}], ",", "tt"}],
                  "}"}], ",", RowBox[{"PrecisionGoal", "\[Rule]", "14"}],
                ",", RowBox[{"AccuracyGoal", "\[Rule]", "16"}]}], "]"}]}],
          "]"}]}], ";", RowBox[{"exp5RunResults", "=",
        RowBox[{"Association", "[", RowBox[{"Table", "[",
            RowBox[{RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                     {"run", ",", "ts", ",", "ys", ",", "q", ",", "fd", ",",
