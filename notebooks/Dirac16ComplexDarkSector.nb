                          {"AbsoluteThickness", "[", "2", "]"}]}], "]"}],
                          "&"}], ")"}], "/@", RowBox[{"vizColors",
                          "\[LeftDoubleBracket]", RowBox[{"1", ";;", "2"}],
                          "\[RightDoubleBracket]"}]}]}], ",", RowBox[
                         {"PlotRange", "\[Rule]", "All"}]}], "]"}], ",",
                    RowBox[{"ListPlot", "[", RowBox[{RowBox[{"{", RowBox[
                          {RowBox[{"rhoR", "\[LeftDoubleBracket]", RowBox[
