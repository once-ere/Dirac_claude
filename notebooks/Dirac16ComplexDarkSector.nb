  Cell[BoxData[RowBox[{RowBox[{"exp1Result", "=",
        RowBox[{"Association", "[", RowBox[{RowBox[{"\"symbolic\"",
              "\[Rule]", "exp1Symbolic"}], ",", RowBox[
             {"\"hamiltonianLinearInMassAndMomentum\"", "\[Rule]",
