                        "]"}]}], ";", RowBox[{"ts", "=", RowBox[{"columnOf",
                        "[", RowBox[{"run", ",", "\"t\""}], "]"}]}], ";",
                    RowBox[{"ys", "=", RowBox[{"columnsOf", "[", RowBox[
                         {"run", ",", "exp2Names"}], "]"}]}], ";",
                    RowBox[{"i0", "=", RowBox[{"First", "[", RowBox[
                         {"FirstPosition", "[", RowBox[{"ts", ",", "0.`"}],
                          "]"}], "]"}]}], ";", RowBox[{"fd", "=", RowBox[
                       {"fdCheck", "[", RowBox[{"ts", ",", "ys", ",",
                          RowBox[{"rhs2", "[", RowBox[{"spec", ",",
                          "MachinePrecision"}], "]"}], ",", RowBox[
                          {"Association", "[", RowBox[{RowBox[{"\"gravity\"",
                          "\[Rule]", RowBox[{"Range", "[", "6", "]"}]}], ",",
                          RowBox[{"\"spinor\"", "\[Rule]", RowBox[{"Range",
                          "[", RowBox[{"7", ",", "38"}], "]"}]}]}], "]"}],
                          ",", RowBox[{"rustTolerance", "[", "\"exp2\"",
                          "]"}]}], "]"}]}], ";", RowBox[{"back", "=",
                      RowBox[{"integrateSystem", "[", RowBox[{RowBox[{"rhs2",
                          "[", RowBox[{"spec", ",", "MachinePrecision"}],
                          "]"}], ",", RowBox[{"ys", "\[LeftDoubleBracket]",
                          "i0", "\[RightDoubleBracket]"}], ",", RowBox[
