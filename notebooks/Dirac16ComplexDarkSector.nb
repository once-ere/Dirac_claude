                          ";;", "2"}], "\[RightDoubleBracket]"}]}]}]}],
                      "]"}], ",", RowBox[{"Sequence", "@@", RowBox[
                       {"vizStyle", "[", RowBox[{"\"EXP-1 mixed state, K = 2: \
rho frozen, hidden-space pressure p_0 oscillates at 2E\"", ",",
                          "\"t = H x4\"", ",", "\"density / pressure\""}],
