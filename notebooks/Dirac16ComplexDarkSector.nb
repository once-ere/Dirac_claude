              RowBox[{"vol", "=", RowBox[{"1", "+", RowBox[{"th", " ",
                    "tS"}], "+", RowBox[{FractionBox["1", "2"], " ",
                    RowBox[{"(", RowBox[{"7", " ", "beta"}], ")"}], " ",
                    SuperscriptBox["tS", "2"]}]}]}], ";", RowBox[{"rates",
                "=", FractionBox[RowBox[{"hub0", "+", RowBox[{"beta", " ",
                     "tS"}]}], "vol"]}], ";", RowBox[{"Association", "[",
                RowBox[{RowBox[{"\"evolution\"", "\[Rule]", RowBox[
                     {RowBox[{"Simplify", "[", RowBox[{RowBox[{SubscriptBox[
                          "\[PartialD]", RowBox[{"tS"}]], "rates"}], "+",
                          RowBox[{"rates", " ", RowBox[{"Total", "[",
                          "rates", "]"}]}], "-", FractionBox[RowBox[{"kap",
                          " ", "mS0"}], RowBox[{"6", " ", "vol"}]]}], "]"}],
                      "===", RowBox[{"ConstantArray", "[", RowBox[{"0", ",",
                          "7"}], "]"}]}]}], ",", RowBox[{"\"volumeRate\"",
                    "\[Rule]", RowBox[{RowBox[{"Simplify", "[", RowBox[
                         {FractionBox[RowBox[{SubscriptBox["\[PartialD]",
                          RowBox[{"tS"}]], "vol"}], "vol"], "-", RowBox[
                          {"Total", "[", "rates", "]"}]}], "]"}], "===",
                      "0"}]}], ",", RowBox[{"\"constraintPropagates\"",
                    "\[Rule]", RowBox[{RowBox[{"Simplify", "[", RowBox[
                         {"Expand", "[", RowBox[{RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{UnderoverscriptBox["\[Sum]", "i", "7"],
                          RowBox[{UnderoverscriptBox["\[Sum]", RowBox[{"j",
                          "=", RowBox[{"i", "+", "1"}]}], "7"], RowBox[
                          {RowBox[{"rates", "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}], " ", RowBox[{"rates",
                          "\[LeftDoubleBracket]", "j",
                          "\[RightDoubleBracket]"}]}]}]}], "-", RowBox[
                          {"kap", " ", RowBox[{"(", RowBox[{FractionBox[
                          "mS0", "vol"], "+", FractionBox["lamS0sq", RowBox[
                          {"2", " ", SuperscriptBox["vol", "2"]}]]}],
                          ")"}]}]}], ")"}], " ", SuperscriptBox["vol",
                          "2"]}], "-", RowBox[{"(", RowBox[{RowBox[
                          {UnderoverscriptBox["\[Sum]", "i", "7"], RowBox[
                          {UnderoverscriptBox["\[Sum]", RowBox[{"j", "=",
                          RowBox[{"i", "+", "1"}]}], "7"], RowBox[{RowBox[
                          {"hub0", "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}], " ", RowBox[{"hub0",
                          "\[LeftDoubleBracket]", "j",
                          "\[RightDoubleBracket]"}]}]}]}], "-", RowBox[
                          {"kap", " ", RowBox[{"(", RowBox[{"mS0", "+",
                          FractionBox["lamS0sq", "2"]}], ")"}]}]}], ")"}]}],
                          "]"}], "]"}], "===", "0"}]}]}], "]"}]}]}], "]"}]}],
      ";", RowBox[{"exp2Symbolic", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"reductionLinear\"", "\[Rule]",
              RowBox[{"reduction2", "[", "\"residualIsLinear\"", "]"}]}],
            ",", RowBox[{"\"derivedHamiltonianEqualsRustForm\"", "\[Rule]",
              RowBox[{RowBox[{"Simplify", "[", RowBox[{"hDerived2", "-",
                    RowBox[{"modeHamiltonian", "[", RowBox[{"mM", ",",
                        RowBox[{"ConstantArray", "[", RowBox[{"0", ",",
                          "8"}], "]"}]}], "]"}]}], "]"}], "===",
                "zero16"}]}], ",", RowBox[{"\"einsteinDiagonal\"", "\[Rule]",
              RowBox[{RowBox[{"Simplify", "[", RowBox[{"einstein2H", "-",
                    RowBox[{"DiagonalMatrix", "[", RowBox[{"Diagonal", "[",
                        "einstein2H", "]"}], "]"}]}], "]"}], "===",
                RowBox[{"ConstantArray", "[", RowBox[{"0", ",", RowBox[
                     {"{", RowBox[{"8", ",", "8"}], "}"}]}], "]"}]}]}], ",",
            RowBox[{"\"groupsConsistent\"", "\[Rule]", RowBox[{
                RowBox[{"Simplify", "[", RowBox[{"{", RowBox[{RowBox[
                       {RowBox[{"einstein2H", "\[LeftDoubleBracket]",
                          RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}],
