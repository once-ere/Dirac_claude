              RowBox[{"closedForm2", "[", "\"constraintPropagates\"",
                "]"}]}]}], "]"}]}], ";",
      RowBox[{"{", RowBox[{RowBox[{"Diagonal", "[", "einstein2H", "]"}], ",",
