                RowBox[{"columnsOf", "[", RowBox[{"run", ",",
                    "spinorNames"}], "]"}]}], ";", RowBox[{RowBox[
                 {"fdCheck", "[", RowBox[{"ts", ",", "ys", ",", RowBox[
