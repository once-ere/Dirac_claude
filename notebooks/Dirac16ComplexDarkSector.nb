                          "\[RightDoubleBracket]"}], ",", "32"}], "]"}]}],
                          "}"}], ",", RowBox[{"SetPrecision", "[", RowBox[
                          {"ts", ",", "32"}], "]"}], ",", RowBox[{"Method",
                          "\[Rule]", "\"ExplicitRungeKutta\""}], ",", RowBox[
                          {"WorkingPrecision", "\[Rule]", "32"}], ",", RowBox[
