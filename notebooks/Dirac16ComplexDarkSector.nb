                          "[", "\"ndsolveMaxExactError\"", "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Values", "[",
                          "exp1RunResults", "]"}]}], "]"}]}], ",",
                  RowBox[{"\"maxExactErrorRust\"", "\[Rule]", RowBox[
                     {"Max", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1",
                          "[", "\"rustMaxExactError\"", "]"}], "&"}], ")"}],
                        "/@", RowBox[{"Values", "[", "exp1RunResults",
                          "]"}]}], "]"}]}]}], "]"}]}], ",",
            RowBox[{"\"maxObservableDeviation\"", "\[Rule]", RowBox[{"Max",
                "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1", "[",
                        "\"observableMaxAbsDeviation\"", "]"}], "&"}], ")"}],
                  "/@", RowBox[{"Values", "[", "exp1RunResults", "]"}]}],
                "]"}]}], ",", RowBox[{"\"maxInitialEigenResidual\"",
              "\[Rule]", RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                     {RowBox[{"#1", "[", "\"initialEigenResidual\"", "]"}],
                      "&"}], ")"}], "/@", RowBox[{"Values", "[",
                    "exp1RunResults", "]"}]}], "]"}]}], ",",
            RowBox[{"\"maxExactErrorColumnDeviation\"", "\[Rule]",
              RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                     {RowBox[{"#1", "[", "\"csvExactErrorColumnDeviation\"",
                        "]"}], "&"}], ")"}], "/@", RowBox[{"Values", "[",
                    "exp1RunResults", "]"}]}], "]"}]}], ",",
            RowBox[{"\"profileDifferenceA1A2\"", "\[Rule]",
              "exp1ProfileDifference"}]}], "]"}]}], ";",
      RowBox[{"exp1Checks", "=", RowBox[{"Association", "[",
          RowBox[{RowBox[{"\"exp1SymbolicReduction\"", "\[Rule]",
              RowBox[{RowBox[{"And", "@@", RowBox[{"Values", "[",
                    "exp1Symbolic", "]"}]}], "&&", "exp1LinearInMK"}]}], ",",
            RowBox[{"\"exp1BackgroundFile\"", "\[Rule]", RowBox[{"AllTrue",
                "[", RowBox[{RowBox[{"Values", "[", "backgroundCheck1",
                    "]"}], ",", RowBox[{RowBox[{RowBox[{RowBox[{"Max", "[",
                          RowBox[{"Values", "[", RowBox[{"KeyDrop", "[",
                          RowBox[{"#1", ",", RowBox[{"{", "\"maxRhoReq\"",
                          "}"}]}], "]"}], "]"}], "]"}], "\[LessEqual]",
                        FractionBox["1", SuperscriptBox["10", "9"]]}], "&&",
                      RowBox[{RowBox[{"#1", "[", "\"maxRhoReq\"", "]"}], "<",
                        "0"}]}], "&"}]}], "]"}]}], ",",
            RowBox[{"\"exp1FiniteDifferenceRHS\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{"exp1Result", "[",
                    "\"finiteDifference\"", "]"}], "[", "\"allPass\"", "]"}],
                "&&", RowBox[{RowBox[{"exp1Result", "[",
                    "\"finiteDifference\"", "]"}], "[",
                  "\"negativeControlFails\"", "]"}]}]}], ",",
            RowBox[{"\"exp1NDSolveAgreement\"", "\[Rule]",
              RowBox[{RowBox[{RowBox[{RowBox[{"exp1Result", "[",
                      "\"ndsolve\"", "]"}], "[",
                    "\"maxAbsStateDeviationVsRust\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "7"]]}], "&&",
                RowBox[{RowBox[{RowBox[{"exp1Result", "[", "\"ndsolve\"",
                      "]"}], "[", "\"maxExactErrorNDSolve\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "9"]]}]}]}], ",", RowBox[{"\"exp1Observables\"",
              "\[Rule]", RowBox[{RowBox[{RowBox[{"exp1Result", "[",
                    "\"maxObservableDeviation\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "12"]]}], "&&",
                RowBox[{RowBox[{"exp1Result", "[",
                    "\"maxInitialEigenResidual\"", "]"}], "\[LessEqual]",
                  FractionBox["1", SuperscriptBox["10", "12"]]}], "&&",
                RowBox[{RowBox[{"exp1Result", "[",
                    "\"maxExactErrorColumnDeviation\"", "]"}],
                  "\[LessEqual]", FractionBox["1", SuperscriptBox["10",
                    "12"]]}]}]}], ",", RowBox[{"\"exp1ProfileIndependence\"",
              "\[Rule]", RowBox[{"exp1ProfileDifference", "\[Equal]",
                "0"}]}]}], "]"}]}], ";",
      RowBox[{"{", RowBox[{RowBox[{"KeyDrop", "[", RowBox[{"exp1Result", ",",
              RowBox[{"{", RowBox[{"\"symbolic\"", ",", "\"background\""}],
                "}"}]}], "]"}], ",", "exp1Checks"}], "}"}]}]], "Input"],
  Cell[
   "EXP-2: self-consistent 8D Einstein - dirac16complex homogeneous \
cosmology", "Section"], Cell["Background: ds^2 = -dt^2 + b^2 dx0^2 + a^2 \
(dx1^2 + dx2^2 + dx3^2) - c^2 (dx5^2 + dx6^2 + dx7^2), t = x4, vielbein \
diag(b, a, a, a, 1, c, c, c). Mode Psi = V^(-1/2) u(t), V = b a^3 c^3: the \
reduction gives i du/dt = -i M_eff gamma^4 u. The mixed Einstein tensor is \
computed with H_i = h_i'/h_i and dH_i = H_i'. With a homogeneous isotropic \
source T^mu_nu = diag(p, p, p, p, -rho, p, p, p) the 44 equation G^4_4 = \
-kappa rho is the constraint Sum_{i<j} H_i H_j = kappa rho, and solving the \
three independent spatial equations G^i_i = kappa p for dH_i gives dH_i = \
-H_i Theta + kappa (rho - p)/6 on the constraint surface: exactly the Rust \
RHS. Matter: rho = m S + (lambda/2) S^2, p = (lambda/2) S^2 (k = 0, so the \
gradient pressures vanish), S = S0 s(u)/V (mean field, expectation-value \
rule). The closed-form solution used by the Rust self-checks, V = 1 + Theta0 \
t + (7 beta/2) t^2, H_i = (H_i0 + beta t)/V, beta = kappa m S0/6, is verified \
symbolically, including exact propagation of the constraint.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"frame2", "=", RowBox[{"DiagonalMatrix", "[",
          RowBox[{"{", RowBox[{RowBox[{"bF", "[", "x4", "]"}], ",",
