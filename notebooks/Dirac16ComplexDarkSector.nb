                 {RowBox[{RowBox[{"einstein2H", "\[LeftDoubleBracket]",
                      RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}],
                    "\[Equal]", RowBox[{"kap", " ", "pP"}]}], ",",
