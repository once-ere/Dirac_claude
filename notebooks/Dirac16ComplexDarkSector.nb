                        "]"}]}], ";", RowBox[{RowBox[{"spec", "[", "\"id\"",
                        "]"}], "\[Rule]", RowBox[{"Association", "[",
                        RowBox[{RowBox[{"\"fd\"", "\[Rule]", RowBox[{"fd",
                          "[", "\"spinor\"", "]"}]}], ",", RowBox[
