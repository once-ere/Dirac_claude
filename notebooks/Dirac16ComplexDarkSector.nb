              "backgroundCheck1"}], ",", RowBox[{"\"runCount\"", "\[Rule]",
              RowBox[{"Length", "[", "exp1RunResults", "]"}]}], ",",
            RowBox[{"\"finiteDifference\"", "\[Rule]", RowBox[{"Association",
                "[", RowBox[{RowBox[{"\"maxRelativeResidual\"", "\[Rule]",
                    RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{RowBox[{"#1", "[", "\"fd\"", "]"}], "[",
                          "\"maxRelativeResidual\"", "]"}], "&"}], ")"}],
                        "/@", RowBox[{"Values", "[", "exp1RunResults",
                          "]"}]}], "]"}]}], ",", RowBox[
                   {"\"maxRelativeTruncationEstimate\"", "\[Rule]",
                    RowBox[{"Max", "[", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{RowBox[{"#1", "[", "\"fd\"", "]"}], "[",
                          "\"maxRelativeTruncationEstimate\"", "]"}], "&"}],
                          ")"}], "/@", RowBox[{"Values", "[",
                          "exp1RunResults", "]"}]}], "]"}]}], ",",
                  RowBox[{"\"resolvedRows\"", "\[Rule]", RowBox[{"Total",
                      "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[{"#1",
                          "[", "\"fd\"", "]"}], "[", "\"resolvedRows\"",
                          "]"}], "&"}], ")"}], "/@", RowBox[{"Values", "[",
                          "exp1RunResults", "]"}]}], "]"}]}], ",",
                  RowBox[{"\"allPass\"", "\[Rule]", RowBox[{"AllTrue", "[",
                      RowBox[{RowBox[{"Values", "[", "exp1RunResults", "]"}],
                        ",", RowBox[{RowBox[{RowBox[{"#1", "[", "\"fd\"",
                          "]"}], "[", "\"pass\"", "]"}], "&"}]}], "]"}]}],
                  ",", RowBox[
                   {"\"negativeControlFlippedMassMaxRelativeResidual\"",
                    "\[Rule]", RowBox[{"exp1Control", "[",
                      "\"maxRelativeResidual\"", "]"}]}], ",", RowBox[
                   {"\"negativeControlFails\"", "\[Rule]", RowBox[{"!",
                      RowBox[{"exp1Control", "[", "\"pass\"", "]"}]}]}]}],
                "]"}]}], ",", RowBox[{"\"ndsolve\"", "\[Rule]",
              RowBox[{"Association", "[", RowBox[{RowBox[{"\"method\"",
                    "\[Rule]", "\"ExplicitRungeKutta order 8, machine \
precision, PrecisionGoal 13, AccuracyGoal 15\""}], ",", RowBox[
