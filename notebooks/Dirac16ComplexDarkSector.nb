                      RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}],
                    "\[Equal]", RowBox[{"kap", " ", "pP"}]}], ",",
                  RowBox[{RowBox[{"einstein2H", "\[LeftDoubleBracket]",
