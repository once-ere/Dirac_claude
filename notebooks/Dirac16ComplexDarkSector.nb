                       {"\"dot\"", ",", "\"line\"", ",", "\"dot\"", ",",
                        "\"line\""}], "}"}]}], "]"}]}], "]"}]}], ";",
          RowBox[{"AppendTo", "[", RowBox[{"figureFiles", ",",
              RowBox[{"exportFigure", "[", RowBox[
                 {"\"exp1_mixed_state_rho_p0.png\"", ",", "g"}], "]"}]}],
            "]"}], ";", "g"}]}], "]"}]], "Input"],
  Cell[BoxData[RowBox[{"Module", "[",
      RowBox[{RowBox[{"{", RowBox[{"curves", ",", "dots", ",", "g"}], "}"}],
        ",", RowBox[{RowBox[{"curves", "=", RowBox[{"Table", "[",
              RowBox[{RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                       {"amp", "=", RowBox[{"Rationalize", "[", RowBox[
                          {"N", "[", RowBox[{"bg", "[", "\"amplitude\"",
                          "]"}], "]"}], "]"}]}], "}"}], ",", RowBox[
                     {"Table", "[", RowBox[{RowBox[{"{", RowBox[{"tt", ",",
                          RowBox[{"-", RowBox[{"N", "[", RowBox[{RowBox[
                          {"einstein1", "\[LeftDoubleBracket]", RowBox[{"5",
                          ",", "5"}], "\[RightDoubleBracket]"}], "/.",
                          "\[VeryThinSpace]", RowBox[{"{", RowBox[{RowBox[
                          {RowBox[{SuperscriptBox["a4", "\[Prime]",
                          MultilineFunction -> None], "[", "_", "]"}],
                          "\[Rule]", RowBox[{"a4PrimeProfile", "[", RowBox[
                          {"amp", ",", "tt"}], "]"}]}], ",", RowBox[{RowBox[
                          {SuperscriptBox["a4", "\[Prime]\[Prime]",
