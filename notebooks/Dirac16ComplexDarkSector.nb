                          {"\"DifferenceOrder\"", "\[Rule]", "8"}]}],
                          "}"}]}], ",", RowBox[{"PrecisionGoal", "\[Rule]",
                          "13"}], ",", RowBox[{"AccuracyGoal", "\[Rule]",
                          "15"}]}], "]"}]}], ";", RowBox[{"rel", "=",
                      RowBox[{"Max", "[", RowBox[{"MapThread", "[", RowBox[
                          {RowBox[{FractionBox[TemplateBox[{RowBox[{"#1",
                          "-", "#2"}]}, "Norm"], TemplateBox[{"#2"},
                          "Norm"]], "&"}], ",", RowBox[{"{", RowBox[{"nd",
                          ",", "ys"}], "}"}]}], "]"}], "]"}]}], ";",
                    RowBox[{"krein0", "=", RowBox[{"kreinNormN", "[",
