                          "]"}], "[", "\"pass\"", "]"}], "&"}]}], "]"}]}]}],
                "]"}]}], ",", RowBox[{"\"ndsolve\"", "\[Rule]",
              RowBox[{"Association", "[", RowBox[{RowBox[{"\"method\"",
